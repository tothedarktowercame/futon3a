ized\n   :evidence [:signal-clean :coherence]\n   :target :hexagram-17-sui}\n\n@ant-interpretation\n  :policy\n  {:mode-bias :adaptive\n   :policy-priors {:forage 0.35 :return 0.25 :hold 0.2 :pheromone 0.2}\n   :description \"Active repair through targeted exploration\"}\n\n  :precision\n  {:Pi-o 0.6\n   :tau 0.6\n   :description \"Balanced exploration and correction\"}\n\n  :pattern-sense\n  {:trail-follow 0.4\n   :gradient-use 0.4\n   :novelty-seek 0.5\n   :description \"Seek and repair\"}\n\n  :adapt-trigger\n  {:condition :coherence-restored\n   :interpretation \"Return to following\"\n   :switch-to :hexagram-17-sui}\n\n  :failure-mode\n  \"Over-repair consumes resources\"\n\n@mmca-interpretation\n  :sigil-encoding\n  {:sigil \"蠱\"\n   :bits \"00101100\"\n   :interpretation \"Corrective intervention on degraded structure\"}\n\n  :exotype-params\n  {:rotation 2\n   :match-threshold 0.5\n   :invert-on-phenotype? true\n   :update-prob 0.55\n   :mix-mode :xor-neighbor\n   :description \"Corrective mixing\"}\n\n  :tensor-interpretation\n  {:operation :repair\n   :description \"Corrective transformation\"}\n\n  :regime-prediction\n  {:expected :repairing\n   :dynamics \"Disrupted patterns with corrective shifts\"\n   :eoc-relevance \"Can restore EoC after collapse\"}\n\n@domain-transfer-notes\n  \"蠱 is the pattern of REPAIR across domains:\n   - In ants: targeted exploration to fix decay\n   - In CA: corrective disruptions\""}], :conclusion "Decay requires deliberate repair; clear corruption before progress resumes.", :directives {:audience "improvisers, system designers, CT practitioners", :sigils ["🌆/一"], :style "pattern", :title "䷑ 蠱 (Gǔ) - Work on What Has Been Spoiled", :tone "foundational"}, :id "iching/hexagram-18-gu", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌆/一"], :source-path "library/iching/hexagram-18-gu.flexiarg", :sources [], :status :ok, :title "䷑ 蠱 (Gǔ) - Work on What Has Been Spoiled", :typed-slots nil} #: