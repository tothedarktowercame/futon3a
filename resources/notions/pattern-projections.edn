an}\n\n  :failure-mode\n  \"Over-approach causes backlash\"\n\n@mmca-interpretation\n  :sigil-encoding\n  {:sigil \"臨\"\n   :bits \"11000000\"\n   :interpretation \"Approach with moderate intervention\"}\n\n  :exotype-params\n  {:rotation 1\n   :match-threshold 0.55\n   :invert-on-phenotype? false\n   :update-prob 0.4\n   :mix-mode :majority\n   :description \"Engage while preserving structure\"}\n\n  :tensor-interpretation\n  {:operation :convergent-step\n   :description \"Reduce distance between modes\"}\n\n  :regime-prediction\n  {:expected :engaged\n   :dynamics \"Converging patterns\"\n   :eoc-relevance \"Potentially stabilizing\"}\n\n@domain-transfer-notes\n  \"臨 is the pattern of APPROACH across domains:\n   - In ants: gradual engagement with signals\n   - In CA: convergent dynamics\""}], :conclusion "Approach is confident engagement; progress comes by drawing near with care.", :directives {:audience "improvisers, system designers, CT practitioners", :sigils ["🙌/比"], :style "pattern", :title "䷒ 臨 (Lín) - Approach", :tone "foundational"}, :id "iching/hexagram-19-lin", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🙌/比"], :source-path "library/iching/hexagram-19-lin.flexiarg", :sources [], :status :ok, :title "䷒ 臨 (Lín) - Approach", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Observation clarifies; step back to see the whole before acting."} {:name "context", :name-key "context", :slug "context", :text "A system needs assessment and perspective."} {:name "IF", :name-key "if", :slug "if", :text "    Action is uncertain and signals are ambiguous."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Observation without action can lead to stagnation."} {:name "THEN", :name-key "then", :slug "then", :text "    Pause to observe, then re-engage with clarity."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Accurate perception gu