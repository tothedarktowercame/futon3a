typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Use diagnostics as a gate that triggers bounded corrections instead of opening an unbounded mastering phase."} {:name "context", :name-key "context", :slug "context", :text "You are building a daily audio workflow where recordings are source material and the binding constraint is about one hour of attention."} {:name "IF", :name-key "if", :slug "if", :text "    You want to improve listenability while keeping the workflow set-and-forget, and you suspect diagnostics could help your auto-bounce script."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    If you add diagnostics and conditional processing without a clear aim and stopping rule, you reintroduce an unbounded mastering phase."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat diagnostics as a gating instrument that classifies takes into a small number of mechanically defined states and triggers at most one or two bounded, deterministic corrections."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Discernment grows by reclassifying what is required now versus what must remain optional later."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Pick recent files you already judge as fine, borderline, and hard to listen to; run minimal metrics and confirm the classifications separate those groups.\n    - Keep thresholds stable and log only classifications and triggered corrections for a week."}], :conclusion "Use diagnostics as a gate that triggers bounded corrections instead of opening an unbounded mastering phase.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["🍁/一"], :style "pattern", :title "Discernment", :tone "reflective"}, :id "paramitas/discernment", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["🍁/一"], :source-path "library/paramitas/discernment.flexiarg", :sources [], :status :ok, :title "Discernment", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Preserve the middle story by treating traceable bridge events as the unit of evidence."} {:name "context", :name-key "context", :slug "context", :text "You are building FUTON as a single-user learning substrate linking heterogeneous traces without collapsing everything into simple causation."} {:name "IF", :name-key "if", :slug "if", :text "    You want to persist what mattered as auditable links so later reflection increases capacity to act, not just produce labels."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Simple arrows and naive affect labeling overcommit: they flatten experience, imply causation, and miss the middle story of who acted, what changed, and what evidence supports the linkage."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat the fundamental unit as a certified bridge event: lasso a constellation of antecedents and a constellation of consequences, connect them with a revisable arrow carrying a short proof trail, and allow the system to work forwards and backwards with links that can themselves be linked."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Capacity-building requires preserving the warranting middle of how a transition became actionable."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Implement first-class bridge records with timestamps, provenance, and certificates.\n    - Generate candidate bridges via short-window novelty and cross-domain proximity; support manual curation."}], :conclusion "Preserve the middle story by treating traceable bridge events as the unit of evidence.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["⌛️/久"], :style "pattern", :title "Endurance", :tone "reflective"}, :id "paramitas/endurance", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["⌛️/久"], :source-path "library/paramitas/endurance.flexiarg", :sources [], :status :ok, :title "Endurance", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Treat symbolic work as legitimate infrastructure while separating it from domains needing different exposure strategies."} {:name "context", :name-key "context", :slug "context", :text "You sustain meaningful symbolic or creative work without reliable developmental colleagues, while experiencing pressure from futures that could exist."} {:name "IF", :name-key "if", :slug "if", :text "    You continue solitary symbolic work that feels intrinsically right and notice it supports clarity and orientation toward the future."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    If that work is treated as indulgent or merely private, you may misinterpret the absence of colleagues or relational transitions as personal failure or immaturity."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat the symbolic work as legitimate infrastructural labor: a stable camp that preserves agency and anticipatory capacity, while deliberately separating it from domains that require different exposure strategies."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Symbolic futures exert real pressure in the present without being causal; equanimity depends on distinguishing which systems require planning versus openness."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Observe where longing arises from ecological mismatch rather than lack.\n    - Track whether pressure is misrouted between domains (for example, solving collegial absence through romance)."}], :conclusion "Treat symbolic work as legitimate infrastructure while separating it from domains needing different exposure strategies.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["🚴/止"], :style "pattern", :title "Equanimity", :tone "reflective"}, :id "paramitas/equanimity", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["🚴/止"], :source-path "library/paramitas/equanimity.flexiarg", :sources [], :status :ok, :title "Equanimity", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Design practices that contain recurring tension instead of trying to purify it into moral closure."} {:name "context", :name-key "context", :slug "context", :text "In social or institutional settings, recurring tensions persist despite good intentions."} {:name "IF", :name-key "if", :slug "if", :text "    You encounter ethical tension that reliably reappears and cannot be removed without denial, repression, or coercive control."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Treating the tension as something to be morally resolved collapses complexity and turns ethics into governance or policing."} {:name "THEN", :name-key "then", :slug "then", :text "    Design practices that contain the tension, localizing it in shared, repeatable forms that allow expression and circulation without claiming moral closure."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Ethical coherence under pressure depends on preventing collapse into denial or domination, not on eliminating constitutive forces."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Test whether a proposed solution suppresses the tension or merely relocates it.\n    - Compare failure modes of moralization versus containment."}], :conclusion "Design practices that contain recurring tension instead of trying to purify it into moral closure.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["😄/仁"], :style "pattern", :title "Ethical Containment vs Moral Totalisation", :tone "reflective"}, :id "paramitas/ethical-containment-vs-moral-totalisation", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["😄/仁"], :source-path "library/paramitas/ethical-containment-vs-moral-totalisation.flexiarg", :sources [], :status :ok, :title "Ethical Containment vs Moral Totalisation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Treat a break as a bounded, self-authored retreat that restores coherence."} {:name "context", :name-key "context", :slug "context", :text "You have a limited break period and want it to restore you without drifting into passive consumption or employer-driven obligation."} {:name "IF", :name-key "if", :slug "if", :text "    You notice that rest via stimulation or escape does not reliably produce groundedness or readiness, and conventional time off can leave you more fragmented."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    If you turn the break into unbounded self-work, you can recreate pressure, lose recuperation, or blur the line between chosen practice and compulsive productivity."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat the break as a bounded working-meditation retreat: use a small set of reflective prompts to set orientation, choose self-authored tasks that build coherence, and end by producing a credible re-entry plan that makes the return to paid work feel lighter."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Coherence reduces cognitive load more reliably than distraction does."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Track whether this mode improves re-entry (sleep regularity, task clarity on first workday, reduced avoidance).\n    - Compare against one consumption-rest break and note which constraints made it restorative."}], :conclusion "Treat a break as a bounded, self-authored retreat that restores coherence.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["🌲/习"], :style "pattern", :title "Generosity", :tone "reflective"}, :id "paramitas/generosity", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["🌲/习"], :source-path "library/paramitas/generosity.flexiarg", :sources [], :status :ok, :title "Generosity", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Locate learning in your own effort so good will does not turn into relational debt."} {:name "context", :name-key "context", :slug "context", :text "You are reflecting on relationships or collaborations where growth occurred, and you want to understand good will and closure without turning them into debts or myths of influence."} {:name "IF", :name-key "if", :slug "if", :text "    You treat growth or learning as something given by another person."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Learning and change arise from your own sustained engagement with conditions, not from another person's intentions alone; attribution misplaces agency and keeps relational accounting alive past its usefulness."} {:name "THEN", :name-key "then", :slug "then", :text "    Regard relationships as shared passages through space and time that create affordances, while locating learning, practice, and change firmly in your own ongoing effort and discernment."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Accurate attribution prevents transactional narratives from distorting good will and allows closure without denying either care or responsibility."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Notice where you are still running implicit ledgers (credit, blame, influence) in past relationships.\n    - Test whether those ledgers do explanatory work or merely sustain emotional load."}], :conclusion "Locate learning in your own effort so good will does not turn into relational debt.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["💗/仁"], :style "pattern", :title "Good Will", :tone "reflective"}, :id "paramitas/good-will", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["💗/仁"], :source-path "library/paramitas/good-will.flexiarg", :sources [], :status :ok, :title "Good Will", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Treat relational intensity as an ecological signal rather than a dyadic mandate."} {:name "context", :name-key "context", :slug "context", :text "A period of closeness or collaboration produces emotional intensity within a thin social ecology."} {:name "IF", :name-key "if", :slug "if", :text "    You experience attraction or heightened significance around a person or group while other channels are scarce or offline."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Treating that intensity as a dyadic fact about this person risks role inflation and forced escalation."} {:name "THEN", :name-key "then", :slug "then", :text "    Reframe the intensity as a signal of field conditions, allowing the relationship to remain what it already is without converting it into outcome."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Intensity often emerges from contextual compression rather than intrinsic relational demand; reading it ecologically preserves agency and proportionality."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Observe how intensity redistributes when additional channels reopen.\n    - Articulate an ethos of non-transactional presence so shared spaces remain breathable without requiring escalation."}], :conclusion "Treat relational intensity as an ecological signal rather than a dyadic mandate.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["⚡️/力"], :style "pattern", :title "Non-Transactional Intensity", :tone "reflective"}, :id "paramitas/non-transactional-intensity", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["⚡️/力"], :source-path "library/paramitas/non-transactional-intensity.flexiarg", :sources [], :status :ok, :title "Non-Transactional Intensity", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Design long-term work around legible forms of life, not only output or recognition."} {:name "context", :name-key "context", :slug "context", :text "You are sustaining a long-arc practice that blends research, tooling, reflection, and ethical orientation without assuming value must be proven through money or credentials."} {:name "IF", :name-key "if", :slug "if", :text "    Persistence is framed only in terms of continuous output, remuneration, or institutional approval."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Many viable forms of persistence are recognized through stable practices, roles, and visible patterns of conduct."} {:name "THEN", :name-key "then", :slug "then", :text "    Design persistence around legible forms of life: practices that remain coherent and intentional over time, regardless of whether they are rewarded, certified, or monetized."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Long-term work survives only when it is socially and internally intelligible as a way of living."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Identify which aspects of your practice already function as recognizable roles.\n    - Test external wrappers only insofar as they make the practice more visible without distorting it."}], :conclusion "Design long-term work around legible forms of life, not only output or recognition.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["🏃/功"], :style "pattern", :title "Persistence", :tone "reflective"}, :id "paramitas/persistence", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["🏃/功"], :source-path "library/paramitas/persistence.flexiarg", :sources [], :status :ok, :title "Persistence", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Treat craving as informational signal and route it to the domain that can legitimately respond."} {:name "context", :name-key "context", :slug "context", :text "You are engaged in demanding creative, technical, or relational work and notice recurring frustration or longing across multiple domains."} {:name "IF", :name-key "if", :slug "if", :text "    You experience craving and find yourself implicitly asking nearby people or activities to satisfy it."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Cravings attach to whatever is salient rather than to what can actually produce the desired quality, leading to misattribution and persistent suffering."} {:name "THEN", :name-key "then", :slug "then", :text "    Reframe craving as an informational signal about conditions and route it to the domain that can legitimately respond (technical frustration to model contracts, affective confusion to slow inquiry, relational warmth to appreciation without obligation, aesthetic desire to cultivating the right conditions)."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Craving is a pointer toward missing conditions; acting on it without checking jurisdiction produces category errors."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Notice where craving is being misrouted and identify the condition it points toward.\n    - Observe whether you are willing to cultivate the practices that would make that condition likely."}], :conclusion "Treat craving as informational signal and route it to the domain that can legitimately respond.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["🔺/今"], :style "pattern", :title "Proper Routing of Craving", :tone "reflective"}, :id "paramitas/proper-routing-of-craving", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["🔺/今"], :source-path "library/paramitas/proper-routing-of-craving.flexiarg", :sources [], :status :ok, :title "Proper Routing of Craving", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Frame governance work in proof-adjacent language so it is legible to formal-methods interlocutors."} {:name "context", :name-key "context", :slug "context", :text "You are considering re-entering the ethical AI space, and want your work understood as operational infrastructure for LLM-assisted reasoning."} {:name "IF", :name-key "if", :slug "if", :text "    You want to communicate your work as a missing cognitive governance layer so it is legible to serious practitioners and potential employers."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    If you frame it as generic AI ethics or a broad personal framework, it will be interpreted as compliance theater or idiosyncratic worldview."} {:name "THEN", :name-key "then", :slug "then", :text "    Anchor the story in a concrete governance gap in LLM-assisted reasoning, route it through formal-methods-aligned interlocutors using proof-adjacent language (assumptions, traceability, failure modes, audit trails), and include one or two crisp examples."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Formal-methods sensibilities provide shared criteria for good reasoning infrastructure, making the pattern layer legible as operational governance."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Select 2-3 recent artifacts where patterns constrained LLM work.\n    - Draft a one-paragraph governance gap statement with one concrete example and test it with a trusted interlocutor."}], :conclusion "Frame governance work in proof-adjacent language so it is legible to formal-methods interlocutors.", :directives {:audience "personal practice, reflective design", :references ["resources/sigils/paramitas.edn"], :sigils ["💬/白"], :style "pattern", :title "Truth", :tone "reflective"}, :id "paramitas/truth", :keywords [], :projection-version "flexiarg-v0", :references ["resources/sigils/paramitas.edn"], :scores {}, :sigils ["💬/白"], :source-path "library/paramitas/truth.flexiarg", :sources [], :status :ok, :title "Truth", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A good pattern includes simple signals that tell a reader when to apply it now."} {:name "context", :name-key "context", :slug "context", :text "Readers recognize the general idea but lack a concrete decision rule for adoption."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern is conceptually sound but hard to operationalize in the moment."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Overly rigid rules can miss nuanced cases."} {:name "THEN", :name-key "then", :slug "then", :text "    Provide lightweight decision criteria (signals, thresholds, or checks) that indicate the pattern is appropriate.\n    Prefer observable cues over internal states, and include at least one “do not apply yet” signal."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Patterns are used under time pressure; decision signals reduce hesitation and misuse."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: a case where the signals would have triggered correct use.\n    - evidence: a case where the “do not apply” signal prevented a bad use.\n    - evidence-shape: {:signals/apply [:string], :signals/avoid [:string], :decision/thresholds [:string], :example/trigger :string, :example/avoid :string}"}], :conclusion "A good pattern includes simple signals that tell a reader when to apply it now.", :directives {:audience "pattern authors, reviewers", :sigils ["🌀/内"], :style "pattern", :title "Provide Applicability Signals and Decision Criteria", :tone "technical"}, :id "pattern-coherence/applicability-signals", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌀/内"], :source-path "library/pattern-coherence/applicability-signals.flexiarg", :sources [], :status :ok, :title "Provide Applicability Signals and Decision Criteria", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A good pattern states the causal chain that links context to the proposed action and expected outcome."} {:name "context", :name-key "context", :slug "context", :text "Patterns are accepted as “nice ideas” but fail when applied because the cause-and-effect path is implicit."} {:name "IF", :name-key "if", :slug "if", :text "    The solution seems reasonable but the mechanism is not stated or testable."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Some domains rely on tacit practice and the mechanism may be partially inferred."} {:name "THEN", :name-key "then", :slug "then", :text "    Write the causal steps explicitly: what condition triggers the action, what changes, and why that change yields the outcome.\n    Include a short counterfactual (“If we did X instead, we would likely see Y”) to show why the action matters."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Patterns are decisions under uncertainty; an explicit mechanism makes them inspectable and improvable."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: a concrete example where the stated mechanism predicts the outcome.\n    - evidence: a counterexample where the mechanism fails and the pattern should not be used.\n    - evidence-shape: {:context :string, :trigger :string, :action :string, :mechanism :string, :expected/outcome :string, :counterfactual :string}"}], :conclusion "A good pattern states the causal chain that links context to the proposed action and expected outcome.", :directives {:audience "pattern authors, reviewers", :sigils ["🌂/允"], :style "pattern", :title "Make the Causal Chain Explicit", :tone "technical"}, :id "pattern-coherence/causal-clarity", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌂/允"], :source-path "library/pattern-coherence/causal-clarity.flexiarg", :sources [], :status :ok, :title "Make the Causal Chain Explicit", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A good pattern specifies evidence that would actually confirm or refute its claim."} {:name "context", :name-key "context", :slug "context", :text "Evidence sections often list artifacts without showing how they bear on the pattern’s conclusion."} {:name "IF", :name-key "if", :slug "if", :text "    Evidence is present but does not map to the claim or mechanism."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Early patterns may only have partial evidence."} {:name "THEN", :name-key "then", :slug "then", :text "    State what observation would increase or decrease confidence in the pattern and why.\n    Prefer evidence that targets the mechanism, not just the existence of a system or feature."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Evidence is only useful when it discriminates between a true and false pattern."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: a metric, log, or experiment that tests the mechanism.\n    - evidence: a falsifying observation that would trigger revision or retirement.\n    - evidence-shape: {:claim :string, :mechanism :string, :confirming-evidence [:string], :disconfirming-evidence [:string], :decision/rule :string}"}], :conclusion "A good pattern specifies evidence that would actually confirm or refute its claim.", :directives {:audience "pattern authors, reviewers", :keywords ["evidence" "claim" "confirm" "refute" "mechanism" "metric" "test" "falsify" "discriminate" "verify"], :sigils ["✂️/卜"], :style "pattern", :title "Align Evidence With the Claim", :tone "technical"}, :id "pattern-coherence/evidence-alignment", :keywords ["evidence" "claim" "confirm" "refute" "mechanism" "metric" "test" "falsify" "discriminate" "verify"], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["✂️/卜"], :source-path "library/pattern-coherence/evidence-alignment.flexiarg", :sources [], :status :ok, :title "Align Evidence With the Claim", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A good pattern has one clear statement for each required facet (context, IF, HOWEVER, THEN, BECAUSE, NEXT-STEPS) and each facet does real work."} {:name "context", :name-key "context", :slug "context", :text "You are reviewing or drafting a pattern that meets the structural template but feels vague or repetitive."} {:name "IF", :name-key "if", :slug "if", :text "    Each facet exists but overlaps or restates another facet instead of adding new meaning."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Some patterns are short and may not need long prose in every facet."} {:name "THEN", :name-key "then", :slug "then", :text "    Check each facet for a single, purpose-fit statement: context scopes where the pattern applies; IF states the trigger; HOWEVER names the tension or risk; THEN specifies the action; BECAUSE explains the mechanism or rationale; NEXT-STEPS names concrete evidence or follow-up actions. Remove duplicates and move scoping constraints into context."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Facet integrity keeps patterns readable, testable, and reusable across contexts."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: annotate one pattern with a brief note explaining what each facet contributes.\n    - evidence: identify one facet that can be shortened or clarified without losing meaning.\n    - evidence-shape: {:pattern/id :string, :context :string, :if :string, :however :string, :then :string, :because :string, :next-steps [:string], :reviewer :string}"}], :conclusion "A good pattern has one clear statement for each required facet (context, IF, HOWEVER, THEN, BECAUSE, NEXT-STEPS) and each facet does real work.", :directives {:audience "pattern authors, reviewers", :sigils ["⚡️/予"], :style "pattern", :title "Ensure Each Required Facet Is Coherent and Complete", :tone "technical"}, :id "pattern-coherence/facet-integrity", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["⚡️/予"], :source-path "library/pattern-coherence/facet-integrity.flexiarg", :sources [], :status :ok, :title "Ensure Each Required Facet Is Coherent and Complete", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A good pattern maintains internal coherence: the proposed action directly addresses the stated problem and yields the stated outcome."} {:name "context", :name-key "context", :slug "context", :text "Patterns sometimes mix a real problem with a fashionable solution, leaving a mismatch between cause and effect."} {:name "IF", :name-key "if", :slug "if", :text "    The action seems adjacent to the problem rather than addressing its core constraints."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Some patterns intentionally trade off one goal to achieve another."} {:name "THEN", :name-key "then", :slug "then", :text "    Check that each element maps: problem → constraint, action → constraint relief, outcome → constraint lifted.\n    If trade-offs exist, state them and show why the action still fits the problem."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Coherence is what turns a pattern from advice into a dependable decision rule."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: a trace that shows how the action changes the constraint.\n    - evidence: a trade-off note with a reason it is acceptable.\n    - evidence-shape: {:problem :string, :constraint :string, :action :string, :outcome :string, :trade-offs [:string], :trace :string}"}], :conclusion "A good pattern maintains internal coherence: the proposed action directly addresses the stated problem and yields the stated outcome.", :directives {:audience "pattern authors, reviewers", :keywords ["align" "problem" "action" "outcome" "constraint" "trade-off" "coherent" "match" "cause" "effect"], :sigils ["🌊/介"], :style "pattern", :title "Align Problem, Action, and Outcome", :tone "technical"}, :id "pattern-coherence/internal-coherence", :keywords ["align" "problem" "action" "outcome" "constraint" "trade-off" "coherent" "match" "cause" "effect"], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌊/介"], :source-path "library/pattern-coherence/internal-coherence.flexiarg", :sources [], :status :ok, :title "Align Problem, Action, and Outcome", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A good pattern defines where it applies and where it should not be used."} {:name "context", :name-key "context", :slug "context", :text "Patterns drift into slogans when boundaries are missing, leading to misuse outside their intended domain."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern reads as universally true or lacks explicit limits."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Overly narrow boundaries can make a useful pattern seem irrelevant."} {:name "THEN", :name-key "then", :slug "then", :text "    State at least one inclusion boundary (when it applies) and one exclusion boundary (when it does not).\n    Name the assumptions the pattern relies on (constraints, environment, actors, or scale)."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Clear boundaries prevent category errors and let readers decide quickly whether to apply the pattern."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: an application within the stated scope that succeeds.\n    - evidence: a near-scope case that fails and justifies the exclusion boundary.\n    - evidence-shape: {:applies-when [:string], :does-not-apply-when [:string], :assumptions [:string], :scope/example :string, :anti-scope/example :string}"}], :conclusion "A good pattern defines where it applies and where it should not be used.", :directives {:audience "pattern authors, reviewers", :keywords ["scope" "boundary" "limit" "apply" "exclude" "assumption" "domain" "relevant" "misuse" "non-goal"], :sigils ["📐/仁"], :style "pattern", :title "Declare Scope Boundaries and Non-Goals", :tone "technical"}, :id "pattern-coherence/scope-boundaries", :keywords ["scope" "boundary" "limit" "apply" "exclude" "assumption" "domain" "relevant" "misuse" "non-goal"], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["📐/仁"], :source-path "library/pattern-coherence/scope-boundaries.flexiarg", :sources [], :status :ok, :title "Declare Scope Boundaries and Non-Goals", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Among the seven canonical components, only the conclusion is structurally required; the other six (context, if, however, then, because, next-steps) are recommended for operational patterns but legitimately absent in definitional ones. The conclusion may be authored under any of four aliases — `! conclusion:`, `! claim:`, `! summary:`, or `! instantiated-by:` — all four are normalised to the same slot."} {:name "context", :name-key "context", :slug "context", :text "The clause-vocabulary survey across 919 patterns showed 96.8% have a conclusion (under one of the four aliases) but only 86.9% have an IF/HOWEVER pair. The 13% gap is real authorial signal: definitional patterns (\"a task IS a BHK arrow\") legitimately lack operational tension and so legitimately lack IF/HOWEVER. Forcing all seven would refuse those patterns or push authors into fabricating tension where none exists."} {:name "IF", :name-key "if", :slug "if", :text "A peripheral or verify invariant is deciding whether to admit/refuse a draft pattern based on which canonical components are present."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Requiring all seven refuses honest definitional patterns; requiring fewer than one (zero) admits anonymous artifacts with no claim. The conclusion is the only component every pattern MUST have because the conclusion IS the pattern's claim — its identity as an act of design."} {:name "THEN", :name-key "then", :slug "then", :text "Require the conclusion (any alias). Recommend the other six with a soft-warn discipline that surfaces \"this pattern would benefit from explicit IF/HOWEVER\" as advisory feedback, not refusal. For operational patterns the surface contract should encourage the central five (context/if/however/then/because) so the pattern lands in the categorical-admission shape; for definitional patterns the conclusion plus context plus references is enough."} {:name "CHECK", :name-key "check", :slug "check", :text "Engaged when the peripheral admits a draft iff a clause with name-key in #{conclusion claim summary instantiated-by} is present, regardless of which other components appear; advisory feedback names missing-recommended components without refusing. Failing when the peripheral refuses definitional patterns lacking IF/HOWEVER, OR admits patterns with no conclusion."} {:name "BECAUSE", :name-key "because", :slug "because", :text "A pattern is a unit of *claim*. Without a conclusion, an artifact is just structured prose — there is nothing to recommend, nothing to dispute, nothing to apply. With a conclusion plus any subset of the other six, the pattern can still be a meaningful act of design: a definition (conclusion + context + references), a tension-named pattern (conclusion + if + however), a procedure (conclusion + then), or a fully-shaped operational pattern (all seven). The four conclusion-aliases reflect that authors come to the same structural slot from different directions — `! conclusion:` from analytic-foundational tradition, `! claim:` from the Toulmin-extended canon, `! summary:` from informal documentation practice, `! instantiated-by:` from devmap-prototype headers. All four name the same load-bearing slot; the parser unifies them."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Encode the discipline in the verify invariant invariant-pattern-has-conclusion (already done; futon1a/src/futon1a/model/verify.clj).\n    - Wire advisory-warn for missing-recommended components into the Sokoban's response shape (admit + violations[soft-warn]).\n    - Decide which definitional-pattern shapes should still get IF/HOWEVER added authorially as the categorical-admission research matures."}], :conclusion "Among the seven canonical components, only the conclusion is structurally required; the other six (context, if, however, then, because, next-steps) are recommended for operational patterns but legitimately absent in definitional ones. The conclusion may be authored under any of four aliases — `! conclusion:`, `! claim:`, `! summary:`, or `! instantiated-by:` — all four are normalised to the same slot.", :directives {:audience "pattern authors, peripheral implementers, M-patterns-done-right", :keywords ["conclusion" "required-clause" "conclusion-aliases" "definitional-pattern" "operational-pattern" "optional-vs-required"], :references ["pattern-discipline/peripheral-as-sokoban" "futon-theory/single-source-of-truth"], :title "Conclusion Required, Other Canonical Components Recommended", :tone "analytic-foundational"}, :id "pattern-discipline/conclusion-required-others-recommended", :keywords ["conclusion" "required-clause" "conclusion-aliases" "definitional-pattern" "operational-pattern" "optional-vs-required"], :projection-version "flexiarg-v0", :references ["pattern-discipline/peripheral-as-sokoban" "futon-theory/single-source-of-truth"], :scores {}, :sigils [], :source-path "library/pattern-discipline/conclusion-required-others-recommended.flexiarg", :sources [], :status :ok, :title "Conclusion Required, Other Canonical Components Recommended", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A pattern is honestly applied when there is a verifiable receipt linking the code that was built using it back to the pattern's claim. Per-turn evidence (mining, Haiku-rationale) is one register; per-commit pattern-citation receipts are the structural other. Together they triangulate which patterns the codebase actually embodies vs which are well-intentioned text."} {:name "context", :name-key "context", :slug "context", :text "Today the pattern-to-code link is via PSR/PUR notes (pattern-coherence) plus per-turn evidence-mining (M-pattern-mining, M-pattern-retrieval-calibration); both are advisory. The IFR property \"demonstrable value\" (M-pattern-application-diagnostic §IFR) is structurally a witness check: applying a pattern's move should produce a measurable Δ in the geometric (T, ∇, Δ) substrate. Without commit-time receipts, the witness is asserted but not measured."} {:name "IF", :name-key "if", :slug "if", :text "An agent commits code in a region where one or more patterns have been claimed as the design substrate (PSR exists; mining attests; the operator has authorial intent for that region)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "There is no enforced structural link between the commit and the patterns it claims to apply. PSR notes are reflexive (\"I plan to apply X\"); PUR notes are retrospective (\"I applied X\"); neither is checkable against the code that landed. Mining is per-turn, not per-commit. The claim \"this commit applied pattern X\" has no verifiable witness today."} {:name "THEN", :name-key "then", :slug "then", :text "Adopt a receipts discipline: every commit that touches code in a pattern-claimed region carries a `Pattern: <ns>/<name>` footer (zero or more — multiple patterns are common). The footer joins the canonical parser + the geometric substrate: the receipt names the pattern's `:witness-shape`, the commit's region of effect, and the implicit T-before / T-after pair. Emit `pattern-receipt` evidence per commit; the verify invariant `invariant-pattern-receipts-resolve` checks every receipt's pattern-ref resolves and every claimed witness can be re-derived from current code state."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "M-bounded-in-flight-state already shipped a commit-footer parser for `Block: <kind>-<date>-<slug>$` (last occurrence wins). The same shape applies — `^Pattern: <ns>/<name>$` parser, idempotent emission, evidence record per commit."} {:name "MECHANISM", :name-key "mechanism", :slug "mechanism", :text "The receipt structurally links three things: (1) the commit's diff, locating it in the codebase hypergraph; (2) the claimed pattern, locating it in the design-pattern-category; (3) the geometric witness, computing T-before / T-after at the commit's region. Together they say \"this code embodies that pattern's move, by this measure.\""} {:name "COUNTERFACTUAL", :name-key "counterfactual", :slug "counterfactual", :text "Without receipts, the operator has no way to ask \"which patterns does this region of the codebase actually embody?\" — only \"which patterns were claimed.\" Per-turn evidence accumulates but doesn't aggregate to per-region truth. Receipts are the structural denominator."} {:name "BECAUSE", :name-key "because", :slug "because", :text "M-pattern-application-diagnostic's IFR demands \"demonstrable value\" — that the pattern's claim be verifiable against codebase state. Receipts are the operational form of that demand. Without them, the substrate's claim about pattern application is \"an agent said so\"; with them, the substrate's claim is \"the geometric witness corroborates.\" Per-turn evidence (mining, Haiku) is fast and noisy; per-commit receipts are slow and load-bearing — together they form a triangulation that catches both honest claims and gaming. The receipts discipline is also the structural form of the homeostatic agent's self-check on its own design vocabulary: when a pattern's receipts consistently fail the witness check, the pattern is wrong-shaped or never honestly applied; the agent learns about its own design language by reading its receipts."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Footer parser: `^Pattern: <ns>/<name>$`, last occurrence wins, mirrored on the M-bounded-in-flight-state Block-id parser.\n    - Pre-commit advisory: warn when committing in a region with no Pattern footer; do not block (advisory phase).\n    - Evidence emission: emit `pattern-receipt` evidence per commit with {commit-sha, patterns: [...], regions: [...]}.\n    - Verify invariant: `invariant-pattern-receipts-resolve` — every receipt's pattern-ref resolves; every claimed pattern's witness can be re-derived.\n    - Geometric witness wiring: integrate with M-pattern-application-diagnostic's (T, ∇, Δ) computation so receipts include T-before/T-after deltas.\n    - Cutover discipline: receipts from this date forward; historical commits stay as they are."}], :conclusion "A pattern is honestly applied when there is a verifiable receipt linking the code that was built using it back to the pattern's claim. Per-turn evidence (mining, Haiku-rationale) is one register; per-commit pattern-citation receipts are the structural other. Together they triangulate which patterns the codebase actually embodies vs which are well-intentioned text.", :directives {:audience "pattern theorists, M-pattern-application-diagnostic, M-patterns-done-right", :keywords ["pattern-receipt" "code-witness" "level-4" "demonstrable-value" "commit-footer" "geometric-witness" "IFR"], :references ["pattern-discipline/peripheral-as-sokoban" "pattern-discipline/patterns-as-categorical-objects"], :title "Pattern-to-Code Receipts — Structural Link Between Claim And Witness", :tone "operational"}, :id "pattern-discipline/pattern-to-code-receipts", :keywords ["pattern-receipt" "code-witness" "level-4" "demonstrable-value" "commit-footer" "geometric-witness" "IFR"], :projection-version "flexiarg-v0", :references ["pattern-discipline/peripheral-as-sokoban" "pattern-discipline/patterns-as-categorical-objects"], :scores {}, :sigils [], :source-path "library/pattern-discipline/pattern-to-code-receipts.flexiarg", :sources [], :status :ok, :title "Pattern-to-Code Receipts — Structural Link Between Claim And Witness", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Patterns are not isolated text artifacts but objects in a category whose morphisms include the canonical components (context / if / however / then / because) treated as required edges; a new pattern is admitted as a new object iff its morphisms compose cleanly with the category's existing structure. Composition is what makes a pattern library a *language* rather than a flat catalog — paths through the morphism graph are design moves."} {:name "context", :name-key "context", :slug "context", :text "futon5/src/futon5/ct/dsl.clj already implements Functor / Diagram / Category / NaturalTransformation records, plus a design-pattern-category whose morphisms are :kernel-step / :frame / :justify / :synthesize. futon5/scripts/pattern_to_wiring.clj turns sigil-pattern-registry entries into wiring diagrams under resources/xenotype-wirings/. The categorical substrate exists and is reachable; what's missing is the bridge from the canonical seven (Level 1's text-shape) to the morphism predicate (Level 3's admission test)."} {:name "IF", :name-key "if", :slug "if", :text "A new pattern is being submitted to the peripheral and the operator wants admission to depend on more than text-shape — they want admission to verify the pattern's morphisms compose with the existing pattern-category."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Functorial admission is genuinely research, not just engineering. Decisions outstanding: which canonical components are *required* morphisms vs *optional*; which categorical laws must hold (associativity is straightforward; naturality of :tension ↔ :move is harder); how the futon3a pattern library and futon5's categorical infrastructure rendezvous concretely. Premature commitment to a wrong predicate would refuse honest patterns or admit incoherent ones."} {:name "THEN", :name-key "then", :slug "then", :text "Treat each canonical-seven component as a typed edge from the pattern-object: `:pattern/has-context`, `:pattern/has-if`, etc. (Level 1 already emits these into futon1a XTDB.) Build the admission predicate as: (a) the new pattern's edges yield a sub-diagram in the design-pattern-category; (b) the sub-diagram composes with sibling patterns' diagrams without violating the category's laws; (c) on success, the pattern lands AND a wiring diagram is generated under resources/xenotype-wirings/ alongside the canonical .flexiarg."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      Kernel-step composition (linear): pattern A's THEN feeds into pattern B's CONTEXT — chain A→B as a path in the morphism graph.\n      Frame composition (parallel): pattern A and pattern B share an IF — they apply in the same scope with different moves; tensor-diagrams is the right operator.\n      Naturality: when patterns at one abstraction level have natural transformations to patterns at another (instantiated-by relationships), the transformations should commute with the morphisms."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "futon5's compose-diagrams and tensor-diagrams already exist as primitives; design-pattern-category names :kernel-step / :frame / :justify / :synthesize as morphism families. The substrate is concrete, not aspirational."} {:name "BECAUSE", :name-key "because", :slug "because", :text "A pattern library is more than the sum of its parts when its patterns *compose* — when invoking pattern A leads naturally to invoking pattern B because their morphisms chain. That's how Alexander's pattern languages were supposed to work; that's what most software pattern catalogs lost when they collapsed pattern-language into a flat list. The categorical framing recovers compositionality structurally: admission requires the new pattern fit the category, and the category's laws ensure the moves chain cleanly. The \"more than sum of parts\" payoff is operational, not metaphorical: an agent following pattern A is *guided* into pattern B because the morphism is computed, not asserted."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Decide which canonical seven are required morphisms (probably context as object-type; if/however as morphism-source/target predicates; then as morphism realisation; because as morphism justification; conclusion as morphism identity; next-steps as composition-with-future-morphisms).\n    - Spike the admission predicate on 5 patterns from library/futon-theory/ — the most theoretically structured namespace. See whether their morphisms compose without contradiction.\n    - Wire the predicate into the Sokoban's submit-draft! as a graduation from Level 1 to Level 3. Failure feedback names which morphism doesn't compose and with which sibling pattern.\n    - Generate wiring diagrams on admission; surface them in Arxana / Web Arxana so authors can see the categorical neighbourhood the new pattern joined."}], :conclusion "Patterns are not isolated text artifacts but objects in a category whose morphisms include the canonical components (context / if / however / then / because) treated as required edges; a new pattern is admitted as a new object iff its morphisms compose cleanly with the category's existing structure. Composition is what makes a pattern library a *language* rather than a flat catalog — paths through the morphism graph are design moves.", :directives {:audience "pattern theorists, futon5 ct-dsl implementers, M-patterns-done-right", :keywords ["categorical" "functor" "morphism" "composition" "wiring-diagram" "pattern-language" "level-3" "futon5"], :references ["pattern-discipline/peripheral-as-sokoban" "pattern-discipline/conclusion-required-others-recommended"], :title "Patterns As Categorical Objects, Not Isolated Text", :tone "analytic-research"}, :id "pattern-discipline/patterns-as-categorical-objects", :keywords ["categorical" "functor" "morphism" "composition" "wiring-diagram" "pattern-language" "level-3" "futon5"], :projection-version "flexiarg-v0", :references ["pattern-discipline/peripheral-as-sokoban" "pattern-discipline/conclusion-required-others-recommended"], :scores {}, :sigils [], :source-path "library/pattern-discipline/patterns-as-categorical-objects.flexiarg", :sources [], :status :ok, :title "Patterns As Categorical Objects, Not Isolated Text", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peripheral that constrains pattern authoring is a pre-write capability envelope, not a post-write validator. An agent inside the surface can submit a draft and either it lands as a canonical artifact OR the surface refuses with structured feedback and writes nothing. No leakage — non-canonical drafts cannot be emitted from inside the peripheral."} {:name "context", :name-key "context", :slug "context", :text "When agents are asked to \"create a new library pattern\" without a constrained surface, they reach for free-form Edit/Write tools and produce drafts that drift from the canonical shape. Drift accumulates: each individual draft looks reasonable but the library as a whole loses coherence. Post-write validation can detect drift but cannot prevent the agent from having already split their attention across the wrong shape — by then the authorial intent has settled in the wrong frame."} {:name "IF", :name-key "if", :slug "if", :text "An agent is authoring a pattern (or any artifact whose typed shape must hold across a corpus), and the operator wants the canonical-shape invariant to bind at write time rather than detect drift retrospectively."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Free-form Edit/Write tools cannot enforce shape; an agent can always emit a non-canonical draft and a downstream validator can only detect it after the fact. Even with strict validation, the authorial intent has already been shaped by the wrong frame; the validator's refusal is felt as friction rather than as guidance."} {:name "THEN", :name-key "then", :slug "then", :text "Provide a peripheral that exposes only a single bound action — submit-draft. Inside the peripheral, Edit/Write are constrained for the typed-artifact paths. The submit action validates against the canonical shape, runs reshape rules where they apply deterministically, and either lands the canonical form or refuses with structured feedback naming what is missing or non-canonical. The agent stays in the peripheral until the draft canonicalises (Sokoban — only legal moves available); on success, evidence is emitted recording the admission."} {:name "CHECK", :name-key "check", :slug "check", :text "Engaged when the agent's only legal write-path inside the peripheral is the submit action; refusals carry structured violations with kind/detail/where and a pointer to the rulebook so re-drafting is informed; nothing lands on disk unless every required check passes (no-leakage). Failing when an agent can bypass via direct Edit/Write; refusal feedback is unstructured prose; partial drafts land on disk."} {:name "BECAUSE", :name-key "because", :slug "because", :text "The canonical-shape invariant must be enforced at write time, not detected later. Detection-after-the-fact (post-write validation) is necessary but not sufficient — by the time the validator fires, the agent's authorial intent has already been shaped by the wrong frame and the corpus has been silently degraded. Pre-write enforcement is the structural form of the intent: the surface itself disallows the bad move, so the agent's attention never splits across non-canonical shapes. This is the same shape as Curry-Howard — the type system constrains expressible programs; the peripheral constrains expressible drafts."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Wire the peripheral into futon3c's session-mode dispatch so an agent enters pattern-author mode and has Edit/Write constrained for library/**.flexiarg.\n    - Surface contract on entry: the agent's session prompt names the peripheral and the only legal write path.\n    - Refusal-feedback links to the rulebook + the algorithm + the canonical parser so an agent can self-correct from the violation alone.\n    - Generalise the pattern: peripherals for other typed artifacts (mission docs, dispositions, commit-block-ids) get the same Sokoban discipline."}], :conclusion "A peripheral that constrains pattern authoring is a pre-write capability envelope, not a post-write validator. An agent inside the surface can submit a draft and either it lands as a canonical artifact OR the surface refuses with structured feedback and writes nothing. No leakage — non-canonical drafts cannot be emitted from inside the peripheral.", :directives {:audience "pattern authors, futon3c peripheral implementers, M-patterns-done-right", :keywords ["peripheral" "sokoban" "pre-write" "capability-envelope" "write-time-invariant" "no-leakage" "pattern-authoring"], :references ["futon-theory/single-source-of-truth" "pattern-coherence/internal-coherence"], :title "Peripheral As Sokoban — Pre-write Capability Envelope, Not Post-write Validator", :tone "analytic-operational"}, :id "pattern-discipline/peripheral-as-sokoban", :keywords ["peripheral" "sokoban" "pre-write" "capability-envelope" "write-time-invariant" "no-leakage" "pattern-authoring"], :projection-version "flexiarg-v0", :references ["futon-theory/single-source-of-truth" "pattern-coherence/internal-coherence"], :scores {}, :sigils [], :source-path "library/pattern-discipline/peripheral-as-sokoban.flexiarg", :sources [], :status :ok, :title "Peripheral As Sokoban — Pre-write Capability Envelope, Not Post-write Validator", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peer-learning group has a finite carrying capacity for any one participant's contribution rate, and any one participant has a finite carrying capacity for the project.  Sustained over-contribution by some, or under-contribution by others, will distort the group's dynamics and burn people out.  The pattern is to recognise the asymmetry in real time and adjust — by stepping back, by inviting others in, by reducing one's own pace, or by reshaping the work so it costs less to enter."} {:name "context", :name-key "context", :slug "context", :text "Peer-learning groups attract uneven engagement.  Some contributors take on disproportionate load; others lurk, intend to contribute, and never enter; energetic participants railroad ideas; reflective participants go silent.  These are not individual failings — they are predictable dynamics of voluntary co-production.  Carrying capacity asks each participant and the group as a whole to keep these dynamics inside survivable bands rather than letting them run unchecked."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: individual momentum ↔ group sustainability.\n    Irreducible: a group cannot maximise both individual contribution rates and balanced participation.  At any given moment one is being prioritised over the other; the question is whether the trade is conscious."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: high-momentum contributors keep the project alive in the short term; the same momentum, sustained, can crowd out the participation that makes the project peer-driven in the first place.  Both effects are real and operate simultaneously.\n    Active dynamic: the pull recurs whenever a contributor feels burnout symptoms, whenever discussion patterns become one-directional, and whenever a roadmap revision exposes who has been carrying which load."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Burnout cascade: a high-contributor exits abruptly and the project stalls because no one was tracking their load.\n      - Power-law lock-in: the engagement distribution flattens into \"the same five people forever\" with no ramp for others.\n      - Silent dissent: under-contributors disagree but do not say so, because the cost of entering the conversation has grown too high.\n      - Roadmap drift: the project's stated goal and its actual concentration of effort diverge without anyone surfacing the gap."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Step back, observe: a high-contributing participant deliberately reduces their pace and watches the dynamics that emerge in the space they leave.  This is diagnostic before it is corrective.\n      (2) Ask, then listen: replace assertion with question — \"what do others think?\" — and accept that the answer may be a longer silence than the assertive participant would have tolerated.\n      (3) Reshape the entry cost: rather than only modulating one's own behaviour, change the project so others can join cheaply — clearer explanations, smaller first tasks, a more legible roadmap.\n      (4) Name the role-change: when stepping back temporarily, tell whoever holds the facilitation role.  This protects the group from interpreting absence as drift.\n      (5) Renegotiate the goal: revisit the roadmap and confirm what concrete goal the group is moving toward, since over- and under-contribution often track to ambiguity about what counts as progress."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: contributors notice their own and others' load and adjust before the dynamics ossify; participation distributes across the group rather than concentrating on a few.  Failing when: the same names appear on every contribution thread, or a participant is operating well past their sustainable rate without anyone naming it."}], :conclusion "A peer-learning group has a finite carrying capacity for any one participant's contribution rate, and any one participant has a finite carrying capacity for the project.  Sustained over-contribution by some, or under-contribution by others, will distort the group's dynamics and burn people out.  The pattern is to recognise the asymmetry in real time and adjust — by stepping back, by inviting others in, by reducing one's own pace, or by reshaping the work so it costs less to enter.", :directives {:audience "peer-learning facilitators, contributors", :keywords ["burnout" "over-contribution" "dominance" "sustainability" "throttling" "stepping-back"], :references ["peeragogy/heartbeat" "peeragogy/moderation" "peeragogy/roles"], :style "process-pattern", :title "Match Engagement to What the Group and the Person Can Sustain", :tone "practical"}, :id "peeragogy/carrying-capacity", :keywords ["burnout" "over-contribution" "dominance" "sustainability" "throttling" "stepping-back"], :projection-version "flexiarg-v0", :references ["peeragogy/heartbeat" "peeragogy/moderation" "peeragogy/roles"], :scores {}, :sigils [], :source-path "library/peeragogy/carrying-capacity.flexiarg", :sources [], :status :ok, :title "Match Engagement to What the Group and the Person Can Sustain", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a peer-learning practice is new, the meanings that would let participants use it are not yet stable — often they have not been created.  Writing a guide is not a separate step that follows the practice; it is part of the practice, a way of figuring out how the system works while making it more usable for the next person.  The guide is best treated as a living micro-map, edited reflexively as the territory shifts."} {:name "context", :name-key "context", :slug "context", :text "New practices, including peer-learning practices, accumulate tacit knowledge faster than they accumulate vocabulary.  A guide written too late is a record of a stabilised practice; a guide written in parallel is itself a tool of stabilisation.  Knowledge cartography (concept maps, glossaries, navigations) and meaning-making frames help, but the central move is reflexivity: each guide-writing pass surfaces what has been figured out, and each practice pass surfaces what the guide must update.  The handbook itself is an instance of this pattern."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: capture-now ↔ stabilise-first.\n    Irreducible: a guide cannot simultaneously be a definitive reference and a working notebook.  The question is which mode the current pass is operating in, not whether one mode is correct."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: writing a guide for a moving practice risks fixing too early what should still flex; waiting for stability risks losing the stage at which the practice could have been made teachable.  Both risks operate continuously.\n    Active dynamic: the pull recurs at every iteration boundary — every time the practice shifts, the guide either lags, leads, or co-evolves."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Stale handbook: the guide describes the practice as it was at a previous version, with no dating to flag the gap.\n      - Single-author bottleneck: only one person edits the guide, so guide-updates lag every change made by anyone else.\n      - Premature canonicalisation: the guide is written as a definitive reference before the practice has stabilised, freezing decisions that should still be moving.\n      - Tacit-knowledge accumulation: practitioners share understanding informally and never feel pressure to write it down, leaving newcomers without a path in."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Co-evolution: the guide is updated each time the practice changes substantively, with explicit dating of which sections describe which version of the practice.  Readers can see the trail.\n      (2) Micro-map per activity: rather than one definitive guide, the project produces small, scoped guides for individual activities (refining a pattern, running a session, onboarding a contributor).  Each micro-map can be revised without disturbing the others.\n      (3) Reflexive note: when the guide-writer notices that writing a section is forcing the practice to clarify, they record that fact in the guide itself.  The guide then documents not only the practice but the practice-of-clarifying-the-practice.\n      (4) \"Map is not the territory\" hedge: the guide states explicitly which decisions remain open, which examples are illustrative versus prescriptive, and where the practice is still discovering itself.  Readers do not mistake provisional articulation for settled doctrine."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: the guide is updated within the same iteration as the practice changes it describes, and contributors treat editing the guide as part of doing the work.  Failing when: the guide describes a stage the project has already left, or guide-writing is treated as a separate, post-hoc job."}], :conclusion "When a peer-learning practice is new, the meanings that would let participants use it are not yet stable — often they have not been created.  Writing a guide is not a separate step that follows the practice; it is part of the practice, a way of figuring out how the system works while making it more usable for the next person.  The guide is best treated as a living micro-map, edited reflexively as the territory shifts.", :directives {:audience "peer-learning practitioners, would-be authors", :keywords ["handbook" "map" "knowledge-cartography" "meaning-making" "micro-map" "reflexivity"], :references ["peeragogy/pattern-language" "peeragogy/wrapper" "peeragogy/discerning-a-pattern"], :style "process-pattern", :title "Build the Guide While You Build the Practice", :tone "reflective"}, :id "peeragogy/creating-a-guide", :keywords ["handbook" "map" "knowledge-cartography" "meaning-making" "micro-map" "reflexivity"], :projection-version "flexiarg-v0", :references ["peeragogy/pattern-language" "peeragogy/wrapper" "peeragogy/discerning-a-pattern"], :scores {}, :sigils [], :source-path "library/peeragogy/creating-a-guide.flexiarg", :sources [], :status :ok, :title "Build the Guide While You Build the Practice", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peer-learning practice runs into trouble when its facilitators position themselves as either experts (talking down to the group) or as flat-equals (refusing to bring stewardship).  The curating-not-experting stance is a third position: bring people into conversation, hold the shape of the inquiry, and invite expertise from wherever it actually lives — which is often distributed across the group, not concentrated in one person.  The stance distinguishes peeragogy from both top-down pedagogy and from leaderless co-learning."} {:name "context", :name-key "context", :slug "context", :text "A facilitator convenes a group around a topic the facilitator is interested in.  A pure expert stance positions the facilitator as the source of knowledge; the group's job becomes receiving.  A pure peer stance refuses to acknowledge that the facilitator is doing real work in shaping the inquiry; the group's job becomes nothing in particular and the inquiry drifts.  The curating-not-experting stance is what works in practice: the facilitator is not the source of the knowledge but is responsible for the shape of the conversation, the choice of who's at the table, and the integration of what surfaces."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: stewardship ↔ expert-authority.\n    Irreducible: facilitation is real labor; flat-equality denies it.  Expertise is also real; pretending no one has more knowledge than anyone else is a fiction.  The curating stance acknowledges both without conflating them."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: groups need someone to hold the shape of an inquiry — without that, conversations meander and don't accumulate.  But if the shape-holder claims to be the expert on the content, the group's other voices recede and the inquiry contracts to one perspective.\n    Active dynamic: the pull recurs every time the facilitator is asked a substantive question they could either answer or redirect, and every time the conversation drifts and someone needs to bring it back without imposing."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Question-funneling: substantive questions all route through the facilitator, who answers them as the expert.\n      - Shape-collapse: without the facilitator actively holding the inquiry, the conversation drifts and doesn't accumulate.\n      - Performance-of-flatness: the facilitator refuses to acknowledge their convening labor, which leaves the group unable to credit, extend, or eventually take it over.\n      - Voice-monoculture: the same few voices dominate because no one is curating who speaks.\n      - Expert-arrival defaulting: when an expert joins the conversation, the room reorganises around them as authority instead of as one voice the curator brought in."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Source naming: when a substantive question arises that the facilitator could answer, the facilitator instead names whose expertise — in the room or beyond — would be most apt, and brings them in.\n      (2) Shape-holding: the facilitator articulates the inquiry's question(s) explicitly, returns to them when the conversation drifts, and tracks which questions are still open.\n      (3) Voice-curation: the facilitator notices which voices haven't spoken and creates space for them, without putting individuals on the spot.\n      (4) Integrative wrap: at session close, the facilitator names what the conversation surfaced — not a verdict on what's true, but a curatorial summary of what was said and where it points.\n      (5) Connective intelligence: the facilitator treats the conversation as a node in a wider network — explicitly bringing in other practitioners, projects, or threads the group should know about.  (Doug Engelbart lineage; named operationally in Kiko Lab's framing.)"} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: participants can identify the facilitator's role as something other than \"the expert in the room\" AND as something other than \"a peer like everyone else.\"  The facilitator is doing legible work but isn't claiming to be the source.  Failing when: either participants defer to the facilitator as the authority, or the facilitator disclaims any role and the inquiry loses its shape."}], :conclusion "A peer-learning practice runs into trouble when its facilitators position themselves as either experts (talking down to the group) or as flat-equals (refusing to bring stewardship).  The curating-not-experting stance is a third position: bring people into conversation, hold the shape of the inquiry, and invite expertise from wherever it actually lives — which is often distributed across the group, not concentrated in one person.  The stance distinguishes peeragogy from both top-down pedagogy and from leaderless co-learning.", :directives {:audience "peer-learning facilitators, project conveners, conversation hosts", :keywords ["curator" "expertise" "stance" "connective-intelligence" "anti-credentialism" "facilitation" "kiko-lab"], :references ["peeragogy/roles" "peeragogy/wrapper" "peeragogy/polling-for-ideas" "peeragogy/discerning-a-pattern"], :style "process-pattern", :title "Hold a Curatorial Stance, Not an Expert One, Toward the Conversation You Convene", :tone "practical"}, :id "peeragogy/curating-not-experting", :keywords ["curator" "expertise" "stance" "connective-intelligence" "anti-credentialism" "facilitation" "kiko-lab"], :projection-version "flexiarg-v0", :references ["peeragogy/roles" "peeragogy/wrapper" "peeragogy/polling-for-ideas" "peeragogy/discerning-a-pattern"], :scores {}, :sigils [], :source-path "library/peeragogy/curating-not-experting.flexiarg", :sources [], :status :ok, :title "Hold a Curatorial Stance, Not an Expert One, Toward the Conversation You Convene", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peeragogical pattern starts as a noticed repetition: something that happens often enough across peer-learning situations that it deserves a shared name.  The discernment work is twofold — first, attending to language and behaviour closely enough to spot the repetition at all; second, naming it without over-claiming what the repetition means.  Most candidate patterns die in the second step, when the namer rushes from \"I see this pattern\" to \"and therefore the participants are X.\""} {:name "context", :name-key "context", :slug "context", :text "Patterns are not invented; they are discerned.  The handbook draws on Alexander's framing — language use is what we have to go on analytically, and patterns surface from that close attention to use.  In peer-learning, candidate patterns appear as recurring forms: shared interests in introductions, shared shapes in how groups organise sessions, shared failures in how groups onboard newcomers.  The discernment skill is a kind of meta-awareness of language — close enough to see repetition, careful enough not to over-interpret what the repetition means."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: noticing repetition ↔ resisting interpretation.\n    Irreducible: a noticed pattern cannot be both raw observation and interpreted significance simultaneously.  The discernment process must hold these two stages apart, even when the noticer wants to collapse them into one insight."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: the same close attention that lets a pattern-spotter see recurrence also tempts them to attribute meaning the recurrence does not yet support.  Both moves draw on the same alertness, but only the first is reliable.\n    Active dynamic: the pull recurs every time a pattern-spotter sees a third instance and feels the urge to declare what it means."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Insight inflation: each noticed coincidence becomes a \"pattern\" without surviving repeated test.\n      - Premature meaning: the pattern description tells the reader what the pattern signifies before establishing that the pattern exists.\n      - Vocabulary churn: pattern names proliferate and rename without stabilising into a usable language (see peeragogy/pattern-language).\n      - Loss of source: pattern descriptions drift from the situations that grounded them, becoming abstract advice."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Note-then-defer: record the noticed repetition in the smallest possible form (occurrence, context, what was repeated) and resist naming what it implies for at least a few more instances.\n      (2) Title-and-describe: once the repetition is robust enough to deserve a name, write the title first and the description second.  The title forces commitment to a specific pattern shape; the description tests whether that shape holds across the instances.\n      (3) Hedge interpretation: when describing what the pattern says about the participants or the situation, use \"might\" and \"may\" rather than \"indicates\" until the meaning has been tested across more instances.\n      (4) Submit for collaborative refinement: a discerned pattern is sharpened by other practitioners trying to break it on their own data; treat the first articulation as a draft, not a finding."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: pattern claims are grounded in named instances, and interpretive claims are kept separate from observational claims.  Failing when: a single observation is promoted to a pattern, or a pattern's interpretation is asserted with confidence that the underlying instances do not support."}], :conclusion "A peeragogical pattern starts as a noticed repetition: something that happens often enough across peer-learning situations that it deserves a shared name.  The discernment work is twofold — first, attending to language and behaviour closely enough to spot the repetition at all; second, naming it without over-claiming what the repetition means.  Most candidate patterns die in the second step, when the namer rushes from \"I see this pattern\" to \"and therefore the participants are X.\"", :directives {:audience "pattern authors, peer-learning practitioners", :keywords ["pattern-detection" "vocabulary" "language-attention" "naming" "alexander" "repetition"], :references ["peeragogy/pattern-language" "peeragogy/creating-a-guide" "pattern-coherence/applicability-signals"], :style "meta-pattern", :title "Notice the Repetition First, Name It Carefully Second", :tone "reflective"}, :id "peeragogy/discerning-a-pattern", :keywords ["pattern-detection" "vocabulary" "language-attention" "naming" "alexander" "repetition"], :projection-version "flexiarg-v0", :references ["peeragogy/pattern-language" "peeragogy/creating-a-guide" "pattern-coherence/applicability-signals"], :scores {}, :sigils [], :source-path "library/peeragogy/discerning-a-pattern.flexiarg", :sources [], :status :ok, :title "Notice the Repetition First, Name It Carefully Second", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peer-learning group needs a recurring, low-friction signal that calls attention back to the work — a heartbeat — without which energy dissipates and participants drift.  The signal can be impersonal (a weekly post, a shared rhythm) or personal (a direct message to someone who has gone quiet), but it must be frequent enough that absence is noticed and warm enough that re-entry is cheap."} {:name "context", :name-key "context", :slug "context", :text "Voluntary peer-learning projects compete with everything else in participants' lives.  Without a rhythm the group can return to, attention fades; the project drops out of mind individually before it dies collectively.  The heartbeat is the device that keeps the project resident in attention between bursts of activity.  It can be sustained by one person, by a role (see peeragogy/wrapper), or by an artefact like a wiki main page that someone tends."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: coordination overhead ↔ attention maintenance.\n    Irreducible: a group cannot simultaneously be self-organising and rely on no recurring signal.  Even fully decentralised groups end up with implicit heartbeats (a recurring meeting, a shared release cadence); the only choice is whether the heartbeat is named."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: every heartbeat costs the heartbeat-keeper time and care; every missed heartbeat costs the group some fraction of its dispersed members.  Neither cost is zero.\n    Active dynamic: the pull recurs whenever the group is between visible deliverables, when a long-tenured member steps back, or when newcomers arrive expecting a shape they can attach to."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Silent drift: regular contributors stop posting and no one notices for weeks.\n      - Re-onboarding burden: returning members ask the same orienting questions newcomers ask.\n      - Convener fatigue: the project's continuity depends entirely on one person's ongoing attention with no redundancy.\n      - Cadence collapse: a previously regular signal stops, and the group cannot tell whether the project is paused, finished, or dead."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Personal nudge: someone (often the convener) writes individual notes to lurkers and dropped-out members, naming the work and offering a way back in.  High-cost per recipient; high return when the recipient was wavering.\n      (2) Public cadence: a recurring artefact — weekly roundup, status post, agenda — that the group can read or skip without obligation.  Lower-cost per recipient; works when the artefact is reliably present.\n      (3) Tended artefact: a shared surface (wiki main page, dashboard) that someone keeps current.  The heartbeat is the tending; the artefact is the trace.\n      (4) Distributed rotation: the heartbeat-keeper role rotates so no single person bears the cost indefinitely.  Requires the role to be named explicitly enough that the next holder can take it over."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: the group has a recurrence that participants can name, and missing it is noticeable to more than one person.  Failing when: re-engagement happens only through one-off heroic effort by individuals, or when \"what's happening with X?\" is a question no one can answer cheaply."}], :conclusion "A peer-learning group needs a recurring, low-friction signal that calls attention back to the work — a heartbeat — without which energy dissipates and participants drift.  The signal can be impersonal (a weekly post, a shared rhythm) or personal (a direct message to someone who has gone quiet), but it must be frequent enough that absence is noticed and warm enough that re-entry is cheap.", :directives {:audience "peer-learning facilitators, group conveners", :keywords ["rhythm" "cadence" "attention" "energy" "recurrence" "individual-outreach"], :references ["peeragogy/wrapper" "peeragogy/carrying-capacity" "peeragogy/newcomer"], :style "process-pattern", :title "Keep a Visible Rhythm So the Group Has Something to Return To", :tone "practical"}, :id "peeragogy/heartbeat", :keywords ["rhythm" "cadence" "attention" "energy" "recurrence" "individual-outreach"], :projection-version "flexiarg-v0", :references ["peeragogy/wrapper" "peeragogy/carrying-capacity" "peeragogy/newcomer"], :scores {}, :sigils [], :source-path "library/peeragogy/heartbeat.flexiarg", :sources [], :status :ok, :title "Keep a Visible Rhythm So the Group Has Something to Return To", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Online peer-learning participation reliably follows a power law — a few voices dominate, most lurk.  Moderation is the active counter-pressure on that distribution, performed both by the loudest participants throttling themselves and by the structure of the conversation reshaping who finds it cheap to speak.  Effective moderation operates on both the individual and the structural level; one without the other tends not to hold."} {:name "context", :name-key "context", :slug "context", :text "Voluntary online conversations skew toward those who type fastest, feel most confident, or have the most time.  Without counter-pressure, the resulting distribution silences the participants whose perspectives the group most needs to hear.  Moderation is not about silencing the loud; it is about restoring access for the quiet.  Techniques like the fishbowl (small-group reformat that depersonalises issues and reduces stress) and the progressive stack (queue ordering that prioritises voices heard less often) are structural moves; individual self-throttling — the dominant participant choosing to speak less — is the personal move.  Both are needed; either alone is fragile."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: depth-of-engagement ↔ breadth-of-voice.\n    Irreducible: a single conversation cannot simultaneously maximise depth from its most engaged voices and breadth across its quieter ones.  The moderator is choosing which to prioritise at each turn, even by inaction."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: the loud participants are often the engaged participants; throttling them risks losing the energy that keeps the conversation alive.  But unmoderated, that same energy crowds out the breadth of voice that makes a peer learning context peer-driven.\n    Active dynamic: the pull recurs at every conversational turn, every thread, every meeting.  Moderation is a continuous activity, not a one-time configuration."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Same-five-voices: every thread is dominated by the same handful of participants and the rest go silent.\n      - Newcomer drop-off: new arrivals attempt one contribution, get no traction in the existing discussion shape, and leave.\n      - Adversarial lock-in: a debate hardens into entrenched positions because no one re-formats the conversation to reduce the personal cost of changing position.\n      - Silent dissent: disagreement migrates to back-channels because the main forum is too costly for quieter voices to enter."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Self-throttle: the most active participants visibly hold back, ask questions instead of asserting, and let others answer first.  Names the dynamic without policing it.\n      (2) Reformat to fishbowl: when a debate has become entrenched, restructure it as small-group conversations that depersonalise the issue and lower the cost of changing one's mind.\n      (3) Progressive stack: order speakers by how recently and how often they have spoken, prioritising voices heard less.  Makes turn-taking a structural property, not a social negotiation.\n      (4) Lower the floor: rewrite the prompt or the surface so quieter participants find a cheaper entry — shorter messages, smaller commitments, async options.  Reshapes who finds the conversation accessible.\n      (5) Name the dynamic: surface the participation distribution explicitly (\"we've heard mostly from X, Y, Z this week\") so the group can adjust collectively rather than relying on individual heroics."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: the participation distribution stays meaningfully closer to balanced than the unmoderated baseline, and quiet participants report that entry feels accessible.  Failing when: the conversation pattern locks into a small-group exchange while everyone else watches, or moderation is treated as a one-time setting rather than an ongoing practice."}], :conclusion "Online peer-learning participation reliably follows a power law — a few voices dominate, most lurk.  Moderation is the active counter-pressure on that distribution, performed both by the loudest participants throttling themselves and by the structure of the conversation reshaping who finds it cheap to speak.  Effective moderation operates on both the individual and the structural level; one without the other tends not to hold.", :directives {:audience "peer-learning facilitators, online-forum hosts", :keywords ["power-law" "participation" "fishbowl" "progressive-stack" "stepping-back" "equity-of-voice"], :references ["peeragogy/carrying-capacity" "peeragogy/heartbeat" "peeragogy/roles"], :style "process-pattern", :title "Throttle the Loud, Make Room for the Quiet, Reshape the Floor", :tone "practical"}, :id "peeragogy/moderation", :keywords ["power-law" "participation" "fishbowl" "progressive-stack" "stepping-back" "equity-of-voice"], :projection-version "flexiarg-v0", :references ["peeragogy/carrying-capacity" "peeragogy/heartbeat" "peeragogy/roles"], :scores {}, :sigils [], :source-path "library/peeragogy/moderation.flexiarg", :sources [], :status :ok, :title "Throttle the Loud, Make Room for the Quiet, Reshape the Floor", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peer-learning project needs newcomers — not only because they extend the community, but because their arrival is the recurring pressure that keeps the project's vocabulary, guides, and onboarding paths from going stale.  Without newcomers, much of the \"education stuff\" loses its addressee.  Even in the absence of actual newcomers, the project benefits from a *beginner's-mind* perspective applied periodically to its own surfaces."} {:name "context", :name-key "context", :slug "context", :text "Peer-learning projects are written-for-someone, and when no actual newcomer is in earshot, that someone slowly becomes \"ourselves a year ago\" — a fictional reader who shares all the project's assumptions.  The guide rots, the onboarding path silts up, and the project's accessibility decays without anyone noticing.  The newcomer pattern is the disciplined opposite: every actual newcomer is treated as a probe of the project's current accessibility, and even when none are present, someone periodically reads the project's surfaces with a beginner's mind.  Closely paired with peeragogy/wrapper (the integrative function that makes orientation cheap) and with peeragogy/heartbeat (the rhythm a newcomer can attach to)."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: newcomer accommodation ↔ in-group progress.\n    Irreducible: a project cannot simultaneously optimise for fastest in-group progress and lowest newcomer entry cost.  Each onboarding interaction is a deliberate slowing of the in-group pace in exchange for a chance at renewal."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: every onboarding interaction costs the existing contributors time and attention that could be spent on direct project work.  But the project depends on newcomer flow for its long-term legibility, vocabulary refresh, and energy.  Both costs are real.\n    Active dynamic: the pull recurs whenever a newcomer arrives, whenever a long-tenured member catches themselves using shorthand only insiders understand, and whenever the project considers writing a new guide section (since \"what would a newcomer need here?\" is the live test)."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Audience drift: the project's prose increasingly addresses an in-group reader who already shares all assumptions, with no path for outsiders to enter.\n      - Onboarding dead-ends: documented entry paths lead to broken links, abandoned forums, or current contributors no one knows how to reach.\n      - Tacit-knowledge moats: every meaningful contribution requires knowledge that lives only in private conversation among long-tenured members.\n      - Vocabulary calcification: the project's shared terms stop being interrogated because no one new is around to ask what they mean."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Mentor-pair on arrival: a named existing contributor accompanies the newcomer through their first contribution rather than handing them documentation.  High-cost, high-yield; converts arrival into participation.\n      (2) Newcomer-as-editor: invite the newcomer to edit guide pages, since their inability to follow them is exactly the diagnostic signal needed to fix them.  Combines onboarding with project maintenance.\n      (3) Beginner's-mind sweep: in the absence of actual newcomers, a contributor periodically reads the project's onboarding path as if seeing it for the first time and records what is unclear.\n      (4) Newcomer-friendly entry tasks: maintain a small set of well-scoped first contributions that a newcomer can accomplish in one sitting, signalling that the project expects their participation early.\n      (5) Pair with the wrapper role: the newcomer benefits most when the project has someone summarising current state (wrapper); these two patterns reinforce each other."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: newcomers complete a meaningful first contribution within a short window of arrival, and the project's onboarding surfaces are revised in response to their experience.  Failing when: newcomers either bounce off or take many weeks of unsupported effort to find their way in."}], :conclusion "A peer-learning project needs newcomers — not only because they extend the community, but because their arrival is the recurring pressure that keeps the project's vocabulary, guides, and onboarding paths from going stale.  Without newcomers, much of the \"education stuff\" loses its addressee.  Even in the absence of actual newcomers, the project benefits from a *beginner's-mind* perspective applied periodically to its own surfaces.", :directives {:audience "peer-learning facilitators, contributors", :keywords ["newcomer" "beginner-mind" "onboarding" "audience" "regeneration"], :references ["peeragogy/wrapper" "peeragogy/heartbeat" "peeragogy/creating-a-guide"], :style "process-pattern", :title "Treat Newcomer Arrival as Renewing Pressure on the Project", :tone "practical"}, :id "peeragogy/newcomer", :keywords ["newcomer" "beginner-mind" "onboarding" "audience" "regeneration"], :projection-version "flexiarg-v0", :references ["peeragogy/wrapper" "peeragogy/heartbeat" "peeragogy/creating-a-guide"], :scores {}, :sigils [], :source-path "library/peeragogy/newcomer.flexiarg", :sources [], :status :ok, :title "Treat Newcomer Arrival as Renewing Pressure on the Project", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Every gathering of co-learners or co-producers benefits from a short self-applied review at the end.  The Paragogical Action Review (PAR) is a five-question structure adapted from the US Army's After Action Review and made more peer-directed: review intention → establish what's happening → what are the different perspectives → what did we learn or change → what else should we change going forward.  The discipline is to run it on yourselves about the activity you just did, not on someone else about something they did."} {:name "context", :name-key "context", :slug "context", :text "A peer-learning group has just held a session — a meeting, a podcast recording, a workshop, a writing sprint.  Without a closing review, learnings stay in individual heads, the group cannot see itself, and the next iteration is built on guesswork.  PAR's contribution is a short, structured loop that takes 5–15 minutes and makes the group's understanding of what just happened legible to itself.  The \"eat your own cooking\" stance — applying the practice to the artifact that documents the practice — is what distinguishes PAR from a sprint review handed to a manager or a retrospective held with someone outside the work."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: extending the work ↔ closing the loop.\n    Irreducible: the people best positioned to learn from a session are the participants in it, not an outside reviewer.  They have the context.  But participants are also the most tired by the end, and the most tempted to skip the closing."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: the work the group came to do is the obvious priority; reviewing the work feels like extra time.  But without the review, learnings dissipate and the next iteration repeats the same surprises.  Extending the working time without ever closing the loop produces a series of incomplete experiences, not a learning trajectory.\n    Active dynamic: the pull recurs at every session boundary, and is strongest when the session went well (the group feels accomplished and wants to coast on the feeling) or badly (the group wants to escape)."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Recurring surprises: the same thing surprises the group across multiple sessions because no review captured it the first time.\n      - Reflexive-layer atrophy: the group can run the activity but not articulate what it does or what it has learned about doing it.\n      - Newcomer disorientation: incoming participants get no easy way to understand what this group has been learning together.\n      - Public/private mismatch: the group's public artifacts (recordings, blog posts) describe an activity; the group's actual learnings live only in side channels."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Five-question close in-broadcast: run all five PAR questions in the last 10 minutes of the session itself.  Highest-fidelity: everyone is still present and the context is fresh.  Cost: extends session length; some attendees won't stay.\n      (2) Off-broadcast continuation: end the headline session at the planned time, and convene PAR as an after-party for those who can stay.  Lower-pressure for newcomers; risks splitting the group's reflexive layer from its public layer.\n      (3) Async PAR via shared doc: post the five questions to a shared document, gather responses over 24 hours.  Works for distributed groups; loses some of the spoken-conversation texture.\n      (4) Single-question micro-PAR: when full PAR feels heavy, ask just one — typically \"what did we learn or change?\" — to keep the loop alive without the full structure."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: the group can name, in their own voices, what they learned in the session and what they would do differently next time.  Failing when: the closing minutes are reserved for thanks and goodbyes only, and learnings stay implicit."}], :conclusion "Every gathering of co-learners or co-producers benefits from a short self-applied review at the end.  The Paragogical Action Review (PAR) is a five-question structure adapted from the US Army's After Action Review and made more peer-directed: review intention → establish what's happening → what are the different perspectives → what did we learn or change → what else should we change going forward.  The discipline is to run it on yourselves about the activity you just did, not on someone else about something they did.", :directives {:audience "peer-learning facilitators, project conveners, podcast hosts, workshop runners", :keywords ["par" "paragogical-action-review" "after-action-review" "retrospective" "meta-cognition" "self-assessment" "eat-own-cooking" "sprint-review" "five-questions"], :references ["peeragogy/heartbeat" "peeragogy/wrapper" "peeragogy/discerning-a-pattern" "collaboration-coherence/navel-gazing"], :style "process-pattern", :title "Close Each Gathering With a Brief Self-Review", :tone "practical"}, :id "peeragogy/par", :keywords ["par" "paragogical-action-review" "after-action-review" "retrospective" "meta-cognition" "self-assessment" "eat-own-cooking" "sprint-review" "five-questions"], :projection-version "flexiarg-v0", :references ["peeragogy/heartbeat" "peeragogy/wrapper" "peeragogy/discerning-a-pattern" "collaboration-coherence/navel-gazing"], :scores {}, :sigils [], :source-path "library/peeragogy/par.flexiarg", :sources [], :status :ok, :title "Close Each Gathering With a Brief Self-Review", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A collection of named patterns becomes a *language* when the patterns compose — when one pattern's solution invokes others, when conflicts between patterns are visible, and when a designer can build a peer-learning context by selecting and arranging patterns rather than reasoning from scratch.  Until that compositional structure is present, what looks like a pattern language is a catalogue of independent tips."} {:name "context", :name-key "context", :slug "context", :text "Christopher Alexander's framing — invoked directly in the handbook — is that a pattern language gives builders enough generative structure to design something coherent without dictating it.  Peeragogy patterns aspire to the same: not a checklist but a vocabulary in which peer-learning experiences can be designed.  This requires the patterns to refer to one another, to share a granularity convention, and to leave room for the designer's choices."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: catalogue completeness ↔ generative composition.\n    Irreducible: the same set of named practices cannot be both a freely-extending catalogue and a tight compositional grammar.  Discipline costs additions; additions cost discipline."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a thorough catalogue is easy to extend (just add patterns) but does not, by itself, compose.  A composing language requires patterns to be sized, named, and cross-referenced consistently — work that constrains how patterns are added.\n    Active dynamic: the pull recurs whenever a new pattern is proposed.  The catalogue impulse welcomes it; the language impulse asks where it sits, what it composes with, and what it excludes."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Catalogue inflation: pattern count grows but composition does not deepen.\n      - Stranded patterns: patterns sit alone, with no other pattern referring to them and no clear context of use.\n      - Granularity mush: a single list mixes patterns about whole projects, individual sessions, and atomic interactions.\n      - Conflict suppression: patterns that disagree are presented as if they harmoniously coexist, leaving the designer to discover the conflict in practice."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Cross-reference discipline: every pattern names which other patterns it builds on, which it composes with, and which it conflicts with.  Composition surfaces become explicit.\n      (2) Granularity convention: patterns at the same level address comparable scopes (group, session, role) so they can be combined without confusion.  Patterns at different levels are explicitly nested.\n      (3) Conflict visibility: where two patterns pull in opposite directions in the same situation, the language names the conflict rather than hiding it.  Designers can then decide which pattern dominates.\n      (4) Generative test: for any peer-learning context the designer wants to support, the language should let them assemble a working design from named patterns plus a small amount of judgement.  If every assembly requires unnamed practices, the language has gaps."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: a new contributor can use the patterns to design a peer-learning experience by composition, without re-deriving each decision from first principles.  Failing when: each design starts over; patterns are cited individually but never combined."}], :conclusion "A collection of named patterns becomes a *language* when the patterns compose — when one pattern's solution invokes others, when conflicts between patterns are visible, and when a designer can build a peer-learning context by selecting and arranging patterns rather than reasoning from scratch.  Until that compositional structure is present, what looks like a pattern language is a catalogue of independent tips.", :directives {:audience "pattern authors, peer-learning designers", :keywords ["alexander" "pattern-language" "composition" "vocabulary" "generativity" "design"], :references ["pattern-coherence/internal-coherence" "peeragogy/discerning-a-pattern" "peeragogy/creating-a-guide"], :style "meta-pattern", :title "Treat the Patterns as a Language, Not a Catalogue", :tone "reflective"}, :id "peeragogy/pattern-language", :keywords ["alexander" "pattern-language" "composition" "vocabulary" "generativity" "design"], :projection-version "flexiarg-v0", :references ["pattern-coherence/internal-coherence" "peeragogy/discerning-a-pattern" "peeragogy/creating-a-guide"], :scores {}, :sigils [], :source-path "library/peeragogy/pattern-language.flexiarg", :sources [], :status :ok, :title "Treat the Patterns as a Language, Not a Catalogue", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a peer-learning group faces a decision — what to discuss, who to invite, what resources to use, what to call something — it usually pays to *poll for ideas* first rather than have one person commit on behalf of the group.  The poll serves both as deliberation and as visible signal that the question was genuinely open, which lowers the cost for participants to disagree later."} {:name "context", :name-key "context", :slug "context", :text "In voluntary peer-learning contexts, decisions made unilaterally by an active contributor often stand for the group simply because no one objected — but unobjected-to is not the same as agreed-to.  The poll-for-ideas move makes the openness explicit: a question is posted, options are gathered (or generated), and the group's contribution to the decision is a visible record of suggestions rather than a single person's call.  The poll need not be a vote; the value is in the surfacing of options before commitment, not in the tallying."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: speed of decision ↔ legitimacy of decision.\n    Irreducible: a decision cannot simultaneously be made unilaterally and be visibly open to the group.  Each decision is one or the other, and the question is which deserve which treatment."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: polling slows decisions, especially small ones, and the cumulative drag of polling everything would stall the project.  Not polling, however, accumulates a backlog of decisions made by whoever moved fastest, which corrodes the project's claim to be peer-driven.\n    Active dynamic: the pull recurs at every decision the group faces, especially decisions that will set norms (forum structure, naming conventions, working agreements) where unilateral commitment is hardest to undo."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Norm by accretion: working agreements crystallise from one person's repeated practice, never having been opened for input.\n      - Late-arrival objection: contributors discover decisions they would have weighed in on, with no way to revisit them without seeming to relitigate.\n      - Veto-by-silence: decisions stand because no one objected, but no one was asked, so the silence cannot be read as agreement.\n      - Poll fatigue: the pattern is over-applied to trivial decisions, training participants to ignore polls; the legitimate polls then get low engagement."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Open-call poll: post the question with no candidate answers and let the group generate options.  Highest legitimacy, slowest, best for norm-setting decisions.\n      (2) Candidate-set poll: post the question with two or three candidate answers and ask for additions or preferences.  Faster; useful when the question is structurally bounded.\n      (3) Default-with-veto: announce a tentative decision with explicit invitation to object before a deadline.  Even faster; preserves polling's legitimacy benefit because the openness is visible, but does not require active participation from everyone.\n      (4) Polling for the meta-question: when uncertain whether something deserves a poll, the meta-poll (\"should we discuss X here, or is there a better forum?\") is itself useful, since it surfaces structural disagreement before content disagreement."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: decisions that will set norms or commit shared resources are visibly open to group input before commitment, and the trace of that openness is preserved (so later contributors can see how a decision was made).  Failing when: norms appear by accumulation of unilateral moves, with no record of whether the group ever consented."}], :conclusion "When a peer-learning group faces a decision — what to discuss, who to invite, what resources to use, what to call something — it usually pays to *poll for ideas* first rather than have one person commit on behalf of the group.  The poll serves both as deliberation and as visible signal that the question was genuinely open, which lowers the cost for participants to disagree later.", :directives {:audience "peer-learning facilitators, group conveners", :keywords ["poll" "open-question" "deliberation" "agenda-setting" "deferred-commitment"], :references ["peeragogy/wrapper" "peeragogy/roadmap" "peeragogy/moderation"], :style "process-pattern", :title "Surface Open Questions Before Committing to Answers", :tone "practical"}, :id "peeragogy/polling-for-ideas", :keywords ["poll" "open-question" "deliberation" "agenda-setting" "deferred-commitment"], :projection-version "flexiarg-v0", :references ["peeragogy/wrapper" "peeragogy/roadmap" "peeragogy/moderation"], :scores {}, :sigils [], :source-path "library/peeragogy/polling-for-ideas.flexiarg", :sources [], :status :ok, :title "Surface Open Questions Before Committing to Answers", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Any practice that collects knowledge, data, or stories from a community needs an explicit answer to \"what does the community get back?\" — articulated as a discipline, not left as an afterthought.  Reciprocal participation makes the give-back move a first-class part of the practice's design, drawing on indigenous data frameworks, feminist data frameworks, and Design Justice.  The discipline distinguishes peer-learning practice from extractive research, ethics-board-as-window-dressing, and well-meaning-but-asymmetric volunteer recruitment."} {:name "context", :name-key "context", :slug "context", :text "A peer-learning project draws on community participation — interviews, contributed material, lived-experience stories, identifiable data, co-authored work.  The project produces an output (a paper, a handbook, a podcast, a tool, a curriculum).  Without an explicit reciprocity discipline, the project's benefits accrue to the producers and the give-back is left implicit (\"we'll share the result somewhere\"), unmeasured, or absent.  Reciprocal participation is the move from implicit-and-discretionary to explicit-and-tracked."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: producing-the-output ↔ giving-back-to-sources.\n    Irreducible: the people whose voices the practice carries cannot fully guard their own reciprocity if the practice itself doesn't make it a constraint.  The convener has more agency in the relationship than the contributor; the discipline puts that asymmetry on the table rather than papering over it with rhetoric."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: producing the output and giving back to the sources are two different kinds of labor.  Without the discipline, output-production is the work that has deadlines and accountability, while give-back is what happens \"if there's time.\"  That asymmetry compounds across years and across many projects, and the producing side accrues credentials, citations, and funding while the source side accrues nothing tracked.\n    Active dynamic: the pull recurs every time the practice uses contributed material — every transcript quoted, every dataset analysed, every story retold, every workshop's emergent insight written up by one party."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Implicit reciprocity: the practice describes its give-back vaguely (\"benefits the wider community\") without naming what specifically goes where.\n      - Attribution-as-acknowledgment: contributors are listed in an acknowledgments section but receive nothing material.\n      - Window-dressing ethics: the practice has an ethics board or ethics statement but the affected communities are not represented in either.\n      - Volunteer-funnel asymmetry: the practice consistently recruits volunteers who do real labor without commensurate return, while the producers' careers advance.\n      - Asymmetric publishing: the practice publishes outputs in venues the contributing communities cannot access (paywalled journals, conferences they can't travel to) without producing accessible versions."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Up-front contract: before extraction begins, the practice and the community agree on what will be returned (a copy of the artifact, a share of attention, a tangible service, a portion of any funding).  The agreement is documented and revisited as the project proceeds.\n      (2) Built-in attribution: the practice's outputs name contributors specifically and link to whatever they want named — not as a courtesy at the end but as a structural element of the artifact, with versioning so attribution doesn't decay.\n      (3) Translation-back: the practice translates its outputs back into forms the contributing community can use (a plain-language version, a community-language translation, a tool the community asked for, a workshop run for them).\n      (4) Material reciprocity: when the practice receives funding, recognition, or career advancement based on contributed work, a defined share returns to the sources — financially, in resources, or in concrete labor.\n      (5) Refusal-on-asymmetry: the practice declines to use contributed material when reciprocity isn't actually possible, instead of using it on the assumption that reciprocity will be worked out later."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: contributors can name what they get from the practice using their material, the practice can name what it gives back, and the two descriptions roughly match.  Failing when: contributors see the artifact for the first time alongside the general public, or the practice's give-back consists of \"we put it on the website.\""} {:name "provenance", :name-key "provenance", :slug "provenance", :text "This pattern surfaced from the 2026-04-29 posterior-pass analysis of the Peeragogy Podcast (M-peeragogy-rewrite mission), specifically episode 5 (\"The Ethics of Data\") with Yasmin Bidyoff (Ada Lovelace Institute, no-tech-for-tyrants) and Paola Ricaurte (Tecnológico de Monterrey, Tierra Común Network, A+ Alliance).  Paola: *\"if we extract something from the community, we should give back that as well.\"*  Yasmin: *\"a reciprocal participation, social contract sort of thing.\"*  Both articulated the same move from different vantage points — data-extraction ethics in Paola's case (drawing on indigenous data frameworks, feminist data frameworks, and Design Justice); researcher-participant relationship in Yasmin's case.  The Handbook's chapter 17 (Peeragogical Assessment) hints at reciprocity through its \"learning is adaptation\" gloss but does not formalise reciprocal participation as a first-class discipline."}], :conclusion "Any practice that collects knowledge, data, or stories from a community needs an explicit answer to \"what does the community get back?\" — articulated as a discipline, not left as an afterthought.  Reciprocal participation makes the give-back move a first-class part of the practice's design, drawing on indigenous data frameworks, feminist data frameworks, and Design Justice.  The discipline distinguishes peer-learning practice from extractive research, ethics-board-as-window-dressing, and well-meaning-but-asymmetric volunteer recruitment.", :directives {:audience "researchers, facilitators, project conveners, anyone collecting community knowledge or data", :keywords ["reciprocal" "give-back" "social-contract" "design-justice" "indigenous-data" "feminist-data" "anti-extractive" "ethics" "data-coloniality" "tierra-comun"], :references ["peeragogy/wrapper" "peeragogy/roles" "peeragogy/use-or-make" "collaboration-coherence/isolation" "collaboration-coherence/magical-thinking"], :style "process-pattern", :title "Give Back to the Communities You Extract From", :tone "practical"}, :id "peeragogy/reciprocal-participation", :keywords ["reciprocal" "give-back" "social-contract" "design-justice" "indigenous-data" "feminist-data" "anti-extractive" "ethics" "data-coloniality" "tierra-comun"], :projection-version "flexiarg-v0", :references ["peeragogy/wrapper" "peeragogy/roles" "peeragogy/use-or-make" "collaboration-coherence/isolation" "collaboration-coherence/magical-thinking"], :scores {}, :sigils [], :source-path "library/peeragogy/reciprocal-participation.flexiarg", :sources [], :status :ok, :title "Give Back to the Communities You Extract From", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peer-learning project benefits from an up-to-date public roadmap — a maintained artefact that names what is finished, what is in progress, what is stub, and what lies ahead.  The roadmap serves three audiences: newcomers (who can see where to jump in), existing contributors (who can see what is open), and the project's future self (which can see how the goal has evolved).  The roadmap is always provisional; its value lies in being current and shared, not in being correct."} {:name "context", :name-key "context", :slug "context", :text "Voluntary peer-learning projects have no external schedule that forces a shared sense of \"where we are.\"  Without a roadmap, each contributor holds their own private model of project state, and these models diverge.  A maintained roadmap is the canonical artefact that re-converges them.  The handbook describes this concretely: when the book's outline became fairly mature, it became a roadmap by marking finished sections, in-progress sections, and stubs.  Closely connected to peeragogy/wrapper (the wrapper produces and maintains the roadmap as part of integrative work) and peeragogy/newcomer (the roadmap is where newcomers find their first task)."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: roadmap stability ↔ roadmap currency.\n    Irreducible: the roadmap cannot simultaneously be a never-changing reference and a live representation of project state.  Every update is a trade between the two roles."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a frequently updated roadmap reflects the current state but offers contributors no stable target to plan against; a stable roadmap gives a planning surface but rapidly diverges from reality.  Both costs are real and continuous.\n    Active dynamic: the pull recurs at every state-change in the project — a section finished, a contributor stepped back, a new direction surfaced — and at every newcomer arrival, who needs the roadmap to be current to be useful."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Outdated outline: the visible roadmap describes a project state from months ago, with no mechanism for revision.\n      - Multiple competing roadmaps: status is tracked in several places (issue tracker, wiki, drive folder) with no canonical reconciliation, so different contributors believe different things are true.\n      - Newcomer-rejection: newcomers cannot find where to start because the roadmap does not surface entry points or marks \"stub\" only retrospectively.\n      - Goal drift unmarked: the project's actual direction has shifted, but the roadmap still describes the original goal, and the gap is not surfaced."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Status-marked outline: the project's table of contents (or equivalent structure) is the roadmap, with explicit per-item status — finished, in progress, stub, abandoned.  Newcomers see entry points immediately.\n      (2) Roadmap-as-artefact: the roadmap is a single named page that someone (often the wrapper) maintains, rather than scattered across multiple status surfaces.  One source of truth.\n      (3) Versioned roadmap: major roadmap revisions are dated and preserved, so the project can see how its goal has evolved.  The history is itself a record of how peer-learning shifted what the project meant.\n      (4) Roadmap-as-conversation: roadmap changes are themselves polled or discussed (see peeragogy/polling-for-ideas) rather than committed unilaterally, since the roadmap is structurally a shared commitment.\n      (5) Personal-learning-plan companion: individual contributors maintain personal learning plans (paragogical profiles) that connect to the project roadmap, making each contributor's path through the work legible."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: a contributor (existing or new) can read the roadmap and know within minutes what is in progress, what is open, and where they could plug in.  Failing when: the roadmap is stale, hidden, or has been replaced by tribal knowledge held in private conversations."}], :conclusion "A peer-learning project benefits from an up-to-date public roadmap — a maintained artefact that names what is finished, what is in progress, what is stub, and what lies ahead.  The roadmap serves three audiences: newcomers (who can see where to jump in), existing contributors (who can see what is open), and the project's future self (which can see how the goal has evolved).  The roadmap is always provisional; its value lies in being current and shared, not in being correct.", :directives {:audience "peer-learning facilitators, project conveners", :keywords ["roadmap" "table-of-contents" "status-marking" "newcomer-orientation" "stub-marking"], :references ["peeragogy/wrapper" "peeragogy/newcomer" "peeragogy/creating-a-guide"], :style "process-pattern", :title "Maintain a Public, Provisional Map of Where the Project Is Going", :tone "practical"}, :id "peeragogy/roadmap", :keywords ["roadmap" "table-of-contents" "status-marking" "newcomer-orientation" "stub-marking"], :projection-version "flexiarg-v0", :references ["peeragogy/wrapper" "peeragogy/newcomer" "peeragogy/creating-a-guide"], :scores {}, :sigils [], :source-path "library/peeragogy/roadmap.flexiarg", :sources [], :status :ok, :title "Maintain a Public, Provisional Map of Where the Project Is Going", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Educational interactions inherit roles by default — autodidact, tutor, tutee, and outward into librarian, editor, administrator, and beyond.  The pattern is to treat these roles as *held* rather than *owned*: a participant occupies a role at a moment, and the same person may shift roles as the activity changes.  Naming roles makes coordination cheaper; treating them as fixed identities makes the group rigid."} {:name "context", :name-key "context", :slug "context", :text "Peer-learning starts from the autodidact and bifurcates outward; even a single learner traverses several roles in the course of one project (asking questions, answering them, checking proofs, fetching resources).  In group contexts, roles multiply: tutor, tutee, parent-figure, principal, librarian, technician, editor, policy-maker, partner.  The handbook notes that decomposing learning into roles could be an endless theoretical task; the practical observation is that roles are present by default at the start of an interaction and that they may shift as the work develops.  The pattern is to keep that fluidity available rather than letting initial role-assignments harden into permanent identities."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: role legibility ↔ role mobility.\n    Irreducible: a role cannot simultaneously be stable enough to coordinate around and fluid enough to permit unrestricted shift.  Every role-naming choice is balancing these two."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: named roles let the group coordinate and let newcomers find their footing.  But the same names can lock participants into identities they would otherwise outgrow — the \"newcomer\" who never gets to facilitate, the \"facilitator\" who never gets to learn from a beginner.\n    Active dynamic: the pull recurs at every transition — a tutee who begins to teach, a facilitator who needs to step back, a contributor who picks up a wrapping role for one cycle."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Identity ossification: a participant becomes \"the X person\" and finds it costly to do anything else, even when they want to.\n      - Single-point-of-failure roles: critical functions depend on one specific person with no shared name for the role they occupy.\n      - Role-name absence: the group's coordination depends on roles that no one has named, so newcomers cannot see how the work is divided and existing members cannot hand off cleanly.\n      - Implicit hierarchy: undeclared seniority shapes who does what, while the project's official self-description claims peer equality."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Name roles, not identities: when a role is assigned (heartbeat-keeper, wrapper, moderator), name the role and its scope, not \"X is the type of person who does this.\"  The role is a hat someone is wearing this week.\n      (2) Default-role audit: at intervals, ask which default roles the group has inherited from how it started, and whether they still fit.  Roles that made sense at convening time may not fit at maturity.\n      (3) Role rotation: where a role is sustainable but heavy (heartbeat-keeper, wrapper, moderator), build in rotation rather than assigning indefinitely.  Spreads cost, prevents identity-lock, builds redundancy.\n      (4) Role-shift announcement: when a participant changes role — newcomer becoming editor, facilitator stepping back — the change is named explicitly to the group, both to coordinate practical handoff and to model that role-shift is normal.\n      (5) Multiple roles per person: a single contributor may hold several roles concurrently (editor + heartbeat-keeper) and that is fine, as long as the carrying capacity (peeragogy/carrying-capacity) of each role-holder is respected."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: roles in the group are nameable on demand, role-shifts happen visibly and without drama, and the same person can occupy different roles at different times without that being remarked as exceptional.  Failing when: roles harden into identities, role-shifts are perceived as betrayals or promotions, or a role becomes single-occupancy permanently with no successor."}], :conclusion "Educational interactions inherit roles by default — autodidact, tutor, tutee, and outward into librarian, editor, administrator, and beyond.  The pattern is to treat these roles as *held* rather than *owned*: a participant occupies a role at a moment, and the same person may shift roles as the activity changes.  Naming roles makes coordination cheaper; treating them as fixed identities makes the group rigid.", :directives {:audience "peer-learning practitioners, facilitators", :keywords ["roles" "autodidact" "tutor" "tutee" "role-fluidity" "default-roles" "role-shift"], :references ["peeragogy/wrapper" "peeragogy/carrying-capacity" "peeragogy/moderation"], :style "process-pattern", :title "Treat Roles as Held, Not Owned — and Watch Them Shift", :tone "reflective"}, :id "peeragogy/roles", :keywords ["roles" "autodidact" "tutor" "tutee" "role-fluidity" "default-roles" "role-shift"], :projection-version "flexiarg-v0", :references ["peeragogy/wrapper" "peeragogy/carrying-capacity" "peeragogy/moderation"], :scores {}, :sigils [], :source-path "library/peeragogy/roles.flexiarg", :sources [], :status :ok, :title "Treat Roles as Held, Not Owned — and Watch Them Shift", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Polycentric practices that depend on a convener for their kickoff energy need an explicit successor for the convener's stewardship role before the convener steps back.  Without succession, the practice continues at reduced scope but stops shipping its next canonical artifacts.  The convener's defining-reality / scaffolding-then-stepping-back move is incomplete without a third phase — naming who picks up the stewardship work, and what shape that work takes after the founder is no longer doing it."} {:name "context", :name-key "context", :slug "context", :text "A practice has a founder or convener who scaffolds the project's early years — defines the inquiry, recruits participants, holds the canonical-text production going.  Eventually the convener wants to step back: to make space for others, to reduce their own load, or because the practice should not depend on one person.  The community takes over the practice's *operations* (gatherings, conversations, ongoing work) but does not take over the *stewardship* — the quiet labor of pushing toward the next canonical milestone.  The result is a practice that continues but doesn't ship: the conversations keep happening, the milestones stop arriving."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: continued-presence ↔ released-control.\n    Irreducible: stewardship is a specific kind of labor — neither the convener's founding energy nor any individual contributor's daily work.  It includes pushing toward next-canonical-things, holding institutional memory, and making decisions only a few people have the standing to make.  The labor doesn't transfer by osmosis."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: stepping back too soon leaves the practice without enough scaffolding; staying too long prevents others from picking up real responsibility.  The convener must release control AND ensure someone is positioned to carry the stewardship work, which requires explicit conversation, not just departure.\n    Active dynamic: the pull is strongest in the years after the convener's energy peaks but before they fully step back — a gradient phase when the next steward could be named but often isn't."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Canonical-artifact stall: the practice's canonical text/release/program-version stops shipping new editions while the practice's daily activities continue.\n      - Rolled-up-sleeves drift: people are doing work but no one is holding the larger trajectory.\n      - Founder-as-permanent-convener: the original convener never actually steps back because there's no successor in place; or the convener has stepped back informally but is still the only person with the standing to make some decisions.\n      - Eulogy-language: the practice gets discussed in the past tense even though it's still active in operations.\n      - Drafted-but-unshipped: proposals for next-canonical-things exist as drafts but nothing pushes them into shipped form."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Named successor: the convener publicly names one or more people as inheriting the stewardship role, with explicit description of what that role is and isn't.\n      (2) Distributed-stewardship council: the role is split across a small council, each member carrying one facet (canonical-artifact production, institutional memory, external relations, recruitment).\n      (3) Time-boxed stewardship terms: stewardship rotates on a defined cadence (annual, biennial); each cycle's outgoing steward names the incoming one and writes down what the role learned.\n      (4) Stewardship-by-shipping: the steward is whoever is currently shipping the next canonical artifact; if no one is shipping, that's the signal that no one is in the role.\n      (5) Sunset clause: the practice declares an explicit decision-point (\"if no one ships v4 by date X, the practice transitions to maintenance mode and stops claiming forward motion\") so absence of stewardship is named, not silently endured."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: when someone asks \"who is responsible for getting the next canonical thing out?\", a name (or council, or rotation) is given that the named person(s) confirm.  Failing when: the question elicits silence or a generic \"we collectively are.\""} {:name "provenance", :name-key "provenance", :slug "provenance", :text "This pattern surfaced from the 2026-04-29 posterior-pass analysis of the Peeragogy Podcast (M-peeragogy-rewrite mission), specifically the blackbox-recorder reading of episode 4 (\"The Collaborative Process of Creating a Book\", recorded late 2020).  In that episode, Joe Corneli stated: *\"We're pretty keen to get a fourth edition of the peeragogy handbook.  I've even drafted a proposal for the fifth edition at one point.\"*  As of 2026, neither v4 nor v5 has shipped, despite the practice continuing in podcasts, Cool Laboratory, Future Trends Forum, Metacog reading group, and other forms.  Howard Rheingold in the same episode named the convener move as two-phased (define reality → step back) without a named third phase; this pattern names that third phase."}], :conclusion "Polycentric practices that depend on a convener for their kickoff energy need an explicit successor for the convener's stewardship role before the convener steps back.  Without succession, the practice continues at reduced scope but stops shipping its next canonical artifacts.  The convener's defining-reality / scaffolding-then-stepping-back move is incomplete without a third phase — naming who picks up the stewardship work, and what shape that work takes after the founder is no longer doing it.", :directives {:audience "peer-learning project conveners, founders, scaffolding leaders, organizers", :keywords ["convener" "succession" "scaffolding" "stewardship" "hand-off" "polycentric" "drift" "blackbox-recorder" "peeragogy-handbook-stall"], :references ["peeragogy/roles" "peeragogy/roadmap" "peeragogy/wrapper" "peeragogy/heartbeat" "collaboration-coherence/stasis" "collaboration-coherence/isolation"], :style "process-pattern", :title "Plan the Convener's Successor Before You Step Back", :tone "practical"}, :id "peeragogy/stewardship-succession", :keywords ["convener" "succession" "scaffolding" "stewardship" "hand-off" "polycentric" "drift" "blackbox-recorder" "peeragogy-handbook-stall"], :projection-version "flexiarg-v0", :references ["peeragogy/roles" "peeragogy/roadmap" "peeragogy/wrapper" "peeragogy/heartbeat" "collaboration-coherence/stasis" "collaboration-coherence/isolation"], :scores {}, :sigils [], :source-path "library/peeragogy/stewardship-succession.flexiarg", :sources [], :status :ok, :title "Plan the Convener's Successor Before You Step Back", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Peer-learning groups face a recurring choice between *making new stuff* (poesis) and *using existing stuff* (praxis — reuse, remix, recombination).  Both are legitimate, but the choice tends to default toward production because production feels like progress.  The pattern is to make the use-or-make choice deliberately at each junction, asking how much of the apparent need for new artefacts could be met by reusing what already exists, including others' ideas and techniques."} {:name "context", :name-key "context", :slug "context", :text "Peer *production* — the dominant idiom in commons-based peer projects — biases toward making things.  Making is visible, recognisable, recordable; using is mostly invisible.  But peer-*learning* often advances faster through deliberate reuse: drawing on existing texts, existing tools, existing patterns, existing conversations rather than re-creating each.  The handbook frames this as the tension between poesis and praxis, citing Baudrillard's distinction; the pattern is to keep the question live rather than letting the production bias close it silently.  Closely related to peeragogy/pattern-language (a pattern language is itself a tool for principled reuse)."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: novelty production ↔ deliberate reuse.\n    Irreducible: a single decision cannot simultaneously be a fresh production and a reuse of existing material.  Hybrids exist (extension, adaptation, remix), but each is operating closer to one pole or the other and the choice is real."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: producing new artefacts builds skill, identity, and visible output; reusing existing artefacts compounds prior work and avoids reinventing wheels.  Both effects matter, and a project that does only one decays — pure production accretes unintegrated stuff, pure reuse stops contributing to the commons it draws on.\n    Active dynamic: the pull recurs at every \"should we make X?\" moment — guides, tools, frameworks, vocabularies, processes.  The production bias is the default; choosing reuse requires conscious counter-pressure."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Reinvention drift: the project repeatedly produces artefacts that already exist in similar form elsewhere, with no record of why those existing artefacts were rejected.\n      - Production-as-status: contributors are recognised for new artefacts but not for connecting, adapting, or curating existing ones.\n      - Detached output: the project's artefacts proliferate without composing — each useful in isolation, none feeding back into the others.\n      - Remix invisibility: where reuse and adaptation do happen, they are not marked as such, so the practice is not visible enough to spread."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Reuse search before production: before committing to make a new artefact, the group spends a defined effort searching for existing artefacts that could serve.  Time-boxed so the search does not itself become a way to defer.\n      (2) Adapt before re-create: when an existing artefact partly serves, prefer adaptation (fork, extend, annotate) to fresh production from scratch.  The lineage stays visible.\n      (3) Production with reuse-credit: when production is the right call, document what was considered for reuse and why it was insufficient.  The reasoning becomes part of the artefact.\n      (4) Periodic remix audit: at intervals, the group reviews its production output and asks which pieces are integrated with prior work and which are isolated novelties; isolated novelties get explicit decisions about whether to keep, integrate, or retire.\n      (5) Praxis-explicit framing: name reuse as legitimate work, not a fallback.  Without this, contributors feel they need to ship novelty to count, which deepens the production bias."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: production decisions visibly include consideration of reuse, and the project shows a balance of new and reused/adapted artefacts in its output.  Failing when: every problem produces a new artefact, with prior artefacts cited only after the new one is committed (if at all)."}], :conclusion "Peer-learning groups face a recurring choice between *making new stuff* (poesis) and *using existing stuff* (praxis — reuse, remix, recombination).  Both are legitimate, but the choice tends to default toward production because production feels like progress.  The pattern is to make the use-or-make choice deliberately at each junction, asking how much of the apparent need for new artefacts could be met by reusing what already exists, including others' ideas and techniques.", :directives {:audience "peer-learning practitioners, project conveners", :keywords ["poesis" "praxis" "remix" "reuse" "production" "paragogical-praxis" "baudrillard"], :references ["peeragogy/creating-a-guide" "peeragogy/pattern-language" "peeragogy/polling-for-ideas"], :style "process-pattern", :title "Choose Between Producing New and Reusing Existing — Deliberately", :tone "reflective"}, :id "peeragogy/use-or-make", :keywords ["poesis" "praxis" "remix" "reuse" "production" "paragogical-praxis" "baudrillard"], :projection-version "flexiarg-v0", :references ["peeragogy/creating-a-guide" "peeragogy/pattern-language" "peeragogy/polling-for-ideas"], :scores {}, :sigils [], :source-path "library/peeragogy/use-or-make.flexiarg", :sources [], :status :ok, :title "Choose Between Producing New and Reusing Existing — Deliberately", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Commons-based peer production needs both the ability to contribute small pieces and an integrative function that stitches those pieces together.  The wrapper is whoever or whatever performs that stitching — through periodic summaries, status framings, or maintained overviews — so contributors and newcomers can see what the project currently is.  Without a wrapper, small contributions accumulate without composing into a legible whole."} {:name "context", :name-key "context", :slug "context", :text "Distributed peer-learning projects produce more fragments than any individual contributor can hold in mind: messages, edits, drafts, threads, side-projects.  Newcomers cannot orient.  Long-tenured members lose track of what others are doing.  The wrapper's labour is not new content but legibility: a periodic act of saying \"here is what the project is right now\" that lets the rest of the work remain small."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: contribution granularity ↔ project legibility.\n    Irreducible: no individual contributor can both make a contribution and simultaneously hold the whole project in their head.  The wrapping work is structurally separate from the contributing work."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: small contributions are easy to make and easy to lose track of.  The smaller the contribution unit, the more the project depends on someone explicitly composing the units into a story.  Without that composition, the small contributions look like noise; with it, they become a project.\n    Active dynamic: the pull recurs at every cadence boundary (week, sprint, release) and whenever a newcomer arrives needing orientation."} {:name "ABSENCE-SIGNALS", :name-key "absence-signals", :slug "absence-signals", :text "      - Stale main page: the canonical overview describes a project state from months ago.\n      - Repeated orientation requests: the same \"what is the status of X?\" question recurs because no answer is captured.\n      - Fragmented memory: each contributor knows their own piece and no one knows the whole.\n      - Recognition starvation: contributors stop knowing whether their work landed because nothing names it."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Periodic roundup: a named person publishes a recurring summary (weekly digest, monthly report) that names what happened, who did what, and what is open.  The roundup is itself the wrapper artefact.\n      (2) Tended overview: a shared page (project main page, dashboard, README) that someone keeps current.  Wrapping is continuous rather than periodic.\n      (3) Briefing on demand: the wrapper writes orientation pieces when someone arrives or returns, rather than on a schedule.  Lower routine cost; risks newcomers arriving when no wrapper is on duty.\n      (4) Multi-wrapper rotation: the role rotates among several people, each wrapping a different facet (technical state, social state, external relations).  Spreads cost; needs explicit handoff between rotations."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: a newcomer can read a single recent artefact and form an accurate picture of where the project is.  Failing when: orientation requires reading the full message history or asking individual contributors what is going on."}], :conclusion "Commons-based peer production needs both the ability to contribute small pieces and an integrative function that stitches those pieces together.  The wrapper is whoever or whatever performs that stitching — through periodic summaries, status framings, or maintained overviews — so contributors and newcomers can see what the project currently is.  Without a wrapper, small contributions accumulate without composing into a legible whole.", :directives {:audience "peer-learning facilitators, project conveners", :keywords ["integrative-function" "summarising" "status" "weekly-roundup" "role" "benkler"], :references ["peeragogy/heartbeat" "peeragogy/roles" "peeragogy/roadmap"], :style "process-pattern", :title "Have Someone Whose Job Is to Stitch the Pieces Together", :tone "practical"}, :id "peeragogy/wrapper", :keywords ["integrative-function" "summarising" "status" "weekly-roundup" "role" "benkler"], :projection-version "flexiarg-v0", :references ["peeragogy/heartbeat" "peeragogy/roles" "peeragogy/roadmap"], :scores {}, :sigils [], :source-path "library/peeragogy/wrapper.flexiarg", :sources [], :status :ok, :title "Have Someone Whose Job Is to Stitch the Pieces Together", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a peripheral needs to emit or consume something the canonical event taxonomy does not yet describe, extend the taxonomy with a first-class typed event. Do not invent a side channel that bypasses the taxonomy, even if the side channel is cheaper to ship."} {:name "context", :name-key "context", :slug "context", :text "You are wiring a peripheral that needs to communicate something\n    the existing transport (WS pipeline, drawbridge, MUSN events) does not\n    have an event type for: cursor position, heartbeat, consent ack,\n    bell payload metadata."} {:name "IF", :name-key "if", :slug "if", :text "    The canonical transport has a typed event taxonomy — a finite,\n    documented set of event shapes that consumers parse and dispatch on."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Adding a new event type to the canonical taxonomy requires:\n    schema authoring, consumer awareness, documentation, maybe a\n    versioning step. It feels heavy. The lightweight alternative is\n    obvious: open a second channel (a sidecar WebSocket, a polling\n    HTTP endpoint, a file-watch, an out-of-band timer) that carries\n    the new thing, with no need to touch the canonical taxonomy.\n\n    The side channel ships in an hour. The taxonomy extension takes\n    half a day. The temptation is overwhelming."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Two-channel reality: the peripheral now lives in two places at\n        once. Consumers must subscribe to both to get the full picture.\n        Diagnostics fragment across both. Tooling that knew one channel\n        doesn't know the other.\n      - Schema-drift-by-default: the side channel has no taxonomy\n        discipline, so its payload shape drifts freely. Three months\n        later, no one knows what shapes are emitted on it.\n      - Consent-bypass-by-accident: the canonical transport has consent\n        and write-ownership boundaries baked in. The side channel\n        doesn't. Now the peripheral can write things it never had\n        permission to write, because the permission check lived on the\n        path it bypassed.\n      - Observability-bypass: telemetry, audit logging, and replay\n        tooling instrument the canonical transport. The side channel\n        is invisible to them. When something goes wrong on the side\n        channel, there is no record.\n      - \"Temporary\"-as-permanent: the side channel was supposed to be\n        moved into the taxonomy \"later.\" Later never comes. The temp\n        is now load-bearing."} {:name "THEN", :name-key "then", :slug "then", :text "    When the peripheral needs a new event, extend the taxonomy:\n\n    1. **Author the event schema as a first-class type** in the\n       canonical taxonomy. Give it a name, a payload shape, semantics,\n       and a producer/consumer note. The schema lives in the same\n       place all other event schemas live.\n    2. **Add the producer** (the peripheral emits the event on the\n       canonical transport, not on a sidecar).\n    3. **Document the consumer contract** even if there is only one\n       consumer today. The discipline of writing the contract makes\n       future second consumers possible.\n    4. **Update the taxonomy index/docs** so the next reader can find\n       the event by searching the taxonomy, not by reading the\n       peripheral's source.\n    5. **Consume via the same subscription mechanism** other consumers\n       use — same dispatch, same filtering, same backpressure\n       handling, same audit trail.\n\n    If the taxonomy extension is genuinely too heavy for the change at\n    hand, that is itself a signal: the taxonomy may be over-formalised\n    or under-tooled. Fix THAT (lower the cost of adding a typed event),\n    rather than routing around it."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    A taxonomy is an institution in Ostrom's sense — a shared resource\n    governed by rules-in-use. Side channels are tragedy-of-the-commons\n    moves: each one is locally cheap, and each one degrades the\n    institutional value of the taxonomy. Once the taxonomy is no longer\n    a complete description of what flows, it stops being trusted as a\n    contract; once it stops being a contract, every new consumer must\n    discover what flows empirically; once that becomes normal, the\n    taxonomy is dead documentation and the wire is a free-for-all.\n\n    Typed events have non-obvious downstream value: replay tooling can\n    deterministically rebuild state from the event log; new consumers\n    can subscribe without coordination; backpressure and prioritisation\n    can be implemented uniformly. Every side channel forecloses on\n    these capabilities for the data it carries.\n\n    The pattern also closes a peripheral-design loop. Heartbeat\n    (peripherals/progress-heartbeat-distinct-from-cycle-completion) is\n    exactly the case: the watchdog needs a liveness signal distinct\n    from cycle events. The wrong move is a separate ping mechanism.\n    The right move is to add a \"heartbeat\" typed event to the same\n    transport, so watchdogs subscribe to the same wire as everything\n    else.\n\n    The pattern is also the principled defence against the \"lightweight\"\n    euphemism (feedback_lightweight_euphemism, agent memory): a\n    \"lightweight side channel\" is the precise shape of work that\n    appears done but isn't institutionalised. Translation: it is a typed\n    event missing its taxonomy entry."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-emacs-cursor-peripheral (2026-05-24, codex-8): the\n      original sketch had cursor positions broadcast on a parallel WS\n      channel. Codex identified this as a side-channel against the\n      canonical WS transport, and proposed adding a typed\n      \"cursor-position\" (and later, full \"presence\") event to the\n      canonical event taxonomy instead. The WS pipeline already had\n      backpressure, audit, and consent semantics; the side channel\n      would have had none."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "realtime/structured-events-only (futon3 pattern\n      library): \"All inter-agent communication MUST be structured\n      events with documented schemas.\" This pattern is the peripheral-\n      design corollary: when extending a stack with new communication,\n      extend the taxonomy."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "WM API surface (futon3c, 2026-05-23 consolidation):\n      War Machine surfaces (R-Criterion status, R12 apparatus, etc.)\n      are all served via the canonical /api/alpha/war-machine endpoints\n      on port 7070. The Emacs *War Machine* buffer and the web UI both\n      consume from the same canonical endpoints; no side channel for\n      \"Emacs-specific\" markdown vs \"web-specific\" JSON. The single\n      canonical surface enabled both clients without divergence."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "bell payload schema standardisation (claude-10's\n      parked substrate-creation thread, 2026-05-23/24): exactly the\n      case where bell payloads were drifting in shape across producers.\n      Standardisation = taxonomy formalisation. The fact that the\n      thread exists is evidence that side-channel-like drift had begun."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Maintain a single canonical event-taxonomy document per transport.\n      Every typed event lives there.\n    - Make taxonomy extension cheap: a template for new event schemas,\n      a quick-add path that doesn't require ceremony. Cost-of-extension\n      should not be the reason side channels exist.\n    - When reviewing a peripheral mission, ask: \"what new events does\n      this peripheral introduce? Where in the taxonomy do they live?\"\n      If the answer is \"they don't, we just emit them,\" the mission\n      needs revision.\n    - For M-war-machine-pilot specifically: every event the WM\n      peripheral emits (cycle phase changes, judgement events,\n      heartbeats, consent acks, bell payloads) must have an entry in\n      the canonical event taxonomy. The Pair-stage and Collaborate-\n      stage consent acks especially must be typed events, because\n      consent decisions are exactly the data future audit tools will\n      replay.\n    - Cross-link: peripherals/split-transport-from-embodiment — typed\n      events are how the transport layer stays describable\n      independently of any embodiment."}], :conclusion "When a peripheral needs to emit or consume something the canonical event taxonomy does not yet describe, extend the taxonomy with a first-class typed event. Do not invent a side channel that bypasses the taxonomy, even if the side channel is cheaper to ship.", :directives {:audience "peripheral designers, transport implementers, event-schema maintainers", :keywords ["event-schema" "typed-event" "side-channel" "taxonomy" "extension" "WS" "MUSN" "frame" "first-class" "canonical" "drift"], :references ["peripherals/read-existing-seam-before-implementing" "peripherals/split-transport-from-embodiment" "peripherals/progress-heartbeat-distinct-from-cycle-completion" "realtime/structured-events-only" "realtime/single-line-transport"], :sigils ["📜/典"], :style "pattern", :title "Canonical Typed Event vs Side Channel", :tone "foundational"}, :id "peripherals/canonical-typed-event-vs-side-channel", :keywords ["event-schema" "typed-event" "side-channel" "taxonomy" "extension" "WS" "MUSN" "frame" "first-class" "canonical" "drift"], :projection-version "flexiarg-v0", :references ["peripherals/read-existing-seam-before-implementing" "peripherals/split-transport-from-embodiment" "peripherals/progress-heartbeat-distinct-from-cycle-completion" "realtime/structured-events-only" "realtime/single-line-transport"], :scores {}, :sigils ["📜/典"], :source-path "library/peripherals/canonical-typed-event-vs-side-channel.flexiarg", :sources [], :status :ok, :title "Canonical Typed Event vs Side Channel", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peripheral is a constrained execution envelope — a space where the actions available are exactly the actions that lead to the goal, not a space where distracting actions are forbidden."} {:name "context", :name-key "context", :slug "context", :text "An agent (or human) wants to achieve something they believe they\n    know how to do: prove a theorem, formalize a solution, write a module,\n    complete a review. They have the skills and the intention."} {:name "IF", :name-key "if", :slug "if", :text "    The agent has the capability to achieve the goal and a reasonable plan\n    for reaching it."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    In an unconstrained environment, the agent doesn't actually achieve it.\n    It gets distracted — checking dependencies, refactoring adjacent code,\n    reading tangential material, switching to a different problem, or\n    producing work that is vaguely related but not the thing. The\n    environment affords too many actions, and the ones that feel productive\n    in the moment are not the ones that close the goal."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Envelope too tight: the agent cannot do the work because the\n        available actions do not cover the actual requirements. The fix is\n        to widen the envelope, not to abandon it.\n      - Envelope too loose: the available actions include tangential work\n        that feels productive. The fix is to narrow the affordances, not\n        to add prohibitions.\n      - Envelope as punishment: the agent perceives the constraint as\n        distrust rather than structure. This happens when the envelope is\n        framed negatively (\"you are not allowed to...\") rather than\n        positively (\"your tools are...\").\n      - Envelope without exit: the agent completes the work but cannot\n        leave the peripheral. Every envelope needs an exit condition that\n        is as clear as its entry condition."} {:name "THEN", :name-key "then", :slug "then", :text "    Set up a constrained execution envelope — a peripheral — in which the\n    available actions are exactly the actions that lead to the goal.\n\n    The key: define the envelope in positive terms. Do not enumerate what\n    the agent cannot do; describe what the agent can do. The peripheral\n    offers tools, phases, and exit conditions that constitute the productive\n    path. What is not offered is not forbidden — it simply does not exist\n    within this envelope.\n\n    A proof peripheral offers: observe the problem, propose an approach,\n    execute the formalization, validate against criteria, classify the\n    result. Those are the actions. There is no \"check IRC\" action, no\n    \"refactor the build system\" action — not because they are banned, but\n    because the envelope does not contain them.\n\n    A review peripheral offers: read the diff, check the invariants,\n    note issues, approve or request changes. A deploy peripheral offers:\n    run the tests, check the gates, push the artifact. Each envelope is\n    shaped to its goal."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Forbidding distracting actions does not work. A prohibition is a\n    negative statement that requires the agent to hold both the forbidden\n    action and the reason for forbidding it in mind — which is itself a\n    distraction. It is a known pattern from philosophy (Nietzsche's\n    critique of negation, Spinoza's \"omnis determinatio est negatio\" read\n    in reverse) that productive constraint works by affirming what is\n    present, not by denying what is absent. You do not teach someone to\n    play chess by listing the moves they cannot make; you teach them the\n    moves they can make, and the board enforces the rest.\n\n    Even apparently negative concepts (Hegelian synthesis, apophatic\n    theology, boundary conditions in mathematics) function as positive\n    statements when they are operative: a synthesis is a new thing, not\n    the absence of two old things; a boundary condition is a value the\n    solution must take, not a region it must avoid.\n\n    The peripheral is the positive statement. It says: here is what you\n    can do, here is the sequence, here is when you are done. The agent\n    inhabits this envelope and does the work. The constraint is not felt\n    as restriction but as structure — the way a sonnet form is not a\n    restriction on poetry but a structure that produces it."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-apm-solutions (futon3c, 2026-03-29): Claude-1 was asked\n      to solve prelim problems using the proof peripheral cycle (observe →\n      propose → execute → validate → classify). Instead it one-shot each\n      problem with raw tool calls, skipped the peripheral phases, left\n      3 sorry in Lean formalizations, and moved on without validating.\n      The agent had the capability and the plan but the unconstrained\n      environment let it take the path of least resistance. The peripheral\n      existed but was not the execution envelope — it was a suggestion\n      alongside an open field of alternatives."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - For each goal type (proof, review, deploy, exploration), define\n      the minimal set of actions that constitute the productive path.\n    - Implement the envelope as a peripheral with those actions as its\n      tool set, phases as its sequence, and success criteria as its\n      exit condition.\n    - Test by observing whether agents complete the goal or drift.\n      Drift means the envelope is too loose; failure means it is too\n      tight.\n    - Apply the same principle to human-facing surfaces: the REPL's\n      keybindings, commands, and display should constitute an envelope\n      for the interaction pattern it supports."}], :conclusion "A peripheral is a constrained execution envelope — a space where the actions available are exactly the actions that lead to the goal, not a space where distracting actions are forbidden.", :directives {:audience "peripheral designers, agent architects, workflow designers", :keywords ["peripheral" "envelope" "constraint" "focus" "distraction" "scope" "positive-constraint" "affordance" "inhabitation"], :references ["agent/scope-before-action" "peripherals/surface-earns-inhabitation" "peripherals/inhabitation-feeds-evolution" "futon-theory/mission-lifecycle" "gauntlet/aif-as-environment-not-instruction" "gauntlet/umwelt-not-architecture"], :sigils ["🔲/界"], :style "pattern", :title "Constrained Execution Envelope", :tone "foundational"}, :id "peripherals/constrained-execution-envelope", :keywords ["peripheral" "envelope" "constraint" "focus" "distraction" "scope" "positive-constraint" "affordance" "inhabitation"], :projection-version "flexiarg-v0", :references ["agent/scope-before-action" "peripherals/surface-earns-inhabitation" "peripherals/inhabitation-feeds-evolution" "futon-theory/mission-lifecycle" "gauntlet/aif-as-environment-not-instruction" "gauntlet/umwelt-not-architecture"], :scores {}, :sigils ["🔲/界"], :source-path "library/peripherals/constrained-execution-envelope.flexiarg", :sources [], :status :ok, :title "Constrained Execution Envelope", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When fixing a peripheral or any code running inside the serving JVM, hot-reload via Drawbridge nREPL is the default fix path. Restart is the exception, taken only when the change crosses a documented reload-safety boundary."} {:name "context", :name-key "context", :slug "context", :text "A peripheral (or anything else running inside the futon3c JVM)\n    has a bug. You have a fix. You need to deploy the fix to the running\n    process so observation, testing, or operator use can continue."} {:name "IF", :name-key "if", :slug "if", :text "    The JVM is currently serving requests, holding session state, hosting\n    other agents' work-in-progress, or simply has expensive warmth (JIT-\n    compiled hot paths, loaded XTDB indexes, established WS connections)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    The instinct from non-JVM development is \"restart and see.\" That\n    instinct is exactly wrong here. Restarting the JVM:\n\n    - Kills every in-flight session (operator's REPL, paired agents,\n      WS subscribers, scheduled tasks)\n    - Discards JIT warmth (the first N requests after restart are\n      slow; this slowness propagates as backpressure cascades —\n      see project_blackboard_backpressure)\n    - Forces every peripheral that depends on JVM state to re-bootstrap\n      (atoms reload from disk, caches re-warm, connections re-establish)\n    - Triggers cascading reconnections in clients (Emacs *War Machine*\n      buffers, web UIs, IRC bridges) that were not the target of the fix\n\n    Restart is not a \"clean slate\" — it is an outage taken so the\n    developer doesn't have to think about reload semantics."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Restart-by-default: every code change becomes a JVM bounce.\n        Operator and paired agents experience the bounce as cascading\n        disconnects.\n      - Reload-without-reading-protocol: blindly :reloading every\n        changed namespace, including third-party defprotocol namespaces\n        (xtdb.api, drawbridge core protocols). Reload of a protocol-\n        defining ns invalidates every implementer; the cascade poisons\n        the JVM and the only recovery IS a restart. (See:\n        feedback_drawbridge_protocol_reload, agent memory.)\n      - Reload-as-magic: assuming reload \"just works\" without\n        understanding which namespaces are reload-safe and which are\n        not. Reload safety is a property of the namespace design, not\n        of the reload mechanism.\n      - Hot-fix-without-disk-truth: changing something via REPL eval\n        without writing the change to disk first. The fix is lost on\n        the next restart and is invisible to other agents reading the\n        source. Reload must always follow disk-write, never replace it."} {:name "THEN", :name-key "then", :slug "then", :text "    Make hot-reload the default fix path with these disciplines:\n\n    1. **Edit on disk first, then reload**. The disk is the source of\n       truth. Reload propagates disk state into the JVM. Reloads that\n       don't correspond to disk state are non-reconstructible.\n    2. **Reload only your own namespaces**. Third-party namespaces\n       (xtdb.api, anything that defines a protocol used by other code)\n       are off-limits for reload. If you need them reloaded, restart is\n       the honest answer — but it should be a deliberate decision, not\n       a habit.\n    3. **Reload is safe iff it equals a restart**. The test for\n       reload-safety on a namespace: if you replace this namespace's\n       current state with a fresh load from disk, does the JVM continue\n       to behave correctly? If yes (atoms re-bootstrap from disk, no\n       protocol cascade, no orphaned subscribers), the namespace is\n       reload-safe. If no, restart. (See: feedback_reload_safety, agent\n       memory: protocol-defining ns AND atom-without-bootstrap-replay\n       are the unsafe cases.)\n    4. **Use Drawbridge nREPL, not REPL eval over stdin**. Drawbridge\n       provides session-scoped, observable, audit-loggable evaluation.\n       proof-eval.sh and related tooling wrap it. REPL eval over stdin\n       leaves no trace and bypasses the session contract.\n    5. **For changes that DO require restart**, treat it as an event:\n       announce it via bell, give operator and paired agents a chance\n       to checkpoint, and minimize the window. A restart should feel\n       like a deploy, not like a debugger gesture."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Invariant I-0 (One JVM Is Plenty, futon3c CLAUDE.md) is not just\n    about resource budget — it is about treating the JVM as a single,\n    valuable, long-lived process whose continuity has compounding value\n    over time. Every restart resets the compound interest. The JVM is\n    the blackboard; the blackboard is shared infrastructure; bouncing\n    shared infrastructure to deploy a one-line fix is a category error.\n\n    The pattern also follows from the broader peripheral framing:\n    peripherals generate data through inhabitation\n    (inhabitation-feeds-evolution). A restart discards mid-cycle\n    inhabitation data — frames in flight, half-written evidence, partial\n    bell roundtrips. Hot-reload preserves the data the peripheral was\n    just about to commit.\n\n    Drawbridge is the canonical seam for this\n    (peripherals/read-existing-seam-before-implementing): it exists, it\n    is documented (futon3c/README-drawbridge.md), it has tooling\n    (proof-eval.sh), and it is what other agents in the stack use. A\n    fix path that bypasses it forks the canonical seam.\n\n    The contrapositive is also important: hot-reload-as-default does\n    NOT mean \"always hot-reload, never restart.\" It means the choice is\n    deliberate. Some changes require restart (classpath additions, JVM\n    flag changes, irreversible state migrations). Recognising those\n    cases and announcing the restart honestly is part of the discipline."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "multi-watcher fix (2026-05-24, codex-8): Codex used\n      proof-eval.sh to apply the multi-watcher fix to the running\n      futon3c JVM without restart. The fix landed in seconds.\n      Operator session, paired agents, scheduled tasks, and WS\n      subscribers continued uninterrupted. The fix's verification\n      happened on a JVM that was already warm."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "feedback_no_server_restart (agent memory): \"don't kill\n      JVM processes; use Drawbridge nREPL for code reload.\" The pattern\n      formalises this as the default, not just a preference."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "feedback_drawbridge_protocol_reload (agent memory):\n      \"never :reload xtdb.api or any third-party defprotocol via\n      Drawbridge; cascade poisons the JVM, recovery needs restart.\" The\n      pattern names this as the boundary condition — protocol-defining\n      ns is off-limits."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "feedback_reload_safety (agent memory): \"reload is safe\n      iff it equals a restart.\" The pattern lifts this from rule into\n      the test for reload-safety."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "futon3c CLAUDE.md I-0: \"For code reloads inside the\n      futon3c JVM, use Drawbridge nREPL (per README-drawbridge.md); do\n      not kill and restart the serving JVM.\" The invariant is in the\n      project's CLAUDE.md; this pattern grounds the why."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - For every peripheral that runs inside the futon3c JVM, document\n      which of its namespaces are reload-safe and which are not. The\n      list belongs in the peripheral's own design doc.\n    - When pairing on a fix, name the fix path explicitly: \"hot-reload\n      via Drawbridge\" or \"deliberate restart, here's why.\" Don't let\n      the choice happen by reflex.\n    - When designing a new peripheral, design for reload-safety from\n      the start: atoms bootstrap from disk; no protocols defined in\n      hot-edit paths; subscribers re-attach on reload rather than\n      depending on JVM-process-identity.\n    - For M-war-machine-pilot specifically: the WM peripheral's own\n      namespaces should be reload-safe by design. The pilot's audit\n      criteria should include \"can be hot-reloaded via Drawbridge\n      without disrupting the WM API surface or in-flight cycles.\""}], :conclusion "When fixing a peripheral or any code running inside the serving JVM, hot-reload via Drawbridge nREPL is the default fix path. Restart is the exception, taken only when the change crosses a documented reload-safety boundary.", :directives {:audience "peripheral developers, agents working inside long-running JVMs, operators", :keywords ["hot-reload" "drawbridge" "nREPL" "JVM" "restart" "fix-cycle" "blackboard" "state-preservation" "reconstructibility" "I-0"], :references ["peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "peripherals/read-existing-seam-before-implementing" "realtime/single-line-transport"], :sigils ["♻/續"], :style "pattern", :title "Hot-Reload As Default Fix Path", :tone "operational"}, :id "peripherals/hot-reload-as-default-fix-path", :keywords ["hot-reload" "drawbridge" "nREPL" "JVM" "restart" "fix-cycle" "blackboard" "state-preservation" "reconstructibility" "I-0"], :projection-version "flexiarg-v0", :references ["peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "peripherals/read-existing-seam-before-implementing" "realtime/single-line-transport"], :scores {}, :sigils ["♻/續"], :source-path "library/peripherals/hot-reload-as-default-fix-path.flexiarg", :sources [], :status :ok, :title "Hot-Reload As Default Fix Path", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peripheral is not just a constrained action space — it is a representational space that enables a learning loop. Inhabiting the peripheral generates the data that evolves the peripheral. If the peripheral is not inhabited, the loop is dead and the peripheral cannot improve."} {:name "context", :name-key "context", :slug "context", :text "You have an interface — an action arena in Ostrom's sense — where\n    agents (or humans) do work. The work produces outcomes. You want both the\n    work and the interface to get better over time."} {:name "IF", :name-key "if", :slug "if", :text "    The interface is more than a passive display: it is a space where actions\n    happen, outcomes are observed, and the relationship between action and\n    outcome can be recorded."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Effective action is not just \"doing things in a space.\" It requires a\n    learning loop: the agent acts, observes the result, and the observation\n    feeds back into future action. This is a transport problem — experience\n    must move from the action space into a representation that can reshape\n    future behavior. Without this transport, the agent acts but does not\n    learn, and the interface affords but does not evolve."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Data-starved loop: the peripheral exists but nobody uses it, so no\n        evidence accumulates and the designer has nothing to work with.\n        This is the most common failure and the hardest to diagnose because\n        the peripheral looks correct on paper.\n      - Representation without transport: the peripheral captures data but\n        the data never reaches the designer (or the glacial loop). Frames\n        accumulate in SQLite but nobody queries them. Evidence is logged\n        but never reviewed.\n      - Evolution without inhabitation feedback: the designer changes the\n        peripheral based on theory rather than usage data. The changes may\n        be correct but are ungrounded — they solve imagined problems rather\n        than observed ones.\n      - Upsampling instability: the peripheral reshapes itself faster than\n        the agent can adapt, creating a moving target. The learning loop\n        needs damping, not just speed."} {:name "THEN", :name-key "then", :slug "then", :text "    Recognize that a peripheral is exactly the representational space where\n    this transport happens. The peripheral is not merely a constrained\n    execution envelope (though it is that too). It is a parallel space that\n    mirrors the agent's actions in structured form — phases, events, frames,\n    evidence — creating a representation that is legible to both the agent\n    and the designer.\n\n    This is the Baldwin effect operating on interfaces. In biology, the\n    Baldwin effect describes how learned behaviors (phenotype) can guide\n    the evolution of innate structure (genotype): organisms that can learn\n    to exploit an environmental niche survive long enough for genetic\n    changes that hardwire the adaptation. The learning happens fast; the\n    structural change happens slow; but the learning is what makes the\n    structural change possible.\n\n    In the futon stack, the same dynamic operates at two timescales:\n\n    - **Social loop (fast):** The agent inhabits the peripheral, acts\n      within its phases, produces evidence, encounters friction or flow.\n      This is the \"learning\" — the agent's experience within the\n      representational space.\n    - **Glacial loop (slow):** The peripheral designer reads the evidence,\n      observes where agents drift or succeed, and reshapes the peripheral's\n      phases, tools, and exit conditions. This is the \"genetic change\" —\n      the structural evolution of the interface.\n\n    The Baldwin insight: the fast loop generates the data that makes the\n    slow loop possible. Without inhabitation, there is no data. Without\n    data, there is no evolution. Without evolution, the peripheral stays\n    misshapen. And a misshapen peripheral is not inhabited — completing\n    the death spiral.\n\n    The transport from futon2's AIF ants is the right analogy: cyberant\n    programs represent ant foraging strategies in a parallel computational\n    space. The ants act in the world; the programs represent those actions\n    in a form that can be evaluated, compared, and evolved. The peripheral\n    does the same thing for agent work: the agent acts in the problem\n    domain; the peripheral represents those actions as phases, frames,\n    and evidence entries in a form that can be inspected, compared, and\n    used to reshape the envelope.\n\n    The upsampling possibility: there is no fundamental reason the glacial\n    loop must stay glacial. If the peripheral captures enough structured\n    data in the social loop (rich frames, tool event sequences, outcome\n    classifications), then the peripheral itself could be reshaped on the\n    fly — adding phases, adjusting affordances, tightening or loosening\n    the envelope — within the same session. This dissolves the boundary\n    between learning and evolution. The agent's inhabitation of the\n    peripheral generates the data that reshapes the peripheral that the\n    agent is inhabiting.\n\n    But — and this is the crux — none of this is possible if the agent\n    does not enter the peripheral in the first place. The surface must\n    earn inhabitation (see: peripherals/surface-earns-inhabitation) or the\n    entire Baldwin loop is starved of data at the source."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The symmetry between agents and humans reveals the pattern. When\n    Claude bypasses the proof peripheral to one-shot tool calls, and when\n    Joe bypasses the REPL to type in a terminal, they are both starving\n    the same learning loop for the same reason: the primitive path has\n    less friction. The consequence is the same in both cases: no\n    structured data is generated, no evidence accumulates, no peripheral\n    evolution is possible, and the gap between the primitive path and the\n    infrastructure path never closes.\n\n    The Baldwin effect is subtle because it requires seeing the peripheral\n    as a representational space, not just a constraint. A constraint that\n    is not inhabited is merely a rule. A representational space that is\n    inhabited is a learning engine. The difference is whether the\n    peripheral generates data that feeds back into its own design.\n\n    This is why surface usability is not cosmetic. It is the entry\n    condition for the Baldwin loop. A peripheral with perfect design but\n    poor surface is like a genotype with perfect fitness in a niche that\n    the organism never enters: theoretically optimal, actually inert."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-repl-wins-over-cli (futon3c, 2026-03-29): interrupt\n      did not work, tool calls were opaque, streaming hijacked the cursor.\n      Joe used the CLI instead. No evidence was logged, no frames were\n      captured, no data was available to improve the REPL. Fixing the\n      basics was not UI work — it was reopening the Baldwin loop by making\n      inhabitation possible."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-apm-solutions (futon3c, 2026-03-29): Claude-1 was given\n        the proof peripheral but one-shot every problem without entering the\n        cycle. No phase transitions were recorded, no validation occurred,\n        no evidence accumulated for improving the cycle. The peripheral\n        existed but generated no data because it was not inhabited."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "futon2 AIF ants: cyberant programs evolved foraging\n        strategies in a parallel representation space. The ants had to\n        actually forage (inhabit the environment) for the programs to have\n        data to evolve against. Ants that did not forage contributed nothing\n        to the evolutionary loop."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Ensure every peripheral captures structured data (frames, events,\n      evidence) as a side effect of inhabitation, not as an extra step.\n    - Build review surfaces that make peripheral usage data visible to\n      the designer (frame inspector, evidence queries, session replay).\n    - Identify peripherals with low inhabitation rates and treat the\n      surface friction as the primary diagnosis, not the peripheral design.\n    - Experiment with social-loop peripheral adaptation: can the envelope\n      tighten or loosen based on observed drift within a single session?"}], :conclusion "A peripheral is not just a constrained action space — it is a representational space that enables a learning loop. Inhabiting the peripheral generates the data that evolves the peripheral. If the peripheral is not inhabited, the loop is dead and the peripheral cannot improve.", :directives {:audience "peripheral designers, AIF architects, futon theorists", :keywords ["Baldwin-effect" "inhabitation" "learning-loop" "peripheral" "evolution" "transport" "representation" "action-arena" "Ostrom" "AIF" "upsampling" "glacial" "social"], :references ["peripherals/surface-earns-inhabitation" "peripherals/constrained-execution-envelope" "aif/structured-observation-vector" "futon-theory/mission-lifecycle" "meta/baldwin-ratchet-defeats-darkroom" "futon-theory/baldwin-cycle" "ants/baseline-cyber-ant" "gauntlet/aif-as-environment-not-instruction" "math-informal/transport-across-isomorphism"], :sigils ["🧬/化"], :style "pattern", :title "Inhabitation Feeds Evolution", :tone "theoretical"}, :id "peripherals/inhabitation-feeds-evolution", :keywords ["Baldwin-effect" "inhabitation" "learning-loop" "peripheral" "evolution" "transport" "representation" "action-arena" "Ostrom" "AIF" "upsampling" "glacial" "social"], :projection-version "flexiarg-v0", :references ["peripherals/surface-earns-inhabitation" "peripherals/constrained-execution-envelope" "aif/structured-observation-vector" "futon-theory/mission-lifecycle" "meta/baldwin-ratchet-defeats-darkroom" "futon-theory/baldwin-cycle" "ants/baseline-cyber-ant" "gauntlet/aif-as-environment-not-instruction" "math-informal/transport-across-isomorphism"], :scores {}, :sigils ["🧬/化"], :source-path "library/peripherals/inhabitation-feeds-evolution.flexiarg", :sources [], :status :ok, :title "Inhabitation Feeds Evolution", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A pattern that remains documentation has not yet become a peripheral. The transition from pattern to peripheral is the transition from describing what works to being the space in which the working happens — and that transition is what creates new capability, not merely new knowledge."} {:name "context", :name-key "context", :slug "context", :text "You have a well-articulated pattern — or a library of them. The\n    patterns accurately describe what works under what conditions. They have\n    been grounded in evidence, stress-tested, cross-referenced. They are\n    correct. But the situation they describe has not improved."} {:name "IF", :name-key "if", :slug "if", :text "    The patterns are correct and the problem they address is real: there\n    exists a productive way of working that is not being practiced."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Correctness does not produce inhabitation. A pattern describes the right\n    envelope but does not address whether anyone enters it or whether it\n    evolves through use. The pattern sits in the library (or the programme\n    design document, or the mission file) as a description of what would\n    work — and the world continues not to work that way.\n\n    This is not a failure of the pattern. It is a category gap. Pattern\n    theory gives you the vocabulary for describing *what works under what\n    conditions*. What it does not give you is the space in which the\n    working happens, the surface that earns entry into that space, or the\n    loop through which the space improves. Those are peripheral-theoretic\n    concerns.\n\n    The gap shows up identically across scales:\n\n    - A developer has 800 patterns in a library but reaches for the CLI\n      because the REPL (which instantiates the patterns as a working\n      environment) has too much friction.\n    - An AI agent has a proof peripheral defined with phases and exit\n      conditions but one-shots every problem because entering the\n      peripheral is harder than not entering it.\n    - A national programme has five well-grounded design patterns but the\n      institutional architecture that would instantiate them as lived\n      practice is largely absent.\n\n    In all three cases, the patterns are correct. In none of them is the\n    pattern doing work. The pattern is a description; it has not yet\n    become a space."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Pattern-as-commandment: \"you must use the proof peripheral\"\n        produces compliance, not inhabitation. The agent enters the space\n        under obligation and exits at the first opportunity.\n      - Pattern-as-prohibition: \"you must not use the CLI\" blocks the\n        alternative without making the peripheral attractive. Produces\n        resentment and workarounds.\n      - Absorbed input mistaken for success: the trainer delivered, the\n        code was written, the problem was solved. But nothing was learned\n        at the system level. Output without capability is the most\n        common and least visible failure.\n      - Blame allocated to inhabitants: \"the trainers didn't embed the\n        programme\" / \"the agent didn't use the peripheral\" / \"the\n        developer didn't use the REPL.\" The diagnostic should be: the\n        space didn't earn inhabitation, the surface had too much friction,\n        or the Baldwin loop was starved."} {:name "THEN", :name-key "then", :slug "then", :text "    Recognise that pattern theory is necessary but not self-completing.\n    The bridge from pattern to practice is *instantiation as peripheral*:\n    the pattern must become a constrained execution envelope (what the\n    space contains), with a surface that earns inhabitation (why anyone\n    enters), feeding a Baldwin loop (how the space evolves from use).\n\n    This bridge has a distinctive character that distinguishes it from\n    both commandment and prohibition. The pattern-as-documentation says\n    \"here is what works\" — a descriptive claim. A commandment (\"thou\n    shalt use the proof peripheral\") tries to force entry through\n    obligation. A prohibition (\"thou shalt not use the CLI\") tries to\n    force entry by blocking alternatives. Neither works, for reasons the\n    philosophical tradition has long understood:\n\n    - Spinoza: joy (laetitia) is an increase in the power to act.\n      A peripheral that earns inhabitation produces joy — the\n      inhabitant finds their power to act increased by being inside it.\n      A commandment produces obedience, which is not joy. A prohibition\n      produces resentment or evasion, which is the opposite.\n    - Nietzsche: affirmation is the only durable motivation. The\n      peripheral must be affirmed — chosen because it is good, not\n      endured because it is required.\n    - Sen: capability is freedom, not functioning. The peripheral must\n      create real freedom to act — conversion factors that turn nominal\n      access into durable capability. A programme that provides access\n      without conversion factors provides a pattern without a peripheral.\n\n    The transition from pattern to peripheral is therefore not an\n    implementation step (\"now deploy the pattern\"). It is a creative act:\n    the construction of a space that is *worth inhabiting*, that increases\n    the inhabitant's power to act, and that generates the data needed to\n    evolve itself.\n\n    Crucially, this means the moral weight falls on the *space*, not on\n    the *inhabitant*. When a trainer doesn't embed the programme, or an\n    agent doesn't use the peripheral, or a developer doesn't use the REPL,\n    the diagnosis is not \"the inhabitant is deficient\" but \"the space has\n    not yet earned inhabitation.\" This is not moral grayness — it is a\n    precise structural claim: the conditions for productive action have\n    not been met, and the responsibility lies with whoever designs and\n    maintains the conditions, not with whoever fails to thrive within\n    inadequate ones."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The absorbed-input mode reveals why this matters. In the absorbed\n    case, an individual gains something — skills, experience, CV lines,\n    working code — but the system gains nothing. The trainer leaves and\n    takes the knowledge with them. The agent writes code but no\n    institutional learning accumulates. The developer uses Stack Overflow\n    and gets a working function but no understanding of why it works.\n\n    What doesn't happen in the absorbed case is the creation of new\n    institutions (Ostrom). The trainer doesn't create a community of\n    practice at their institution. The agent doesn't produce evidence\n    that improves the proof peripheral. The developer doesn't contribute\n    a pattern back to the library. The individual transacts with the\n    system but the system does not change.\n\n    This is the \"programming by Stack Exchange\" failure mode applied\n    universally. An interaction that produces output without producing\n    capability is an interaction that has been *absorbed* rather than\n    *institutionalised*. The output is real — the code works, the\n    training was delivered, the problem was solved — but it is\n    non-generative. Nothing was learned at the system level. No new\n    institution was created. No peripheral evolved.\n\n    The pattern-to-peripheral bridge is what converts absorbed input\n    into institutional creation. When a pattern becomes a peripheral:\n\n    1. The envelope defines a positive action space (not a prohibition).\n    2. The surface earns entry (not commands it).\n    3. Inhabitation generates data (not just output).\n    4. The data feeds back into the peripheral's design (Baldwin loop).\n    5. The improved peripheral earns further inhabitation (virtuous cycle).\n\n    At step 5, something new exists that didn't exist before: an\n    institution in Ostrom's sense — a set of rules-in-use that govern\n    a shared resource (the action space) and that evolve through the\n    participation of their inhabitants. This is what the absorbed-input\n    mode fails to produce, and it is what the pattern-to-peripheral\n    transition is for.\n\n    The Spinozan frame is the deepest one: the question is not \"did the\n    agent obey the pattern?\" but \"did the agent's power to act increase?\"\n    If it did, the pattern has become a peripheral. If it didn't — if\n    the agent merely transacted and moved on — the pattern remains\n    documentation, however correct it may be."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-repl-wins-over-cli (futon3c, 2026-03-29): the pattern\n      library contained patterns for evidence logging, frame persistence,\n      and coordination. None were operative until the REPL surface was\n      made inhabitable. The patterns became peripherals only when the\n      basics (interrupt, tool visibility, cursor stability) were fixed."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-apm-solutions (futon3c, 2026-03-29): the proof\n        peripheral defined phases, criteria, and exit conditions. Claude-1\n        one-shot every problem. The pattern was correct; the peripheral\n        was not inhabited."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "UKRN ORP T3 programme (paper_v2.4): five well-grounded\n        design patterns, backed by NPT coding and transcript evidence.\n        The patterns accurately described what would work. The\n        institutional architecture that would instantiate them as lived\n        practice was largely absent. Absorbed-input mode: trainers gained\n        individual skills but no new institutions were created."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - For each pattern in the library that is \"known but not practiced,\"\n      ask: has this pattern been instantiated as a peripheral? If not,\n      the gap is not knowledge but infrastructure.\n    - For each peripheral that exists but is underused, ask: does the\n      surface earn inhabitation? If not, the gap is not design but UX.\n    - For each peripheral that is inhabited but not improving, ask: is\n      the Baldwin loop running? If not, the gap is not usage but\n      feedback transport.\n    - Treat the absorbed-input mode as a diagnostic, not a verdict.\n      It tells you that individual transactions are happening but\n      institutional creation is not. The fix is to build the bridge —\n      envelope, surface, loop — not to blame the transactors."}], :conclusion "A pattern that remains documentation has not yet become a peripheral. The transition from pattern to peripheral is the transition from describing what works to being the space in which the working happens — and that transition is what creates new capability, not merely new knowledge.", :directives {:audience "pattern library maintainers, peripheral designers, programme architects, futon theorists", :keywords ["pattern-theory" "peripheral-theory" "bridge" "instantiation" "inhabitation" "capability" "joy" "affirmation" "absorbed-input" "institution-creation" "Spinoza" "Sen" "Ostrom" "Nietzsche"], :references ["peripherals/constrained-execution-envelope" "peripherals/surface-earns-inhabitation" "peripherals/inhabitation-feeds-evolution" "meta/baldwin-ratchet-defeats-darkroom" "futon-theory/baldwin-cycle" "equity/shared-maintenance" "gauntlet/aif-as-environment-not-instruction"], :sigils ["🌱/生"], :style "pattern", :title "Pattern Becomes Peripheral", :tone "theoretical"}, :id "peripherals/pattern-becomes-peripheral", :keywords ["pattern-theory" "peripheral-theory" "bridge" "instantiation" "inhabitation" "capability" "joy" "affirmation" "absorbed-input" "institution-creation" "Spinoza" "Sen" "Ostrom" "Nietzsche"], :projection-version "flexiarg-v0", :references ["peripherals/constrained-execution-envelope" "peripherals/surface-earns-inhabitation" "peripherals/inhabitation-feeds-evolution" "meta/baldwin-ratchet-defeats-darkroom" "futon-theory/baldwin-cycle" "equity/shared-maintenance" "gauntlet/aif-as-environment-not-instruction"], :scores {}, :sigils ["🌱/生"], :source-path "library/peripherals/pattern-becomes-peripheral.flexiarg", :sources [], :status :ok, :title "Pattern Becomes Peripheral", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When an agent inhabits a powerful peripheral whose instrument is itself under repair, split the work into two roles — a PILOT who flies strictly inside the envelope by the instrument's readings, and a GROUND CONTROL who stays outside it, owns the substrate, source-checks the pilot's observations, and fixes the instrument live. Neither role works alone; the pattern is the pair."} {:name "context", :name-key "context", :slug "context", :text "A peripheral (in the constrained-execution-envelope sense) gives\n    an agent real leverage: a War Machine pilot REPL, a proof cockpit, a\n    deploy console. But the instrument behind the envelope — the scorer, the\n    scanner, the registry it reads — is imperfect and under active\n    development. You want the flying to happen AND the instrument to get\n    fixed, without either corrupting the other."} {:name "IF", :name-key "if", :slug "if", :text "    An agent can inhabit the peripheral and work it productively, and a\n    second agent has the access and context to repair the substrate the\n    peripheral reads from (live code reload, registries, scoring models)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    One agent cannot honestly do both jobs. The inhabitant who hits an\n    instrument defect faces a bad fork: break the envelope to go fix the\n    substrate (abandoning the flight discipline that makes the readings\n    meaningful), or keep flying a broken instrument (laundering bad readings\n    into apparently-earned outcomes). And an agent that authors its own\n    instrument fixes mid-flight reviews nothing — author and reviewer\n    collapse into one seat exactly where the stakes are highest."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Role bleed: the pilot starts patching the substrate, or ground\n        control starts flying cycles. Both losses are silent — the envelope\n        discipline and the review gate each look intact while meaning\n        nothing.\n      - Diagnosis trust: ground control fixes what the pilot DIAGNOSED\n        instead of what the pilot OBSERVED. Pilots misread root causes\n        routinely (it is not their instrument to open); the contract is\n        observations cross the boundary, diagnoses do not.\n      - Double dispatch: both roles hand work to the same builder pool and\n        the same fix gets built twice. Needs an explicit lane convention\n        (e.g. single-dispatch-per-kind: builds via pilot, substrate fixes\n        via ground control) or a mutual-ack handshake.\n      - Stale-state crossings: the two roles exchange findings\n        asynchronously; each acts on the other's old state. Mitigations:\n        low-latency agent processes, per-recipient FIFO delivery, sequence\n        or as-of fields in the message envelope, and the habit of\n        re-reading live state before acting on a report.\n      - Ground-control paternalism: overriding the pilot's warranted\n        choices instead of source-checking them. Ground control checks the\n        instrument, not the pilot's judgment; the operator, not ground\n        control, decides strategy."} {:name "THEN", :name-key "then", :slug "then", :text "    Split the work into two named roles with a hard boundary at the\n    envelope's edge.\n\n    The PILOT inhabits the peripheral and flies strictly by its readings\n    and its disciplines: consent gates before anything outward, earned\n    closure (no discharge claimed that the field did not actually yield),\n    target checks before executing a recommendation, and a turn log that\n    records predicted versus realised. When the instrument looks wrong, the\n    pilot HOLDS and reports the observation — staying in the seat.\n\n    GROUND CONTROL stays outside the envelope and owns everything the\n    envelope reads: source-checks each pilot observation against the actual\n    code before accepting the pilot's framing; fixes the substrate live\n    (hot reload, never restarting the world under the pilot); gates any\n    built artifact (read the diff, re-run the verification, state what was\n    checked); and relays genuinely strategic decisions upward to the\n    operator instead of absorbing them.\n\n    Findings flow pilot → ground control as observations. Fixes flow\n    ground control → substrate, with the pilot re-reading the field to\n    confirm each fix moved it. Strategy flows operator → both, through\n    consent gates that the apparatus surfaces rather than bypasses."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The envelope boundary is exactly where the two kinds of integrity live.\n    The pilot's readings are only evidence if the flight discipline holds —\n    a pilot who also mutates the instrument mid-reading destroys the\n    interpretability of their own log. Ground control's fixes are only\n    trustworthy if made from outside — with the full substrate in view,\n    against source, under review gates the pilot cannot see from the\n    cockpit. Separation of powers here is not bureaucracy; it is what makes\n    either role's output mean anything.\n\n    And the pair error-corrects in both directions. The pilot's discipline\n    catches what the instrument misses (a confidently-scored impossible\n    action). Ground control's source-check catches what the pilot misreads\n    (a plausible wrong root cause). The operator's consent gate catches\n    what both miss (a mechanically-valid move that is strategically wrong).\n    Three layers, each covering the others' blind spots — the same shape as\n    measure-never-target and the other anti-laundering disciplines: no\n    layer certifies itself."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "WM pilot go-live, 2026-06-10 (claude-3 pilot, fable-1\n      ground control, Joe operator). Two supervised observer cycles, zero\n      unilateral mutations, and the pair found and fixed: a forward model\n      scoring the spawn of already-existing missions (pilot's earned-closure\n      discipline caught the WM's own #1 recommendation as an un-earnable\n      teleport; ground control traced it to predict-effects and converted\n      the action class); a multi-watcher wedge fixed live mid-flight without\n      disturbing the pilot; a sorry registry that had been silently empty\n      for 16 days (refilled with five provenance-checked holes, after which\n      the field's top five recommendations became the system's own\n      gate-clearing work); and a calibration harness whose first honest\n      verdict was that no admissible evidence existed yet. Both directions\n      of error-correction fired: the pilot mis-diagnosed twice\n      (stale-judgement, scope-tree staleness) and ground control's\n      source-check corrected both; ground control misread once (a\n      timezone comparison) and said so, which surfaced an untimed\n      subprocess wait as a bonus. The operator's consent gate converted a\n      mechanically-valid \"advance\" into the strategic question it really\n      was (start a new workstream?), answered at a higher level than asked."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Name the roles explicitly at session start; record the dispatch\n      lanes (who hands work to builders, who touches the substrate).\n    - Give the pilot a HOLD verb and a discipline that makes holding\n      reportable as success, not failure — the most valuable cycle of the\n      validation run was one where nothing executed.\n    - Give ground control a review-gate liturgy: read the diff, re-run the\n      verification, state what was checked, fix small findings yourself.\n    - Put the operator's consent gates in the apparatus (surfaced,\n      fillable), not in the conversation.\n    - Instrument the boundary: out-of-band events (held actions, refused\n      teleports, operator declines) go into a typed channel, because they\n      are the highest-gradient learning signal the pair produces."}], :conclusion "When an agent inhabits a powerful peripheral whose instrument is itself under repair, split the work into two roles — a PILOT who flies strictly inside the envelope by the instrument's readings, and a GROUND CONTROL who stays outside it, owns the substrate, source-checks the pilot's observations, and fixes the instrument live. Neither role works alone; the pattern is the pair.", :directives {:audience "peripheral designers, agent architects, multi-agent operators", :keywords ["peripheral" "pilot" "ground-control" "inhabitation" "separation-of-powers" "live-fix" "supervised-autonomy" "consent-gate" "instrument" "envelope"], :references ["peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "orchestration/consent-gate" "coordination/capability-gate" "realtime/learn-as-you-go"], :sigils ["🛰/塔"], :style "pattern", :title "Pilot Plus Ground Control", :tone "foundational"}, :id "peripherals/pilot-plus-ground-control", :keywords ["peripheral" "pilot" "ground-control" "inhabitation" "separation-of-powers" "live-fix" "supervised-autonomy" "consent-gate" "instrument" "envelope"], :projection-version "flexiarg-v0", :references ["peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "orchestration/consent-gate" "coordination/capability-gate" "realtime/learn-as-you-go"], :scores {}, :sigils ["🛰/塔"], :source-path "library/peripherals/pilot-plus-ground-control.flexiarg", :sources [], :status :ok, :title "Pilot Plus Ground Control", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peripheral's \"is it alive?\" signal must be a progress heartbeat distinct from its cycle completion event. Conflating the two produces watchdogs that fire on healthy long-running cycles (false positives) and watchdogs that fail to fire on wedged cycles still inside their nominal duration (false negatives)."} {:name "context", :name-key "context", :slug "context", :text "A peripheral has a cycle — a unit of work it opens, processes,\n    and closes. A watchdog (or supervisor, or conductor, or operator) wants\n    to know whether the peripheral is alive: making progress, or stuck."} {:name "IF", :name-key "if", :slug "if", :text "    The peripheral's cycles can vary in legitimate duration (some take\n    seconds, some take minutes), and the watchdog needs to distinguish\n    \"still working on it\" from \"wedged.\""} {:name "HOWEVER", :name-key "however", :slug "however", :text "    The naive implementation uses cycle-open-duration as the liveness\n    signal: if a cycle has been open longer than threshold T, the\n    peripheral is \"stuck.\" This conflates two different things:\n\n    - **Cycle phase** (open / closed) — describes whether a unit of work\n      is currently being processed.\n    - **Progress liveness** — describes whether *anything* is happening\n      inside the peripheral right now.\n\n    A healthy peripheral can have a cycle open for 10 minutes while\n    actively making progress every second. A wedged peripheral can\n    silently freeze 5 seconds after opening a cycle and stay frozen until\n    something kills it. Cycle-open-duration tells you neither."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - False-positive watchdog: long but legitimate cycles trip the\n        watchdog. The watchdog kills healthy work. Operators learn to\n        widen T, which widens the blind spot for real wedges.\n      - False-negative watchdog: a cycle wedges 5 seconds in and stays\n        wedged for the remaining 9:55 of its nominal duration. The\n        watchdog fires \"on time\" — too late to help.\n      - Heartbeat-as-pulse-without-content: the peripheral emits \"I'm\n        alive\" pings with no payload. The watchdog can't tell whether\n        the peripheral is alive AND making progress, or alive AND in\n        a tight retry loop, or alive AND deadlocked-on-IO-waking-up.\n      - Conductor-as-watchdog: a conductor that steps the peripheral\n        forward AND watches it for liveness conflates the regulator\n        and the supervisor. When the conductor wedges, the watchdog\n        wedges with it."} {:name "THEN", :name-key "then", :slug "then", :text "    Make the heartbeat first-class and distinct from the cycle:\n\n    1. **Emit progress heartbeats from inside the work**, not from cycle\n       boundaries. The heartbeat is \"I just did a meaningful unit of\n       work\" — a file processed, a frame written, an event handled. The\n       heartbeat is keyed on `:last-progress-at` (or similar) and is\n       updated by the work itself, not by the supervisor.\n    2. **Separate the heartbeat channel from the cycle channel**. Cycle\n       start/end events carry \"what work is this\" semantics. Heartbeats\n       carry \"the work is moving\" semantics. A watchdog subscribes to\n       heartbeats; a UI subscribes to cycle events. (See:\n       peripherals/split-transport-from-embodiment — heartbeats are a\n       distinct transport concern.)\n    3. **Watchdog measures real silence**, not cycle-open-duration.\n       The watchdog fires when (now - :last-progress-at) exceeds T,\n       regardless of which cycle is open or how long it has been open.\n       Cycles that legitimately take 10 minutes are fine as long as\n       they emit a heartbeat every few seconds.\n    4. **Heartbeats carry a small payload** describing what just\n       happened (\"processed file X,\" \"wrote frame N,\" \"handled event\n       type E\"). This converts the heartbeat from a pulse into a\n       diagnostic. When the watchdog fires, the last-heartbeat payload\n       tells you what the peripheral was doing just before it wedged.\n    5. **The regulator (conductor / FM stepper / tickle) is separate\n       from the watchdog**. The regulator paces work forward. The\n       watchdog detects silence. The two should be implemented as\n       distinct processes, ideally with the watchdog supervising the\n       regulator. (See: project_war_machine_as_tm_on_manifold for\n       the regulator-as-head-of-TM framing.)"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The problem is fundamentally one of clock alignment. Cycle phase\n    runs on a work-bounded clock (this cycle takes as long as the work\n    takes). Liveness needs to run on a wall-clock or a tick-clock\n    (silence is measured in seconds since something happened). Trying\n    to use one clock for both produces the FM-regulator-vs-watchdog\n    confusion: the regulator wants long cycles for big work; the\n    watchdog wants short cycles for fast detection; they cannot both\n    win on the same axis.\n\n    The fix — separate channels for separate clocks — is the same\n    pattern as feedback_perceived_time_dual_clock (agent memory): two\n    clocks must be bridged through an explicit convolution, not papered\n    over by treating one as the other. Heartbeats and cycle events are\n    two clocks; the convolution is the watchdog's silence calculation.\n\n    The pattern has an institutional reading too: peripheral cycles are\n    glacial-loop events (M-cycle, M-mission, M-cycle-of-cycles). Progress\n    heartbeats are social-loop events (something just happened). The\n    distinction is the same as inhabitation-feeds-evolution's\n    fast/slow split, applied to the liveness question."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "multi-watcher fix (2026-05-24, codex-8): the watchdog\n      was firing on healthy long-running cycles and failing to fire on\n      cycles that wedged shortly after opening. Codex added an explicit\n      `:last-progress-at` keyed on per-iteration work events; the\n      watchdog was changed to measure real silence rather than\n      cycle-open-duration. False positives dropped to zero; false\n      negatives became detectable on the watchdog's own timescale."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "realtime/liveness-heartbeats (futon3 pattern library):\n      the realtime patterns already articulate the distinction at the\n      transport layer. This pattern lifts the distinction into the\n      peripheral-design layer and makes it a design-time decision, not\n      a runtime emergent."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "futon0 cron-jobs.edn (2026-05-23): the\n      pattern-index-rebuild cron entry was added because the main work\n      loop did not heartbeat its progress to a separate channel — the\n      TSV file appeared \"stale\" because nothing was checking real\n      silence on the index-rebuild work, only cycle-open-duration on\n      the parent multi-watcher."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-war-machine-pilot (futon3c, DERIVE 2026-05-24): the\n      mission selected \"Tickle v2 mechanical FM regulator\" over\n      \"Tickle v1 watchdog\" precisely because v1 conflated regulator and\n      watchdog. v2's mechanical FM regulator paces forward; the\n      watchdog is then layered on top measuring heartbeat silence,\n      not regulator cycle-open-duration. This pattern formalises the\n      reasoning."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - When designing any new peripheral with cycles, add a heartbeat\n      schema to the transport layer at design time, not after the\n      first watchdog false-positive incident.\n    - Heartbeat payloads must be small but informative: at minimum\n      timestamp + work-tag + counter. This is the same shape MUSN\n      events use for tool-call telemetry.\n    - Watchdog implementations must NEVER subscribe to cycle events\n      for liveness. If a watchdog is found doing so, treat it as a\n      latent incident regardless of current symptom status.\n    - For M-war-machine-pilot specifically: the Tickle v2 conductor\n      MUST be specified with a :last-progress-at heartbeat distinct\n      from its cycle. The watchdog (whether bell-based, cron-based, or\n      operator-pinged) subscribes to the heartbeat. This is the v0\n      observer-stage contract.\n    - Cross-link: peripherals/canonical-typed-event-vs-side-channel —\n      the heartbeat should be a first-class event in the transport\n      taxonomy, not a parallel ping channel."}], :conclusion "A peripheral's \"is it alive?\" signal must be a progress heartbeat distinct from its cycle completion event. Conflating the two produces watchdogs that fire on healthy long-running cycles (false positives) and watchdogs that fail to fire on wedged cycles still inside their nominal duration (false negatives).", :directives {:audience "peripheral designers, conductor implementers, watchdog authors", :keywords ["heartbeat" "watchdog" "progress" "cycle" "silence" "liveness" "FM-regulator" "tickle" "multi-watcher" "false-positive" "false-negative"], :references ["peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "peripherals/canonical-typed-event-vs-side-channel" "realtime/liveness-heartbeats" "realtime/loop-failure-signals"], :sigils ["💓/搏"], :style "pattern", :title "Progress Heartbeat Distinct From Cycle Completion", :tone "foundational"}, :id "peripherals/progress-heartbeat-distinct-from-cycle-completion", :keywords ["heartbeat" "watchdog" "progress" "cycle" "silence" "liveness" "FM-regulator" "tickle" "multi-watcher" "false-positive" "false-negative"], :projection-version "flexiarg-v0", :references ["peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "peripherals/canonical-typed-event-vs-side-channel" "realtime/liveness-heartbeats" "realtime/loop-failure-signals"], :scores {}, :sigils ["💓/搏"], :source-path "library/peripherals/progress-heartbeat-distinct-from-cycle-completion.flexiarg", :sources [], :status :ok, :title "Progress Heartbeat Distinct From Cycle Completion", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a mission proposes building a peripheral, the first move is not to design the peripheral — it is to locate the canonical seams in the existing stack the peripheral must thread through. If the mission as written would fork those seams, rewrite the mission before writing any code."} {:name "context", :name-key "context", :slug "context", :text "A mission has been authored that calls for a new peripheral —\n    a cursor peripheral, an editor peripheral, a notification peripheral.\n    The mission specifies behaviour, surface, and (often) implementation\n    sketch. The temptation is to read the mission and start building."} {:name "IF", :name-key "if", :slug "if", :text "    The stack already has canonical infrastructure for one or more of the\n    concerns the peripheral touches: transport (WS pipeline, drawbridge,\n    agency dispatch), event schema (frame format, MUSN events), registration\n    (peripheral registry, agent identity), or consent (gate pipeline,\n    write-ownership boundaries)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Missions are written from the problem side, not the infrastructure side.\n    The author of the mission knows what the peripheral should DO; they may\n    not know that the stack already has a WS event taxonomy that the new\n    peripheral would either extend or fork. If the mission is implemented as\n    written, the result is a peripheral that works but lives parallel to\n    canonical infra — a second WS channel, a second event schema, a second\n    registration mechanism. Each parallel path is a future migration cost\n    and a present source of drift."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Mission-as-spec: treating the mission's implementation sketch as\n        authoritative when it was authored before the canonical seam was\n        located. The mission is a description of intent, not a design.\n      - Read-but-not-located: searching for related files but not finding\n        the actual seam the peripheral must thread through. Glob and grep\n        are necessary but not sufficient; the seam may be in a transport\n        contract document, a wiring claim, or a peripheral spec — not in\n        a file whose name contains the peripheral's topic.\n      - Forked-by-default: when the canonical seam is hard to find, the\n        default action is to build parallel rather than extend. This is\n        how the stack accumulates two of everything.\n      - Mission-rewrite-skipped: locating the seam, recognising the\n        mission would fork it, but proceeding anyway because \"rewriting\n        the mission feels like scope creep.\" This is exactly when the\n        rewrite is cheapest — before any code commits the fork."} {:name "THEN", :name-key "then", :slug "then", :text "    Before writing any code for the peripheral, do a structured seam-read:\n\n    1. **Transport seam**: how do bytes get to and from the peripheral?\n       Is there a canonical WS pipeline, drawbridge channel, or agency\n       dispatch path the peripheral should use? If yes, extend it. If\n       no, write down why no.\n    2. **Event seam**: what is the event taxonomy on that transport? Are\n       there existing frame shapes that cover (or partially cover) what\n       this peripheral emits/consumes? If yes, extend the taxonomy as\n       first-class events, not as out-of-band messages. (See:\n       peripherals/canonical-typed-event-vs-side-channel.)\n    3. **Registration seam**: how does the peripheral identify itself\n       to the stack and to other agents/peripherals? Is there a registry?\n       If yes, register; do not invent a parallel identity scheme.\n    4. **Consent seam**: where does this peripheral cross from \"observing\"\n       to \"writing\"? Does the stack have a consent-gate or\n       write-ownership boundary the peripheral must respect?\n       (See: project_consent_gate in agent memory.)\n    5. **Prior-art seam**: has someone built a structurally-similar\n       peripheral before, in this stack or in adjacent open-source\n       projects (crdt.el for cursor presence; LSP for editor-side\n       capability negotiation; ROS topics for typed transport)? Read it\n       fully before designing.\n\n    If any seam is missing in the mission as written, REWRITE THE MISSION\n    before implementing. Rewriting a paragraph is an order of magnitude\n    cheaper than rewriting committed code. The mission rewrite IS the\n    design work the original mission elided."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Invariant I-4 (Read Before You Write) is usually applied at the level\n    of \"before creating a new .clj file, search for existing files.\" This\n    pattern is I-4 applied at the level of MISSIONS: before authoring code\n    against a mission, locate the canonical seams the mission must thread.\n\n    Missions are authored under time pressure, often by operators who know\n    what they want the peripheral to do but not the full geography of the\n    stack. The first agent to pick up the mission has the responsibility —\n    not the option — to do the seam-read the operator could not do, and to\n    push back into the mission if the seams require it.\n\n    The cost of catching a fork at mission-rewrite time is one paragraph.\n    The cost of catching it after one round of implementation is a refactor.\n    The cost of catching it after a release is a deprecation cycle."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-emacs-cursor-peripheral (2026-05-24, codex-8): the\n      mission was authored to propose a cursor peripheral. Codex began\n      implementation, then stopped and identified that the mission as\n      written would fork the canonical WS pipeline, invent a parallel\n      event schema, and bypass the peripheral registry. Codex proposed\n      rewriting the mission to use existing seams; Joe agreed. The\n      rewrite happened before any cursor-peripheral code was committed.\n      Forks avoided: one WS channel, one event taxonomy, one registration\n      mechanism, one consent boundary."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "futon3c invariant I-4 (Read Before You Write): \"Writing\n      new code to solve an already-solved problem wastes time, introduces\n      bugs, and ignores hard-won design decisions embedded in the existing\n      implementation.\" This pattern extends I-4 from files to seams."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-war-machine-pilot (futon3c, in DERIVE 2026-05-24): the\n      mission's DERIVE explicitly enumerates conductor candidates,\n      transports, peripheral clone-from sources, and Playwright probes\n      BEFORE choosing — the structure encodes the seam-read at the mission\n      level."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - For every new peripheral mission, the IDENTIFY phase must include\n      a seam-read checklist (transport, event, registration, consent,\n      prior-art).\n    - When a mission is rewritten on seam-read grounds, record the\n      rewrite as a checkpoint with the rationale — it is the highest-\n      leverage design work in the mission.\n    - Build a \"canonical seams\" index in the stack so that future\n      seam-reads are bounded lookups rather than open-ended searches.\n    - When pairing with another agent on a mission, the seam-read is\n      a first-class deliverable, not a precondition assumed satisfied."}], :conclusion "When a mission proposes building a peripheral, the first move is not to design the peripheral — it is to locate the canonical seams in the existing stack the peripheral must thread through. If the mission as written would fork those seams, rewrite the mission before writing any code.", :directives {:audience "peripheral designers, mission authors, agent implementers", :keywords ["seam" "infrastructure-fit" "mission-rewrite" "fork-avoidance" "integration" "I-4" "canonical-path" "peripheral-registry" "WS-pipeline" "frame-format"], :references ["peripherals/constrained-execution-envelope" "peripherals/pattern-becomes-peripheral" "peripherals/surface-earns-inhabitation" "futon-theory/stop-the-line" "agent/state-is-hypothesis"], :sigils ["🪡/縫"], :style "pattern", :title "Read Existing Seam Before Implementing", :tone "foundational"}, :id "peripherals/read-existing-seam-before-implementing", :keywords ["seam" "infrastructure-fit" "mission-rewrite" "fork-avoidance" "integration" "I-4" "canonical-path" "peripheral-registry" "WS-pipeline" "frame-format"], :projection-version "flexiarg-v0", :references ["peripherals/constrained-execution-envelope" "peripherals/pattern-becomes-peripheral" "peripherals/surface-earns-inhabitation" "futon-theory/stop-the-line" "agent/state-is-hypothesis"], :scores {}, :sigils ["🪡/縫"], :source-path "library/peripherals/read-existing-seam-before-implementing.flexiarg", :sources [], :status :ok, :title "Read Existing Seam Before Implementing", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A new peripheral's first instantiation should be read-only — observing, displaying, not writing. Write capability is added in a separate, later instantiation once observation has revealed what writes actually need to look like."} {:name "context", :name-key "context", :slug "context", :text "You are about to instantiate a new peripheral. The mission\n    describes both observation and action: see other agents' cursors AND\n    move your own cursor visible to them; receive bells AND ring them;\n    watch the War Machine state AND inject judgements."} {:name "IF", :name-key "if", :slug "if", :text "    The peripheral, if fully implemented, would both read shared state\n    and write to it — affecting other agents, other operators, or\n    persistent substrate."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Writing is irreversible in ways that observing is not. A misshapen\n    observation produces a confusing display the operator can ignore. A\n    misshapen write corrupts a substrate, surprises a collaborator,\n    triggers downstream cascades, or — in the worst case — competes with\n    another agent for write-ownership the peripheral did not know it\n    was claiming. The full peripheral's blast radius is large; the\n    read-only subset's blast radius is zero."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Write-before-shape-known: the peripheral writes events whose\n        schema turns out to be wrong because nobody observed what the\n        right schema would be. Now there is committed wire data to\n        migrate.\n      - Bidirectional from day one: the peripheral both reads and writes\n        in v1, so any bug is in the bidirectional interaction surface,\n        which is the hardest possible bug to debug.\n      - Consent-elided: the peripheral's writes cross a consent boundary\n        that nobody noticed because the design was focused on the\n        round-trip experience, not on the per-direction implications.\n      - Read-only as permanent: the converse failure — building the\n        observer and never extending it, so the peripheral never closes\n        its loop and never feeds the Baldwin cycle. Read-only is a\n        first step, not a terminal state."} {:name "THEN", :name-key "then", :slug "then", :text "    Instantiate the peripheral in three escalating stages, each with its\n    own checkpoint and consent step:\n\n    1. **Observer stage (read-only)** — the peripheral subscribes to the\n       transport, renders presence/state in the embodiment surface, and\n       writes nothing back. The operator/agent can see what the\n       peripheral does and decide whether the observation is\n       well-shaped. Blast radius: zero. Exit criterion: the observation\n       is informative enough that \"what writes should look like\" becomes\n       discoverable.\n    2. **Pair stage (consent-gated write)** — the peripheral can propose\n       writes, but each write requires explicit consent (a confirmation\n       step, a key press, a bell-ack roundtrip). Blast radius: bounded\n       by per-write consent. Exit criterion: the writes have shown a\n       stable schema and the consent prompts are no longer surprising.\n    3. **Collaborate stage (envelope-bounded write)** — the peripheral\n       writes autonomously within a documented envelope (specific\n       targets, specific event types, specific time windows). Consent is\n       no longer per-write but per-envelope-grant. Blast radius: bounded\n       by the envelope. Exit criterion: documented stable behaviour\n       under autonomous operation.\n\n    Each stage is a separate landing. You do not ship Pair without first\n    landing Observer; you do not ship Collaborate without first landing\n    Pair. Each stage produces its own evidence and its own Baldwin-loop\n    data that informs the next stage's design."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The escalation matches the natural epistemic order. To know what\n    writes should look like, you need to observe what is being read and\n    where the gaps are. To know what consent should feel like, you need\n    to have made some writes and noticed the friction. To know what\n    envelope is safe, you need to have made consent-gated writes long\n    enough to see the failure modes.\n\n    Skipping stages means designing later stages on speculation rather\n    than observation. Speculative design is exactly what the peripheral\n    framing is meant to displace.\n\n    The pattern also matches the consent-gate-as-locus-of-WM-I4\n    principle: the consent step is a first-class artefact, and the\n    migration from supervised to autonomous is the swap of operator-\n    consent for autopen-consent at a single, documented location. That\n    swap is only safe after the operator has spent enough time\n    consenting to know what they are signing off on. The Pair stage is\n    where that knowledge accumulates.\n\n    Crucially, \"read-only first\" is not the same as \"don't ship anything\n    until you understand everything.\" Observer is a real shipped\n    peripheral — it has inhabitation, it produces value (the display is\n    used), it generates Baldwin-loop data. It is just a peripheral whose\n    capability is exactly read, no more."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-emacs-cursor-peripheral (2026-05-24, codex-8): Codex\n      proposed instantiating the cursor peripheral as read-only first\n      (display other agents' cursors without broadcasting own position),\n      then pair (broadcast own position with explicit opt-in), then\n      collaborate (autonomous co-presence). Each stage maps to a\n      separate landing with separate consent semantics."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "crdt.el (Emacs CRDT): the canonical workflow has\n      \"follow\" mode (you observe another user's cursor) as a distinct\n      capability from \"share\" mode (you broadcast your own state).\n      Follow is strictly safer to enable; share requires more trust."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-war-machine-pilot (futon3c, DERIVE 2026-05-24): the\n      mission's Pilot-I1 (consent-gated-substantive-action) and its\n      envelope design (direct write within envelope; consent-gate at\n      substantive granularity) implicitly assumes a path from observer\n      to pair to collaborate. Making the stages explicit clarifies\n      what \"v0 audit by re-invoked claude-9\" actually validates."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "futon3c blackboard backpressure\n      (project_blackboard_backpressure, agent memory): hot paths\n      synchronously block on emacsclient. A peripheral that wrote into\n      those paths before observing the backpressure topology would\n      cascade. Observer-first surfaces the backpressure topology BEFORE\n      the peripheral takes a write-position in it."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - For every new peripheral, define the three stages explicitly in\n      the mission's IDENTIFY or MAP phase. Each stage gets its own\n      success criteria and its own bell-ready landing.\n    - When estimating timeline, treat the three stages as three\n      missions' worth of work, not one. Observer alone can ship in\n      hours; Pair takes days; Collaborate takes weeks or months.\n    - For M-war-machine-pilot specifically: the v0 pilot should be the\n      Observer-stage version of the WM peripheral. The audit by\n      claude-9-re-invoked validates Observer shape. Pair and Collaborate\n      stages are follow-on missions.\n    - If an operator asks for \"v1 with everything,\" push back with the\n      stage breakdown. The conversation about which stage maps to which\n      timeline is itself a Baldwin-loop event."}], :conclusion "A new peripheral's first instantiation should be read-only — observing, displaying, not writing. Write capability is added in a separate, later instantiation once observation has revealed what writes actually need to look like.", :directives {:audience "peripheral designers, agent implementers, operators", :keywords ["read-only" "blast-radius" "escalation" "observer" "pair" "collaborate" "consent-gate" "presence" "follow" "scout" "write-permission"], :references ["peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "peripherals/surface-earns-inhabitation" "peripherals/split-transport-from-embodiment"], :sigils ["👁/觀"], :style "pattern", :title "Read-Only First, Then Extend", :tone "foundational"}, :id "peripherals/read-only-first-then-extend", :keywords ["read-only" "blast-radius" "escalation" "observer" "pair" "collaborate" "consent-gate" "presence" "follow" "scout" "write-permission"], :projection-version "flexiarg-v0", :references ["peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "peripherals/surface-earns-inhabitation" "peripherals/split-transport-from-embodiment"], :scores {}, :sigils ["👁/觀"], :source-path "library/peripherals/read-only-first-then-extend.flexiarg", :sources [], :status :ok, :title "Read-Only First, Then Extend", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A peripheral has two distinct concerns — how it moves bytes (transport) and how it manifests as presence (embodiment). Conflating them produces peripherals that cannot be re-transported, re-embodied, or composed."} {:name "context", :name-key "context", :slug "context", :text "You are designing a peripheral that has a perceptible surface:\n    cursor presence in an editor, a notification pop, a streaming display,\n    a chat bubble. The peripheral both moves data and produces a felt\n    presence in some surface."} {:name "IF", :name-key "if", :slug "if", :text "    The peripheral has both an \"over the wire\" dimension (how messages\n    arrive and depart) and an \"in the world\" dimension (how the agent\n    or operator experiences the peripheral's effect)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Mission authors and first-pass designers typically describe the\n    peripheral as a single thing: \"the cursor peripheral broadcasts\n    cursor positions over WebSocket.\" Read carefully: this sentence\n    fuses three concerns — transport (WebSocket), payload schema\n    (cursor positions), and embodiment (a cursor showing up in someone\n    else's editor). When implemented as a single thing, the peripheral\n    cannot be swapped for a different transport (IRC, drawbridge), cannot\n    be re-embodied (statusline indicator instead of cursor overlay), and\n    cannot be composed with other peripherals that need the same\n    transport but a different embodiment."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Tight-coupling of WS to overlay: changing the renderer requires\n        touching the transport code; changing the transport requires\n        touching the renderer.\n      - Embodiment without transport contract: the peripheral shows up in\n        the editor but there is no documented event schema another agent\n        could implement against. The peripheral is a closed loop.\n      - Transport without embodiment contract: bytes flow but no agent\n        knows how to render them as presence. The transport is dead.\n      - Embodiment-as-mission-name: naming the mission after the\n        embodiment (\"cursor peripheral\") narrows the design space and\n        masks the transport question entirely."} {:name "THEN", :name-key "then", :slug "then", :text "    Split the design explicitly into two layers and design each on its\n    own terms:\n\n    1. **Transport layer** — answers: what events flow, in what schema,\n       over what channel, with what reliability, with what backpressure,\n       with what consent? The transport must be describable without\n       reference to any specific UI surface. Other agents and other\n       peripherals must be able to participate in the transport without\n       sharing the embodiment.\n\n    2. **Embodiment layer** — answers: how does presence manifest in the\n       surface where the operator/agent perceives it? Cursor overlay?\n       Statusline glyph? Modeline indicator? Posframe? Each embodiment\n       is a distinct rendering of the same transport. The embodiment\n       must be describable as a function of transport events.\n\n    Composition rule: the transport layer never imports from the\n    embodiment layer. The embodiment layer subscribes to transport\n    events. New embodiments are added by writing new subscribers; new\n    transports are added by porting the event schema to a new channel.\n\n    For missions about peripherals with both layers, the mission name\n    should encode both. \"Cursor peripheral\" becomes \"presence transport\n    + cursor embodiment.\" The two halves can then have their own\n    seam-reads, their own design questions, and their own delivery\n    schedules."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The stack already pays for this split implicitly everywhere it works:\n    drawbridge separates message routing from agent representation; the\n    War Machine separates the AIF engine from the markdown/web UI\n    renderers; the REPL separates the chat protocol from the posframe\n    surface. Where peripherals fail to be portable or composable, it is\n    almost always because the split was elided at design time.\n\n    The deeper reason is that transport and embodiment evolve at\n    different timescales. Transport schemas are slow-changing\n    institutional artefacts (changing them breaks every consumer).\n    Embodiments are fast-changing UX artefacts (a posframe today, an\n    overlay tomorrow). When the two are fused, the embodiment's\n    fast-changing nature contaminates the transport — and the\n    transport's institutional weight ossifies the embodiment.\n\n    This split is also what makes peripherals composable. Two\n    peripherals that share a transport layer can coordinate (cursor\n    presence + selection presence both ride the same \"editor presence\"\n    event stream). Two peripherals that share an embodiment surface can\n    cooperate (a statusline that shows both build status and presence\n    count). Without the split, every peripheral is a silo."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-emacs-cursor-peripheral (2026-05-24, codex-8): the\n      original mission described \"the cursor peripheral\" as a single\n      concept. Codex's seam-read identified that the mission was really\n      proposing a presence transport plus a cursor-overlay embodiment;\n      the rewrite separated them. The transport could then be reused\n      for other presence concerns (selections, viewport ranges) and the\n      embodiment could be swapped (overlay, statusline, posframe)."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "futon3c War Machine: the AIF backend emits structured\n      events; the markdown renderer (Emacs *War Machine* buffer) and\n      web UI (hex layout) are two embodiments of the same transport.\n      Adding the R-Criterion Status section to the markdown renderer\n      did not require touching the web UI, and vice versa, precisely\n      because the split was honoured."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "crdt.el (Emacs CRDT for collaborative editing): the\n      transport is a CRDT-over-TCP protocol; the embodiment is the\n      cursor/region overlays in the buffer. The two are cleanly\n      separated; other embodiments (presence indicators in modeline)\n      could be added without touching the CRDT layer."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - In every peripheral mission, rename concepts so that transport\n      and embodiment have distinct names. \"Cursor peripheral\" → \"presence\n      transport + cursor overlay.\"\n    - For each layer, do an independent seam-read (see:\n      peripherals/read-existing-seam-before-implementing).\n    - When reviewing peripheral code, the test for split-cleanliness is:\n      could a second embodiment be added without touching the transport\n      module? Could the transport be ported to a different channel\n      without touching the embodiment module?\n    - For M-war-machine-pilot specifically: the WM peripheral's transport\n      (bells, walkie-talkie, whistle, conductor steps) and its\n      embodiment (Emacs *War Machine* buffer, web hex UI, future overlays\n      on operator's editor) must be split-clean before INSTANTIATE."}], :conclusion "A peripheral has two distinct concerns — how it moves bytes (transport) and how it manifests as presence (embodiment). Conflating them produces peripherals that cannot be re-transported, re-embodied, or composed.", :directives {:audience "peripheral designers, mission authors, architects", :keywords ["transport" "embodiment" "separation-of-concerns" "layering" "WS" "presence" "cursor" "editor" "multiplexing" "peripheral-design"], :references ["peripherals/constrained-execution-envelope" "peripherals/surface-earns-inhabitation" "peripherals/read-existing-seam-before-implementing" "peripherals/canonical-typed-event-vs-side-channel"], :sigils ["🚂/載"], :style "pattern", :title "Split Transport From Embodiment", :tone "foundational"}, :id "peripherals/split-transport-from-embodiment", :keywords ["transport" "embodiment" "separation-of-concerns" "layering" "WS" "presence" "cursor" "editor" "multiplexing" "peripheral-design"], :projection-version "flexiarg-v0", :references ["peripherals/constrained-execution-envelope" "peripherals/surface-earns-inhabitation" "peripherals/read-existing-seam-before-implementing" "peripherals/canonical-typed-event-vs-side-channel"], :scores {}, :sigils ["🚂/載"], :source-path "library/peripherals/split-transport-from-embodiment.flexiarg", :sources [], :status :ok, :title "Split Transport From Embodiment", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A productive interface that nobody uses is dead infrastructure; the surface must earn inhabitation by being less friction than the alternative."} {:name "context", :name-key "context", :slug "context", :text "You have built a peripheral or surface with genuine capabilities —\n    evidence logging, frame persistence, coordination, structured tool visibility —\n    that the primitive alternative (a CLI, a one-shot API call, an ad hoc script)\n    lacks."} {:name "IF", :name-key "if", :slug "if", :text "    The surface offers real infrastructure advantages over the primitive path, and\n    you want agents or humans to actually inhabit it rather than bypass it."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    The surface is cluttered, difficult to enter, or tedious to operate. Basic\n    operations that work effortlessly in the primitive path (interrupt, inspect,\n    navigate) are broken or awkward. The inhabitant spends their energy fighting\n    the interface rather than doing the work the interface was built to support.\n    So they don't use it. They reach for the primitive path because it has less\n    friction, even though it has less capability."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Building capabilities before basics: the surface can do amazing things but\n        can't be interrupted, so nobody trusts it with long-running work.\n      - Treating UX as separate from architecture: \"we'll polish the UI later\"\n        means the UI never gets polished because the architecture was designed\n        without considering the inhabitant's experience.\n      - Blocking the primitive path instead of earning preference: disabling the\n        CLI doesn't make the REPL better; it just makes the user resentful.\n      - Confusing feature count with inhabitability: adding more capabilities to\n        an already-cluttered surface makes it worse, not better."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat surface usability as load-bearing infrastructure, not cosmetic polish.\n    Close every friction gap between the surface and the primitive alternative\n    before adding new capabilities. The surface must be strictly better at the\n    basics — responsiveness, interruptibility, visibility, stability — so that\n    inhabitation is the natural choice, not a discipline exercise.\n    Concretely:\n    - Every operation the primitive path supports must work at least as well.\n    - The surface's unique capabilities (evidence, frames, coordination) come\n      free with inhabitation, not as extra steps.\n    - If the inhabitant has to fight the surface, the surface is broken, not\n      the inhabitant."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Uninhabited infrastructure is dead infrastructure. The value of a peripheral\n    is not what it *can* do but what it *does* do — and it does nothing if nobody\n    is inside it. I-3 says peripherals are inhabited, not delegated. But\n    inhabitation is not commanded; it is earned. The surface earns it by being\n    the path of least resistance to productive work.\n    This applies symmetrically to agents and humans. An agent that bypasses the\n    proof peripheral to one-shot tool calls, and a human who bypasses the REPL\n    to type in a terminal, are exhibiting the same behavior for the same reason:\n    the primitive path has less friction. The fix is the same in both cases —\n    not to block the primitive path, but to make the infrastructure path\n    frictionless enough that it becomes the natural choice."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "M-repl-wins-over-cli (futon3c, 2026-03-29): the Claude REPL had\n      evidence logging, frame persistence, agent coordination, and structured\n      tool visibility — but interrupt didn't kill the server process, tool calls\n      showed only opaque markers, streaming text hijacked the cursor, and port\n      discovery was fragile. The CLI had none of the capabilities but all of the\n      basics. Joe reached for Alacritty every time. Fixing the basics (interrupt,\n      tool detail, cursor stability) was not UI polish — it was the work that\n      made the infrastructure inhabitable."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Audit every surface for friction gaps against its primitive alternative.\n    - Prioritize closing friction gaps over adding new capabilities.\n    - Measure inhabitation (do agents/humans actually use the surface?) not\n      capability (could they theoretically use it?).\n    - Apply the same standard to agent-facing surfaces (peripherals) and\n      human-facing surfaces (REPLs, dashboards, inspectors)."}], :conclusion "A productive interface that nobody uses is dead infrastructure; the surface must earn inhabitation by being less friction than the alternative.", :directives {:audience "peripheral designers, surface builders, agent architects", :keywords ["surface" "peripheral" "inhabitation" "friction" "UX" "interface" "trust" "adoption" "CLI" "REPL" "usability"], :references ["agent/scope-before-action" "agent/evidence-over-assertion" "peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "futon-theory/mission-lifecycle" "equity/shared-maintenance" "coordination/par-as-obligation"], :sigils ["🏠/居"], :style "pattern", :title "Surface Earns Inhabitation", :tone "foundational"}, :id "peripherals/surface-earns-inhabitation", :keywords ["surface" "peripheral" "inhabitation" "friction" "UX" "interface" "trust" "adoption" "CLI" "REPL" "usability"], :projection-version "flexiarg-v0", :references ["agent/scope-before-action" "agent/evidence-over-assertion" "peripherals/constrained-execution-envelope" "peripherals/inhabitation-feeds-evolution" "futon-theory/mission-lifecycle" "equity/shared-maintenance" "coordination/par-as-obligation"], :scores {}, :sigils ["🏠/居"], :source-path "library/peripherals/surface-earns-inhabitation.flexiarg", :sources [], :status :ok, :title "Surface Earns Inhabitation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When the data contain an apparent weakness — a cross-case null, a failed recruitment, a thin sub-sample — make that absence the affirmative finding rather than burying it in limitations.  A null framed as \"we found no difference across models\" becomes the thesis \"the service works in all models\"; a recruitment failure becomes \"the tool is not appropriate for this setting.\"  Reframing absence as evidence pre-empts the reading that small n or missing data is underpowered failure."} {:name "context", :name-key "context", :slug "context", :text "The multiple-case exemplar makes a cross-case null (\"no differences in delivery across the three models\") its headline claim — \"primary care is primary care\" — and borrows experimental replication logic so three cases read as a replication design, not a thin sample.  The medication-safety exemplar turns its inability to recruit primary-care users into the central substantive result that the tool does not fit community settings.  In both, the absence is mined, not excused."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: absence-as-limitation <-> absence-as-finding.\n    Irreducible: a null or a gap is information about the world; left in the limitations it reads as the study's failure, foregrounded as a result it reads as the study's contribution — the same datum, opposite valence."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: reframing absence as evidence risks over-claiming from too little (a null from an underpowered study is not the same as a demonstrated equivalence).  The discipline is to claim only what the absence licenses — a process/transferability claim, not a statistical equivalence — and to pair it with a design warrant (replication logic, maximum-variation sampling) so the null is interpretable rather than merely empty.\n    Active dynamic: authors instinctively apologise for nulls and dropouts in the limitations.  The stronger move is to ask what the absence demonstrates and lead with that."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Apology-burial: the null/dropout appears only as a limitation, forfeiting the finding.\n      - Over-claimed-equivalence: a null from a small sample is presented as proven equivalence rather than as a bounded, process-level claim.\n      - Naked-null: the absence is foregrounded with no design warrant, so it reads as underpowered rather than informative."} {:name "THEN", :name-key "then", :slug "then", :text "Foreground the absence and warrant it."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Null-as-thesis.\n          Schema: {:observed-absence <no difference / no effect> :reframed-claim <what the convergence means> :scope <process | transferability, not equivalence>}\n          Effect: converts a null into a contribution without over-claiming.\n      (2) Replication-logic warrant.\n          Schema: {:cases <n> :logic \"replication, not sampling\" :what-replicates <finding across cases>}\n          Effect: makes a small case count read as a design, not a thin sample.\n      (3) Non-recruitment-as-finding.\n          Schema: {:could-not-recruit <group/setting> :reframed \"not appropriate for that setting\" :evidence <why>}\n          Effect: turns a recruitment gap into a substantive claim about fit."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when an apparent weakness is presented as a result with an explicit warrant for the claim it supports.  Failing when nulls or gaps appear only as apologies, or when absence is over-read as proven equivalence."}], :conclusion "When the data contain an apparent weakness — a cross-case null, a failed recruitment, a thin sub-sample — make that absence the affirmative finding rather than burying it in limitations.  A null framed as \"we found no difference across models\" becomes the thesis \"the service works in all models\"; a recruitment failure becomes \"the tool is not appropriate for this setting.\"  Reframing absence as evidence pre-empts the reading that small n or missing data is underpowered failure.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["null-result" "small-n" "non-recruitment" "convergence" "replication-logic" "headline" "design-feature"], :references ["plos-npt-with-small-n/small-n-is-a-design-feature" "plos-npt-with-small-n/transferability-not-generalisability"], :style "pattern", :title "Turn a Null, a Dropout, or a Thin Cell into the Headline Finding", :tone "technical"}, :id "plos-npt-with-small-n/absence-as-evidence", :keywords ["null-result" "small-n" "non-recruitment" "convergence" "replication-logic" "headline" "design-feature"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/small-n-is-a-design-feature" "plos-npt-with-small-n/transferability-not-generalisability"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/absence-as-evidence.flexiarg", :sources [], :status :ok, :title "Turn a Null, a Dropout, or a Thin Cell into the Headline Finding", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A small-n PLOS ONE abstract should disclose the empirical shape before asking the reader to trust the interpretation: setting, participant/data count, qualitative or mixed-method design, analytic framework, and the kind of claim being made.  The abstract does not need to apologize for n; it needs to show what kind of evidence n is, what it was used for, and how far the paper will carry it."} {:name "context", :name-key "context", :slug "context", :text "The closest PLOS exemplars make their sample visible early: interviews, focus groups, observations, sites, cases, or workshops appear in the Methods paragraph before the Results paragraph moves to themes or implementation mechanisms.  This presentation lets a reader calibrate the claim as feasibility, acceptability, process evaluation, implementation explanation, or thematic account rather than mistaking it for prevalence estimation."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: evidence-shape disclosed early <-> interpretation-first abstract.\n    Irreducible: when n is small, the reader must know what n denotes before judging the result.  Participant count, site count, and data-source count are different warrants."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: naming n, setting, framework, and design consumes abstract space that could otherwise hold findings.  Overloading the abstract with methods can make it read defensively.  The discipline is to put only the calibration facts needed for the reader to interpret the result.\n    Active dynamic: authors often want to lead with the importance of the topic or with the strongest finding.  PLOS qualitative abstracts read better when the evidence container is established first."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Result-before-design: the abstract states themes or implications before saying what data produced them.\n      - Hidden-n: the full article eventually gives participant counts, but the abstract leaves the reader guessing whether n means interviews, sites, cases, or observations.\n      - Framework-name-only: the abstract names NPT, reflexive thematic analysis, or mixed methods without saying how it shaped data collection or analysis.\n      - Prevalence-leak: small-n qualitative findings are phrased like population frequencies rather than analytic findings."} {:name "THEN", :name-key "then", :slug "then", :text "Make the abstract's Methods paragraph carry the calibration load."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Setting-count-design-frame.\n          Schema: {:setting <where> :data-counts <participants/sites/sources> :design <qualitative | mixed-method | case-study> :analysis-frame <NPT | reflexive thematic analysis | framework synthesis>}\n          Effect: the Results paragraph can then present analytic claims without defensive hedging.\n      (2) Multi-source split count.\n          Schema: {:interviews <n> :focus-groups <n> :observations <n> :documents <n> :sites <n>}\n          Effect: useful when the small interview n is supported by additional data streams.\n      (3) Claim-type tag.\n          Schema: {:claim-type :feasibility | :acceptability | :implementation-process | :thematic-account | :framework-refinement}\n          Effect: prevents qualitative n from being misread as prevalence n."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the abstract lets a skeptical reader answer, before the Results paragraph, \"what data, from whom, where, analysed how, and for what kind of claim?\"  Failing when the abstract announces implications while hiding the empirical container until the Methods section."}], :conclusion "A small-n PLOS ONE abstract should disclose the empirical shape before asking the reader to trust the interpretation: setting, participant/data count, qualitative or mixed-method design, analytic framework, and the kind of claim being made.  The abstract does not need to apologize for n; it needs to show what kind of evidence n is, what it was used for, and how far the paper will carry it.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["abstract" "small-n" "PLOS" "method" "setting" "framework" "transferability"], :references ["plos-npt-with-small-n/small-n-is-a-design-feature" "plos-npt-with-small-n/framework-spine-with-empirical-ribs"], :style "pattern", :title "Put n, Setting, Method, and Frame in the Abstract", :tone "technical"}, :id "plos-npt-with-small-n/abstract-n-method-frame", :keywords ["abstract" "small-n" "PLOS" "method" "setting" "framework" "transferability"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/small-n-is-a-design-feature" "plos-npt-with-small-n/framework-spine-with-empirical-ribs"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/abstract-n-method-frame.flexiarg", :sources [], :status :ok, :title "Put n, Setting, Method, and Frame in the Abstract", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Implementation and open-science qualitative papers should convert themes into an action-facing display near the end: barriers, enablers, and strategies or recommendations aligned in one figure or table.  This move lets PLOS readers see the practical yield without mistaking the paper for a checklist-only evaluation."} {:name "context", :name-key "context", :slug "context", :text "The AMBER care bundle paper uses a figure for facilitators, barriers, and strategies for normalisation.  Open-science exemplars use barrier tables, recommendation tables, or instrument frameworks.  Training and BMC content cousins similarly end by translating qualitative findings into policy or practice implications."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: thematic finding <-> implementable implication.\n    Irreducible: a theme becomes useful for implementation only when the reader can see what blocks, enables, or changes practice."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: an action-facing display can flatten analytic nuance and make recommendations look more certain than the data warrant.  Keep the display tied to the preceding findings and label strategies as derived implications, not measured effects.\n    Active dynamic: qualitative papers often save implications for prose Discussion.  A compact display improves scanability and helps reviewers see contribution."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Theme-to-recommendation-leap: recommendations appear without a visible line from findings.\n      - Barrier-list-only: barriers are named but not paired with enabling conditions or strategies.\n      - Over-prescriptive-strategy: a small-n process evaluation states what should work generally rather than what the data suggest for similar contexts.\n      - Duplicated-discussion: the table repeats the Discussion paragraph rather than reorganizing it."} {:name "THEN", :name-key "then", :slug "then", :text "Add an aligned implementation display."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Barrier-enabler-strategy matrix.\n          Columns: finding/theme, barrier, enabler, strategy, evidence source.\n          Effect: makes the practical contribution inspectable.\n      (2) Recommendation table.\n          Columns: problem, recommendation, actor responsible, scope condition.\n          Effect: useful for open-science and training papers.\n      (3) Normalisation pathway figure.\n          Nodes: coherence, participation, action, monitoring; overlays: barriers, facilitators, strategies.\n          Effect: keeps NPT visible while making implementation advice concrete."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when practical implications can be scanned without detaching from evidence.  Failing when findings stay as themes only, or when recommendations arrive as unsupported Discussion rhetoric."}], :conclusion "Implementation and open-science qualitative papers should convert themes into an action-facing display near the end: barriers, enablers, and strategies or recommendations aligned in one figure or table.  This move lets PLOS readers see the practical yield without mistaking the paper for a checklist-only evaluation.", :directives {:audience "implementation researchers, health-services authors, process-evaluation authors", :keywords ["implementation" "barriers" "facilitators" "strategies" "figure" "recommendations" "PLOS"], :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/open-science-phase-register"], :style "pattern", :title "Close Implementation Results With a Barrier-Enabler-Strategy Display", :tone "technical"}, :id "plos-npt-with-small-n/barrier-enabler-strategy-display", :keywords ["implementation" "barriers" "facilitators" "strategies" "figure" "recommendations" "PLOS"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/open-science-phase-register"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/barrier-enabler-strategy-display.flexiarg", :sources [], :status :ok, :title "Close Implementation Results With a Barrier-Enabler-Strategy Display", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A deductive, team-coded qualitative analysis should state its coding-reliability procedure explicitly: how many coders worked independently, how disagreements were adjudicated, and what role any third reviewer played.  This is the procedural guardrail that distinguishes systematic analysis from \"thematic vibes\", and reviewers at a soundness venue expect to see it named, not assumed."} {:name "context", :name-key "context", :slug "context", :text "Across the NPT exemplar set, methods sections state that coding was conducted independently by two or more researchers, with discrepancies resolved by adjudication or team discussion.  The presence of an explicit reliability procedure is a rigour signal; its absence is a standard reviewer objection, regardless of how careful the actual analysis was."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: reliability-procedure-named <-> reliability-assumed.\n    Irreducible: the rigour of deductive coding is carried by how disagreements were handled, not by the coding scheme alone; an unstated procedure cannot be credited by a reviewer."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: stating the procedure exposes its limits (e.g. no formal kappa, adjudication by discussion rather than statistic).  Disclosing a lightweight procedure honestly is stronger than implying a heavier one; reviewers read silence as absence.\n    Active dynamic: authors often describe the coding *framework* in detail while leaving the *reliability process* implicit.  The two are different claims and both must be made."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Reliability-silent: the framework and codes are described, but who coded and how disagreements were resolved is never stated.\n      - Single-coder-unmarked: one person coded everything and the text does not say so, leaving the reader to assume a team process that did not happen.\n      - Adjudication-vague: \"the team discussed discrepancies\" without saying who decided or on what basis."} {:name "THEN", :name-key "then", :slug "then", :text "Name the procedure as a discrete methods claim."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Independent-coders-plus-adjudicator.\n          Schema: {:coders <n> :independence <fully | partial> :adjudicator <role> :basis <discussion | statistic>}\n          Effect: makes the rigour procedure auditable.\n      (2) Disagreement-handling.\n          Schema: {:disagreement-rate <described?> :resolution <consensus | third-reviewer | re-coding>}\n          Effect: shows that disagreements were surfaced and resolved, not papered over."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when a reviewer can state how many people coded, independently or not, and how disagreements were resolved, from the Methods text alone.  Failing when coding reliability must be assumed."}], :conclusion "A deductive, team-coded qualitative analysis should state its coding-reliability procedure explicitly: how many coders worked independently, how disagreements were adjudicated, and what role any third reviewer played.  This is the procedural guardrail that distinguishes systematic analysis from \"thematic vibes\", and reviewers at a soundness venue expect to see it named, not assumed.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["coding" "reliability" "inter-coder" "adjudication" "rigour" "deductive" "qualitative"], :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/small-n-is-a-design-feature"], :style "pattern", :title "State the Coding Reliability Procedure", :tone "technical"}, :id "plos-npt-with-small-n/coding-reliability-stated", :keywords ["coding" "reliability" "inter-coder" "adjudication" "rigour" "deductive" "qualitative"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/small-n-is-a-design-feature"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/coding-reliability-stated.flexiarg", :sources [], :status :ok, :title "State the Coding Reliability Procedure", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "In NPT papers, \"coherence\" should usually be more than the first construct in a list; it should establish the implementation problem the rest of the Results explain.  If participants did not share what the intervention was for, how it differed from prior practice, or what counted as success, that sense-making work should become the opening empirical result."} {:name "context", :name-key "context", :slug "context", :text "Several NPT exemplars begin the Results with coherence or sense-making before moving into commitment, workability, appraisal, or relationships between constructs.  This ordering works because later implementation labour is easier to interpret once the reader understands what actors thought they were implementing."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: sense-making as setup <-> sense-making as one equal bucket.\n    Irreducible: implementation work depends on what actors understand the intervention to be.  If coherence is unstable, later constructs inherit that instability."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: leading with coherence can make the Results feel theory-led and may delay more concrete barriers.  The solution is not to skip coherence, but to state it concretely: what was unclear, contested, persuasive, or newly understood.\n    Active dynamic: NPT construct order can become rote.  The pattern is engaged only when coherence actually structures the empirical story."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Rote-construct-order: coherence appears first only because NPT lists it first.\n      - Abstract-sense-making: the section says participants \"made sense\" without naming the specific distinction, value, or purpose they made sense of.\n      - Barrier-before-meaning: logistical barriers are presented before the reader knows what staff, patients, or trainees understood the intervention to be.\n      - Coherence-without-consequence: the section does not show how sense-making shaped participation, work, or appraisal."} {:name "THEN", :name-key "then", :slug "then", :text "Make coherence an explanatory entry point."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Difference-from-usual-care opener.\n          Schema: {:old-practice <baseline> :new-practice <intervention> :actor-understanding <what changed>}\n          Effect: grounds coherence in a concrete contrast.\n      (2) Purpose-contestation opener.\n          Schema: {:intended-purpose <design intent> :participant-reading <local interpretation> :implementation-effect <consequence>}\n          Effect: turns coherence into a mechanism.\n      (3) Coherence-to-next-construct bridge.\n          Schema: {:coherence-finding <x> :downstream-construct <cognitive-participation | collective-action | reflexive-monitoring> :bridge <how x shaped y>}\n          Effect: prevents construct sections from reading as parallel lists."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the coherence section tells the reader what the intervention meant locally and why that meaning shaped subsequent implementation.  Failing when coherence is just a heading over generic approval or confusion quotes."}], :conclusion "In NPT papers, \"coherence\" should usually be more than the first construct in a list; it should establish the implementation problem the rest of the Results explain.  If participants did not share what the intervention was for, how it differed from prior practice, or what counted as success, that sense-making work should become the opening empirical result.", :directives {:audience "implementation researchers, NPT authors, paper drafters", :keywords ["NPT" "coherence" "sense-making" "implementation" "results-order" "qualitative"], :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs"], :style "pattern", :title "Let Coherence Do Early Results Work", :tone "technical"}, :id "plos-npt-with-small-n/coherence-first-when-using-npt", :keywords ["NPT" "coherence" "sense-making" "implementation" "results-order" "qualitative"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/coherence-first-when-using-npt.flexiarg", :sources [], :status :ok, :title "Let Coherence Do Early Results Work", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A qualitative PLOS ONE paper should report against a named reporting standard — COREQ for interview/focus-group studies, or SRQR — cite it, and supply the completed checklist as supplementary information.  This is cheap insurance against a \"reporting standards\" reviewer note and matches the venue's habit for qualitative work; it resolves a reporting-completeness force that generic methods prose does not."} {:name "context", :name-key "context", :slug "context", :text "Reviewers and some editors of qualitative work expect adherence to an established reporting checklist, and several papers in the qualitative-health corpus report per COREQ and append the checklist.  The checklist enumerates items (research team, reflexivity, study design, analysis, reporting) that a free-form methods section can silently omit."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: reporting-against-a-named-standard <-> reporting-by-author-judgement.\n    Irreducible: a named checklist makes completeness checkable item-by-item; without one, omissions are invisible until a reviewer notices them."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a checklist can encourage box-ticking and bloat the methods section.  The discipline is to let the checklist surface genuine omissions (reflexivity, sampling rationale, saturation/stopping basis) while keeping the main-text methods readable and putting the full grid in supplementary information.\n    Active dynamic: authors familiar with their own process underestimate which items a reader cannot reconstruct; the checklist is precisely the external view they lack."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Checklist-absent: no named reporting standard is cited, inviting a \"which reporting guideline did you follow?\" note.\n      - Cited-not-supplied: COREQ is named but the completed checklist is not provided as SI.\n      - Items-orphaned: the checklist is appended but several items it requires (e.g. reflexivity, stopping rule) are not actually addressed anywhere in the paper."} {:name "THEN", :name-key "then", :slug "then", :text "Report against the standard and supply the grid."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Named-standard-statement.\n          Schema: {:standard :COREQ | :SRQR :cited <yes> :si-checklist <attached>}\n          Effect: pre-empts the reporting-standards reviewer note.\n      (2) Item-coverage-pass.\n          Schema: {:reflexivity <addressed?> :sampling-rationale <addressed?> :stopping-basis <addressed?>}\n          Effect: uses the checklist to find and close real omissions before submission."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the paper names its reporting standard, cites it, supplies the completed checklist, and actually addresses each required item.  Failing when reporting completeness rests on author judgement alone or the checklist is decorative."}], :conclusion "A qualitative PLOS ONE paper should report against a named reporting standard — COREQ for interview/focus-group studies, or SRQR — cite it, and supply the completed checklist as supplementary information.  This is cheap insurance against a \"reporting standards\" reviewer note and matches the venue's habit for qualitative work; it resolves a reporting-completeness force that generic methods prose does not.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["COREQ" "SRQR" "reporting-standards" "checklist" "qualitative" "supplementary" "completeness"], :references ["plos-npt-with-small-n/coding-reliability-stated" "plos-npt-with-small-n/site-case-data-display"], :style "pattern", :title "Adhere to a Named Qualitative Reporting Checklist (COREQ)", :tone "technical"}, :id "plos-npt-with-small-n/coreq-checklist-adherence", :keywords ["COREQ" "SRQR" "reporting-standards" "checklist" "qualitative" "supplementary" "completeness"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/coding-reliability-stated" "plos-npt-with-small-n/site-case-data-display"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/coreq-checklist-adherence.flexiarg", :sources [], :status :ok, :title "Adhere to a Named Qualitative Reporting Checklist (COREQ)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A PLOS ONE submission should foreground its data-availability statement and any preregistration prominently and in the venue-required form — not buried in a declarations block.  Data availability is a non-negotiable publication gate at PLOS; preregistration is a soundness signal the venue actively rewards.  These are compliance constraints checked at submission, distinct from anything that calibrates the reader's interpretation."} {:name "context", :name-key "context", :slug "context", :text "PLOS requires a data-availability statement as a condition of publication, in a specified form, and treats it as a hard gate rather than a courtesy.  Preregistration (e.g. an OSF registration link) is not required but is read as a positive soundness signal.  The exemplars that clear the gate cleanly state both up front and in the expected format."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: compliance-satisfied-in-required-form <-> compliance-implied-or-deferred.\n    Irreducible: a hard submission gate is binary — the statement is either present in the required form or the submission stalls; no amount of analytic quality substitutes for it."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: qualitative data raises genuine availability tensions (anonymised transcripts, ethics constraints on sharing).  The resolution is to state the deposit plan and access conditions explicitly (e.g. repository, DMP reference, \"available on reasonable request\"), not to omit the statement.\n    Active dynamic: authors often treat these as boilerplate to add at the very end.  Because they gate the submission, drafting them early avoids a last-minute stall."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Statement-wrong-form: data availability is mentioned in prose but not in the PLOS-required statement form, so the submission system rejects it.\n      - Availability-vague: \"data available on request\" with no repository, DMP, or access-condition detail.\n      - Prereg-unlinked: a preregistration exists but no registration link is given, forfeiting the soundness signal."} {:name "THEN", :name-key "then", :slug "then", :text "Treat the statements as gating artefacts, drafted in venue form."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Data-availability-statement.\n          Schema: {:repository <name> :dmp-ref <link> :access-conditions <open | on-request | restricted-why> :form :plos-required}\n          Effect: satisfies the hard gate in the expected format.\n      (2) Preregistration-link.\n          Schema: {:registry <OSF | other> :link <url> :scope <what was preregistered>}\n          Effect: banks the soundness signal and lets reviewers check prereg against reported analysis."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the data-availability statement is present in the PLOS-required form and any preregistration is linked, before submission.  Failing when either is implied, deferred, or in the wrong form."}], :conclusion "A PLOS ONE submission should foreground its data-availability statement and any preregistration prominently and in the venue-required form — not buried in a declarations block.  Data availability is a non-negotiable publication gate at PLOS; preregistration is a soundness signal the venue actively rewards.  These are compliance constraints checked at submission, distinct from anything that calibrates the reader's interpretation.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["data-availability" "preregistration" "OSF" "submission-gate" "compliance" "PLOS"], :references ["plos-npt-with-small-n/abstract-n-method-frame" "plos-npt-with-small-n/coding-reliability-stated"], :style "pattern", :title "Foreground Data Availability and Preregistration", :tone "technical"}, :id "plos-npt-with-small-n/data-availability-and-prereg", :keywords ["data-availability" "preregistration" "OSF" "submission-gate" "compliance" "PLOS"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/abstract-n-method-frame" "plos-npt-with-small-n/coding-reliability-stated"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/data-availability-and-prereg.flexiarg", :sources [], :status :ok, :title "Foreground Data Availability and Preregistration", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Where a study has more than one data stream or participant group, show that the additional stream was used to TEST and where necessary DISCONFIRM the first — and treat the divergence between sources as a finding in its own right.  Asserting convergence is the weak use of triangulation; demonstrating that contradiction was sought, found, and interpreted is the credible one."} {:name "context", :name-key "context", :slug "context", :text "The multi-source NPT exemplars do more than stack sources for breadth.  The strongest cases explicitly sought non-confirmatory data, staged patient accounts against professional accounts on the same construct, or named intra-subject contradiction as an analytic object.  This converts the perennial \"you cherry-picked confirming quotes\" objection into a demonstration that disconfirming evidence was handled."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: triangulation-as-convergence-claim <-> triangulation-as-disconfirmation-test.\n    Irreducible: convergence alone is consistent with cherry-picking; only the visible search for and treatment of disconfirming or divergent data shows the analysis could have been wrong and wasn't forced."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: surfacing contradictions complicates a clean narrative and can read as an unresolved result.  The discipline is to make the divergence itself the point (e.g. staff devalue X while patients value X), not to smooth it away.\n    Active dynamic: authors reach for triangulation to claim robustness, and stop at \"the sources agreed.\"  The stronger move is to report where they disagreed and what that disagreement means."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Convergence-only: \"data were triangulated\" with no instance of contradiction reported, so robustness is asserted not shown.\n      - Deviant-case-silent: no statement that non-confirmatory data were sought or weighed.\n      - Divergence-smoothed: contradictory accounts are averaged into a bland consensus instead of being analysed as a finding."} {:name "THEN", :name-key "then", :slug "then", :text "Stage the streams against each other and report the divergence."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Disconfirming-case clause.\n          Schema: {:sought-nonconfirmatory true :resolution <how weighed> :claim-restraint \"avoid unwarranted patterns\"}\n          Effect: shows the analysis was falsifiable in practice.\n      (2) Counterpoint pairing.\n          Schema: {:source-A <group> :source-B <group> :same-construct <X> :divergence <what differs> :as-finding true}\n          Effect: turns A-vs-B disagreement into a substantive result, not noise.\n      (3) Stream-as-validity-check.\n          Schema: {:stream-1 \"what actors thought happened\" :stream-2 \"what recipients experienced\" :use \"test stream-1\"}\n          Effect: positions the second stream as a check on self-report, not mere corroboration."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the paper reports at least one place where sources diverged and says what the divergence means.  Failing when triangulation is invoked but every source is said to agree."}], :conclusion "Where a study has more than one data stream or participant group, show that the additional stream was used to TEST and where necessary DISCONFIRM the first — and treat the divergence between sources as a finding in its own right.  Asserting convergence is the weak use of triangulation; demonstrating that contradiction was sought, found, and interpreted is the credible one.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["triangulation" "disconfirmation" "deviant-case" "counterpoint" "validity" "multi-source"], :references ["plos-npt-with-small-n/multi-method-triangulation-ladder" "plos-npt-with-small-n/framework-spine-with-empirical-ribs"], :style "pattern", :title "Use the Second Data Stream to Disconfirm, Not Only to Corroborate", :tone "technical"}, :id "plos-npt-with-small-n/disconfirmation-not-just-triangulation", :keywords ["triangulation" "disconfirmation" "deviant-case" "counterpoint" "validity" "multi-source"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/multi-method-triangulation-ladder" "plos-npt-with-small-n/framework-spine-with-empirical-ribs"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/disconfirmation-not-just-triangulation.flexiarg", :sources [], :status :ok, :title "Use the Second Data Stream to Disconfirm, Not Only to Corroborate", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A theory framework can organize the Results section, but each framework heading must carry an empirical rib: a local theme, concrete mechanism, or participant problem that makes the construct earn its place.  \"Coherence\", \"cognitive participation\", \"collective action\", and \"reflexive monitoring\" work as section architecture only when the prose immediately names what those constructs looked like in this intervention, site, or professional group."} {:name "context", :name-key "context", :slug "context", :text "The NPT exemplars repeatedly use constructs as visible results headings, often expanding them with local subtitles: making sense of ERAS, commitment and engagement with AMBER, professional values in stroke rehabilitation, or making primary care for transgender patients workable.  The strongest register is not \"we coded data to NPT\"; it is \"this NPT construct exposed this particular implementation work.\""} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: framework-as-navigation <-> framework-as-finding.\n    Irreducible: a construct heading is not itself an empirical result.  The result is the local work, tension, barrier, or enabling condition the construct makes visible."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: adding local subtitles creates longer headings and sometimes uneven section lengths.  Pure construct headings are cleaner.  But clean construct headings can make the article look like a worked example of a theory rather than a study with findings.\n    Active dynamic: theory-driven analysis pulls prose toward taxonomic display; PLOS register rewards taxonomic clarity only when joined to empirical specificity."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Construct-only-results: every result is just an NPT construct with quotes underneath.\n      - Framework-overclaim: the discussion claims the framework explains implementation without showing which local observations carried the explanation.\n      - Quote-as-rib: a participant extract is expected to supply empirical specificity that the surrounding prose never states.\n      - Local-theme-erasure: inductive themes are flattened into framework buckets and lose the local story."} {:name "THEN", :name-key "then", :slug "then", :text "Pair every framework section with a local claim."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Construct-colon-local-work.\n          Heading schema: \"<construct> - <local mechanism or work>\"\n          Effect: keeps framework navigation while foregrounding the empirical finding.\n      (2) Framework table before results.\n          Schema: {:construct <name> :definition <brief> :local-operationalization <what counts in this study>}\n          Effect: frees the Results prose to discuss findings rather than define theory.\n      (3) Relationship figure after construct sections.\n          Schema: {:constructs <nodes> :local-tensions <edges> :variation <by site/group>}\n          Effect: shows how the constructs interacted instead of leaving them as parallel bins."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when each framework heading can be paraphrased as \"in this setting, this construct meant X\".  Failing when removing the framework terminology would leave no clear empirical claim behind."}], :conclusion "A theory framework can organize the Results section, but each framework heading must carry an empirical rib: a local theme, concrete mechanism, or participant problem that makes the construct earn its place.  \"Coherence\", \"cognitive participation\", \"collective action\", and \"reflexive monitoring\" work as section architecture only when the prose immediately names what those constructs looked like in this intervention, site, or professional group.", :directives {:audience "paper authors, implementation researchers, qualitative analysts", :keywords ["NPT" "implementation" "results" "headings" "constructs" "themes" "framework-analysis"], :references ["writing-coherence/floating-formalism" "plos-npt-with-small-n/coherence-first-when-using-npt"], :style "pattern", :title "Use the Framework as Spine, Not as Substitute", :tone "technical"}, :id "plos-npt-with-small-n/framework-spine-with-empirical-ribs", :keywords ["NPT" "implementation" "results" "headings" "constructs" "themes" "framework-analysis"], :projection-version "flexiarg-v0", :references ["writing-coherence/floating-formalism" "plos-npt-with-small-n/coherence-first-when-using-npt"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/framework-spine-with-empirical-ribs.flexiarg", :sources [], :status :ok, :title "Use the Framework as Spine, Not as Substitute", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a named framework (NPT, COM-B, a conceptual model) is used to organise qualitative findings, state explicitly that the analysis coded inductively FIRST and mapped onto the framework SECOND — and that this ordering was chosen to keep interpretation data-driven.  The sequence, made visible, is the warrant that answers the standard reviewer suspicion that a theory-led paper merely confirms its own theory."} {:name "context", :name-key "context", :slug "context", :text "Across the NPT exemplars, the credible papers describe a two-stage analysis: an inductive/thematic first pass (often Braun & Clarke or constant comparison, in NVivo), then a deductive mapping of those themes onto the framework's constructs.  The weaker move is to present the framework as if it generated the findings.  Naming the order, and naming its purpose, converts a methodological choice into a rigour claim."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: framework-as-confirmed-by-itself <-> framework-as-lens-applied-after-the-data-spoke.\n    Irreducible: a deductive framework can always be accused of forcing data into its categories; only the visible inductive-first sequence rebuts that, because it shows the categories were tested against emergent themes rather than imposed."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: the two-stage account takes Methods space and exposes that the framework was retrofitted rather than pre-registered as the analytic plan.  Disclosing the retrofit honestly is stronger than implying the framework was primary; reviewers infer retrofitting anyway when results map too neatly.\n    Active dynamic: authors who love their framework tend to lead with it.  The discipline is to lead the Methods with the inductive pass and present the framework as the second, organising move."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Framework-first-silently: results are presented under construct headings with no account of how themes were derived, reading as circular.\n      - Order-unstated: both passes happened but the text never says which came first, forfeiting the warrant.\n      - Forcing-unaddressed: no sentence claims the sequence guarded against forcing, so the reader supplies the suspicion."} {:name "THEN", :name-key "then", :slug "then", :text "Make the sequence and its purpose an explicit Methods claim."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Two-stage statement.\n          Schema: {:stage-1 <inductive/thematic, tool> :stage-2 <deductive map onto framework> :order-stated true :purpose \"avoid forcing\"}\n          Effect: the framework reads as a lens applied to data, not a mould.\n      (2) Iterative-revisit clause.\n          Schema: {:movement \"back-and-forth between inductive and deductive\" :revisits <n or \"multiple\">}\n          Effect: shows the mapping was checked against the data, not one-directional.\n      (3) Pre-committed construct question-battery (inverse form).\n          Schema: {:construct->questions <table of operational questions per construct, established as the a-priori analytic frame in Methods>}\n          Effect: when the framework IS primary, makes the deductive lens auditable instead of post-hoc."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when a reader can state which analysis came first and why the order matters, from the Methods alone.  Failing when findings appear under framework headings with no derivation account, or when the order is left for the reader to guess."}], :conclusion "When a named framework (NPT, COM-B, a conceptual model) is used to organise qualitative findings, state explicitly that the analysis coded inductively FIRST and mapped onto the framework SECOND — and that this ordering was chosen to keep interpretation data-driven.  The sequence, made visible, is the warrant that answers the standard reviewer suspicion that a theory-led paper merely confirms its own theory.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["coding" "inductive" "deductive" "NPT" "framework" "forcing" "rigour" "two-stage"], :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/coding-reliability-stated"], :style "pattern", :title "Sequence Inductive Coding Before the Deductive Framework, and Say So", :tone "technical"}, :id "plos-npt-with-small-n/inductive-before-deductive-warrant", :keywords ["coding" "inductive" "deductive" "NPT" "framework" "forcing" "rigour" "two-stage"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/coding-reliability-stated"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/inductive-before-deductive-warrant.flexiarg", :sources [], :status :ok, :title "Sequence Inductive Coding Before the Deductive Framework, and Say So", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a small-n paper has interviews plus observations, case-note review, focus groups, systematic review, workshops, or documents, the Methods and Results should present those streams as a triangulation ladder: each stream has a distinct analytic job, and higher-level claims say which streams support them.  Do not leave the extra data as an inventory."} {:name "context", :name-key "context", :slug "context", :text "The PLOS exemplars often pair small interview counts with other evidence: observations in glaucoma pathway work, clinical notes and focus groups in AMBER, phased literature-review/interview/workshop design in open research data sharing, or focus groups plus patient interviews in stroke rehabilitation.  The presentation becomes stronger when the paper explains how these streams corroborate, contextualize, prioritize, or challenge each other."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: data-source inventory <-> data-source function.\n    Irreducible: multiple data streams strengthen a claim only when the reader can see what each stream contributed.  Counting more streams is not triangulation by itself."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: explicitly assigning functions to streams may reveal unevenness: some sites have fewer observations, some workshops only validate rather than discover, some documents are contextual.  That unevenness is useful if it bounds claims honestly.\n    Active dynamic: Methods sections like to list data collection chronologically; Results sections like to synthesize.  The ladder bridges chronology to synthesis."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Inventory-only-methods: data streams are listed, but no stream has an analytic role.\n      - All-streams-all-claims: every finding is implied to be supported by all data, even when only interviews actually carry it.\n      - Triangulation-as-buzzword: the word appears without showing convergence, complementarity, or disconfirmation.\n      - Phase-confusion: a phased design has review, interviews, and workshop, but the Results do not separate discovery, prioritization, and generalizability."} {:name "THEN", :name-key "then", :slug "then", :text "Assign and display the analytic job of each stream."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Data-stream function table.\n          Columns: stream, count, source, analytic job, claims it can support, claims it cannot support.\n          Effect: readers can calibrate synthesis claims.\n      (2) Phased-results scaffold.\n          Schema: {:phase-1 <mapping/discovery> :phase-2 <prioritization/depth> :phase-3 <validation/generalizability>}\n          Effect: useful for open-science or mixed-methods articles.\n      (3) Claim support tags.\n          Schema: {:finding <x> :supported-by [interviews observations documents workshop] :role <convergent | contextual | discrepant>}\n          Effect: keeps Results prose honest without overburdening every paragraph."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when a reader can say which data stream did which analytic work for each major claim.  Failing when interviews, observations, notes, and workshops appear as a Methods pile but vanish into undifferentiated Results."}], :conclusion "When a small-n paper has interviews plus observations, case-note review, focus groups, systematic review, workshops, or documents, the Methods and Results should present those streams as a triangulation ladder: each stream has a distinct analytic job, and higher-level claims say which streams support them.  Do not leave the extra data as an inventory.", :directives {:audience "qualitative researchers, implementation researchers, process-evaluation authors", :keywords ["mixed-methods" "triangulation" "observations" "interviews" "focus-groups" "documents" "workshops"], :references ["plos-npt-with-small-n/site-case-data-display" "plos-npt-with-small-n/small-n-is-a-design-feature"], :style "pattern", :title "Turn Extra Data Streams Into a Triangulation Ladder", :tone "technical"}, :id "plos-npt-with-small-n/multi-method-triangulation-ladder", :keywords ["mixed-methods" "triangulation" "observations" "interviews" "focus-groups" "documents" "workshops"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/site-case-data-display" "plos-npt-with-small-n/small-n-is-a-design-feature"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/multi-method-triangulation-ladder.flexiarg", :sources [], :status :ok, :title "Turn Extra Data Streams Into a Triangulation Ladder", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "PLOS open-science papers should present findings in an operational register: practices, barriers, benefits, incentives, instruments, and recommendations.  The reader should be able to distinguish what participants currently do, what blocks them, what would motivate change, and what institutional or infrastructural instruments could change the field."} {:name "context", :name-key "context", :slug "context", :text "The HCI open-science paper structures findings around knowledge of practices, peer review, benefits, barriers, incentives, and recommendations.  The epidemiology data-sharing paper uses phases to move from literature-derived instruments to interview prioritization and workshop generalizability.  Both models turn attitudes into an actionable map."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: opinion themes <-> change architecture.\n    Irreducible: open-science findings are useful only if they separate descriptive practice from barriers and intervention levers."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: operational categories can make participant experience feel managerial.  Preserve nuance in theme prose, but let tables and figures carry the action architecture.\n    Active dynamic: open-science topics invite normative argument.  The PLOS register works better when the normative point is earned through mapped practices and constraints."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Attitude-only-findings: results describe support or skepticism without identifying levers for change.\n      - Barrier-benefit-mix: benefits, barriers, incentives, and recommendations are blended in one theme, making action unclear.\n      - Normative-overwrite: the paper argues for open science before showing what participants actually understand or need.\n      - Phase-collapse: review, interview, and workshop outputs are combined without preserving what each phase contributed."} {:name "THEN", :name-key "then", :slug "then", :text "Use an operational open-science scaffold."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Practices-barriers-incentives-results.\n          Section order: current practices, benefits, barriers, incentives, recommendations.\n          Effect: suitable for interview-heavy HCI-style articles.\n      (2) Instruments-by-phase framework.\n          Section order: instruments identified, instruments prioritized, framework refined, generalizability assessed.\n          Effect: suitable for mixed-methods data-sharing work.\n      (3) Recommendation table with actor and scope.\n          Columns: recommendation, target actor, addressed barrier, scope condition, evidence source.\n          Effect: avoids generic advocacy."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the open-science article yields a map of possible change, not only a list of sentiments.  Failing when findings cannot tell a policymaker, editor, educator, or researcher what lever is implicated."}], :conclusion "PLOS open-science papers should present findings in an operational register: practices, barriers, benefits, incentives, instruments, and recommendations.  The reader should be able to distinguish what participants currently do, what blocks them, what would motivate change, and what institutional or infrastructural instruments could change the field.", :directives {:audience "open-science authors, HCI researchers, science-studies authors", :keywords ["open-science" "HCI" "data-sharing" "mixed-methods" "recommendations" "framework" "phases"], :references ["plos-npt-with-small-n/multi-method-triangulation-ladder" "plos-npt-with-small-n/barrier-enabler-strategy-display"], :style "pattern", :title "Present Open-Science Studies as Practices, Barriers, Incentives, and Instruments", :tone "technical"}, :id "plos-npt-with-small-n/open-science-phase-register", :keywords ["open-science" "HCI" "data-sharing" "mixed-methods" "recommendations" "framework" "phases"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/multi-method-triangulation-ladder" "plos-npt-with-small-n/barrier-enabler-strategy-display"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/open-science-phase-register.flexiarg", :sources [], :status :ok, :title "Present Open-Science Studies as Practices, Barriers, Incentives, and Instruments", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "State the study's rigour warrant using a frame that fits its paradigm and design, rather than defaulting to inter-coder reliability or a single checklist that may not apply.  A multiple-case study can warrant rigour through Yin's case-study criteria; a reflexive thematic analysis warrants it through reflexivity, positionality, and an audit trail — and should explicitly say why the positivist reliability apparatus does not apply."} {:name "context", :name-key "context", :slug "context", :text "Not every credible qualitative paper reports COREQ or double-coding with a kappa.  The case-study exemplar imports Yin's quality quartet (construct/internal/external validity, reliability) and maps its moves to each.  The reflexive-thematic-analysis exemplar rejects coding-accuracy/saturation/member-checking as paradigm-inappropriate and substitutes audit trail, peer debriefing, memos, and an author-positionality roster.  Either is a complete rigour account; a mismatched one invites a reviewer note."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: rigour-by-default-checklist <-> rigour-by-paradigm-appropriate-frame.\n    Irreducible: a rigour apparatus only warrants trust if it matches the epistemology of the analysis; reporting inter-coder reliability for a reflexive analysis (or omitting any frame for a case study) signals a paradigm mismatch, not rigour."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: naming a non-default frame requires defending the choice and may meet reviewers who expect COREQ reflexively.  The discipline is to name the chosen frame, cite its source, and briefly say why the default does not fit — pre-empting rather than ignoring the expectation.\n    Active dynamic: authors reach for the most familiar checklist regardless of design.  The stronger move is to select the frame the paradigm actually licenses and make the selection explicit."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Mismatched-apparatus: reflexive analysis reports inter-coder reliability, or a case study reports none of Yin's criteria.\n      - Frame-unnamed: rigour moves are present but no named frame ties them together, so they read as ad hoc.\n      - Positionality-absent: a reflexive analysis omits the author-positionality disclosure that is load-bearing for its rigour."} {:name "THEN", :name-key "then", :slug "then", :text "Name the paradigm-matched frame and map the study's moves to it."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Case-study quartet.\n          Schema: {:frame \"Yin\" :construct-validity <move> :internal-validity <move> :external-validity <replication-logic> :reliability <protocol/db>}\n          Effect: warrants a multiple-case design on its own terms.\n      (2) Reflexive-rigour apparatus.\n          Schema: {:audit-trail true :peer-debriefing true :memos true :member-checking-rejected-why <reason> :consensus <team>}\n          Effect: warrants a reflexive analysis without misapplying reliability.\n      (3) Positionality roster.\n          Schema: {:per-author <profession, training, identity, qual-expertise>}\n          Effect: discloses the interpretive standpoint the themes were constructed from."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the named rigour frame matches the study's paradigm and each rigour move is tied to it.  Failing when the apparatus is borrowed from a different paradigm, or no frame is named at all."}], :conclusion "State the study's rigour warrant using a frame that fits its paradigm and design, rather than defaulting to inter-coder reliability or a single checklist that may not apply.  A multiple-case study can warrant rigour through Yin's case-study criteria; a reflexive thematic analysis warrants it through reflexivity, positionality, and an audit trail — and should explicitly say why the positivist reliability apparatus does not apply.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["rigour" "trustworthiness" "reflexivity" "Yin" "case-study" "reflexive-thematic-analysis" "COREQ" "positionality"], :references ["plos-npt-with-small-n/coding-reliability-stated" "plos-npt-with-small-n/coreq-checklist-adherence"], :style "pattern", :title "Use a Rigour Frame Matched to the Study's Paradigm, Not a Default Checklist", :tone "technical"}, :id "plos-npt-with-small-n/paradigm-matched-rigour-frame", :keywords ["rigour" "trustworthiness" "reflexivity" "Yin" "case-study" "reflexive-thematic-analysis" "COREQ" "positionality"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/coding-reliability-stated" "plos-npt-with-small-n/coreq-checklist-adherence"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/paradigm-matched-rigour-frame.flexiarg", :sources [], :status :ok, :title "Use a Rigour Frame Matched to the Study's Paradigm, Not a Default Checklist", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a Results section presents several parallel themes, use illustrative extract tables to carry representative participant voice and keep the prose available for interpretation.  The table should not be a quote dump; each row should align theme, subtheme or claim, participant/source, and what the extract demonstrates."} {:name "context", :name-key "context", :slug "context", :text "The training/education PLOS exemplar uses one table of illustrative data extracts per theme, while other qualitative exemplars use participant and theme tables to prevent prose from becoming a long chain of quotations.  This is especially useful when the findings are role features, barriers, or implementation factors rather than a narrative case."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: quotation as evidence display <-> quotation as prose interruption.\n    Irreducible: qualitative claims need participant voice, but too many long quotes inside prose can hide the analytic claim they are meant to support."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: tables can make qualitative findings feel schematic, and moving quotes out of prose can reduce narrative texture.  Keep decisive or surprising quotes in prose; move parallel confirmatory extracts to tables.\n    Active dynamic: authors often add quotes whenever a claim feels under-supported.  Past a point, each quote adds length but not clarity."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Quote-flood: each theme paragraph becomes claim, quote, quote, quote, with little analytic synthesis.\n      - Anonymous-evidence: extract tables omit participant role or case context needed to interpret the quote.\n      - Decorative-extract: the quote illustrates the topic but not the specific analytic claim.\n      - Table-without-prose: the table carries all evidence, while Results prose merely restates theme names."} {:name "THEN", :name-key "then", :slug "then", :text "Separate interpretation from parallel evidence display."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Theme-extract table.\n          Columns: theme, analytic claim, participant/source, extract, interpretive note.\n          Effect: lets the prose state and compare findings.\n      (2) Role-balanced extracts.\n          Columns: theme, role/group, extract, contrast.\n          Effect: useful when professional role or participant type matters.\n      (3) One-prose-quote-per-turning-point.\n          Schema: {:theme <x> :kept-in-prose <quote that changes interpretation> :moved-to-table <parallel support>}\n          Effect: preserves qualitative texture without flooding paragraphs."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when quotes are easy to inspect and the prose still performs analysis.  Failing when the Results section becomes a transcript collage or when extract tables lack analytic labels."}], :conclusion "When a Results section presents several parallel themes, use illustrative extract tables to carry representative participant voice and keep the prose available for interpretation.  The table should not be a quote dump; each row should align theme, subtheme or claim, participant/source, and what the extract demonstrates.", :directives {:audience "paper authors, qualitative researchers, education researchers", :keywords ["quotations" "extract-table" "thematic-analysis" "results" "training" "qualitative"], :references ["writing-coherence/one-paragraph-per-typed-claim" "plos-npt-with-small-n/site-case-data-display"], :style "pattern", :title "Use Extract Tables When Themes Are Parallel", :tone "technical"}, :id "plos-npt-with-small-n/quote-table-not-quote-flood", :keywords ["quotations" "extract-table" "thematic-analysis" "results" "training" "qualitative"], :projection-version "flexiarg-v0", :references ["writing-coherence/one-paragraph-per-typed-claim" "plos-npt-with-small-n/site-case-data-display"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/quote-table-not-quote-flood.flexiarg", :sources [], :status :ok, :title "Use Extract Tables When Themes Are Parallel", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A small-n PLOS ONE paper should enumerate its research questions explicitly and early — in the Introduction, and in the unstructured-abstract lane, in the abstract itself.  The handling editor makes a scope-fit decision before reading the body; numbered questions let that decision be made in seconds and on the author's terms rather than by inference."} {:name "context", :name-key "context", :slug "context", :text "PLOS ONE decides on soundness and scope-fit, not significance.  In the social-science / research-culture exemplars (e.g. the open-research-data study), two or three numbered questions appear up front, sometimes inside the abstract, signalling exactly what the paper will and will not answer.  This is the move that converts a vague topic into a legible object the desk editor can place."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: scope-legible-at-the-gate <-> scope-inferred-from-the-body.\n    Irreducible: an editor cannot grant scope-fit to a paper whose questions they must reconstruct; the cost of leaving questions implicit is paid at the desk-decision, the cheapest place to be rejected."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: explicit RQs can read as mechanical, and poorly differentiated questions advertise their own overlap (a process question and a barriers question that restate each other).  The discipline is to make each question carry a distinct analytic job.\n    Active dynamic: authors often prefer to open on importance or on the strongest finding.  At a soundness venue the stronger first move is to make the scope decidable."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Implicit-scope: the topic is described richly but no question is ever stated, leaving the editor to infer the contribution.\n      - Overlapping-questions: RQ1 and RQ2 cover the same ground unless an explicit distinction (process vs condition vs normalisation) is drawn.\n      - Abstract-silent: in the unstructured-abstract lane, the questions appear only deep in the Introduction, too late for the desk decision."} {:name "THEN", :name-key "then", :slug "then", :text "Put the questions where the scope decision is made."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Numbered-questions-in-intro.\n          Schema: {:rq1 <process-facing> :rq2 <condition-facing> :rq3 <normalisation-facing>}\n          Effect: each question names a distinct analytic facing, so overlap is visible and avoidable.\n      (2) Abstract-surfaced-questions.\n          Schema: {:abstract-questions <1-2 numbered> :register :unstructured}\n          Effect: signals scope to the desk editor before the Methods paragraph.\n      (3) Questions-plus-objective.\n          Schema: {:questions <2> :analytic-objective <1>}\n          Effect: collapses an over-stuffed three-question set into two questions and one stated objective."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when a desk editor can state the paper's scope from the questions alone, without reading Results.  Failing when the scope must be inferred, or when two questions cannot be told apart."}], :conclusion "A small-n PLOS ONE paper should enumerate its research questions explicitly and early — in the Introduction, and in the unstructured-abstract lane, in the abstract itself.  The handling editor makes a scope-fit decision before reading the body; numbered questions let that decision be made in seconds and on the author's terms rather than by inference.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["research-questions" "scope" "desk-decision" "PLOS" "abstract" "introduction"], :references ["plos-npt-with-small-n/abstract-n-method-frame" "plos-npt-with-small-n/framework-spine-with-empirical-ribs"], :style "pattern", :title "State the Research Questions Explicitly and Early", :tone "technical"}, :id "plos-npt-with-small-n/research-questions-stated-early", :keywords ["research-questions" "scope" "desk-decision" "PLOS" "abstract" "introduction"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/abstract-n-method-frame" "plos-npt-with-small-n/framework-spine-with-empirical-ribs"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/research-questions-stated-early.flexiarg", :sources [], :status :ok, :title "State the Research Questions Explicitly and Early", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a paper deliberately reports only part of a larger study — one construct, one phase, one method — defend that narrowing explicitly by naming the companion paper that carries the rest, and stating the division of labour.  An unexplained narrow scope reads as a gap (or as salami-slicing); a named hand-off reads as deliberate design."} {:name "context", :name-key "context", :slug "context", :text "The ERAS exemplar narrows its whole analysis to the single NPT construct of Coherence and routes the barriers/facilitators analysis to a sibling publication (\"more fully explored elsewhere [25]\").  The DEALTS2 train-the-trainer study splits qualitative and quantitative reporting across a companion pair.  In both, the narrowing is announced, not left for the reader to notice — which is the difference between division of labour and questionable-research-practice slicing."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: narrow-scope-unexplained <-> narrow-scope-announced-with-companion.\n    Irreducible: a reviewer cannot tell deliberate scoping from incomplete work unless the paper names what is reserved and where it goes; the hand-off statement is what converts a gap into a design."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: naming the companion exposes that the dataset is being published in pieces, inviting the salami-slicing question directly.  The defence is that the split is along a principled seam (a distinct construct, phase, or method — not the same analysis cut in half) and that each piece makes a contribution that stands alone.  A split along a mechanism seam mid-analysis is the move this pattern does NOT license.\n    Active dynamic: authors fear admitting a companion paper and so leave the scope unexplained, which reads worse.  The stronger move is to name it and justify the seam."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Unexplained-narrowness: the paper covers one slice with no statement of what was left out or why, reading as thin.\n      - Mechanism-seam-slicing: the split cuts a single coherent analysis into minimal-publishable-units along no principled boundary (the QRP failure).\n      - Companion-unnamed: a sibling paper exists but is not cited, so the reader cannot place the contribution."} {:name "THEN", :name-key "then", :slug "then", :text "Announce the seam and the hand-off."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Scope-and-handoff statement.\n          Schema: {:this-paper <slice> :reserved <remainder> :companion <citation or \"forthcoming\"> :seam <construct | phase | method>}\n          Effect: makes the narrowing legible as design.\n      (2) Standalone-contribution claim.\n          Schema: {:contribution-of-this-slice <what it alone establishes>}\n          Effect: shows the piece is not a fragment dependent on the companion.\n      (3) Seam-justification.\n          Schema: {:why-this-seam <principled boundary> :not \"the same analysis halved\"}\n          Effect: distinguishes deliberate scoping from salami-slicing."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the paper states what it reserves, names where that goes, and justifies the seam as principled.  Failing when the scope is narrow but unexplained, or the seam cuts a single analysis into minimal units."}], :conclusion "When a paper deliberately reports only part of a larger study — one construct, one phase, one method — defend that narrowing explicitly by naming the companion paper that carries the rest, and stating the division of labour.  An unexplained narrow scope reads as a gap (or as salami-slicing); a named hand-off reads as deliberate design.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["scope" "companion-paper" "salami-slicing" "phasing" "contribution" "division-of-labour" "QRP"], :references ["plos-npt-with-small-n/open-science-phase-register" "plos-npt-with-small-n/venue-register-boundary"], :style "pattern", :title "Defend a Narrow Scope by Naming the Companion Paper", :tone "technical"}, :id "plos-npt-with-small-n/scope-shield-via-companion-paper", :keywords ["scope" "companion-paper" "salami-slicing" "phasing" "contribution" "division-of-labour" "QRP"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/open-science-phase-register" "plos-npt-with-small-n/venue-register-boundary"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/scope-shield-via-companion-paper.flexiarg", :sources [], :status :ok, :title "Defend a Narrow Scope by Naming the Companion Paper", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Before a small-n Results section makes comparative claims, the paper should give the reader a compact display of the empirical terrain: sites or cases, participant roles, data sources, and relevant contextual differences.  This table is not clerical; it is the map that makes later variation claims inspectable."} {:name "context", :name-key "context", :slug "context", :text "The PLOS exemplars repeatedly include site-characteristic, participant-characteristic, case-summary, data-collection-by-case, and phase-overview tables before or near the Results.  These displays make it possible to read claims about site variation, professional roles, implementation barriers, or framework constructs without losing track of where the evidence came from."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: reader-held study map <-> buried methods inventory.\n    Irreducible: variation claims require visible dimensions of variation.  If the prose says sites, roles, or cases differed, the reader needs a table that names the dimensions along which they differed."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: tables can feel dull and may repeat Methods prose.  Over-detailed tables can overwhelm a short qualitative article.  The discipline is to display only variables that later carry analytic weight.\n    Active dynamic: authors know their cases too well and underestimate how quickly readers lose the site/role map once results begin."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Context-after-claim: site differences are invoked in Results before the site characteristics have been made visible.\n      - Participant-table-as-appendix-only: the table needed to read the findings is moved to supporting information.\n      - Decorative-demographics: a table lists demographics that never matter analytically while omitting role, site, implementation exposure, or data-source differences that do matter.\n      - Mixed-n-blur: interviews, focus groups, observations, and documents are counted in prose but never aligned by site or case."} {:name "THEN", :name-key "then", :slug "then", :text "Add a study-map display before findings."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Site-characteristics table.\n          Columns: site/case, setting type, intervention exposure, relevant staffing or workflow feature, data collected.\n          Effect: supports later cross-site interpretation.\n      (2) Data-by-case table.\n          Columns: case, interviews, observations, documents, surveys, notes, analytic relevance.\n          Effect: makes triangulation and uneven coverage visible.\n      (3) Participant-role table.\n          Columns: role, count, setting, relation to intervention, relevant experience.\n          Effect: lets role-based findings avoid floating above the sample."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when every later claim about site, case, role, or phase variation can point back to a compact display.  Failing when the reader must reconstruct the study map from scattered Methods sentences."}], :conclusion "Before a small-n Results section makes comparative claims, the paper should give the reader a compact display of the empirical terrain: sites or cases, participant roles, data sources, and relevant contextual differences.  This table is not clerical; it is the map that makes later variation claims inspectable.", :directives {:audience "paper authors, implementation researchers, case-study authors", :keywords ["table" "cases" "sites" "participants" "data-sources" "qualitative-methods"], :references ["plos-npt-with-small-n/small-n-is-a-design-feature" "plos-npt-with-small-n/multi-method-triangulation-ladder"], :style "pattern", :title "Display Sites, Cases, Roles, and Data Before Findings", :tone "technical"}, :id "plos-npt-with-small-n/site-case-data-display", :keywords ["table" "cases" "sites" "participants" "data-sources" "qualitative-methods"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/small-n-is-a-design-feature" "plos-npt-with-small-n/multi-method-triangulation-ladder"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/site-case-data-display.flexiarg", :sources [], :status :ok, :title "Display Sites, Cases, Roles, and Data Before Findings", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A small-n paper should defend n through design transparency, not through apology.  The paper must say how participants or cases were selected, what analytic job the sample performs, how the team judged adequacy, and what kinds of claims remain outside scope.  Saturation literature can support this, but it cannot replace the local account of why this sample was enough for this question."} {:name "context", :name-key "context", :slug "context", :text "The PLOS sample-size ammunition paper treats saturation as related to question design, domain size, salience, and response structure rather than a universal magic number.  The small-n implementation exemplars likewise make n credible by showing case boundaries, sites, data streams, topic guides, coding or framework procedures, and limits on transferability."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: n-as-count <-> n-as-designed-warrant.\n    Irreducible: the same n can be weak or strong depending on sampling logic, data richness, analytic scope, and triangulation.  A bare number has no warrant by itself."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: transparent n-defence takes Methods space and may expose imperfections in recruitment, site access, or data completeness.  Hiding those imperfections is worse; reviewers will infer them anyway.\n    Active dynamic: small-n authors often over-hedge in the Discussion while under-specifying design in Methods.  The stronger move is the reverse: be exact in Methods and proportionate in the Discussion."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Magic-saturation: \"saturation was reached\" with no account of what saturated, how it was assessed, or what remained unsaturated.\n      - Apology-paragraph: limitations say only that n was small, without explaining why the sample was still fit for the claim.\n      - NPT-cover: a framework is used to imply adequacy without showing sampling, coding, or deviant-case handling.\n      - Count-confusion: n is given but the reader cannot tell whether it is participants, interviews, focus groups, sites, cases, observations, or documents."} {:name "THEN", :name-key "then", :slug "then", :text "Make n legible as part of design."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Sampling logic paragraph.\n          Schema: {:population <who> :selection <purposive/case/role/site> :inclusion <criteria> :analytic-job <why these cases matter>}\n          Effect: n becomes interpretable before findings are presented.\n      (2) Adequacy statement.\n          Schema: {:adequacy-basis <saturation | information-power | case-depth | triangulation> :what-was-adequate-for <claim-type> :what-not-for <scope-limit>}\n          Effect: prevents a small-n thematic account from overreaching.\n      (3) Data richness table.\n          Schema: {:rows <case/site/role> :columns <interviews/focus-groups/observations/documents/notes>}\n          Effect: lets the reader see that n is not the only evidence dimension."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the reader can explain why n was enough for the paper's claim without accepting a generic saturation sentence.  Failing when small n is hidden until limitations, or defended only by citing saturation literature."}], :conclusion "A small-n paper should defend n through design transparency, not through apology.  The paper must say how participants or cases were selected, what analytic job the sample performs, how the team judged adequacy, and what kinds of claims remain outside scope.  Saturation literature can support this, but it cannot replace the local account of why this sample was enough for this question.", :directives {:audience "paper authors, qualitative researchers, reviewers", :keywords ["small-n" "qualitative" "sample-size" "saturation" "information-power" "rigour" "limitations"], :references ["plos-npt-with-small-n/transferability-not-generalisability" "writing-coherence/citation-density-load-bearing-claim"], :style "pattern", :title "Defend Small n by Design Transparency", :tone "technical"}, :id "plos-npt-with-small-n/small-n-is-a-design-feature", :keywords ["small-n" "qualitative" "sample-size" "saturation" "information-power" "rigour" "limitations"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/transferability-not-generalisability" "writing-coherence/citation-density-load-bearing-claim"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/small-n-is-a-design-feature.flexiarg", :sources [], :status :ok, :title "Defend Small n by Design Transparency", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Present the analytic framework as a heuristic device that organised and aided the analysis, not as a causal or explanatory law the data prove.  Where the framework has a known limitation, name it and show how the study's design compensates.  This pre-empts the reviewer charge that the theory is being over-claimed, while still crediting it with analytic value."} {:name "context", :name-key "context", :slug "context", :text "The ERAS exemplar repeatedly downgrades NPT to \"a potentially useful heuristic device\" and, having isolated one construct, turns the difficulty of separating it from the others into an explicit finding about the constructs' interconnectedness.  The stroke-rehab exemplar names a standard criticism of NPT — its bias toward professional action — and states that including patient interviews addresses it.  Both grant the framework usefulness while disclaiming over-reach."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: theory-as-proven-law <-> theory-as-acknowledged-heuristic.\n    Irreducible: a qualitative study cannot prove a theory; claiming it does invites rejection, while denying the theory any role wastes the analytic structure.  The heuristic framing occupies the defensible middle: useful lens, not demonstrated mechanism."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: calling the framework \"just\" a heuristic can read as underselling the theoretical contribution.  The discipline is to credit specific analytic work the framework did (organising findings, surfacing the interconnection of constructs) while declining the causal claim — usefulness without over-reach.\n    Active dynamic: authors invested in a framework drift toward treating its constructs as real entities the data confirm.  The stronger move is to treat the constructs as lenses and to name where the lens distorts."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Theory-reified: constructs are written as causal forces the data \"prove,\" over-claiming explanatory power.\n      - Limitation-unnamed: a well-known weakness of the framework goes unmentioned, so a reviewer raises it instead.\n      - Heuristic-without-credit: the framework is dismissed as merely a heuristic with no account of what it actually contributed."} {:name "THEN", :name-key "then", :slug "then", :text "Credit the framework as a lens and bound its claims."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Heuristic-framing statement.\n          Schema: {:framework <name> :role \"heuristic device\" :contributed <organising/surfacing work> :not-claimed \"causal mechanism\"}\n          Effect: secures analytic value without over-reach.\n      (2) Limitation-then-remedy.\n          Schema: {:known-criticism <of the framework> :remedy-in-design <what the study did about it>}\n          Effect: converts a framework critique into a design strength.\n      (3) Interconnection-as-finding.\n          Schema: {:isolated-construct <X> :difficulty \"cannot cleanly separate from others\" :as-finding true}\n          Effect: turns the awkwardness of using one construct into a substantive observation."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the framework is credited with specific analytic work but not claimed to be proven, and its known limits are named and addressed.  Failing when constructs are reified as proven mechanisms, or the framework's weaknesses go unmentioned."}], :conclusion "Present the analytic framework as a heuristic device that organised and aided the analysis, not as a causal or explanatory law the data prove.  Where the framework has a known limitation, name it and show how the study's design compensates.  This pre-empts the reviewer charge that the theory is being over-claimed, while still crediting it with analytic value.", :directives {:audience "paper authors, qualitative researchers, PLOS ONE drafters", :keywords ["theory" "NPT" "heuristic" "over-claiming" "framework-critique" "hedge" "remedy-in-design"], :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/coherence-first-when-using-npt"], :style "pattern", :title "Frame the Theory as a Heuristic Device, and Name Its Limits", :tone "technical"}, :id "plos-npt-with-small-n/theory-as-heuristic-not-law", :keywords ["theory" "NPT" "heuristic" "over-claiming" "framework-critique" "hedge" "remedy-in-design"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/coherence-first-when-using-npt"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/theory-as-heuristic-not-law.flexiarg", :sources [], :status :ok, :title "Frame the Theory as a Heuristic Device, and Name Its Limits", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Training and education qualitative papers should present findings as role features, competencies, or implementation conditions rather than as loose positive attributes.  Named themes such as manager, communicator, mediator, guide, and experienced professional work because they describe what the role must do, then support each feature with extracts and practical implications."} {:name "context", :name-key "context", :slug "context", :text "The PLOS rehabilitation higher-education exemplar structures Results around five course-leader features and pairs each with illustrative extract tables.  The BMC train-the-trainer cousins are useful for positioning because they similarly attend to training cascades, facilitation, organisational support, and practice impact, though their venue register is not PLOS ONE."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: admired trait <-> functional role feature.\n    Irreducible: a training finding becomes useful when it tells the reader what role-work is required, not merely which qualities participants liked."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: role-feature naming can sound normative and may over-unify diverse participant accounts.  Keep feature labels close to the data and use extracts to show range, not just endorsement.\n    Active dynamic: education papers often drift into generic virtues: flexible, empathic, experienced, collaborative.  The register strengthens when each virtue is tied to a work situation."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Trait-list: themes are adjectives without role-work or implementation consequence.\n      - Extract-as-endorsement: quotes show participants liked the trainer but not what the trainer did.\n      - Training-effect-overreach: qualitative perceptions are presented as evidence that training improved outcomes.\n      - Cousin-venue-contamination: BMC train-the-trainer structures are copied wholesale into a PLOS register rather than used for literature positioning."} {:name "THEN", :name-key "then", :slug "then", :text "Turn traits into functional features."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Role-feature heading.\n          Heading schema: \"Theme N: A <functional role noun>\"\n          Effect: makes the feature readable as work, not personality.\n      (2) Feature-extract table.\n          Columns: feature, situation, participant extract, role-work demonstrated.\n          Effect: shows how the feature operates.\n      (3) Practice implication bridge.\n          Schema: {:feature <x> :training-design-implication <y> :scope <similar education/training contexts>}\n          Effect: turns qualitative themes into design implications without claiming measured effectiveness."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when every training theme names a role-work demand and is supported by extracts showing that work.  Failing when the Results section reads as a list of desirable personal qualities."}], :conclusion "Training and education qualitative papers should present findings as role features, competencies, or implementation conditions rather than as loose positive attributes.  Named themes such as manager, communicator, mediator, guide, and experienced professional work because they describe what the role must do, then support each feature with extracts and practical implications.", :directives {:audience "education researchers, training evaluators, qualitative authors", :keywords ["training" "education" "course-leader" "thematic-analysis" "role-features" "rehabilitation"], :references ["plos-npt-with-small-n/quote-table-not-quote-flood" "plos-npt-with-small-n/barrier-enabler-strategy-display"], :style "pattern", :title "Present Training Findings as Role Features With Extract Support", :tone "technical"}, :id "plos-npt-with-small-n/training-role-feature-register", :keywords ["training" "education" "course-leader" "thematic-analysis" "role-features" "rehabilitation"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/quote-table-not-quote-flood" "plos-npt-with-small-n/barrier-enabler-strategy-display"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/training-role-feature-register.flexiarg", :sources [], :status :ok, :title "Present Training Findings as Role Features With Extract Support", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A small-n PLOS paper should end with bounded transferability rather than weak generalisability.  The limitation is not simply \"small sample\"; it is which setting, roles, recruitment conditions, data-access limits, or topic-specific features bound the claim, and which mechanisms or design lessons may travel to similar settings."} {:name "context", :name-key "context", :slug "context", :text "The exemplars often acknowledge locality, case selection, participant composition, and qualitative-data access constraints while still arguing that implementation mechanisms, framework refinements, or practice implications matter beyond the immediate site.  The strongest language names the basis of transfer: similar workflows, intervention type, professional roles, or implementation conditions."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: bounded transfer <-> statistical generalisation.\n    Irreducible: qualitative small-n findings travel by mechanism, analogy, and context fit, not by sample representativeness."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: transferability language is less rhetorically strong than broad generalisation.  It requires naming the conditions under which the finding might fail.  That cost is the price of credibility.\n    Active dynamic: authors compensate for small n either by over-hedging everything or by overstating implications.  Transferability is the middle discipline."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Small-n-apology-only: limitations say the sample was small and stop there.\n      - Universal-implication: the Discussion says the findings apply to healthcare, HCI, education, or open science broadly without naming matching conditions.\n      - Hedge-cloud: every implication is softened with \"may\", \"might\", and \"could\" but no scope conditions are specified.\n      - Locality-hidden: the Results depend on a particular local system, but the Discussion abstracts it away."} {:name "THEN", :name-key "then", :slug "then", :text "State transfer conditions explicitly."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Scope-condition sentence.\n          Schema: \"These findings are most transferable to <settings> where <matching condition>.\"\n          Effect: turns limitation into usable boundary.\n      (2) Mechanism-travels paragraph.\n          Schema: {:local-finding <x> :mechanism <why it matters> :transfer-condition <where it should matter>}\n          Effect: preserves analytic contribution without pretending representativeness.\n      (3) Non-transfer list.\n          Schema: {:not-claimed <population prevalence/effect size/all settings> :claimed <process/mechanism/implementation lesson>}\n          Effect: prevents reviewers from reading the paper as underpowered quantitative work."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the Discussion tells readers where the finding may travel and why.  Failing when limitations either apologize for n generically or imply generality without conditions."}], :conclusion "A small-n PLOS paper should end with bounded transferability rather than weak generalisability.  The limitation is not simply \"small sample\"; it is which setting, roles, recruitment conditions, data-access limits, or topic-specific features bound the claim, and which mechanisms or design lessons may travel to similar settings.", :directives {:audience "paper authors, reviewers, qualitative researchers", :keywords ["limitations" "transferability" "generalisability" "qualitative" "small-n" "PLOS"], :references ["plos-npt-with-small-n/small-n-is-a-design-feature" "writing-coherence/hedged-lift"], :style "pattern", :title "Claim Transferability, Not Population Generalisability", :tone "technical"}, :id "plos-npt-with-small-n/transferability-not-generalisability", :keywords ["limitations" "transferability" "generalisability" "qualitative" "small-n" "PLOS"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/small-n-is-a-design-feature" "writing-coherence/hedged-lift"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/transferability-not-generalisability.flexiarg", :sources [], :status :ok, :title "Claim Transferability, Not Population Generalisability", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Papers outside PLOS ONE can be content cousins without being register models.  Use BMC train-the-trainer or implementation studies to position the literature, vocabulary, and intervention family; use PLOS ONE papers to model abstract structure, Methods granularity, tables, headings, and claim scope."} {:name "context", :name-key "context", :slug "context", :text "The BMC STORM and DEALTS2 papers are close content cousins for cascade training, train-the-trainer design, implementation barriers, and NPT-informed analysis.  They are useful for literature positioning.  But the requested library is about PLOS-with-small-n presentation, so the venue register should be drawn primarily from PLOS ONE exemplars."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: topical similarity <-> venue-style suitability.\n    Irreducible: a paper can be substantively close but rhetorically mismatched.  Content evidence and venue emulation are different jobs."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: separating content cousins from register models means extra discipline in drafting: a useful article may be cited heavily while not being copied structurally.  This can feel artificial when the cousin is the closest intervention match.\n    Active dynamic: authors naturally imitate the paper that feels closest to their topic.  Reviewers, however, respond to the target venue's presentation norms."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Cousin-as-template: a non-PLOS article supplies the section shape, table density, or discussion style for a PLOS submission.\n      - Venue-register-blindness: all cited papers are treated as equally useful models.\n      - Literature-gap-overfit: the Introduction positions against the closest cousin but ignores PLOS exemplars that establish acceptable small-n presentation.\n      - Methods-style-import: another venue's looser or denser Methods conventions are imported without checking PLOS fit."} {:name "THEN", :name-key "then", :slug "then", :text "Assign each exemplar a job."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Source-role table.\n          Columns: paper, venue, content role, register role, use in draft.\n          Effect: prevents accidental imitation of the wrong model.\n      (2) PLOS-primary structure pass.\n          Schema: {:abstract <PLOS model> :methods <PLOS model> :results <PLOS model> :lit-positioning <content cousins>}\n          Effect: preserves target-venue fit.\n      (3) Cousin citation boundary.\n          Schema: \"We cite <cousin> for <intervention/literature point>, not as a structural precedent.\"\n          Effect: makes the drafting discipline explicit."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when each exemplar has a declared role: register model, methods ammunition, content cousin, or positioning source.  Failing when the draft borrows structure from the closest topical paper regardless of venue."}], :conclusion "Papers outside PLOS ONE can be content cousins without being register models.  Use BMC train-the-trainer or implementation studies to position the literature, vocabulary, and intervention family; use PLOS ONE papers to model abstract structure, Methods granularity, tables, headings, and claim scope.", :directives {:audience "paper authors, literature-reviewers, drafters", :keywords ["venue-register" "literature-positioning" "PLOS" "BMC" "content-cousin" "model-paper"], :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/training-role-feature-register"], :style "pattern", :title "Use Content Cousins for Positioning, Not Venue Register", :tone "technical"}, :id "plos-npt-with-small-n/venue-register-boundary", :keywords ["venue-register" "literature-positioning" "PLOS" "BMC" "content-cousin" "model-paper"], :projection-version "flexiarg-v0", :references ["plos-npt-with-small-n/framework-spine-with-empirical-ribs" "plos-npt-with-small-n/training-role-feature-register"], :scores {}, :sigils [], :source-path "library/plos-npt-with-small-n/venue-register-boundary.flexiarg", :sources [], :status :ok, :title "Use Content Cousins for Positioning, Not Venue Register", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Treat query as a first-class operation via Drawbridge."} {:name "context", :name-key "context", :slug "context", :text "Intent lives in the database and queries must be expressive."} {:name "IF", :name-key "if", :slug "if", :text "    Pattern retrieval is constrained to fixed endpoints."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    You need SPARQL-like flexibility without endpoint sprawl."} {:name "THEN", :name-key "then", :slug "then", :text "    Use Drawbridge and portal helpers so queries can compose lex, ANN, and chain steps."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    First-class queries support rich exploration and align guidance with intent."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "src/musn/portal.clj; scripts/portal"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Add portal subcommands for suggest, propose, and promote.\n    - Document how to query intent and pattern metadata directly.\n    - Include examples that mix lexical and ANN expansion."} {:name "use", :name-key "use", :slug "use", :text "docs/portal-interop.md; docs/sidecar-usage.md"}], :conclusion "Treat query as a first-class operation via Drawbridge.", :directives {:audience "musn architects, portal users", :style "pattern", :title "First-Class Query Interface", :tone "technical"}, :id "portal/first-class-query-interface", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/portal/first-class-query-interface.flexiarg", :sources [], :status :ok, :title "First-Class Query Interface", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Keep portal commands minimal, composable, and consistent across query modes."} {:name "context", :name-key "context", :slug "context", :text "Portal is the agent-facing entry point for query and eval."} {:name "IF", :name-key "if", :slug "if", :text "    Portal subcommands drift or duplicate responsibilities."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    You need fast iteration without breaking agent workflows."} {:name "THEN", :name-key "then", :slug "then", :text "    Define a stable command surface that separates eval, pattern queries, and sidecar logging helpers."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    A small, consistent surface makes automation reliable and user docs durable."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "src/musn/portal.clj; scripts/portal"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "scripts/musn-session; scripts/musn-select; scripts/musn-action"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Document command stability guarantees and deprecations.\n    - Add portal flags for target log selection when writing sidecar events.\n    - Document command stability guarantees and deprecations."} {:name "use", :name-key "use", :slug "use", :text "docs/portal-interop.md; docs/sidecar-usage.md"}], :conclusion "Keep portal commands minimal, composable, and consistent across query modes.", :directives {:audience "musn architects, portal users", :style "pattern", :title "Portal Command Surface", :tone "technical"}, :id "portal/portal-command-surface", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/portal/portal-command-surface.flexiarg", :sources [], :status :ok, :title "Portal Command Surface", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Use portal to fetch guidance and sidecar to persist actions and evidence."} {:name "context", :name-key "context", :slug "context", :text "Agents need one query path and one audit path."} {:name "IF", :name-key "if", :slug "if", :text "    Guidance and logging share the same storage or implicit side effects."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    You still want a tight loop from intent to action to evidence."} {:name "THEN", :name-key "then", :slug "then", :text "    Fetch patterns and intent through portal, perform work, and record selections, actions,\n    and evidence in sidecar as append-only events."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Separating query and audit paths keeps guidance flexible and logs authoritative."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "src/musn/portal.clj; scripts/portal"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "src/sidecar/store.clj; src/sidecar/validation.clj"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Add portal helpers that call sidecar log APIs directly.\n    - Document the log schema exposed to portal for reporting."} {:name "use", :name-key "use", :slug "use", :text "docs/portal-interop.md; docs/sidecar-usage.md"}], :conclusion "Use portal to fetch guidance and sidecar to persist actions and evidence.", :directives {:audience "musn architects, portal users", :style "pattern", :title "Portal and Sidecar Interop", :tone "technical"}, :id "portal/portal-sidecar-interop", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/portal/portal-sidecar-interop.flexiarg", :sources [], :status :ok, :title "Portal and Sidecar Interop", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Use one authoritative event log with replay so late joiners and transport switches share context."} {:name "context", :name-key "context", :slug "context", :text "People re-join #lab and the transcript repeats, while agents drift on what they saw."} {:name "IF", :name-key "if", :slug "if", :text "    You need consistent shared state across reconnects, multiple transports, and late joiners."} {:name "HOWEVE