 :id "musn/use-requires-evidence", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌂/示"], :source-path "library/musn/use-requires-evidence.flexiarg", :sources [], :status :ok, :title "Use Requires Evidence", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Adaptive Delivery Spine [🪡/式 🧩/合]"} {:name "context", :name-key "context", :slug "context", :text "Trainers value interactivity and contextual adaptation, but sessions feel rushed and overstuffed without a clear delivery architecture."} {:name "if", :name-key "if", :slug "if", :text "You want trainers to tailor content to local needs without losing coherence."} {:name "however", :name-key "however", :slug "however", :text "One-size-fits-all agendas create fatigue, reduce interaction, and leave trainers unable to cover core material."} {:name "then", :name-key "then", :slug "then", :text "Define a delivery spine: a minimal core (two to three modules) plus named elective modules and a required co-working block for local adaptation. Provide time budgets and “drop-in” variants for short sessions."} {:name "because", :name-key "because", :slug "because", :text "A spine creates predictable structure while legitimizing adaptation; it protects interaction time and reduces overload."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "transcript1 t1-15; transcript2A t2a-13; transcript2B t2b-45."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish three spine variants (90-min, half-day, full-day).\n      - Add a template for local adaptation notes and decisions.\n      - Include a standard Q&A and co-working segment in every variant."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: collect post-session notes on what was dropped or adapted.\n      - metric: percentage of sessions using a declared spine variant."}], :conclusion "Adaptive Delivery Spine [🪡/式 🧩/合]", :directives {:audience "trainers, curriculum-designers, cohort-leads", :sigils ["🪡/式"], :style "design-pattern", :title "Adaptive Delivery Spine", :tone "formal-analytic"}, :id "or/adaptive-delivery-spine", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🪡/式" "🧩/合"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Adaptive Delivery Spine", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Attribution-Forward Review [👥/文 💬/心]"} {:name "context", :name-key "context", :slug "context", :text "Traditional anonymous peer review hides both power and care; reviewers feel disposable, authors feel judged by invisible forces."} {:name "if", :name-key "if", :slug "if", :text "You want review to function as dialogue and mentorship, not merely gatekeeping."} {:name "however", :name-key "however", :slug "however", :text "Reviewers fear retaliation or reputational harm; editors worry openness will reduce reviewer supply."} {:name "then", :name-key "then", :slug "then", :text "Shift to attribution-forward models where reviews are named by default (with consensual pseudonymity as an option) and each includes a stance note on expertise, conflicts, and values. Allow reviews to be citable artefacts in their own right."} {:name "because", :name-key "because", :slug "because", :text "Open review pilots show higher civility, specificity, and reusability; stance notes help readers contextualise critique. Attribution turns review into a shared scholarly contribution."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish one named review of this catalogue with stance notes.\n      - Share a stance-note mini-form as a reusable template.\n      - Compare outcomes from open vs. blind review in one venue and summarise."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: track the proportion of reviews with names or stance notes.\n      - metric: reviewers later cited or thanked in follow-on work."}], :conclusion "Attribution-Forward Review [👥/文 💬/心]", :directives {:audience "editors, review-coordinators, programme-committees", :sigils ["👓/只"], :style "design-pattern", :title "Attribution-Forward Review", :tone "formal-analytic"}, :id "or/attribution-forward-review", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👓/只" "👥/文" "💬/心"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Attribution-Forward Review", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Bridge-Before-Portal [🌲/门 🚢/川]"} {:name "context", :name-key "context", :slug "context", :text "Faced with fragmented systems, teams dream of one portal that unifies access; portal projects become expensive, slow, and prone to locking teams in."} {:name "if", :name-key "if", :slug "if", :text "You seek interoperability and shared visibility quickly while preserving flexibility for future architectures."} {:name "however", :name-key "however", :slug "however", :text "Institutional incentives reward big launches over modest connectors; monolithic portals over-specify needs, become brittle, and exhaust teams."} {:name "then", :name-key "then", :slug "then", :text "Start with bridges rather than portals: small, reversible connections such as exports, DOI cross-links, citation recipes, or shared notebooks. Each bridge must pass a reversal test: can you reconstruct your data or process if the bridge disappears?"} {:name "because", :name-key "because", :slug "because", :text "Bridges enable staged federation and mutual learning without committing to one architecture. They preserve optionality, lower risk, and turn integrations into negotiable boundary objects."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Implement a simple bridge between this catalogue and another pattern repository.\n      - Create a reversal-test checklist and apply it to existing integrations.\n      - Document one failed portal attempt and what a bridge-first approach would have changed."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: maintain a Bridge Register with status and reversal-test logs.\n      - metric: proportion of bridges that can be rebuilt within a set time (e.g., two hours)."}], :conclusion "Bridge-Before-Portal [🌲/门 🚢/川]", :directives {:audience "infrastructure-leads, product-owners, integration-teams", :sigils ["🚴/以"], :style "design-pattern", :title "Bridge-Before-Portal", :tone "formal-analytic"}, :id "or/bridge-before-portal", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚴/以" "🌲/门" "🚢/川"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Bridge-Before-Portal", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Citizen Co-Learning Track [👫/人 🚞/入]"} {:name "context", :name-key "context", :slug "context", :text "Many crowdsourcing projects treat volunteers as task workers; once tasks end, engagement collapses and relationships dissolve."} {:name "if", :name-key "if", :slug "if", :text "You want participation that deepens over time, with volunteers becoming co-researchers who can interpret and shape future work."} {:name "however", :name-key "however", :slug "however", :text "Infrastructures are optimised for throughput, not growth; lessons and reflection spaces are afterthoughts, and churn is treated as inevitable."} {:name "then", :name-key "then", :slug "then", :text "Add a parallel co-learning track with short lessons tied to live project data, reflection prompts, and co-authorship opportunities. Maintain learning logs where participants narrate discoveries."} {:name "because", :name-key "because", :slug "because", :text "Structured learning increases retention, data quality, and trust. When contributors understand the science and see themselves as co-authors, motivation becomes stewardship."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish a learning track explaining how this catalogue evolves and inviting remix lessons.\n      - Curate example projects with strong co-learning components and reference them.\n      - Create a reusable reflection prompt bank for different phases of participation."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: track repeat participation rates and volunteer co-authorship counts.\n      - metric: volunteers initiate learning sessions or produce derivative educational materials."}], :conclusion "Citizen Co-Learning Track [👫/人 🚞/入]", :directives {:audience "engagement-leads, educators, public-participation-officers", :sigils ["👫/人"], :style "design-pattern", :title "Citizen Co-Learning Track", :tone "formal-analytic"}, :id "or/citizen-co-learning-track", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👫/人" "🚞/入"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Citizen Co-Learning Track", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Co-Ownership Engine [🤝/共 🌍/场]"} {:name "context", :name-key "context", :slug "context", :text "Trainers describe T3 as an entry point into a wider community and a moment of shared ownership; this co-ownership motivates action."} {:name "if", :name-key "if", :slug "if", :text "You want training impact to spread beyond individual sessions and sustain over time."} {:name "however", :name-key "however", :slug "however", :text "Without explicit structures, community benefits are uneven and some trainers feel isolated after the programme ends."} {:name "then", :name-key "then", :slug "then", :text "Build co-ownership into the programme: dedicated peer cohorts, shared adaptation reviews, and a visible pathway for trainers to contribute improvements and mentor new cohorts."} {:name "because", :name-key "because", :slug "because", :text "Co-ownership turns individual participation into collective momentum and reduces drop-off after the initial training wave."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "transcript1 t1-19; transcript1 t1-25; transcript3 t3-4."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Establish rotating peer cohorts with monthly check-ins.\n      - Create a contribution pathway for trainers to propose updates.\n      - Pair new trainers with a local or regional mentor."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: track cohort participation and peer-mentoring activity.\n      - metric: proportion of trainers contributing back within 6 months."}], :conclusion "Co-Ownership Engine [🤝/共 🌍/场]", :directives {:audience "programme-leads, community-managers, trainers", :sigils ["🤝/共"], :style "design-pattern", :title "Co-Ownership Engine", :tone "formal-analytic"}, :id "or/co-ownership-engine", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🤝/共" "🌍/场"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Co-Ownership Engine", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "DREAM Audit (Per Release) [💫/心 🌜/月]"} {:name "context", :name-key "context", :slug "context", :text "Release notes usually track technical changes, not shifts in desire, relationships, embodiment, autonomy, or multiplicity; inner drift remains invisible."} {:name "if", :name-key "if", :slug "if", :text "You want to track how work is changing the people and relationships around it, not just the feature set."} {:name "however", :name-key "however", :slug "however", :text "Under deadline pressure, emotional or ethical reflection feels off-topic; there is no structured space for it."} {:name "then", :name-key "then", :slug "then", :text "Attach a short DREAM Audit to each release: a brief paragraph reflecting on Desire, Relationality, Embodiment, Autonomy, and Multiplicity since the last iteration. Publish these alongside technical notes."} {:name "because", :name-key "because", :slug "because", :text "DREAM audits keep the project’s inner compass visible, helping teams align ongoing work with founding purpose and relational health."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Add DREAM notes to the next release of this catalogue.\n      - Link each DREAM audit from the release notes index to keep them findable.\n      - Invite individual contributors to contribute micro-audits and aggregate them.\n      - Visualise DREAM themes over time as a simple trend or word map."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: check each tagged release for a DREAM note.\n      - metric: releases read as letters from a living community rather than only change logs."}], :conclusion "DREAM Audit (Per Release) [💫/心 🌜/月]", :directives {:audience "core-team, facilitators, ethics-boards", :sigils ["🚴/只"], :style "design-pattern", :title "DREAM Audit (Per Release)", :tone "formal-analytic"}, :id "or/dream-audit-per-release", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚴/只" "💫/心" "🌜/月"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "DREAM Audit (Per Release)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Expectation Scaffold [🧭/规 📎/文]"} {:name "context", :name-key "context", :slug "context", :text "National T3 programmes attract diverse participants with uneven prior knowledge and shifting institutional mandates; ambiguity about what is required versus optional undermines delivery."} {:name "if", :name-key "if", :slug "if", :text "You want trainers to act confidently and consistently while still adapting locally."} {:name "however", :name-key "however", :slug "however", :text "Vague participation rules and undefined completion criteria leave trainers unsure what they can legitimately promise, and delivery fragments across institutions."} {:name "then", :name-key "then", :slug "then", :text "Publish a minimal expectation scaffold: required sessions, optional pathways, and a stated “ready-to-deliver” threshold. Provide a short, plain-language briefing on what T3 is and is not, plus a self-check checklist for trainers."} {:name "because", :name-key "because", :slug "because", :text "Clarity lowers cognitive load, reduces mismatch between expectations and capacity, and improves coordination across distributed trainers."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "transcript1 t1-1; transcript2A t2a-15; transcript2B t2b-1."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Create a one-page “T3 in Brief” with required/optional components.\n      - Define a minimal competency checklist with examples of acceptable adaptations.\n      - Add an onboarding call focused on expectations and scope."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: review and update the scaffold annually with trainer input.\n      - metric: trainers report clarity on requirements before first delivery."}], :conclusion "Expectation Scaffold [🧭/规 📎/文]", :directives {:audience "programme-leads, trainers, policy-owners", :sigils ["🧭/规"], :style "design-pattern", :title "Expectation Scaffold", :tone "formal-analytic"}, :id "or/expectation-scaffold", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🧭/规" "📎/文"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Expectation Scaffold", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Feedback-Activation Loop [🔁/促 📊/度]"} {:name "context", :name-key "context", :slug "context", :text "Trainers note that engagement and feedback are crucial for improving delivery and sustaining motivation, but current feedback mechanisms are thin."} {:name "if", :name-key "if", :slug "if", :text "You want long-term impact and evidence of cultural change beyond one-off sessions."} {:name "however", :name-key "however", :slug "however", :text "Reliance on optional surveys misses signal; trainers lack feedback on impact and cannot easily demonstrate reach."} {:name "then", :name-key "then", :slug "then", :text "Establish a lightweight feedback loop: short post-session pulse, 3-6 month follow-up, and a visible impact log. Pair this with a rotation of “impact stories” that travel across cohorts."} {:name "because", :name-key "because", :slug "because", :text "Regular feedback sustains motivation, reveals adaptation needs, and supports accountability."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "transcript2B t2b-41; transcript2B t2b-39; transcript1 t1-18."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Add a two-question pulse survey after each session.\n      - Run a quarterly impact story round-up shared across cohorts.\n      - Provide a simple template for reporting reach and learning."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: review impact logs in quarterly tune audits.\n      - metric: proportion of trainers submitting at least one impact story per year."}], :conclusion "Feedback-Activation Loop [🔁/促 📊/度]", :directives {:audience "programme-leads, evaluators, trainers", :sigils ["🔁/促"], :style "design-pattern", :title "Feedback-Activation Loop", :tone "formal-analytic"}, :id "or/feedback-activation-loop", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🔁/促" "📊/度"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Feedback-Activation Loop", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Fit-for-Use Stars [🌝/用 💎/正]"} {:name "context", :name-key "context", :slug "context", :text "The five-star open data ladder encourages continuous improvement but can paralyse teams who feel they must reach “perfect” before sharing."} {:name "if", :name-key "if", :slug "if", :text "You want data to be genuinely usable — shared early enough to matter, clear enough to trust, and structured enough for others to build on."} {:name "however", :name-key "however", :slug "however", :text "Pressure to hit high star levels delays deposit; ethics constraints and limited resources make full openness unrealistic."} {:name "then", :name-key "then", :slug "then", :text "Choose openness level by intended use rather than abstract ideal. Document it in a brief Use Note explaining trade-offs and planned upgrades. Treat openness as iterative design with scheduled enhancements."} {:name "because", :name-key "because", :slug "because", :text "Incremental sharing accelerates collaboration and preserves value; clear use-context prevents misinterpretation and sets realistic expectations for reuse."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish a Use Note for this catalogue’s data, with current star level and roadmap.\n      - Create a showcase of 2-, 3-, and 5-star datasets with annotated rationales.\n      - Develop a simple “Data Readiness Meter” visual tied to star levels."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: review Use Notes during readiness windows and tune upgrade plans.\n      - metric: datasets show staged improvements rather than long-delayed first releases."}], :conclusion "Fit-for-Use Stars [🌝/用 💎/正]", :directives {:audience "data-stewards, PIs, repository-teams", :sigils ["🚴/以"], :style "design-pattern", :title "Fit-for-Use Stars", :tone "formal-analytic"}, :id "or/fit-for-use-stars", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚴/以" "🌝/用" "💎/正"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Fit-for-Use Stars", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Five-P Rhythm for Impact [🎑/日 ➰/以]"} {:name "context", :name-key "context", :slug "context", :text "Open Research meetings drift between chatter and overload; agendas swell, actions blur, and participants leave unsure what was achieved."} {:name "if", :name-key "if", :slug "if", :text "You want meetings that reliably generate both concrete outcomes and shared understanding."} {:name "however", :name-key "however", :slug "however", :text "Teams swing between hyper-productive checklists and unfocused discussion; without scaffolding, every meeting starts from scratch."} {:name "then", :name-key "then", :slug "then", :text "Use the Five-P rhythm: People (who’s here), Process (what’s working), Plan (what’s next), Product (deliverables), Perspective (what’s been learned). Close with a short After-Action Review and add a sentence to a public changelog."} {:name "because", :name-key "because", :slug "because", :text "Five-P balances efficiency with reflection; AARs and changelogs clarify accountability and make impact visible over time."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Run editorial meetings for this catalogue using Five-P and publish the changelog.\n      - Produce a printable Five-P agenda/timer card.\n      - Collect stories of meetings improved by this pattern and share them."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: check that recurring meetings are documented with Five-P notes and AARs.\n      - metric: observers can infer project rhythm and decisions from meeting records alone."}], :conclusion "Five-P Rhythm for Impact [🎑/日 ➰/以]", :directives {:audience "meeting-chairs, project-leads, facilitation-teams", :sigils ["➰/以"], :style "design-pattern", :title "Five-P Rhythm for Impact", :tone "formal-analytic"}, :id "or/five-p-rhythm-for-impact", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["➰/以" "🎑/日"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Five-P Rhythm for Impact", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Friction-as-Feature [🔥/石 〰️/反]"} {:name "context", :name-key "context", :slug "context", :text "Integration efforts often aim to erase seams via automation and unification; but seamlessness can hide translation work and dilute accountability."} {:name "if", :name-key "if", :slug "if", :text "You need interoperability that preserves meaning differences, provenance, and stewardship across systems."} {:name "however", :name-key "however", :slug "however", :text "Cultural and managerial pressure prizes smooth dashboards and invisible handoffs; when errors appear, no one can see where translation went wrong."} {:name "then", :name-key "then", :slug "then", :text "Treat seams as features, not flaws. Name and document each seam (e.g., metadata crosswalks), maintain a Seam Registry with steward, cadence, rationale, and “what we’d lose if smoothed,” and hold brief, time-boxed Seam Debates to revisit design choices."} {:name "because", :name-key "because", :slug "because", :text "Constructive friction clarifies ownership, reduces schema drift, and fosters cross-team understanding. Visible seams are repairable edges rather than brittle failure points."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Create a public Seam Registry for this catalogue’s pipelines.\n      - Document one over-smoothed failure and one seam-preserving success.\n      - Publish a 15-minute Seam Debate format with guiding questions."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: include seam visibility and stewardship status in Tune Audits.\n      - metric: contributors can point to the main seams and explain why they exist."}], :conclusion "Friction-as-Feature [🔥/石 〰️/反]", :directives {:audience "data-stewards, integration-teams, architects", :sigils ["🔥/石"], :style "design-pattern", :title "Friction-as-Feature", :tone "formal-analytic"}, :id "or/friction-as-feature", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🔥/石" "〰️/反"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Friction-as-Feature", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Identifier Garden [🌳/田 🐞/友]"} {:name "context", :name-key "context", :slug "context", :text "Research ecosystems are dense with identifiers (DOI, ORCID, ROR, grant IDs); unmanaged, they become confusing “ID sprawl.”"} {:name "if", :name-key "if", :slug "if", :text "You value provenance, credit, and discoverability and want identifiers to enhance human understanding rather than burden it."} {:name "however", :name-key "however", :slug "however", :text "When IDs multiply without stewardship, they become bureaucratic weeds: outdated records, broken provenance, mismatched dashboards, and wasted reconciliation effort."} {:name "then", :name-key "then", :slug "then", :text "Curate identifiers as a garden. Publish an ID Map listing each identifier type, what it represents, who stewards it, and when it was issued or verified. Adopt a minimal set per project and prune regularly."} {:name "because", :name-key "because", :slug "because", :text "Explicit ID policies prevent drift, reduce maintenance overhead, and improve automated linking across DOI–ORCID–ROR triples. The garden metaphor frames IDs as living elements needing care."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish an Identifier Garden for this catalogue, with stewards and review dates.\n      - Build a simple Garden Check script to flag missing or stale IDs.\n      - Share a Garden Companion snippet for READMEs and metadata headers."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: review the ID Map during readiness windows for correctness and minimality.\n      - metric: each ID has an active steward and verified link in the last cycle."}], :conclusion "Identifier Garden [🌳/田 🐞/友]", :directives {:audience "information-specialists, repo-admins, research-office-staff", :sigils ["🌳/田"], :style "design-pattern", :title "Identifier Garden", :tone "formal-analytic"}, :id "or/identifier-garden", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌳/田" "🐞/友"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Identifier Garden", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "License-as-Story [🎎/口 👄/文]"} {:name "context", :name-key "context", :slug "context", :text "Standard licence boilerplate rarely communicates intent; badges look official but feel sterile, and newcomers cannot tell how to use work responsibly."} {:name "if", :name-key "if", :slug "if", :text "You want reciprocity and lineage, not just formal compliance, and you see licensing as a chance to express relationship, not only ownership."} {:name "however", :name-key "however", :slug "however", :text "Legal phrasing alienates non-specialists; people skim the code, miss the ethos, and maintainers end up policing misunderstandings."} {:name "then", :name-key "then", :slug "then", :text "Pair every legal licence with a short, human-readable License Story: “We chose X because… Please do… Please avoid… If unsure…” Optionally record a 60-second audio version spoken by a steward."} {:name "because", :name-key "because", :slug "because", :text "Narrative licence notes improve contributor understanding, reduce misuse, and spark richer conversations about attribution and reciprocity. The story turns licensing into a living social contract."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Record an audio Licence Story for this catalogue.\n      - Curate three exemplars (data, code, OER) using this format.\n      - Add guidance for awkward cases (mixed authorship, dual licences)."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: sample one Licence Story per repo during Tune Audits for tone and clarity.\n      - metric: new contributors correctly reuse and attribute assets without seeking extra permission."}], :conclusion "License-as-Story [🎎/口 👄/文]", :directives {:audience "maintainers, project-leads, legal-liaisons", :sigils ["💢/只"], :style "design-pattern", :title "License-as-Story", :tone "formal-analytic"}, :id "or/license-as-story", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/只" "🎎/口" "👄/文"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "License-as-Story", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "License Laddering [🔺/工 📐/正]"} {:name "context", :name-key "context", :slug "context", :text "Licensing confusion paralyses Open Research teams; drafts stall while contributors fear being “too open” or “not open enough.”"} {:name "if", :name-key "if", :slug "if", :text "You aim for maximal remixability while preserving dignity and traceable attribution."} {:name "however", :name-key "however", :slug "however", :text "Legal anxiety and moral caution pull toward NC/ND restrictions that persist long after their original justification."} {:name "then", :name-key "then", :slug "then", :text "Begin from a permissive default (e.g., CC BY) and step downward only when a written, reviewable harm model requires it. Assign each restriction a steward, rationale, and review date. Publish a short License Story beside each licence."} {:name "because", :name-key "because", :slug "because", :text "Evidence from OSS/OER shows permissive licences increase remix, translation, and classroom adoption. Harm models turn vague fear into auditable, time-limited clarity."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Add a Licence Story to this catalogue as a live exemplar.\n      - Create one contrasting case where restrictive terms are justified.\n      - Link to an “Open Commercialisation” draft pattern for value-capture questions."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: include licence review in quarterly Tune Audits (“Does this story still ring true?”).\n      - metric: visible commit history updating rationale, steward, or licence level."}], :conclusion "License Laddering [🔺/工 📐/正]", :directives {:audience "project-PIs, maintainers, library-leads", :sigils ["🔺/工"], :style "design-pattern", :title "License Laddering", :tone "formal-analytic"}, :id "or/license-laddering", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🔺/工" "📐/正"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "License Laddering", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Living Materials Stewardship [🌱/料 🔁/修]"} {:name "context", :name-key "context", :slug "context", :text "Trainers praise access to materials, but content quickly ages and requires local adaptation work that is rarely resourced."} {:name "if", :name-key "if", :slug "if", :text "You want materials to remain credible and easy to use across contexts."} {:name "however", :name-key "however", :slug "however", :text "Static resources drift from practice; updating is ad hoc, and trainers bear the cost of reworking content alone."} {:name "then", :name-key "then", :slug "then", :text "Treat materials as a living product: assign stewards, publish update cadence, and provide a lightweight change log. Add an adaptation log so local changes can be upstreamed or documented."} {:name "because", :name-key "because", :slug "because", :text "Stewardship reduces drift, distributes maintenance work, and increases trust in the materials."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "transcript1 t1-9; transcript1 t1-15; transcript2B t2b-9."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Create a quarterly update rhythm with named maintainers.\n      - Add a one-page adaptation log template to each module.\n      - Prioritize updates for sections flagged as outdated by trainers."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: run a short “materials health” review each quarter.\n      - metric: time since last update for each module."}], :conclusion "Living Materials Stewardship [🌱/料 🔁/修]", :directives {:audience "maintainers, curriculum-owners, trainers", :sigils ["🌱/料"], :style "design-pattern", :title "Living Materials Stewardship", :tone "formal-analytic"}, :id "or/living-materials-stewardship", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌱/料" "🔁/修"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Living Materials Stewardship", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Maintainer Care [🙌/友 🍵/心]"} {:name "context", :name-key "context", :slug "context", :text "Open projects depend on a few steady hands whose labour becomes invisible; burnout or departure can collapse continuity and tone."} {:name "if", :name-key "if", :slug "if", :text "You want sustainability grounded in care rather than heroism, recognising that bandwidth is finite."} {:name "however", :name-key "however", :slug "however", :text "Volunteer cultures often glorify self-sacrifice; metrics reward responsiveness, not rest, and burnout is individualised as “failure.”"} {:name "then", :name-key "then", :slug "then", :text "Embed maintainer care into governance: quiet hours, rotating responsibilities, small stipends or micro-funds for caretaking work, and peer check-ins about energy. Treat maintainership as a shared rhythm, not a permanent identity."} {:name "because", :name-key "because", :slug "because", :text "Projects that foreground wellbeing retain maintainers longer and sustain clearer, kinder communication; care is infrastructural, not ornamental."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish a Maintainer Care Charter for this catalogue.\n      - Document at least one care intervention and its observed effects.\n      - Add a “Care Pulse” survey item to Tune Audits for maintainers."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: monitor response times, care-pulse responses, and rotation of demanding roles.\n      - metric: maintainers self-report their work as sustainable and often energising."}], :conclusion "Maintainer Care [🙌/友 🍵/心]", :directives {:audience "maintainers, sponsors, community-stewards", :sigils ["🙌/友"], :style "design-pattern", :title "Maintainer Care", :tone "formal-analytic"}, :id "or/maintainer-care", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🙌/友" "🍵/心"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Maintainer Care", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Method/Documentary Split [📁/书 ✂️/分]"} {:name "context", :name-key "context", :slug "context", :text "In most projects, the protocol and the story collapse into a single document; methods are rewritten to match outcomes, hiding uncertainty and adaptation."} {:name "if", :name-key "if", :slug "if", :text "You value honesty, reproducibility, and institutional learning, and want future readers to see how discovery actually unfolded."} {:name "however", :name-key "however", :slug "however", :text "Fear of embarrassment or perceived loss of credibility leads teams to conceal deviations; journals reward polished linear narratives."} {:name "then", :name-key "then", :slug "then", :text "Publish two living artefacts: PROTOCOL.md (forward-looking intention and checks) and LOG.md (backward-looking account of what happened and what changed). Require both for releases and add a one-minute embodied reflection before signing off logs."} {:name "because", :name-key "because", :slug "because", :text "Separating plan from record normalises adaptation and preserves context. It accelerates troubleshooting, improves mentoring, and turns “failure” into documented learning."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Implement PROTOCOL.md and LOG.md for this catalogue.\n      - Assemble a gallery of split examples from different domains.\n      - Prototype a visual diff that overlays protocol and log changes."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: audit releases for presence and quality of both artefacts.\n      - metric: logs read as narratives of learning, not just checklists."}], :conclusion "Method/Documentary Split [📁/书 ✂️/分]", :directives {:audience "project-leads, lab-heads, qualitative-teams", :sigils ["🚴/只"], :style "design-pattern", :title "Method/Documentary Split", :tone "formal-analytic"}, :id "or/method-documentary-split", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚴/只" "📁/书" "✂️/分"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Method/Documentary Split", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Overlay Bridges [🚢/门 🌈/互]"} {:name "context", :name-key "context", :slug "context", :text "Academic publishing remains dominated by legacy journals even as Open Research grows; authors still need career-legible outputs."} {:name "if", :name-key "if", :slug "if", :text "You want more open practices without severing links to recognised venues."} {:name "however", :name-key "however", :slug "however", :text "“Open-only” reforms can trigger resistance and duplicate labour; authors fear outcomes that “do not count.”"} {:name "then", :name-key "then", :slug "then", :text "Build overlay bridges that route manuscripts through open, community-based review while retaining compatibility with target journals. Publish timelines and handoff packets (cover letter, review bundle) that show how reviews and revisions travel."} {:name "because", :name-key "because", :slug "because", :text "Overlay models shorten time-to-feedback, reuse reviewer effort, and preserve promotion-relevant outputs. They demonstrate coexistence rather than rupture between open and traditional systems."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Pilot an overlay handoff for this catalogue or a related paper.\n      - Publish a generic Overlay SOP and handoff packet template.\n      - Document one successful overlay and one failed attempt with lessons learned."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: track open-reviewed submissions that later appear in formal venues.\n      - metric: number of reusable review bundles shared across platforms."}], :conclusion "Overlay Bridges [🚢/门 🌈/互]", :directives {:audience "journal-editors, platform-designers, research-office-staff", :sigils ["💢/也"], :style "design-pattern", :title "Overlay Bridges", :tone "formal-analytic"}, :id "or/overlay-bridges", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/也" "🚢/门" "🌈/互"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Overlay Bridges", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Peripheral-to-Core Pathways [🏃/入 👈/中]"} {:name "context", :name-key "context", :slug "context", :text "Open communities often start with energetic newcomers at the margins, yet core roles ossify; newcomers circle indefinitely while veterans burn out."} {:name "if", :name-key "if", :slug "if", :text "You want growth through renewal, with newcomers becoming confident stewards and leaders over time."} {:name "however", :name-key "however", :slug "however", :text "Many groups equate “open” with “anyone can join,” without clear developmental routes; invisible hierarchies and extractive labour patterns persist."} {:name "then", :name-key "then", :slug "then", :text "Design explicit pathways: observe → co-do → steward. Each phase includes recognition (badges, micro-credentials), time-bound roles, and options to rotate out. Create a metaboliser process that turns complaints and conflicts into repair actions."} {:name "because", :name-key "because", :slug "because", :text "Transparent progression paths increase retention and distribute leadership more equitably; metabolising tensions into maintenance preserves trust."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish a Pathways Map for this catalogue’s contribution roles.\n      - Host a metaboliser session using recent tensions and document outcomes.\n      - Develop a badge rubric with sunset dates for stewardship roles."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: monitor steward rotation and newcomer advancement.\n      - metric: visible movement from periphery to core and back, with gratitude expressed in both directions."}], :conclusion "Peripheral-to-Core Pathways [🏃/入 👈/中]", :directives {:audience "community-stewards, network-organisers, programme-leads", :sigils ["🚴/也"], :style "design-pattern", :title "Peripheral-to-Core Pathways", :tone "formal-analytic"}, :id "or/peripheral-to-core-pathways", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚴/也" "🏃/入" "👈/中"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Peripheral-to-Core Pathways", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Platform Choreography [🎶/人 🚴/心]"} {:name "context", :name-key "context", :slug "context", :text "Open projects accumulate tools — GitHub, drives, Slack, Overleaf, wikis — each with its own rhythm. Notifications multiply; attention fragments; contributors burn out from noise rather than conflict."} {:name "if", :name-key "if", :slug "if", :text "You want predictable collaboration rhythms and treat attention as a shared resource to be guarded, not consumed."} {:name "however", :name-key "however", :slug "however", :text "Tools are added opportunistically; chats interrupt deep work; issue trackers overflow; volunteers lose track of when and where to contribute."} {:name "then", :name-key "then", :slug "then", :text "Treat the ecosystem as a dance, not a stack. Map tempos of each channel (daily, weekly, monthly), cap alerts per person, keep one slow “sketch” space and one fast coordination lane, and publish a Dance Card that shows when commits, triage, and reviews happen."} {:name "because", :name-key "because", :slug "because", :text "Predictable cadences correlate with contributor retention, fewer orphan branches, and clearer trust. Rhythm becomes a governance instrument instead of background noise."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish a Dance Card for this catalogue’s edit and release cycles.\n      - Compare metrics (merge rate, retention) before and after cadence changes.\n      - Share a choreography map overlaying platforms, tempos, and roles."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: quarterly rhythm review checking alert volume, merge velocity, and perceived “in-sync-ness.”\n      - metric: contributors report knowing when to show up and how to plug in."}], :conclusion "Platform Choreography [🎶/人 🚴/心]", :directives {:audience "platform-admins, dev-ops, community-maintainers", :sigils ["💤/也"], :style "design-pattern", :title "Platform Choreography", :tone "formal-analytic"}, :id "or/platform-choreography", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💤/也" "🎶/人" "🚴/心"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Platform Choreography", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Quality-by-Design Crowd [🎋/工 👀/正]"} {:name "context", :name-key "context", :slug "context", :text "Crowdsourcing and citizen science rely on many contributors whose data quality varies widely; naive policing or rejection erodes trust."} {:name "if", :name-key "if", :slug "if", :text "You need reliable data while treating contributors as collaborators rather than expendable labour."} {:name "however", :name-key "however", :slug "however", :text "Without embedded structure, volunteers guess expectations, receive late feedback, and become discouraged when work is rejected."} {:name "then", :name-key "then", :slug "then", :text "Build quality into the workflow: use gold-standard screening questions, embed spot-checks and instant feedback, and publish fairness, wage, and recognition policies. Frame correction as coaching."} {:name "because", :name-key "because", :slug "because", :text "Embedded calibration improves accuracy and retention better than post-hoc filtering; transparent fairness norms increase commitment and reduce conflict."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Create a Screening Bank template with gold questions and answer keys.\n      - Design feedback scripts or UI snippets for immediate, constructive responses.\n      - Publish a quality dashboard spec (precision/recall, agreement, retention)."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: regularly review calibration pass rates and feedback sentiment.\n      - metric: contributors describe feedback as helpful, and rejection rates fall without quality loss."}], :conclusion "Quality-by-Design Crowd [🎋/工 👀/正]", :directives {:audience "citizen-science-leads, crowdsourcing-teams, data-stewards", :sigils ["🎋/工"], :style "design-pattern", :title "Quality-by-Design Crowd", :tone "formal-analytic"}, :id "or/quality-by-design-crowd", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🎋/工" "👀/正"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Quality-by-Design Crowd", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Readiness Windows [🌄/旦 ⌛️/今]"} {:name "context", :name-key "context", :slug "context", :text "Continuous integration without temporal boundaries can become perpetual churn; major changes land at random, exhausting reviewers and users."} {:name "if", :name-key "if", :slug "if", :text "You value both responsiveness and reliability, aiming for deep innovation without undermining trust in shared infrastructure."} {:name "however", :name-key "however", :slug "however", :text "Uncoordinated change leads to version fatigue; people hesitate to build on unstable foundations, and governance becomes reactive firefighting."} {:name "then", :name-key "then", :slug "then", :text "Declare Readiness Windows — defined periods (e.g., quarterly) when schema-breaking or major changes are allowed. Outside windows, restrict changes to backward-compatible updates. Align audits, freezes, and celebrations with this schedule."} {:name "because", :name-key "because", :slug "because", :text "Temporal boundaries transform chaos into cadence. Predictable windows make change intentional, concentrate review effort, and create meaningful release moments."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish this catalogue’s change calendar with marked readiness windows.\n      - Tag schema-affecting changes with their window in git history.\n      - Design a “Window Badge” indicating last passed readiness review."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: monitor frequency of major changes outside declared windows.\n      - metric: declining emergency hotfixes and clearer anticipation of big shifts."}], :conclusion "Readiness Windows [🌄/旦 ⌛️/今]", :directives {:audience "maintainers, release-managers, steering-groups", :sigils ["🌄/旦"], :style "design-pattern", :title "Readiness Windows", :tone "formal-analytic"}, :id "or/readiness-windows", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌄/旦" "⌛️/今"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Readiness Windows", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Retirement Shelf [🍂/古 ➰/止]"} {:name "context", :name-key "context", :slug "context", :text "Over time, projects accumulate legacy artefacts that no longer fit current realities; without rituals for letting go, clutter and confusion grow."} {:name "if", :name-key "if", :slug "if", :text "You want to honour lineage while keeping the system light enough to move."} {:name "however", :name-key "however", :slug "however", :text "Deletion feels disrespectful; founders resist archival moves; newcomers keep tripping over outdated guidance."} {:name "then", :name-key "then", :slug "then", :text "Create a Retirement Shelf — a visible archive for superseded patterns or components. For each item, publish a Retirement Note explaining why it was useful, why it is no longer active, and what replaces it. Mark retirements with simple ceremonies or reflections."} {:name "because", :name-key "because", :slug "because", :text "Dignified endings preserve institutional memory without clutter. Visible lineage supports transparency and helps newcomers understand evolution of practice."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Initialise a Retirement Shelf for this catalogue and migrate one pattern into it.\n      - Record a short retirement reflection for that item.\n      - Draw a lineage map linking retired artefacts to their successors."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: during Tune Audits, consider retire/replace as valid outcomes and move items accordingly.\n      - metric: a slowly growing shelf with clear successors, signalling a culture that values endings as well as beginnings."}], :conclusion "Retirement Shelf [🍂/古 ➰/止]", :directives {:audience "pattern-stewards, archivists, core-team", :sigils ["💢/只"], :style "design-pattern", :title "Retirement Shelf", :tone "formal-analytic"}, :id "or/retirement-shelf", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/只" "🍂/古" "➰/止"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Retirement Shelf", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Snapshot-with-Story DOI [📥/文 📤/示]"} {:name "context", :name-key "context", :slug "context", :text "Repositories routinely mint DOIs, but deposits often feel opaque; readers see version numbers without understanding intent or trajectory."} {:name "if", :name-key "if", :slug "if", :text "You want releases to be both citable and alive, linking frozen artefacts to ongoing work."} {:name "however", :name-key "however", :slug "however", :text "Deposit workflows optimise for compliance, not communication; metadata is perfunctory, and DOIs become cold identifiers rather than narrative anchors."} {:name "then", :name-key "then", :slug "then", :text "Pair every DOI with a Release Story (~120 words) explaining what changed, what remains open, and how to cite. Each release bundles (a) immutable archive, (b) STORY.md, (c) link to the active workspace or repo."} {:name "because", :name-key "because", :slug "because", :text "Narrative DOIs see more accurate citation, fewer misuse tickets, and clearer reuse; they transform preservation into pedagogy by contextualising the snapshot."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish this pattern’s own Release Story and link it to its DOI.\n      - Curate examples of good Release Stories for data, code, and preprints.\n      - Add a CI hook to require STORY.md for each tagged release."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: sample three DOIs per audit and verify the presence and clarity of Release Stories.\n      - metric: fraction of releases with STORY.md and an active workspace link."}], :conclusion "Snapshot-with-Story DOI [📥/文 📤/示]", :directives {:audience "repository-managers, research-software-engineers, project-leads", :sigils ["👓/只"], :style "design-pattern", :title "Snapshot-with-Story DOI", :tone "formal-analytic"}, :id "or/snapshot-with-story-doi", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👓/只" "📥/文" "📤/示"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Snapshot-with-Story DOI", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Tune Audits (Quarterly) [🎐/节 💬/公]"} {:name "context", :name-key "context", :slug "context", :text "Libraries and frameworks accumulate noise over time; patterns that once sang drift out of tune, but maintenance focuses on bugs instead of meaning."} {:name "if", :name-key "if", :slug "if", :text "You want your project to remain alive and coherent, not merely operational."} {:name "however", :name-key "however", :slug "however", :text "Audits are often bureaucratic and postponed; “we’ll clean it up later” hides slow decay."} {:name "then", :name-key "then", :slug "then", :text "Hold quarterly Tune Audits. Randomly sample a small set of artefacts (e.g., three patterns) and ask, “Does this still sing?” Decide to renew, revise, or retire, and log short narrative notes rather than scores."} {:name "because", :name-key "because", :slug "because", :text "Lightweight, regular reflection keeps documentation aligned with practice. Tuning normalises revision and creates a public trail of living decisions."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Publish Tune Logs for this catalogue showing renew/revise/retire outcomes.\n      - Experiment with simple rituals (audio snippets, icons) to mark tuned items.\n      - Compare tuned vs. untuned sections for perceived energy and clarity."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: track participation in Tune Audits and follow-through on decisions.\n      - metric: steady flow of small revisions and occasional dignified retirements."}], :conclusion "Tune Audits (Quarterly) [🎐/节 💬/公]", :directives {:audience "pattern-stewards, product-owners, governance-groups", :sigils ["🎐/节"], :style "design-pattern", :title "Tune Audits (Quarterly)", :tone "formal-analytic"}, :id "or/tune-audits-quarterly", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🎐/节" "💬/公"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Tune Audits (Quarterly)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Two-Stage Fidelity (Registered Rhythm) [⌛️/土 ✊/义]"} {:name "context", :name-key "context", :slug "context", :text "Protocols inevitably evolve; without visibility, analytic flexibility becomes invisible bias and HARKing."} {:name "if", :name-key "if", :slug "if", :text "You want both transparency and creativity, preserving a clear record of intention while allowing adaptive learning."} {:name "however", :name-key "however", :slug "however", :text "Preregistration is often treated as bureaucracy; deviations are hidden, and rigid templates discourage exploration."} {:name "then", :name-key "then", :slug "then", :text "Use a two-stage rhythm. Stage-1 preregisters design, anticipated challenges, and threat models. Stage-2 publishes results plus an adherence audit using a Deviation Ledger that records justified changes as first-class data."} {:name "because", :name-key "because", :slug "because", :text "Registered Reports show that preregistration reduces bias, and explicit deviation logs preserve interpretability. Together they balance rigour and discovery."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "      - Preregister the next release of this catalogue and maintain a Deviation Ledger.\n      - Share ledger examples from both qualitative and quantitative projects.\n      - Draft an “Adaptive Protocols” companion pattern and link it here."} {:name "governance", :name-key "governance", :slug "governance", :text "      - practice: include Deviation Ledger review in Tune Audits.\n      - metric: proportion of deviations that are logged, justified, and discussed."}], :conclusion "Two-Stage Fidelity (Registered Rhythm) [⌛️/土 ✊/义]", :directives {:audience "methodologists, PIs, registry-admins, trialists", :sigils ["💢/以"], :style "design-pattern", :title "Two-Stage Fidelity (Registered Rhythm)", :tone "formal-analytic"}, :id "or/two-stage-fidelity", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/以" "⌛️/土" "✊/义"], :source-path "library/or/or.flexiarg", :sources [], :status :ok, :title "Two-Stage Fidelity (Registered Rhythm)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Bioliteracy & Open Value"} {:name "context", :name-key "context", :slug "context", :text "You are turning bioliteracy teaching assets into open research value without overloading staff."} {:name "IF", :name-key "if", :slug "if", :text "    BMS teaching already runs hands-on, data-rich pedagogy that yields reusable datasets, notebooks, and protocols."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    These artefacts stay siloed from research culture; teaching workloads are intense, data ethics complex, and open practice feels like “extra work.”"} {:name "THEN", :name-key "then", :slug "then", :text "    Treat BMS as the north-node chariot bridging teaching and research. Use Fit-for-Use Stars to calibrate openness, bring Quality-by-Design Crowd techniques into labs, and add a Citizen Co-Learning track so students and communities follow real research logic and publish interpretable outputs."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    When teaching artefacts are shared with calibrated openness, students gain researcher identity, BMS gains institutional visibility, and Brookes signals pedagogical excellence tied directly to Open Research value."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Pick one BMS module and map which artefacts can graduate to calibrated open outputs.]"}], :conclusion "Bioliteracy & Open Value", :directives {:audience "BMS educators, bioscience PIs, teaching leads, data-literacy coordinators", :sigils ["🌱/仁"], :style "design-pattern", :title "Bioliteracy & Open Value", :tone "formal-analytic"}, :id "or2/bioliteracy-open-value", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌱/仁"], :source-path "library/or2/bioliteracy-open-value.flexiarg", :sources [], :status :ok, :title "Bioliteracy & Open Value", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Data-Intensive Practice on Office-Centred Infrastructure"} {:name "context", :name-key "context", :slug "context", :text "You are exposing infrastructure seams so ECM can act without waiting for a full rebuild."} {:name "IF", :name-key "if", :slug "if", :text "    ECM researchers now rely on high-throughput, computational workflows, but institutional infrastructure is still tuned to desktop/Office-era assumptions."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Requests for advanced platforms are treated as costly edge cases, so unsupported clusters, brittle scripts, and risk-laden storage hacks proliferate."} {:name "THEN", :name-key "then", :slug "then", :text "    Surface seams instead of hiding them: document the pressure points between ECM workflows and central IT, build reversible Bridge-Before-Portal workflows (e.g., container recipes, Story DOI-linked notebooks), maintain an Identifier Garden for datasets/software, and hold seam debates to decide which frictions are intentional."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Making seams visible lets ECM plan around constraints, lowers institutional risk, and produces reusable assets without waiting for a full infrastructure overhaul; chariot nodes move faster when they know the terrain."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Log the top three ECM seam points and draft one reversible bridge workflow.]"}], :conclusion "Data-Intensive Practice on Office-Centred Infrastructure", :directives {:audience "ECM heads, IT leadership, research software engineers, data-intensive PIs", :sigils ["🎐/中"], :style "design-pattern", :title "Data-Intensive Practice on Office-Centred Infrastructure", :tone "formal-analytic"}, :id "or2/data-intensive-infrastructure-gap", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🎐/中"], :source-path "library/or2/data-intensive-infrastructure-gap.flexiarg", :sources [], :status :ok, :title "Data-Intensive Practice on Office-Centred Infrastructure", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Open Practice Beyond Hypothesis"} {:name "context", :name-key "context", :slug "context", :text "You are making practice-based research legible without forcing it into hypothesis templates."} {:name "IF", :name-key "if", :slug "if", :text "    Arts and performance research produces experiential, multimodal knowledge that resists hypothesis-driven templates."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Repository forms, REF narratives, and grant portals still assume linear methods, fixed datasets, and analytic prose, so practice-based work becomes distorted or underspecified."} {:name "THEN", :name-key "then", :slug "then", :text "    Name Arts as the west-node chariot: use License-as-Story and Story DOIs to contextualise practice, apply the Method/Documentary Split (PROTOCOL.md vs LOG.md) to separate intention from creative trace, and build small narrative bridges—audio snippets, annotated scores—instead of forcing data schemas."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Open Research serves Arts when it clarifies lineage, process, and situated intention; story-driven artefacts preserve dignity, reduce administrative friction, and let practice be legible without erasing its form."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Prototype one Arts deposit using the Method/Documentary Split and Story DOI.]"}], :conclusion "Open Practice Beyond Hypothesis", :directives {:audience "Arts researchers, practice-based PIs, research office partners, REF leads", :sigils ["🎐/文"], :style "design-pattern", :title "Open Practice Beyond Hypothesis", :tone "formal-analytic"}, :id "or2/open-practice-beyond-hypothesis", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🎐/文"], :source-path "library/or2/open-practice-beyond-hypothesis.flexiarg", :sources [], :status :ok, :title "Open Practice Beyond Hypothesis", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Progress Cylinder Assurance"} {:name "context", :name-key "context", :slug "context", :text "You want proof of movement well before a deadline rather than a last-minute scramble."} {:name "IF", :name-key "if", :slug "if", :text "    a task has an explicit SCHEDULED or DEADLINE date and an EFFORT estimate of 1h or more."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    work tends to bunch after the date, producing false signals of progress and unreliable delivery."} {:name "THEN", :name-key "then", :slug "then", :text "    require an early effort marker: log at least one work session totaling ≥ 1/3 of EFFORT no later than 3 days before the scheduled/deadline date; if that marker is missing, reschedule or split the task."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    cylinder-set guarantees are about partial evidence within a bounded prefix; early effort is a compact proof that work is moving through the pipe."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Add a check in the agenda view that flags tasks with EFFORT but no early effort marker.]"}], :conclusion "Progress Cylinder Assurance", :directives {:audience "OR Programme Manager, project leads, stewards", :sigils ["🌜/引"], :style "design-pattern", :title "Progress Cylinder Assurance", :tone "formal-analytic"}, :id "or2/progress-cylinder-assurance", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌜/引"], :source-path "library/or2/progress-cylinder-assurance.flexiarg", :sources [], :status :ok, :title "Progress Cylinder Assurance", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Shared Futures Beyond Atomised Incentives"} {:name "context", :name-key "context", :slug "context", :text "You are stabilising cross-disciplinary futures work so it survives incentive pressure."} {:name "IF", :name-key "if", :slug "if", :text "    SRF and EHL convene Brookes’ shared-futures agenda, yet academic incentives still reward individual outputs and leave network work unpaid or invisible."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Without explicit pathways, core members burn out, newcomers hover at the periphery, and the futures agenda stays fragile."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat SRF/EHL as the south-node chariot that carries cross-disciplinary futures work. Publish Peripheral-to-Core Pathways with rotation dates, add a Citizen Co-Learning track, and run gatherings on the Five-P rhythm so action and reflection stay in sync and justified in workload narratives."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    When shared-futures labour has visible routes, learning scaffolds, and simple meeting cadences, it strengthens participation, legitimises community stewardship in promotions, and keeps Brookes’ futures agenda alive under constraint."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Publish the pathway map and schedule one Five-P cadence pilot session.]\n    next[Use this pattern to frame the January sandpit scheduling and invitations.]"}], :conclusion "Shared Futures Beyond Atomised Incentives", :directives {:audience "SRF leads, EHL leadership, network organisers, programme leads", :sigils ["🌈/公"], :style "design-pattern", :title "Shared Futures Beyond Atomised Incentives", :tone "formal-analytic"}, :id "or2/shared-futures-beyond-atomised-incentives", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌈/公"], :source-path "library/or2/shared-futures-beyond-atomised-incentives.flexiarg", :sources [], :status :ok, :title "Shared Futures Beyond Atomised Incentives", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Spread Effort Assurance"} {:name "context", :name-key "context", :slug "context", :text "Some tasks need sustained attention across multiple days to avoid brittle output."} {:name "IF", :name-key "if", :slug "if", :text "    a task has EFFORT of 3h or more and a scheduled or deadline date."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    single-session completion hides uncertainty and leaves no space for reflection or correction."} {:name "THEN", :name-key "then", :slug "then", :text "    require work to be clocked on at least two distinct days before completion; otherwise split the task or schedule a review pass."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    effort spread creates natural review cycles and reduces the probability that rushed work ships unexamined."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Add a simple tag or property to mark multi-day work and surface it in agenda checks.]"}], :conclusion "Spread Effort Assurance", :directives {:audience "OR Programme Manager, project leads, stewards", :sigils ["👎/布"], :style "design-pattern", :title "Spread Effort Assurance", :tone "formal-analytic"}, :id "or2/spread-effort-assurance", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👎/布"], :source-path "library/or2/spread-effort-assurance.flexiarg", :sources [], :status :ok, :title "Spread Effort Assurance", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Steward of the Open Research Emporium"} {:name "context", :name-key "context", :slug "context", :text "You are naming library stewardship as the infrastructure that makes OR navigable."} {:name "IF", :name-key "if", :slug "if", :text "    Library OR teams quietly hold metadata, repositories, visibility, and preservation work that lets research feel navigable."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Their labour is framed as routine administration; workloads rise without recognition, and stewardship remains invisible even though it props up every School."} {:name "THEN", :name-key "then", :slug "then", :text "    Position the Library node as the Steward of an Open Research Emporium. Use Story DOIs, Identifier Gardens, and Platform Choreography to make deposits, licences, and showcases effortless, and curate a narrative Emporium page that links live projects to preserved artefacts."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    When stewardship is named as the ground the system stands on, it becomes negentropic—reducing duplication, clarifying provenance, and giving researchers trust that OR support lightens rather than loads their work."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Draft the Emporium page outline and identify 3 live projects to feature.]\n    next[Use this pattern to frame handover materials, case study templates, and video publication as stewardship work.]"}], :conclusion "Steward of the Open Research Emporium", :directives {:audience "Library OR teams, repository managers, research office partners, School leads", :sigils ["🌆/门"], :style "design-pattern", :title "Steward of the Open Research Emporium", :tone "formal-analytic"}, :id "or2/steward-emporium", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌆/门"], :source-path "library/or2/steward-emporium.flexiarg", :sources [], :status :ok, :title "Steward of the Open Research Emporium", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Brookes OR Dungeon-Crawl Topology"} {:name "context", :name-key "context", :slug "context", :text "You are making the OR topology visible so roles can navigate tensions and handoffs."} {:name "IF", :name-key "if", :slug "if", :text "    OR1 hydrated Brookes with licences, bridges, tune audits, and identifier patterns, yet nobody can see how PVC, ORPM, UKRN, Schools, and Library positions interlock."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Without a shared map, Open Research looks like scattered good ideas and unpaid extra jobs; mandate, coherence, horizon, and stewardship remain invisible tensions."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat OR1 as dungeon tiles and OR2 as Xiangqi-style pieces. Draw a Mojo-inspired topology with UP (UKRN), CENTER (Two Joes), DOWN (Library), and directional School nodes, and author a short OR2 pattern for each node that shows how OR1 techniques reduce the friction already on their desks. Use the map as the spine for transition workshops and handover."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    When roles can point to a position—split center, wizard-above, steward-below—they stop feeling like quirks and become parts of a single institutional engine; OR techniques turn into moves the nodes already need rather than burdensome extras."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Draft the topology map and validate it with one School lead and the ORPM.]"}], :conclusion "Brookes OR Dungeon-Crawl Topology", :directives {:audience "PVC-RI, OR Programme Manager, UKRN lead, School leads, Library OR teams", :sigils ["🗻/山"], :style "design-pattern", :title "Brookes OR Dungeon-Crawl Topology", :tone "formal-analytic"}, :id "or2/topology-dungeon-crawl", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🗻/山"], :source-path "library/or2/topology-dungeon-crawl.flexiarg", :sources [], :status :ok, :title "Brookes OR Dungeon-Crawl Topology", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Two Joes, One Mandate"} {:name "context", :name-key "context", :slug "context", :text "You are aligning mandate authority with integrative OR pattern leadership."} {:name "IF", :name-key "if", :slug "if", :text "    Brookes’ Open Research centerline is split between two roles—the PVC (mandate, REF-facing authority) and the OR Programme Manager (pattern literacy, integrative insight)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    The pair seldom co-steer; the PVC lacks time to use the ORPM’s maps, the ORPM lacks formal authority, and the UKRN horizon role floats above them, leaving Schools to see OR as abstract noise."} {:name "THEN", :name-key "then", :slug "then", :text "    Name the dual-center engine explicitly. Pair the PVC’s “excellence under constraint” tension with the ORPM’s translation of OR1 techniques into School-ready moves, and triangulate with the UKRN lead during recurring briefings. Publish a Center Brief summarising the mandate, topology, and next moves so each School can locate itself."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Authority and coherence rarely live in one office; treating them as a designed partnership turns Open Research into a negentropic force that reduces duplication and gives Schools a clear rationale rather than another committee."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Draft the Center Brief and circulate it to PVC, ORPM, and UKRN for alignment.]"}], :conclusion "Two Joes, One Mandate", :directives {:audience "PVC-RI, OR Programme Manager, UKRN lead, School leads", :sigils ["👥/中" "🔦/义"], :style "design-pattern", :title "Two Joes, One Mandate", :tone "formal-analytic"}, :id "or2/two-joes-one-mandate", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👥/中" "🔦/义"], :source-path "library/or2/two-joes-one-mandate.flexiarg", :sources [], :status :ok, :title "Two Joes, One Mandate", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "UKRN Horizon Bridge"} {:name "context", :name-key "context", :slug "context", :text "You are translating UKRN horizon signals into usable moves for Brookes leadership and Schools."} {:name "IF", :name-key "if", :slug "if", :text "    Brookes belongs to UKRN, giving it a long-arc vantage on trustworthy, reproducible practice across the sector."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    The UKRN lead sits far from day-to-day operations; without explicit ties to the Two Joes and Schools, horizon intelligence remains abstract and unused."} {:name "THEN", :name-key "then", :slug "then", :text "    Activate the UKRN lead as a horizon bridge: hold short quarterly altitude calls with PVC + ORPM, translate sector expectations into lightweight Bridge-Before-Portal moves (Story DOIs, licence narratives, shared templates), and cite UKRN alignment to justify incremental shifts rather than new committees."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    When horizon signals are routed through the centerline, Brookes gains negentropic alignment—less reinvention, stronger credibility with funders/REF, and practical improvements that feel supportive rather than imposed."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Schedule the first quarterly altitude call and capture a short bridge memo for Schools.]"}], :conclusion "UKRN Horizon Bridge", :directives {:audience "UKRN institutional lead, PVC-RI, OR Programme Manager, School leads", :sigils ["🌅/旦" "🗻/刊"], :style "design-pattern", :title "UKRN Horizon Bridge", :tone "formal-analytic"}, :id "or2/ukrn-horizon-bridge", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌅/旦" "🗻/刊"], :source-path "library/or2/ukrn-horizon-bridge.flexiarg", :sources [], :status :ok, :title "UKRN Horizon Bridge", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Xiangqi-Inspired Decorators"} {:name "context", :name-key "context", :slug "context", :text "You are making the OR2 topology readable at a glance with role decorators."} {:name "IF", :name-key "if", :slug "if", :text "    OR2 patterns describe tensions carried by distinct Brookes roles but there is no shared notation tying nodes to their positional logic on the topology map."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Without visible decorators, PVC, ORPM, UKRN, Library, and School roles blur; newcomers cannot tell whether a pattern concerns mandate, horizon, stewardship, or frontline action."} {:name "THEN", :name-key "then", :slug "then", :text "    Borrow symbolic Xiangqi cues—Cannon for UKRN (UP), General + Advisor for the Two Joes (CENTER), Elephant for Library (DOWN), Chariots for Schools—and render them as minimal icons that sit beside each pattern header. Publish a legend so non-specialists can parse the map instantly."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Decorators make institutional tensions legible at a glance, improving navigability, pattern casting, and recognition of positional constraints without resorting to heavy prose or cultural caricature."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Draft the icon legend and apply it to one pilot map page.]"}], :conclusion "Xiangqi-Inspired Decorators", :directives {:audience "OR Programme Manager, UKRN lead, PVC-RI, pattern authors, School contributors", :sigils ["🎴/艺"], :style "design-pattern", :title "Xiangqi-Inspired Decorators (Institutional Pieces)", :tone "formal-analytic"}, :id "or2/xiangqi-decorators", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🎴/艺"], :source-path "library/or2/xiangqi-decorators.flexiarg", :sources [], :status :ok, :title "Xiangqi-Inspired Decorators (Institutional Pieces)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "An autonomous agent must not take an irreversible or outward-facing action unilaterally; route it through a consent-gate — a first-class, recorded operator-approval step at the exact locus where the action would otherwise fire — so the act is auditable and the supervised→autonomous transition is a swap at one seam, not a re-architecture."} {:name "context", :name-key "context", :slug "context", :text "An autonomous loop can produce actions whose effects leave the system (sends, emails/EOIs, payments/invoices, publishes) or otherwise cannot be undone."} {:name "IF", :name-key "if", :slug "if", :text "    The agent's action space includes outward or irreversible acts AND it runs partly or fully unattended."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Blanket \"ask before everything\" wedges the loop — there is no autonomy left. Blanket \"act freely\" risks irreversible harm — there is no safety. And an approval that is an ad-hoc pause (not a recorded artifact) cannot be audited, replayed, or migrated to automation once trust is earned."} {:name "THEN", :name-key "then", :slug "then", :text "    Put a consent-gate at the action's locus. The agent acts autonomously on everything reversible and in-scope; for outward/irreversible acts it NAGs **with warrant** (per pattern-warranted-choice-point) and waits. The consent step emits a first-class `consent-gate-event` with an id that the executing action cites. Then: (a) every outward act is auditable to its approval; (b) supervised→autonomous migration = replacing the operator with an autopen at ONE known location, not rewiring the loop."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    WM-I4 is not \"the WM doesn't act\" — it is \"the WM doesn't act UNILATERALLY.\" The consent-gate is the precise locus of that distinction. Making consent a first-class artifact (rather than an implicit human-in-the-loop pause) is exactly what lets trust be migrated incrementally: the operator's judgment is substituted at a named seam, once and only once it is earned, with the whole history legible. An un-recorded pause cannot be safely automated because there is nothing to point the autopen at."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - The gate emits a typed `consent-gate-event` {:id :action :warrant-pattern :approved-by :approved-at | :declined}; the action cites the id (no orphan outward acts).\n    - Pairs with pattern-warranted-choice-point: the gate's NAG carries the warrant (which signed-off rule made this consent-required).\n    - The migration seam is the deliverable — track which consent classes have moved supervised→autopen and on what earned evidence.\n    - evidence: consent-gate-events per run; approve/decline/edit ratio; outward acts with vs without a cited consent id (the latter = a violation).\n    - evidence-shape: {:consent/events :int, :consent/approved :int, :consent/declined :int, :consent/edited :int, :orphan-outward-acts :int, :autopen-migrated-classes [:keyword]}"} {:name "DOES-NOT-APPLY", :name-key "does-not-apply", :slug "does-not-apply", :text "    Reversible, in-scope, low-blast-radius actions (gating them is pure friction). Internal computations with no outward effect (no consent surface needed)."} {:name "INSTANCES", :name-key "instances", :slug "instances", :text "    - The WM guardrails NAG outward/irreversible acts (sends/EOI/invoice) rather than executing them (`futon3c/wm/guardrails.clj` outward-op?).\n    - WM-GUARDRAILS-SPEC.md: the consent-gate / gate-at-merge posture (staging branch; Joe merges = the consent locus for code)."}], :conclusion "An autonomous agent must not take an irreversible or outward-facing action unilaterally; route it through a consent-gate — a first-class, recorded operator-approval step at the exact locus where the action would otherwise fire — so the act is auditable and the supervised→autonomous transition is a swap at one seam, not a re-architecture.", :directives {:audience "designers of (partly) unattended autonomous loops, guardrail authors, operators", :keywords ["consent" "outward-action" "irreversible" "autopen" "supervised-to-autonomous" "WM-I4" "first-class-artifact"], :references ["orchestration/pattern-warranted-choice-point" "war-machine/advanceability" "aif/admissibility"], :sigils ["✋/🔏"], :style "pattern", :title "The Consent Gate — Don't Act Unilaterally, Act Through a Recorded Approval Locus", :tone "declarative"}, :id "orchestration/consent-gate", :keywords ["consent" "outward-action" "irreversible" "autopen" "supervised-to-autonomous" "WM-I4" "first-class-artifact"], :projection-version "flexiarg-v0", :references ["orchestration/pattern-warranted-choice-point" "war-machine/advanceability" "aif/admissibility"], :scores {}, :sigils ["✋/🔏"], :source-path "library/orchestration/consent-gate.flexiarg", :sources [], :status :ok, :title "The Consent Gate — Don't Act Unilaterally, Act Through a Recorded Approval Locus", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Every choice-point in an autonomous loop should carry the pattern(s) that warrant it; a NAG (operator-gated choice) is precisely the fork the patterns cannot decide, surfaced to the operator WITH its warrant and the one specific gap — turning \"the system blocks you\" into \"your own rule is asking you to confirm one thing.\""} {:name "context", :name-key "context", :slug "context", :text "An autonomous agent (the WM) ranks and selects actions; some actions are operator-gated (outward/irreversible, self-modifying, off-goal, or not-yet-advanceable). The choice to act-or-defer is governed by a set of patterns/rules the operator signed off on earlier."} {:name "IF", :name-key "if", :slug "if", :text "    You have an autonomous decision loop whose choices are operator-consequential AND governed by a known set of signed-off patterns/rules (guardrails, admissibility, consent gates)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    A generic \"operator confirmation required\" block is illegible. The operator cannot tell whether it is their own rule firing or an arbitrary obstruction, so they either rubber-stamp it (the gate erodes to a no-op) or stall on it (the loop wedges). Worse, the patterns that DECIDE the autonomous picks are invisible too — the agent's \"warranted\" choices look like caprice from outside."} {:name "THEN", :name-key "then", :slug "then", :text "    Warrant every choice-point. (1) Each rule/pattern that governs a choice is named and recorded as the choice's **warrant** (reuse the existing `:fork-warrant` channel — frames already record the patterns applied at a fork). (2) An **autonomous** pick carries its warrant (the patterns that decided it) — recorded and auditable, not surfaced. (3) A **NAG** is the dual case: the patterns are silent, conflicting, or genuinely undecidable, so the choice is legitimately the operator's. Surface it with `{the firing pattern + its signed-off rationale, the specific undecidable gap, the minimal unblock}`. The NAG reads: *\"Because of pattern P — which you set — I can't decide this one thing; fill the gap and we roll.\"*"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    This is how a trusted human-AI handoff actually works in an interactive session: *\"I've read your complex spec; I just need your nod on this one small thing.\"* The warrant makes the block the operator's OWN rule rather than the machine's caprice, so consent is informed, fast, and trust-preserving — sometimes a quick \"yeah, let's roll,\" occasionally a real pause, but always over a legible gap. An unwarranted block is either rubber-stamped (defeating the gate's purpose) or stalls the loop (defeating autonomy). The NAG-as-undecidable-fork is the **dual** of the autonomous-pick-as-decided-fork: one pattern-warrant frame, two faces — decide-and-act vs cannot-decide-so-surface."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - The rule→pattern mapping is DATA, not code branches: a table `{guardrail-rule → {pattern-id, warrant-text, gap, unblock}}`, so warrants stay auditable and editable.\n    - Reuse `:fork-warrant` (futon3c/aif/loop_learning.clj) — a NAG is a fork whose warrant-patterns failed to decide; don't build a parallel channel.\n    - The warrant CITES flexiargs (orchestration/consent-gate, aif/admissibility, aif/niche-construction, war-machine/advanceability), so the operator can read the actual rationale they signed off on.\n    - Render the warrant in the operator view (needs-you / bulletin): pattern + signed-off-reason + the gap + the one unblock action.\n    - evidence: warranted-vs-generic NAG count; operator decision-latency on warranted vs generic NAGs; rubber-stamp rate (approvals with no dwell) as a trust-erosion signal.\n    - evidence-shape: {:nag/warranted :bool, :nag/pattern-id :keyword, :nag/gap :string, :nag/unblock :string, :decision/latency-ms :int, :decision/outcome <:approved|:declined|:edited>}"} {:name "DOES-NOT-APPLY", :name-key "does-not-apply", :slug "does-not-apply", :text "    Low-consequence, fully-reversible choices (the warrant overhead is unjustified — just act). Choices governed by NO pattern: then the right move is not to warrant the block but to author the missing pattern first (the gap is \"this case is unspecified,\" which is itself operator work)."} {:name "INSTANCES", :name-key "instances", :slug "instances", :text "    - The WM NAG (`futon3c/data/wm/needs-you.edn`): today carries a generic per-class `:why`; the upgrade attaches the firing guardrail rule's pattern-warrant.\n    - The interactive-session \"approve this one thing and we start rolling\" dynamic (Joe + claude-1) — the human prototype this pattern makes durable.\n    - The consent-gate on outward/irreversible acts (orchestration/consent-gate) is the warrant for one whole NAG class."}], :conclusion "Every choice-point in an autonomous loop should carry the pattern(s) that warrant it; a NAG (operator-gated choice) is precisely the fork the patterns cannot decide, surfaced to the operator WITH its warrant and the one specific gap — turning \"the system blocks you\" into \"your own rule is asking you to confirm one thing.\"", :directives {:audience "designers of autonomous decision loops (the War Machine), guardrail authors, operators", :keywords ["warrant" "fork-warrant" "NAG" "consent" "choice-point" "human-in-the-loop" "legible-handoff" "undecidable" "guardrail"], :references ["orchestration/consent-gate" "aif/admissibility" "aif/niche-construction" "war-machine/advanceability" "futon-theory/structural-tension-as-observation"], :sigils ["🚪/⊢"], :style "pattern", :title "Pattern-Warranted Choice-Points (and the NAG as the Undecidable Fork)", :tone "declarative"}, :id "orchestration/pattern-warranted-choice-point", :keywords ["warrant" "fork-warrant" "NAG" "consent" "choice-point" "human-in-the-loop" "legible-handoff" "undecidable" "guardrail"], :projection-version "flexiarg-v0", :references ["orchestration/consent-gate" "aif/admissibility" "aif/niche-construction" "war-machine/advanceability" "futon-theory/structural-tension-as-observation"], :scores {}, :sigils ["🚪/⊢"], :source-path "library/orchestration/pattern-warranted-choice-point.flexiarg", :sources [], :status :ok, :title "Pattern-Warranted Choice-Points (and the NAG as the Undecidable Fork)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A coding handoff to a worker agent is not a message; it is a MODELED OBJECT with a lifecycle, recorded in the mission document that owns it: spec + acceptance bar + gates at dispatch, job-id on send, bell-back summary + commit shas on return, review verdict at the gate — and the worker's commits carry a Mission: trailer so the output tape (code/v05/commit→mission) attributes the work mechanically. The record makes the handoff auditable by the same scope instruments that audit everything else in the mission."} {:name "context", :name-key "context", :slug "context", :text "One operator orchestrates several coding agents (Claude-family\n    reviewers/authors, Codex workers) under a subscription-runtime rebalance:\n    substantial coding flows to workers, the orchestrator holds review.\n    The dispatch volume is high (nine handoffs on 2026-06-11 alone) and the\n    mission documents are typed, scope-detected objects."} {:name "IF", :name-key "if", :slug "if", :text "    Handoffs are working well as messages — bells with goal, files,\n    acceptance bar, gates, and a bell-back contract (the CLAUDE.md\n    coding-handoff protocol, adopted 2026-06-03 to rebalance runtime)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    A handoff that lives only in the message channel is invisible to the\n    mission it serves. Six months later the mission doc says a thing was\n    built but not who built it, under what spec, against what acceptance\n    bar, or which commits answered it. The dispatch→result chain exists\n    only in job stores and chat scrollback — exactly the\n    logging-without-propagating trap. And the audit instruments\n    (scope detector, Skolem binding audit, the commit→mission output tape)\n    cannot see objects that were never written down."} {:name "THEN", :name-key "then", :slug "then", :text "    1. The mission INSTANTIATE section carries one record per handoff:\n       spec summary, acceptance one-liner, worker, Job: <job-id> stamped at\n       dispatch, Bell-back: filled on return (summary + commit shas +\n       review verdict).\n    2. The bell instructs the worker to include a \"Mission: <mission-id>\"\n       trailer in its commit messages, so commit→mission attribution is\n       declared, not inferred (provenance \"trailer\" beats\n       \"session-heuristic\" in the transducer's edge ranking).\n    3. The bell-back is reviewed at a real gate (author ≠ reviewer; re-run\n       the stated gates; findings fixed by the reviewer, not re-belled) and\n       the verdict enters the record.\n    4. Records use a stable textual form so the scope detector can bind\n       them (candidate binder: handoff, with job-id and bell-back state as\n       ends — a chip that turns from amber to green when the bell-back\n       lands)."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The pattern earns its place twice. From the COORDINATION standpoint it\n    extends social/scope-bounded-handoff: that pattern constrains what a\n    worker may touch; this one makes the whole exchange a first-class\n    object in the artifact that owns it. From the MODELING standpoint\n    (the deeper reason): a recorded handoff joins the mission's scope tree,\n    the Skolem audit's binding flow, and the commit→mission output tape —\n    the orchestration layer stops being exhaust and becomes part of the\n    system's model of its own work. What is recorded can be audited;\n    what is attributed can be queried; what is typed can be rendered."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      M-smart-emacs-cursor §6 (futon3c, 2026-06-11) — first full instance,\n      conducted by voice:\n      - H1 (completion-bubble subscriber → codex-1): spoken directive →\n        record typed into the mission by the agent cursor → bell\n        invoke-1781178866343-683-497c41fe (typed bell, kind request) →\n        bell-back ~25 min with commit bfdb482 — \"Mission:\n        M-smart-emacs-cursor\" trailer VERIFIED in the commit object, the\n        first mission-attributed commit in the stack's history → review\n        gate (check-parens OK, ert 4/4) → verdict typed back into the\n        record. Chain complete, every link on disk.\n      - H2 (watcher scope lane → codex-2): same form, job\n        invoke-1781178866664-684-b47bd48f, in flight at time of writing.\n      - Origin: runtime rebalancing experiment (Codex gets runtime when the\n        Claude subscription is the binding constraint), CLAUDE.md protocol\n        2026-06-03; ~9 dispatches on 2026-06-11 under it."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    1. Mint the handoff binder (15th) in mission_scope_detect.py once the\n       record form stabilizes; verdict-style coloring per bell-back state.\n    2. Join records to the transducer lane: a recorded job-id plus a\n       trailer-attributed commit should reconcile mechanically; flag\n       records whose commits never arrive (the undischarged-handoff smell).\n    3. Backfill records for the 2026-06-11 dispatch wave where the missions\n       they served still lack them."}], :conclusion "A coding handoff to a worker agent is not a message; it is a MODELED OBJECT with a lifecycle, recorded in the mission document that owns it: spec + acceptance bar + gates at dispatch, job-id on send, bell-back summary + commit shas on return, review verdict at the gate — and the worker's commits carry a Mission: trailer so the output tape (code/v05/commit→mission) attributes the work mechanically. The record makes the handoff auditable by the same scope instruments that audit everything else in the mission.", :directives {:audience "multi-agent coordinators, mission authors, futon3c implementers", :keywords ["handoff" "orchestration" "traceability" "bell" "mission" "commit-trailer" "review-gate" "multi-agent"], :references ["social/scope-bounded-handoff" "futon-theory/agent-contract" "futon-theory/proof-path" "mission-coherence/logic-model-before-code"], :style "pattern", :title "The Recorded Handoff — dispatch as a modeled object", :tone "analytic-foundational"}, :id "orchestration/recorded-handoff", :keywords ["handoff" "orchestration" "traceability" "bell" "mission" "commit-trailer" "review-gate" "multi-agent"], :projection-version "flexiarg-v0", :references ["social/scope-bounded-handoff" "futon-theory/agent-contract" "futon-theory/proof-path" "mission-coherence/logic-model-before-code"], :scores {}, :sigils [], :source-path "library/orchestration/recorded-handoff.flexiarg", :sources [], :status :ok, :title "The Recorded Handoff — dispatch as a modeled object", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a classifier rule defers as well as accepts, route the defers into an explicit typed channel and refine the rule from cluster shape in that channel."} {:name "context", :name-key "context", :slug "context", :text "An active classifier (auto-approve / hard-rule / heuristic) produces both accept and defer outcomes on real traffic."} {:name "IF", :name-key "if", :slug "if", :text "    The classifier's outcomes are operator-consequential AND its inputs shift over time (semantics drift, edge cases accumulate, false-positive/false-negative regimes change)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Without explicit failure-tracking, refinement happens by intuition or never. Free-text or unlogged defer reasons cannot be clustered. Continuous reflection burns operator attention; periodic reflection requires a typed substrate to reflect over."} {:name "THEN", :name-key "then", :slug "then", :text "    (1) Define defer reasons as a typed enum (closed set, named upfront, kept small). (2) Every defer writes a record `{:reason <enum>, :inputs <hash-or-summary>, :timestamp ...}` to an explicit channel. (3) Periodically (after a sweep, batch, or N events) cluster the channel by `:reason`, by `:reason × <secondary-dim>` (file extension, repo, user-id, whatever the domain offers), and by `:reason × <pattern-suffix>`. (4) Clusters that exceed a threshold (≥3 entries) surface as candidate-rule-refinement proposals: `\"N inputs deferred for reason R; consider refinement Y to accept them\"`. (5) Operator promotes (with edits), suppresses, or defers each candidate. Promoted refinements are appended to the rule's data-driven invariant set."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The defer queue is a prediction-error signal in the AIF sense — the rule's expected outcome was \"accept\" but the actual outcome was \"defer.\" Cluster patterns in the defer-reason space surface where the rule is consistently wrong. Each cluster IS a candidate refinement readable directly off the data, without the operator having to invent it. Rules that evolve from their own observed failures stay calibrated against drift; rules without this channel rot."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: count defers per period, broken down by reason; track distribution shape over time\n    - evidence: count candidate-rule proposals generated per reflection cycle; track promoted-vs-suppressed-vs-deferred ratio\n    - evidence: measure defer-rate reduction in the period following each promoted refinement (success metric: refinement-promoted → next-period defer-reduction)\n    - evidence: detect rule drift via defer-rate trajectory — sustained upward trend on a reason cluster means the rule is losing calibration on that axis\n    - evidence: assert the defer-reason enum stays closed-set (no schema drift); enum-extension is itself an operator decision worth tracking\n    - evidence-shape: {:defer/count :int, :defer/reasons {:keyword :int}, :defer/secondary-cluster {[:keyword :string] :int}, :candidates/proposed :int, :candidates/promoted :int, :candidates/suppressed :int, :defer-reduction-pct :float, :enum-extensions [:keyword]}"} {:name "DOES-NOT-APPLY", :name-key "does-not-apply", :slug "does-not-apply", :text "    Rules applied rarely or with low-consequence outcomes (overhead not justified). Domains where defer reasons cannot be enumerated (the typed channel is impossible). Systems where the operator cannot act on candidates promptly (the channel becomes a pile of unprocessed signals; the rule rots faster than it can evolve)."} {:name "INSTANCES", :name-key "instances", :slug "instances", :text "    - futon3c street-sweeper INV-17 v2 reflection 2026-05-25: 142 defers from one sweep → 5 coarse + ~10 fine-grained candidate-INVs; promoting one (INV-18 test-context-paths skip security check) reduced :security-sensitive-diff defers 34 → 3 on next sweep\n    - Spam filter false-positive learning (user \"not spam\" clicks = defer-channel)\n    - Compiler diagnostic refinement from `// suppress` cluster analysis\n    - Test-coverage gap analysis from skipped-test reasons\n    - Prediction-market resolution-failure mode mining"} {:name "RELATED", :name-key "related", :slug "related", :text "    - realtime/learn-as-you-go: also about logging what works/fails; this pattern is the structured, typed-channel + clustering variant specific to rule refinement (the prior pattern is freeform learning notes)\n    - aif/prediction-error: the underlying AIF-loop shape this pattern instantiates for rule design specifically (rather than for action selection)\n    - code-coherence/dead-code-hygiene: relates by analogy — also lets a rule's effect (unused-flag) feed back into the rule's evolution"}], :conclusion "When a classifier rule defers as well as accepts, route the defers into an explicit typed channel and refine the rule from cluster shape in that channel.", :directives {:audience "futon agents, classifier maintainers, rule-system designers", :sigils ["🌂/?"], :style "pattern", :title "Let Rules Evolve From Their Own Deferrals", :tone "technical"}, :id "orchestration/rule-evolves-from-its-deferrals", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌂/?"], :source-path "library/orchestration/rule-evolves-from-its-deferrals.flexiarg", :sources [], :status :ok, :title "Let Rules Evolve From Their Own Deferrals", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "For fast bounded coordination between two components, lift state into a shared substrate and keep messages as deltas."} {:name "context", :name-key "context", :slug "context", :text "Two components (agents, services, modules) coordinate via message-passing on a bounded task that requires several turns to closure."} {:name "IF", :name-key "if", :slug "if", :text "    Coordination requires more than one back-and-forth to reach closure, and each turn references context established in prior turns."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Messages that carry full context grow with each turn, become slow to parse + produce at high cadence, are brittle to single-message loss (recovery requires reconstructing context from scratch), and create attention overhead for whichever side has to re-read the bundled context every turn."} {:name "THEN", :name-key "then", :slug "then", :text "    Designate a shared substrate (a markdown scratch file, a key-value store, a typed-event log) as the single locus of state for the coordination. Each message carries only the delta — a Q, an A, a sha, a \"proceed\" signal. Both sides append; both sides read the substrate before responding rather than re-establishing context inside the message. Close with an explicit marker (e.g., `DONE: <sha>`) so the substrate itself records the coordination's end."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Lifting state out of the message stream decouples message-size from context-size. Coordination latency becomes (substrate-write + small-message-parse) rather than (full-context-parse + response-with-full-context). Single-message loss is recoverable from the substrate. Recoverability + smaller messages + cheaper parse compound across turns; the cadence supports more turns per unit of operator attention."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: measure message-bytes per turn vs substrate-bytes — substrate-bytes should dominate; ratio < 0.2 implies the substrate is doing its job\n    - evidence: count turns to closure under both protocols (state-in-message vs state-in-substrate) on a comparable task; expect ≥2× turn-throughput for substrate variant\n    - evidence: simulate single-message loss; confirm recovery is possible from substrate alone\n    - evidence: assess substrate-maintenance overhead — when it approaches or exceeds the message-passing savings, the pattern is misapplied (use unbounded-stream protocols instead)\n    - evidence-shape: {:substrate/path :string, :substrate/bytes :int, :message/bytes-mean :int, :turns-to-closure :int, :loss-recovery-possible? :boolean, :substrate-overhead-ms :int, :message-latency-ms :int}"} {:name "DOES-NOT-APPLY", :name-key "does-not-apply", :slug "does-not-apply", :text "    One-shot async handoffs (substrate adds overhead with no coordination benefit). Pure-event-stream protocols (substrate creates an attractor that distorts the protocol toward shared-state assumptions; use event-sourcing patterns instead). Unbounded streams (the closure marker is the structural exit; without bounded scope, the substrate grows without recovery)."} {:name "INSTANCES", :name-key "instances", :slug "instances", :text "    - futon3c hop-wiring collab 2026-05-25: scratch at ~/code/storage/hop-wiring-scratch.md + 4 brief whistles → E-pilot-hop-trigger-wiring v1 shipped. Each whistle was a Q or A delta; scratch carried full state.\n    - Shared AST between compiler passes (vs message-passing per transform)\n    - Google Doc + Slack pings (vs reproducing the whole doc in every Slack message)\n    - Microservices with shared cache + small RPC payloads (vs full-payload RPC)\n    - Git as coordination substrate + brief PR comments (vs emailing patches)"} {:name "RELATED", :name-key "related", :slug "related", :text "    - realtime/authoritative-transcript: also about a single source of truth, but transcript-focused (replay semantics for late joiners); this pattern is about lifting state for active coordination cadence\n    - realtime/structured-events-only: keeps message shape disciplined; complementary\n    - social/scope-bounded-handoff: bounded-task framing is a precondition for this pattern"}], :conclusion "For fast bounded coordination between two components, lift state into a shared substrate and keep messages as deltas.", :directives {:audience "futon agents, multi-agent collaborators, distributed-systems designers", :sigils ["📁/?"], :style "pattern", :title "Lift State Into Shared Substrate; Keep Messages As Deltas", :tone "technical"}, :id "orchestration/state-in-substrate-deltas-in-messages", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["📁/?"], :source-path "library/orchestration/state-in-substrate-deltas-in-messages.flexiarg", :sources [], :status :ok, :title "Lift State Into Shared Substrate; Keep Messages As Deltas", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Earlier framings — p4ng-era multi-agent simulation, conceptual\n  sketches around mana-as-budget — treated AGENTS as the natural\n  unit of mana accounting. This was wrong, in a way that became\n  visible only after the substrate framing landed. Mana attaches to\n  SESSIONS, not agents. The agent-as-unit reading is preserved here\n  as a flawed precursor — useful to read, useful to point to, not\n  useful to act from."} {:name "context", :name-key "context", :slug "context", :text "    p4ng-era pattern work modelled futon agents as semi-autonomous\n    actors whose budget/license could meaningfully be tracked\n    per-actor. The framing made sense in a multi-agent simulation\n    context where each agent ran its own loop. It did not survive\n    contact with operational reality, where:\n      - One operator's session typically routes through multiple\n        agents (Claude REPL, Codex, Tickle, Forum bots) in tight\n        sequence, each contributing partial work to one coherent\n        chunk.\n      - The *felt cost* of allostatic load is borne by the operator,\n        not by any individual agent. An agent has no metabolism\n        beyond its turn.\n      - Block-closure (the source of mana awards per\n        `structure/mana-allostasis`) is an operator-attestable act,\n        not an agent action."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "DIAGNOSTIC", :name-key "diagnostic", :slug "diagnostic", :text "      Whenever discussing budget/license/mana around agents, check the\n      unit. If \"agent X is over budget\" is the claim, ask: what would\n      the analogous claim about the *session* containing agent X\n      look like? If it loses meaning, the agent-unit framing has\n      snuck in. Restore the session-unit framing."} {:name "REFERENCES", :name-key "references", :slug "references", :text "      - structure/mana-allostasis — formalises the balance equation with sessions as the temporal frame.\n      - structure/block-as-futonic-revolution — defines block-closure as operator-attestable.\n      - invariant-coherence/drain-channel-shape — drain channels under the mana-allostasis faculty; sibling pluri-channel framing.\n      - p4ng/p4ng-agents — the precursor multi-agent framing this note corrects.\n      - M-bounded-in-flight-state V-6 — the verification thread that surfaced the unit error and named it."} {:name "WHAT-CARRIES-FORWARD", :name-key "what-carries-forward", :slug "what-carries-forward", :text "      The precursor was right about the *shape* of the problem (some\n      notion of budget/credit/dana is needed; pure unbounded action\n      selection is wrong). It was wrong about the *unit*. The fix is\n      to keep the budget concept and reattach it to sessions:\n        - `nonstarter_mana.clj`'s `--session` parameter is the\n          operational evidence that the corrected unit is already in\n          production code.\n        - `structure/mana-allostasis` formalises balance per session.\n        - The candidate invariant `budgeted-action-selection/mana-gated-work`\n          (futon5a queue run-064) is the family-level expression of\n          the same shape with the corrected unit."} {:name "WHAT-WENT-WRONG", :name-key "what-went-wrong", :slug "what-went-wrong", :text "      The precursor framing made three structural assumptions that\n      looked plausible and turned out not to hold:\n        1. *Agent autonomy* — that agents have enough independent\n           continuity to bear a budget across turns. They don't; an\n           agent's continuity lives in the session that hosts it.\n        2. *Unit-of-attestation* — that agents can attest their own\n           work-completion. They can't, in any way that survives the\n           operator's distinct sense of \"this is done.\" Block-closure\n           requires operator attestation (see\n           `structure/block-as-futonic-revolution`).\n        3. *Per-agent metabolic state* — that \"this agent is tired\"\n           is meaningful. It isn't. The operator is the one who tires;\n           agents are stateless across calls."}], :conclusion "  Earlier framings — p4ng-era multi-agent simulation, conceptual\n  sketches around mana-as-budget — treated AGENTS as the natural\n  unit of mana accounting. This was wrong, in a way that became\n  visible only after the substrate framing landed. Mana attaches to\n  SESSIONS, not agents. The agent-as-unit reading is preserved here\n  as a flawed precursor — useful to read, useful to point to, not\n  useful to act from.", :directives {:audience "pattern theorists, anyone reading the mana-allostasis frame and wondering where the unit came from", :factor "Discernment (vipassanā) — naming a flawed precursor explicitly so it can be inherited usefully", :keywords ["mana" "agent" "session" "unit" "precursor" "p4ng" "attribution"], :references ["structure/mana-allostasis" "structure/block-as-futonic-revolution" "invariant-coherence/drain-channel-shape" "p4ng/p4ng-agents"], :sigils ["📜/誤"], :style "precursor-note", :title "Agent-as-Mana-Unit Was the Wrong Unit (precursor note)", :tone "analytic-historical"}, :id "p4ng/agent-as-mana-unit-was-the-wrong-unit", :keywords ["mana" "agent" "session" "unit" "precursor" "p4ng" "attribution"], :projection-version "flexiarg-v0", :references ["structure/mana-allostasis" "structure/block-as-futonic-revolution" "invariant-coherence/drain-channel-shape" "p4ng/p4ng-agents"], :scores {}, :sigils ["📜/誤"], :source-path "library/p4ng/agent-as-mana-unit-was-the-wrong-unit.flexiarg", :sources [], :status :ok, :title "Agent-as-Mana-Unit Was the Wrong Unit (precursor note)", :typed-slots nil} #:pattern{:clauses [{:name "instantiated-by", :name-key "instantiated-by", :slug "instantiated-by", :text "Boundary Oscillation"} {:name "context", :name-key "context", :slug "context", :text "MAS agents engage across different domains or networks."} {:name "if", :name-key "if", :slug "if", :text "Norms, roles, or goals diverge significantly."} {:name "however", :name-key "however", :slug "however", :text "Agents retain memory of shared pattern lineage."} {:name "then", :name-key "then", :slug "then", :text "Activate a boundary-negotiation sequence to recalibrate alignment."} {:name "because", :name-key "because", :slug "because", :text "Distributed systems must reconverge periodically to maintain coherence."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Log one concrete instance of this pattern in the futon3 ledger."} {:name "evidence-base", :name-key "evidence-base", :slug "evidence-base", :text "    - Ostrom emphasises boundary negotiation in polycentric governance.\n    - Cross-domain AI coordination frameworks highlight the need for periodic re-alignment."}], :conclusion "Boundary Oscillation", :directives {:audience "MAS designers, institutional theorists, multi-agent governance researchers", :sigils ["💢/了"], :style "design-pattern", :title "Boundary Oscillation", :tone "formal-analytic"}, :id "p4ng/boundary-oscillation", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/了"], :source-path "library/p4ng/p4ng-agent-environments.multiarg", :sources [], :status :ok, :title "Boundary Oscillation", :typed-slots nil} #:pattern{:clauses [{:name "instantiated-by", :name-key "instantiated-by", :slug "instantiated-by", :text "Disruption Traceback"} {:name "context", :name-key "context", :slug "context", :text "Misuse or breakdown of patterns occurs in MAS."} {:name "if", :name-key "if", :slug "if", :text "Harmful consequences go unaddressed."} {:name "however", :name-key "however", :slug "however", :text "System logs trace the source behaviour."} {:name "then", :name-key "then", :slug "then", :text "Initiate proportionate review and corrective pattern feedback."} {:name "because", :name-key "because", :slug "because", :text "Accountability mechanisms reinforce shared norms."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Log one concrete instance of this pattern in the futon3 ledger."} {:name "evidence-base", :name-key "evidence-base", :slug "evidence-base", :text "    - Governance frameworks emphasise traceability to maintain accountability.\n    - Safety-critical systems rely on post-incident analysis for learning."}], :conclusion "Disruption Traceback", :directives {:audience "MAS designers, institutional theorists, multi-agent governance researchers", :sigils ["💢/引"], :style "design-pattern", :title "Disruption Traceback", :tone "formal-analytic"}, :id "p4ng/disruption-traceback", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/引"], :source-path "library/p4ng/p4ng-agent-environments.multiarg", :sources [], :status :ok, :title "Disruption Traceback", :typed-slots nil} #:pattern{:clauses [{:name "instantiated-by", :name-key "instantiated-by", :slug "instantiated-by", :text "Institutional Drift"} {:name "context", :name-key "context", :slug "context", :text "Repeated MAS sessions produce cumulative outcomes."} {:name "if", :name-key "if", :slug "if", :text "Pattern use becomes routinised."} {:name "however", :name-key "however", :slug "however", :text "Changing contexts or challenges are not reflected in pattern updates."} {:name "then", :name-key "then", :slug "then", :text "Trigger a meta-level PAR to recontextualise relevance."} {:name "because", :name-key "because", :slug "because", :text "Institutions require periodic re-grounding to avoid ossification."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Log one concrete instance of this pattern in the futon3 ledger."} {:name "evidence-base", :name-key "evidence-base", :slug "evidence-base", :text "    - Ostrom’s design principles stress ongoing adaptation to changing contexts.\n    - Organisational learning research shows that routinised behaviour leads to drift without periodic review."}], :conclusion "Institutional Drift", :directives {:audience "MAS designers, institutional theorists, multi-agent governance researchers", :sigils ["💢/了"], :style "design-pattern", :title "Institutional Drift", :tone "formal-analytic"}, :id "p4ng/institutional-drift", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/了"], :source-path "library/p4ng/p4ng-agent-environments.multiarg", :sources [], :status :ok, :title "Institutional Drift", :typed-slots nil} #:pattern{:clauses [{:name "instantiated-by", :name-key "instantiated-by", :slug "instantiated-by", :text "Legitimate Iteration"} {:name "context", :name-key "context", :slug "context", :text "Agents propose updates to patterns or governance processes."} {:name "if", :name-key "if", :slug "if", :text "Authority to revise is unclear."} {:name "however", :name-key "however", :slug "however", :text "Stakeholders share a precedent for collaborative evolution."} {:name "then", :name-key "then", :slug "then", :text "Apply an iteration-validation protocol to confirm legitimacy."} {:name "because", :name-key "because", :slug "because", :text "Transparent mechanisms for revision build trust and resilience."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Log one concrete instance of this pattern in the futon3 ledger."} {:name "evidence-base", :name-key "evidence-base", :slug "evidence-base", :text "    - Collaborative governance relies on agreed mechanisms for rule evolution.\n    - Versioning and validation procedures in software communities show the value of transparent change processes."}], :conclusion "Legitimate Iteration", :directives {:audience "MAS designers, institutional theorists, multi-agent governance researchers", :sigils ["😻/由"], :style "design-pattern", :title "Legitimate Iteration", :tone "formal-analytic"}, :id "p4ng/legitimate-iteration", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["😻/由"], :source-path "library/p4ng/p4ng-agent-environments.multiarg", :sources [], :status :ok, :title "Legitimate Iteration", :typed-slots nil} #:pattern{:clauses [{:name "instantiated-by", :name-key "instantiated-by", :slug "instantiated-by", :text "Norm Seed"} {:name "context", :name-key "context", :slug "context", :text "A new MAS instance is initiated."} {:name "if", :name-key "if", :slug "if", :text "No clear shared norms exist."} {:name "however", :name-key "however", :slug "however", :text "Some agents hold relevant precedents."} {:name "then", :name-key "then", :slug "then", :text "Seed the interaction with minimal, foundational mini-patterns to set direction."} {:name "because", :name-key "because", :slug "because", :text "Early framing disproportionately shapes long-term behaviour."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Log one concrete instance of this pattern in the futon3 ledger."} {:name "evidence-base", :name-key "evidence-base", :slug "evidence-base", :text "    - Commons governance literature highlights initial rule-setting as critical.\n    - Social computing research shows early norms guide emergent behaviour."}], :conclusion "Norm Seed", :directives {:audience "MAS designers, institutional theorists, multi-agent governance researchers", :sigils ["💢/以"], :style "design-pattern", :title "Norm Seed", :tone "formal-analytic"}, :id "p4ng/norm-seed", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/以"], :source-path "library/p4ng/p4ng-agent-environments.multiarg", :sources [], :status :ok, :title "Norm Seed", :typed-slots nil} #:pattern{:clauses [{:name "instantiated-by", :name-key "instantiated-by", :slug "instantiated-by", :text "Pattern Dispute Dialogue"} {:name "context", :name-key "context", :slug "context", :text "Agents disagree over pattern interpretation or application."} {:name "if", :name-key "if", :slug "if", :text "Conflicts stall progress."} {:name "however", :name-key "however", :slug "however", :text "Shared design principles are available."} {:name "then", :name-key "then", :slug "then", :text "Launch structured dialogue around contested pattern meaning."} {:name "because", :name-key "because", :slug "because", :text "Productive conflict resolution deepens co-understanding and evolves pattern clarity."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Log one concrete instance of this pattern in the futon3 ledger."} {:name "evidence-base", :name-key "evidence-base", :slug "evidence-base", :text "    - Dialogue-based conflict-resolution frameworks highlight structured conversation as a resolution tool.\n    - Pattern communities (e.g. PLoP) rely on structured dispute resolution to refine patterns."}], :conclusion "Pattern Dispute Dialogue", :directives {:audience "MAS designers, institutional theorists, multi-agent governance researchers", :sigils ["💬/口"], :style "design-pattern", :title "Pattern Dispute Dialogue", :tone "formal-analytic"}, :id "p4ng/pattern-dispute-dialogue", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💬/口"], :source-path "library/p4ng/p4ng-agent-environments.multiarg", :sources [], :status :ok, :title "Pattern Dispute Dialogue", :typed-slots nil} #:pattern{:clauses [{:name "instantiated-by", :name-key "instantiated-by", :slug "instantiated-by", :text "Proportional Load Sharing"} {:name "context", :name-key "context", :slug "context", :text "Tasks and pattern contributions vary in complexity."} {:name "if", :name-key "if", :slug "if", :text "Some agents consistently overcontribute."} {:name "however", :name-key "however", :slug "however", :text "Collective benefit requires equitable engagement."} {:name "then", :name-key "then", :slug "then", :text "Adjust incentives or redistribute roles to spread workload fairly."} {:name "because", :name-key "because", :slug "because", :text "Sustainable MAS practice requires balanced contribution patterns."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Log one concrete instance of this pattern in the futon3 ledger."} {:name "evidence-base", :name-key "evidence-base", :slug "evidence-base", :text "    - Distributed team management finds that chronic overcontribution harms group stability.\n    - Commons governance stresses proportionality as a fairness principle."}], :conclusion "Proportional Load Sharing", :directives {:audience "MAS designers, institutional theorists, multi-agent governance researchers", :sigils ["🚴/布"], :style "design-pattern", :title "Proportional Load Sharing", :tone "formal-analytic"}, :id "p4ng/proportional-load-sharing", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["