g "conclusion", :text "Offer multiple interpretive views (themes, timelines, geography) so different stakeholders can read the same story world."} {:name "context", :name-key "context", :slug "context", :text "You are serving diverse stakeholders who need different lenses on the same story world."} {:name "IF", :name-key "if", :slug "if", :text "    Participants and partners need different cuts."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    One canonical view cannot serve all."} {:name "THEN", :name-key "then", :slug "then", :text "    Provide small, composable queries/visuals that emphasise varied relationships."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Multi-view reading keeps the world inclusive and useful."} {:name "STATUS", :name-key "status", :slug "status", :text "    status[blocked]\n    blocked-by[vsatlas/view-library]"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Prototype two contrasting views against the same dataset.]\n    next[Define which two views to build first (based on stakeholder need) and measure whether interpretations diverge.]"}], :conclusion "Offer multiple interpretive views (themes, timelines, geography) so different stakeholders can read the same story world.", :directives {:sigils ["💢/几"], :title "Interpretive Views"}, :id "vsatlas/interpretive-views", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💢/几"], :source-path "library/vsatlas/vsat-vsatlas.multiarg", :sources [], :status :ok, :title "Interpretive Views", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Combine open infrastructure (VSATLAS) with expert practice layers so organisations can adopt the platform with guidance."} {:name "context", :name-key "context", :slug "context", :text "You are defining a paired offer so partners get infrastructure plus guided practice. This does not apply when a partner explicitly wants only consulting or only software."} {:name "IF", :name-key "if", :slug "if", :text "    Partners need both tech and practice."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Selling only software or only consulting leaves gaps."} {:name "THEN", :name-key "then", :slug "then", :text "    Offer an intertwined model—hosted infrastructure plus expert facilitation packages."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    This pairing speeds adoption and keeps governance healthy."} {:name "STATUS", :name-key "status", :slug "status", :text "    status[blocked]\n    blocked-by[vsatlas/offer-sheet]"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Translate pilot learnings into a two-layer offer doc.]\n    next[Define evidence signals (e.g., higher adoption vs infrastructure-only offers).]"}], :conclusion "Combine open infrastructure (VSATLAS) with expert practice layers so organisations can adopt the platform with guidance.", :directives {:sigils ["🚴/也"], :title "Open Infrastructure + Expert Practice"}, :id "vsatlas/open-infrastructure-expert-practice", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚴/也"], :source-path "library/vsatlas/vsat-vsatlas.multiarg", :sources [], :status :ok, :title "Open Infrastructure + Expert Practice", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Build VSATLAS so contributors can progress from authors to stewards to maintainers in an open ecosystem."} {:name "context", :name-key "context", :slug "context", :text "You are designing explicit progression so contributors can grow into co-governance roles. This does not apply to short-lived cohorts without maintenance needs."} {:name "IF", :name-key "if", :slug "if", :text "    VSAT already supports expressive entry."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    There is no path toward co-governance."} {:name "THEN", :name-key "then", :slug "then", :text "    Define roles, rituals, and contribution ladders that move people deeper into care for the manifold."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Open ecosystems thrive when progression is explicit."} {:name "STATUS", :name-key "status", :slug "status", :text "    status[blocked]\n    blocked-by[vsatlas/pathway-design]"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Map a sample contributor journey with checkpoints and cite it in futon3.]\n    next[Define progression signals (e.g., % of contributors advancing) and a failure signal (e.g., drop-off after first checkpoint).]"}], :conclusion "Build VSATLAS so contributors can progress from authors to stewards to maintainers in an open ecosystem.", :directives {:sigils ["🔦/门"], :title "Open Progression Ecosystem"}, :id "vsatlas/open-progression-ecosystem", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🔦/门"], :source-path "library/vsatlas/vsat-vsatlas.multiarg", :sources [], :status :ok, :title "Open Progression Ecosystem", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Specify VSATLAS as viewing, interpretation, and stewardship layers so relational meaning can emerge while stories stay trustworthy."} {:name "context", :name-key "context", :slug "context", :text "You are defining governance layers so linking can stay open while still accountable. This does not apply when link volume and sensitivity are low or when linking features are not yet available to test governance."} {:name "IF", :name-key "if", :slug "if", :text "    Linking must protect narrative sovereignty."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Free-form linking risks chaos and harm."} {:name "THEN", :name-key "then", :slug "then", :text "    Separate reading, proposing, and governing roles with clear criteria."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Layered governance balances openness with care."} {:name "STATUS", :name-key "status", :slug "status", :text "    status[blocked]\n    blocked-by[vsatlas/role-model]"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Draft the minimal role/data model and test against a use case.]\n    next[Define an apply signal (e.g., link volume or sensitivity threshold) and a governance failure test case.]\n    next[Ensure the minimal linking features exist before running governance pilots.]"}], :conclusion "Specify VSATLAS as viewing, interpretation, and stewardship layers so relational meaning can emerge while stories stay trustworthy.", :directives {:sigils ["🙇/几"], :title "Three-Layer Architecture"}, :id "vsatlas/three-layer-architecture", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🙇/几"], :source-path "library/vsatlas/vsat-vsatlas.multiarg", :sources [], :status :ok, :title "Three-Layer Architecture", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Use pilot-defined story subsets as anthology filters that reshape the\n  constellation to a focused sub-world, preserving all spatial and\n  relational affordances."} {:name "context", :name-key "context", :slug "context", :text "You are curating viewing experiences for different audiences or sessions from the same corpus. This does not apply when all stories are always relevant to all viewers."} {:name "IF", :name-key "if", :slug "if", :text "    A facilitator, exhibition, or course module needs a focused subset of\n    the full story world."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Showing everything overwhelms; building separate installations\n    duplicates effort."} {:name "THEN", :name-key "then", :slug "then", :text "    Reuse the pilot (anthology) model to filter stories at query time\n    (?pilot=N). The dome re-projects around fewer clusters, vertical\n    spread is clamped for small collections, and all navigation\n    (planetarium, geomview, VR) works on the filtered set."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Filtering is cheaper than forking. The same relational infrastructure\n    serves multiple curatorial frames without duplicating data or code."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Test whether small anthologies (2–4 stories) feel spatially coherent or sparse.]\n    next[Explore nested anthologies (pilot within pilot) for multi-session programmes.]\n    next[Add anthology selection to the VR interface (controller menu or gaze-based selector).]"}], :conclusion "  Use pilot-defined story subsets as anthology filters that reshape the\n  constellation to a focused sub-world, preserving all spatial and\n  relational affordances.", :directives {:audience "curators, facilitators, digital library architects", :references ["vsatlas/minimal-linking-pilot" "vsatlas/facilitation-scaffolds" "vsatlas/interpretive-views"], :sigils ["📚/选"], :style "design-pattern", :title "Anthology as Constellation Filter", :tone "analytic"}, :id "vsatlatarium/anthology-as-filter", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlas/minimal-linking-pilot" "vsatlas/facilitation-scaffolds" "vsatlas/interpretive-views"], :scores {}, :sigils ["📚/选"], :source-path "library/vsatlatarium/anthology-as-filter.flexiarg", :sources [], :status :ok, :title "Anthology as Constellation Filter", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Render inter-story links as coloured, curved arcs with type, status, and\n  rationale so relational meaning is visible geometry, not hidden metadata."} {:name "context", :name-key "context", :slug "context", :text "You are making the interpretive layer legible as spatial form. This does not apply when link volume is so high that arcs would become visual noise."} {:name "IF", :name-key "if", :slug "if", :text "    Viewers need to see why stories are connected — not just that they are."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Undifferentiated lines flatten thematic, causal, adjacency, and contrast\n    links into a single \"related\" signal."} {:name "THEN", :name-key "then", :slug "then", :text "    Colour arcs by link type, modulate opacity by status (accepted bright,\n    proposed mid, retired faint), and bow arcs inward (planetarium) or\n    outward (geomview) so they read as spatial bridges rather than flat\n    edges. Provide legend toggles to show/hide types independently."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Typed arcs externalise the interpretive grammar that VSATLAS\n    contributors use when proposing connections, making review and\n    discussion concrete rather than abstract."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Add arc hover interaction showing link rationale text in-scene.]\n    next[Measure whether typed arcs improve participants' ability to articulate connection reasons.]\n    next[Define a visual-noise threshold (arc count) where filtering or aggregation becomes necessary.]"}], :conclusion "  Render inter-story links as coloured, curved arcs with type, status, and\n  rationale so relational meaning is visible geometry, not hidden metadata.", :directives {:audience "narrative system designers, knowledge graph practitioners", :references ["vsatlas/non-destructive-relational-layers" "vsatlas/three-layer-architecture"], :sigils ["🌈/弧"], :style "design-pattern", :title "Arc as Typed Relation", :tone "analytic"}, :id "vsatlatarium/arc-as-typed-relation", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlas/non-destructive-relational-layers" "vsatlas/three-layer-architecture"], :scores {}, :sigils ["🌈/弧"], :source-path "library/vsatlatarium/arc-as-typed-relation.flexiarg", :sources [], :status :ok, :title "Arc as Typed Relation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Cache the O(N²) force-directed layout across requests so the planetarium\n  loads instantly when story data has not changed."} {:name "context", :name-key "context", :slug "context", :text "You are serving a 3D visualisation from SSR where layout computation is the bottleneck. This does not apply to client-side-only visualisations where the cost is borne by the browser."} {:name "IF", :name-key "if", :slug "if", :text "    The force-directed simulation (spring forces, repulsion, centering)\n    runs on every request, consuming CPU proportional to scene count\n    squared."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Story data changes rarely — most requests see the same constellation."} {:name "THEN", :name-key "then", :slug "then", :text "    Fingerprint the inputs (story IDs, scene counts, link IDs, view mode,\n    pilot filter) and cache the computed layout in a globalThis-backed\n    in-memory store. Invalidate automatically when the fingerprint changes."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    First-load computes; subsequent loads return instantly. This turned a\n    200% CPU incident on a 2-CPU host into sub-millisecond cache hits."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Add cache-hit/miss logging to measure real-world hit rate.]\n    next[Consider persisting the cache to disk for cold-start performance after server restart.]"}], :conclusion "  Cache the O(N²) force-directed layout across requests so the planetarium\n  loads instantly when story data has not changed.", :directives {:audience "platform engineers, digital library architects", :references ["vsatlatarium/cluster-as-story" "vsatlas/proof-of-concept-scope"], :sigils ["⚡/缓"], :style "design-pattern", :title "Cached Layout Computation", :tone "plain-analytic"}, :id "vsatlatarium/cached-layout-computation", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlatarium/cluster-as-story" "vsatlas/proof-of-concept-scope"], :scores {}, :sigils ["⚡/缓"], :source-path "library/vsatlatarium/cached-layout-computation.flexiarg", :sources [], :status :ok, :title "Cached Layout Computation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Represent each story as a spatial cluster of scene nodes so internal\n  narrative structure is visible alongside inter-story connections."} {:name "context", :name-key "context", :slug "context", :text "You are designing a visualisation that must convey both within-story structure and between-story relationships at a glance. This does not apply to single-story views where internal navigation is sufficient."} {:name "IF", :name-key "if", :slug "if", :text "    Viewers need to grasp both the shape of individual stories and how\n    they relate to one another."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Collapsing stories to single points hides internal richness;\n    flattening all scenes to one level hides story boundaries."} {:name "THEN", :name-key "then", :slug "then", :text "    Use a two-level layout: stories are clusters positioned on the dome\n    via golden-spiral distribution, and scenes within each cluster are\n    arranged by force-directed simulation around the cluster centre.\n    Narrative arcs (within) and interpretive links (between) are drawn\n    as distinct arc types."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Two-level clustering preserves the part-whole relationship that\n    makes a story more than a bag of scenes, while still exposing the\n    relational fabric that VSATLAS adds across stories."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Test legibility with 50+ stories to find the threshold where clusters overlap.]\n    next[Experiment with alternative intra-cluster layouts (radial, timeline) for stories with strong sequence.]"}], :conclusion "  Represent each story as a spatial cluster of scene nodes so internal\n  narrative structure is visible alongside inter-story connections.", :directives {:audience "narrative system designers, digital library architects", :references ["vsatlas/connected-story-world" "vsatlas/non-destructive-relational-layers"], :sigils ["🌌/文"], :style "design-pattern", :title "Cluster as Story, Node as Scene", :tone "analytic"}, :id "vsatlatarium/cluster-as-story", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlas/connected-story-world" "vsatlas/non-destructive-relational-layers"], :scores {}, :sigils ["🌌/文"], :source-path "library/vsatlatarium/cluster-as-story.flexiarg", :sources [], :status :ok, :title "Cluster as Story, Node as Scene", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Project story constellations onto a dome surface so the viewer occupies a\n  privileged interior position — reading outward rather than inspecting\n  from above."} {:name "context", :name-key "context", :slug "context", :text "You are choosing a spatial metaphor for browsing a connected story world. This does not apply when the corpus is small enough that a flat list suffices."} {:name "IF", :name-key "if", :slug "if", :text "    A collection of linked stories needs a spatial reading frame that\n    communicates immersion and equal proximity."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Flat graphs or tree views impose implicit hierarchies and lose the\n    sense of being surrounded by a world."} {:name "THEN", :name-key "then", :slug "then", :text "    Map story clusters onto the inner surface of a sphere (planetarium\n    model) so the viewer looks outward at the constellation from its\n    centre, with drag-to-rotate giving access to the full sky."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The dome equalises distance — every story is the same radius away,\n    and orientation replaces ranking as the primary navigation axis."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Measure whether dome vs flat-list affects exploration breadth (stories visited per session).]\n    next[Test with screen-reader users to define a non-visual equivalent of dome orientation.]"}], :conclusion "  Project story constellations onto a dome surface so the viewer occupies a\n  privileged interior position — reading outward rather than inspecting\n  from above.", :directives {:audience "narrative system designers, VSAT collaborators", :references ["vsatlas/connected-story-world" "vsatlas/interpretive-views"], :sigils ["🔭/天"], :style "design-pattern", :title "Dome Projection as Reading Frame", :tone "analytic"}, :id "vsatlatarium/dome-projection", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlas/connected-story-world" "vsatlas/interpretive-views"], :scores {}, :sigils ["🔭/天"], :source-path "library/vsatlatarium/dome-projection.flexiarg", :sources [], :status :ok, :title "Dome Projection as Reading Frame", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Treat VR headset navigation as a first-class mode where the viewer's body\n  (head orientation, hand pointing, controller buttons) replaces mouse and\n  scroll as the primary interface to the constellation."} {:name "context", :name-key "context", :slug "context", :text "You are designing for immersive hardware (Quest 2/3, future AR) where the viewer is physically inside the dome. This does not apply to desktop-only deployments."} {:name "IF", :name-key "if", :slug "if", :text "    The planetarium metaphor maps naturally to VR — the viewer is literally\n    inside a sphere of stories."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Porting mouse interactions to VR produces clumsy, imprecise pointing\n    at small targets with no tactile feedback."} {:name "THEN", :name-key "then", :slug "then", :text "    Add generous invisible hit volumes around nodes and labels, use\n    controller buttons for structural navigation (B = back to\n    planetarium), and keep the viewer inside the scene rather than\n    navigating away (overlay architecture for story reading)."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Embodied interfaces reward spatial memory — viewers remember where a\n    story is in the dome and reach for it, building familiarity through\n    physical gesture rather than text search."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Prototype the overlay architecture so story-reading stays inside the planetarium scene.]\n    next[Test with AR passthrough to see if the dome works as a mixed-reality installation.]\n    next[Measure whether VR visitors explore more stories than desktop visitors (spatial memory effect).]"}], :conclusion "  Treat VR headset navigation as a first-class mode where the viewer's body\n  (head orientation, hand pointing, controller buttons) replaces mouse and\n  scroll as the primary interface to the constellation.", :directives {:audience "VR interaction designers, digital library architects", :references ["vsatlatarium/dome-projection" "vsatlas/community-engagement"], :sigils ["🥽/体"], :style "design-pattern", :title "Embodied Browsing (VR as First-Class Navigation)", :tone "analytic"}, :id "vsatlatarium/embodied-browsing", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlatarium/dome-projection" "vsatlas/community-engagement"], :scores {}, :sigils ["🥽/体"], :source-path "library/vsatlatarium/embodied-browsing.flexiarg", :sources [], :status :ok, :title "Embodied Browsing (VR as First-Class Navigation)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Allow continuous zoom from immersive dome interior to external sky-disk\n  overview so viewers can shift between situated reading and structural\n  comprehension without changing mode."} {:name "context", :name-key "context", :slug "context", :text "You are designing navigation that spans close-reading and bird's-eye analysis within a single interaction. This does not apply when the corpus has no spatial projection (e.g., pure list views)."} {:name "IF", :name-key "if", :slug "if", :text "    Viewers need to alternate between exploring a neighbourhood of stories\n    and surveying the whole constellation."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Discrete mode switches (planetarium button vs geomview button) break\n    flow and lose spatial orientation."} {:name "THEN", :name-key "then", :slug "then", :text "    Let scroll-back move the camera past the dome origin so the\n    surrounding sphere contracts into a visible disk. As the camera\n    retreats, dome-projected arcs smoothly straighten to their natural\n    bezier paths via debounced redraw at blended dome radius."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Continuous zoom preserves the viewer's mental model of where they are\n    in the constellation. The transition from \"inside looking out\" to\n    \"outside looking in\" is a zoom, not a teleport."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Animate node positions to match arc straightening (currently nodes stay dome-projected).]\n    next[Test whether the sky-disk view is useful for facilitators projecting to a group.]\n    next[Explore whether the continuum works in VR (headset zoom via thumbstick push/pull).]"}], :conclusion "  Allow continuous zoom from immersive dome interior to external sky-disk\n  overview so viewers can shift between situated reading and structural\n  comprehension without changing mode.", :directives {:audience "interaction designers, digital library architects", :references ["vsatlatarium/dome-projection" "vsatlas/interpretive-views"], :sigils ["🔭/盘"], :style "design-pattern", :title "Sky-Disk Continuum (Immersion ↔ Overview)", :tone "analytic"}, :id "vsatlatarium/sky-disk-continuum", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlatarium/dome-projection" "vsatlas/interpretive-views"], :scores {}, :sigils ["🔭/盘"], :source-path "library/vsatlatarium/sky-disk-continuum.flexiarg", :sources [], :status :ok, :title "Sky-Disk Continuum (Immersion ↔ Overview)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Use a continuous \"vapor\" slider to control atmospheric intensity —\n  bloom, glow, particles, colour shift — so viewers can modulate the\n  affective register of the constellation without changing its structure."} {:name "context", :name-key "context", :slug "context", :text "You are designing an interface where emotional tone is a parameter alongside structural navigation. This does not apply to purely analytic views where atmosphere would be misleading."} {:name "IF", :name-key "if", :slug "if", :text "    The same constellation serves both analytical review and evocative\n    exhibition contexts."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    A fixed aesthetic either feels too clinical for exhibition or too\n    decorative for analysis."} {:name "THEN", :name-key "then", :slug "then", :text "    Provide a single slider that continuously blends from minimal\n    (dark, precise, subtle arcs) to maximal (pink glow, bloom on arcs,\n    particle dust, background colour shift, hover halos). The underlying\n    data stays identical."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Separating affect from structure lets the same tool serve a\n    facilitator's workshop (vapor low) and a gallery wall (vapor high)\n    without rebuilding the view."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Test whether high-vapor mode influences which stories viewers explore first (affect-driven navigation).]\n    next[Consider per-cluster vapor levels to highlight focal stories in a facilitated session.]"}], :conclusion "  Use a continuous \"vapor\" slider to control atmospheric intensity —\n  bloom, glow, particles, colour shift — so viewers can modulate the\n  affective register of the constellation without changing its structure.", :directives {:audience "interaction designers, exhibition designers", :references ["vsatlatarium/dome-projection" "vsatlas/interpretive-views"], :sigils ["🌸/气"], :style "design-pattern", :title "Vapor as Affective Dimension", :tone "analytic"}, :id "vsatlatarium/vapor-as-affect", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlatarium/dome-projection" "vsatlas/interpretive-views"], :scores {}, :sigils ["🌸/气"], :source-path "library/vsatlatarium/vapor-as-affect.flexiarg", :sources [], :status :ok, :title "Vapor as Affective Dimension", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Use pilot-defined story subsets as anthology filters that reshape the constellation to a focused sub-world."} {:name "context", :name-key "context", :slug "context", :text "You are curating viewing experiences for different audiences or sessions from the same corpus."} {:name "IF", :name-key "if", :slug "if", :text "A facilitator, exhibition, or course module needs a focused subset of the full story world."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Showing everything overwhelms; building separate installations duplicates effort."} {:name "THEN", :name-key "then", :slug "then", :text "Reuse the pilot model to filter stories at query time. The dome re-projects around fewer clusters with clamped vertical spread."} {:name "BECAUSE", :name-key "because", :slug "because", :text "Filtering is cheaper than forking. The same infrastructure serves multiple curatorial frames."} {:name "STATUS", :name-key "status", :slug "status", :text "status[ready]"}], :conclusion "Use pilot-defined story subsets as anthology filters that reshape the constellation to a focused sub-world.", :directives {:sigils ["📚/选"], :title "Anthology as Constellation Filter"}, :id "vsatlatarium/anthology-as-filter", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["📚/选"], :source-path "library/vsatlatarium/vsatlatarium.multiarg", :sources [], :status :ok, :title "Anthology as Constellation Filter", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Render inter-story links as coloured, curved arcs with type, status, and rationale so relational meaning is visible geometry, not hidden metadata."} {:name "context", :name-key "context", :slug "context", :text "You are making the interpretive layer legible as spatial form."} {:name "IF", :name-key "if", :slug "if", :text "Viewers need to see why stories are connected — not just that they are."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Undifferentiated lines flatten thematic, causal, adjacency, and contrast links into a single \"related\" signal."} {:name "THEN", :name-key "then", :slug "then", :text "Colour arcs by link type, modulate opacity by status, bow arcs to read as spatial bridges. Provide legend toggles to show/hide types independently."} {:name "BECAUSE", :name-key "because", :slug "because", :text "Typed arcs externalise the interpretive grammar that contributors use when proposing connections."} {:name "STATUS", :name-key "status", :slug "status", :text "status[ready]"}], :conclusion "Render inter-story links as coloured, curved arcs with type, status, and rationale so relational meaning is visible geometry, not hidden metadata.", :directives {:sigils ["🌈/弧"], :title "Arc as Typed Relation"}, :id "vsatlatarium/arc-as-typed-relation", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌈/弧"], :source-path "library/vsatlatarium/vsatlatarium.multiarg", :sources [], :status :ok, :title "Arc as Typed Relation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Cache the O(N²) force-directed layout across requests so the planetarium loads instantly when data has not changed."} {:name "context", :name-key "context", :slug "context", :text "You are serving a 3D visualisation from SSR where layout is the bottleneck."} {:name "IF", :name-key "if", :slug "if", :text "The force-directed simulation runs on every request, consuming CPU proportional to scene count squared."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Story data changes rarely — most requests see the same constellation."} {:name "THEN", :name-key "then", :slug "then", :text "Fingerprint inputs and cache the layout in a globalThis-backed store. Invalidate when the fingerprint changes."} {:name "BECAUSE", :name-key "because", :slug "because", :text "First-load computes; subsequent loads return instantly."} {:name "STATUS", :name-key "status", :slug "status", :text "status[ready]"}], :conclusion "Cache the O(N²) force-directed layout across requests so the planetarium loads instantly when data has not changed.", :directives {:sigils ["⚡/缓"], :title "Cached Layout Computation"}, :id "vsatlatarium/cached-layout-computation", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["⚡/缓"], :source-path "library/vsatlatarium/vsatlatarium.multiarg", :sources [], :status :ok, :title "Cached Layout Computation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Represent each story as a spatial cluster of scene nodes so internal narrative structure is visible alongside inter-story connections."} {:name "context", :name-key "context", :slug "context", :text "You are designing a visualisation that must convey both within-story structure and between-story relationships at a glance."} {:name "IF", :name-key "if", :slug "if", :text "Viewers need to grasp both the shape of individual stories and how they relate to one another."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Collapsing stories to single points hides internal richness; flattening all scenes to one level hides story boundaries."} {:name "THEN", :name-key "then", :slug "then", :text "Use a two-level layout: stories are clusters positioned on the dome via golden-spiral distribution, and scenes within each cluster are arranged by force-directed simulation."} {:name "BECAUSE", :name-key "because", :slug "because", :text "Two-level clustering preserves the part-whole relationship that makes a story more than a bag of scenes."} {:name "STATUS", :name-key "status", :slug "status", :text "status[ready]"}], :conclusion "Represent each story as a spatial cluster of scene nodes so internal narrative structure is visible alongside inter-story connections.", :directives {:sigils ["🌌/文"], :title "Cluster as Story, Node as Scene"}, :id "vsatlatarium/cluster-as-story", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌌/文"], :source-path "library/vsatlatarium/vsatlatarium.multiarg", :sources [], :status :ok, :title "Cluster as Story, Node as Scene", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Project story constellations onto a dome surface so the viewer occupies a privileged interior position — reading outward rather than inspecting from above."} {:name "context", :name-key "context", :slug "context", :text "You are choosing a spatial metaphor for browsing a connected story world. This does not apply when the corpus is small enough that a flat list suffices."} {:name "IF", :name-key "if", :slug "if", :text "A collection of linked stories needs a spatial reading frame that communicates immersion and equal proximity."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Flat graphs or tree views impose implicit hierarchies and lose the sense of being surrounded by a world."} {:name "THEN", :name-key "then", :slug "then", :text "Map story clusters onto the inner surface of a sphere (planetarium model) so the viewer looks outward at the constellation from its centre."} {:name "BECAUSE", :name-key "because", :slug "because", :text "The dome equalises distance — every story is the same radius away, and orientation replaces ranking as the primary navigation axis."} {:name "STATUS", :name-key "status", :slug "status", :text "status[ready]"}], :conclusion "Project story constellations onto a dome surface so the viewer occupies a privileged interior position — reading outward rather than inspecting from above.", :directives {:sigils ["🔭/天"], :title "Dome Projection as Reading Frame"}, :id "vsatlatarium/dome-projection", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🔭/天"], :source-path "library/vsatlatarium/vsatlatarium.multiarg", :sources [], :status :ok, :title "Dome Projection as Reading Frame", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Treat VR headset navigation as a first-class mode where the viewer's body replaces mouse and scroll as the primary interface."} {:name "context", :name-key "context", :slug "context", :text "You are designing for immersive hardware where the viewer is physically inside the dome."} {:name "IF", :name-key "if", :slug "if", :text "The planetarium metaphor maps naturally to VR — the viewer is literally inside a sphere of stories."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Porting mouse interactions to VR produces clumsy, imprecise pointing."} {:name "THEN", :name-key "then", :slug "then", :text "Add generous hit volumes, controller buttons for structural navigation, and keep the viewer inside the scene via overlay architecture."} {:name "BECAUSE", :name-key "because", :slug "because", :text "Embodied interfaces reward spatial memory — viewers remember where a story is and reach for it."} {:name "STATUS", :name-key "status", :slug "status", :text "status[ready]"}], :conclusion "Treat VR headset navigation as a first-class mode where the viewer's body replaces mouse and scroll as the primary interface.", :directives {:sigils ["🥽/体"], :title "Embodied Browsing (VR as First-Class Navigation)"}, :id "vsatlatarium/embodied-browsing", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🥽/体"], :source-path "library/vsatlatarium/vsatlatarium.multiarg", :sources [], :status :ok, :title "Embodied Browsing (VR as First-Class Navigation)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Allow continuous zoom from immersive dome interior to external sky-disk overview so viewers can shift between situated reading and structural comprehension."} {:name "context", :name-key "context", :slug "context", :text "You are designing navigation that spans close-reading and bird's-eye analysis within a single interaction."} {:name "IF", :name-key "if", :slug "if", :text "Viewers need to alternate between exploring a neighbourhood and surveying the whole constellation."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Discrete mode switches break flow and lose spatial orientation."} {:name "THEN", :name-key "then", :slug "then", :text "Let scroll-back move the camera past the dome origin so the surrounding sphere contracts into a visible disk, with arcs smoothly straightening."} {:name "BECAUSE", :name-key "because", :slug "because", :text "Continuous zoom preserves the viewer's mental model. The transition from \"inside looking out\" to \"outside looking in\" is a zoom, not a teleport."} {:name "STATUS", :name-key "status", :slug "status", :text "status[ready]"}], :conclusion "Allow continuous zoom from immersive dome interior to external sky-disk overview so viewers can shift between situated reading and structural comprehension.", :directives {:sigils ["🔭/盘"], :title "Sky-Disk Continuum (Immersion ↔ Overview)"}, :id "vsatlatarium/sky-disk-continuum", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🔭/盘"], :source-path "library/vsatlatarium/vsatlatarium.multiarg", :sources [], :status :ok, :title "Sky-Disk Continuum (Immersion ↔ Overview)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Use a continuous vapor slider to control atmospheric intensity so viewers can modulate the affective register without changing structure."} {:name "context", :name-key "context", :slug "context", :text "You are designing an interface where emotional tone is a parameter alongside structural navigation."} {:name "IF", :name-key "if", :slug "if", :text "The same constellation serves both analytical review and evocative exhibition."} {:name "HOWEVER", :name-key "however", :slug "however", :text "A fixed aesthetic either feels too clinical for exhibition or too decorative for analysis."} {:name "THEN", :name-key "then", :slug "then", :text "Provide a single slider that blends from minimal (dark, precise) to maximal (glow, bloom, particles). The data stays identical."} {:name "BECAUSE", :name-key "because", :slug "because", :text "Separating affect from structure lets the same tool serve a workshop and a gallery wall."} {:name "STATUS", :name-key "status", :slug "status", :text "status[ready]"}], :conclusion "Use a continuous vapor slider to control atmospheric intensity so viewers can modulate the affective register without changing structure.", :directives {:sigils ["🌸/气"], :title "Vapor as Affective Dimension"}, :id "vsatlatarium/vapor-as-affect", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌸/气"], :source-path "library/vsatlatarium/vsatlatarium.multiarg", :sources [], :status :ok, :title "Vapor as Affective Dimension", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "An open mission is an admissible autonomous WM target only if it has at least one open hole — a concrete next increment. A hole-less open mission (its gap not yet articulated) is NOT auto-actionable: surface it (NAG), do not pick it. Among admissible missions, prefer the single-cycle leaf (exactly one open hole)."} {:name "context", :name-key "context", :slug "context", :text "The WM ranks open missions to advance. Missions sit at varying lifecycle phases (IDENTIFY..INSTANTIATE); some carry articulated open work (counted holes), others — early or stub — carry none."} {:name "IF", :name-key "if", :slug "if", :text "    Your autonomous loop selects \"advance mission M\" actions over a landscape of missions at different maturities."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    A mission with zero open holes has nothing concrete to advance THIS cycle — either its gap is not yet articulated (an un-agreed IDENTIFY) or it is effectively done. Picking it means the agent \"engages\" but has no bounded next step, so it flails or fake-finishes. And — the subtle failure — a body-size score that rewards smallness will PERVERSELY prefer the 0-hole mission (nothing-to-do scores best) over a 1-hole single-cycle leaf (one real cycle of work)."} {:name "THEN", :name-key "then", :slug "then", :text "    Gate `:open-mission` actions with `open-mission-with-holes?` (`open?` AND `open-hole-count ≥ 1`). A 0-hole open mission is inadmissible for autonomous advancement → NAG: *\"nothing concrete to advance here; articulate the next hole / agree the gap, or it's not ready.\"* Among admissible (≥1-hole) missions, prefer the **single-cycle leaf** — exactly one open hole = exactly one bounded cycle. Advance one hole per cycle (don't flood)."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The WM advances work, and \"advance\" requires a concrete increment — a hole. The hole-count is the advanceability proxy. Without the ≥1-hole gate the agent picks vacuous targets; with a naive small-is-good body term it actively prefers them. Both are real, observed failure modes (below). The gate also carries the hole-budget discipline (one hole/cycle, the E-cheesemonger bound) — bounded, earned, no fake-finish."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - The gate lives in `autonomous-admissible?` (`futon3c/wm/guardrails.clj` → `open-mission-with-holes?` / `positive-open-hole-count?`).\n    - Pairs with pattern-warranted-choice-point: the 0-hole NAG carries the advanceability warrant (here is why, here is the gap = articulate the hole).\n    - Hardening (separate): the EFE body-size term should prefer EXACTLY one hole (a \"distance-from-1-hole\" shape), not merely reward fewer holes — so a 0-hole mission never out-scores a single-cycle leaf even if the admissibility filter is bypassed (defense-in-depth).\n    - evidence: 0-hole picks rejected per run; single-cycle-leaf pick rate; fake-finish (claimed-discharge, field-didn't-move) rate.\n    - evidence-shape: {:zero-hole-rejected :int, :single-cycle-leaf-picks :int, :multi-hole-picks :int, :fake-finishes :int}"} {:name "DOES-NOT-APPLY", :name-key "does-not-apply", :slug "does-not-apply", :text "    Selection surfaces where every candidate is guaranteed to carry articulated work (no hole-less items can appear). Non-mission action classes (advanceability is mission-specific)."} {:name "INSTANCES", :name-key "instances", :slug "instances", :text "    - Terminal-C3 (M-capability-star-map, 2026-06-07): the RAW candidate run top-ranked `M-arxana-roundtrip` (0 holes, `:identify`) purely because body=0 scored best; the PRODUCTION `open-mission-with-holes?` gate excluded it, and EFE then top-ranked the 1-hole single-cycle leaf `M-essay-corpus-substrate` — C3 PASS. The gate is the difference between a vacuous pick and a real one."}], :conclusion "An open mission is an admissible autonomous WM target only if it has at least one open hole — a concrete next increment. A hole-less open mission (its gap not yet articulated) is NOT auto-actionable: surface it (NAG), do not pick it. Among admissible missions, prefer the single-cycle leaf (exactly one open hole).", :directives {:audience "War Machine guardrail authors, pilot, mission authors", :keywords ["advanceability" "open-hole-count" "single-cycle-leaf" "hole-budget" "no-fake-finish" "gap-not-articulated"], :references ["war-machine/ideal-actual-gap" "aif/admissibility" "orchestration/pattern-warranted-choice-point"], :sigils ["🕳/1"], :style "pattern", :title "Advanceability — An Open Mission Is an Autonomous Target Only If It Has a Concrete Next Hole", :tone "declarative"}, :id "war-machine/advanceability", :keywords ["advanceability" "open-hole-count" "single-cycle-leaf" "hole-budget" "no-fake-finish" "gap-not-articulated"], :projection-version "flexiarg-v0", :references ["war-machine/ideal-actual-gap" "aif/admissibility" "orchestration/pattern-warranted-choice-point"], :scores {}, :sigils ["🕳/1"], :source-path "library/war-machine/advanceability.flexiarg", :sources [], :status :ok, :title "Advanceability — An Open Mission Is an Autonomous Target Only If It Has a Concrete Next Hole", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A library of reusable strategies that is searched automatically on every conversation turn functions as ambient intelligence - the system's background awareness of what it knows, surfaced without being asked."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    futon3a's pattern library is searched via MiniLM embeddings on every A->B turn in the REPL, and the results appear as desktop notifications with evidence certificates. The operator does not request the search; it happens as a side-effect of working. Over time, the activation pattern across the library reveals which strategies are repeatedly relevant and which are never activated."} {:name "IF", :name-key "if", :slug "if", :text "    The system can search a large pattern library automatically on each work turn and surface the results ambiently rather than as an interruption."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    A large knowledge base is only useful when the right pieces surface at the right time. Retrieval quality depends on embedding quality and library coverage, and notification fatigue will turn ambient retrieval into noise if low-relevance patterns keep firing."} {:name "THEN", :name-key "then", :slug "then", :text "    Search the library on every turn as a background process. Display results as ambient notifications, log the activation history as evidence, and use the resulting hot-zone / cold-zone pattern to tune retrieval and train later pre-hoc prediction."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Expert practitioners develop intuitions that surface relevant knowledge without deliberate recall. Ambient retrieval externalises that intuition: the system maintains a background awareness of its own knowledge and surfaces relevant pieces as the situation evolves."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Use the activation history to tune retrieval quality and distinguish genuine hot zones from cold library regions that never become relevant.]"}], :conclusion "A library of reusable strategies that is searched automatically on every conversation turn functions as ambient intelligence - the system's background awareness of what it knows, surfaced without being asked.", :directives {:title "Ambient Pattern Retrieval"}, :id "war-machine/ambient-pattern-retrieval", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/ambient-pattern-retrieval.flexiarg", :sources [], :status :ok, :title "Ambient Pattern Retrieval", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Multi-agent coordination fails at infrastructure seams, not at intelligence boundaries: the bottleneck is merge permissions, liveness signals, and orchestration state, not agent capability."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    The Tickle Experiment ran a multi-agent CT review pipeline with rising approval quality, but much of the rework came from merge gaps, a stateless orchestrator, and silent failures. The agents were competent; the plumbing leaked."} {:name "IF", :name-key "if", :slug "if", :text "    Multiple agents are working across a shared pipeline and the same coordination failures recur across otherwise capable agents."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    A system can work at the agent level while still failing at the infrastructure level. Some failures are still agent-level, and infrastructure investment eventually hits diminishing returns, but repeated cross-agent failure is a systems signal first."} {:name "THEN", :name-key "then", :slug "then", :text "    Invest first in liveness heartbeats, stateful orchestration, and merge automation before trying to solve the problem with more capable agents or larger prompts."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Coordination is a system property, not an agent property. Improving the parts while ignoring the relations between them produces more capable agents that still cannot coordinate."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Instrument liveness, stateful assignment tracking, and merge automation before scheduling another capability-only improvement pass.]"}], :conclusion "Multi-agent coordination fails at infrastructure seams, not at intelligence boundaries: the bottleneck is merge permissions, liveness signals, and orchestration state, not agent capability.", :directives {:title "Coordination Bottleneck"}, :id "war-machine/coordination-bottleneck", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/coordination-bottleneck.flexiarg", :sources [], :status :ok, :title "Coordination Bottleneck", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A dynamic display that animates state changes over time reveals patterns that a static snapshot hides - trends, rhythms, decay, and momentum become visible as motion."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    The futon2 ant war visualiser makes colony momentum obvious within seconds, whereas a single screenshot only shows positions. The same applies to strategic state: a static report can show counts but not whether those counts are growing, shrinking, or stalled."} {:name "IF", :name-key "if", :slug "if", :text "    The operator needs to distinguish growth from decay, acceleration from stagnation, or winning motion from a dead-even snapshot."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Static reports show position but not momentum. Animation also adds complexity and can be distracting if motion overwhelms semantically important but quieter regions."} {:name "THEN", :name-key "then", :slug "then", :text "    Animate the strategic state over time, with replay controls and a spatial layout that makes both position and trajectory visible at once, while keeping the table as a drill-down renderer for exact values."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Temporal patterns are perceptible in animation but invisible in snapshots. For strategic awareness, the trajectory matters more than the position; you need the movie, not just the frame."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Replay recent strategic history as a controllable animation and check whether the motion reveals distinctions the static report concealed.]"}], :conclusion "A dynamic display that animates state changes over time reveals patterns that a static snapshot hides - trends, rhythms, decay, and momentum become visible as motion.", :directives {:title "Dynamic Over Static"}, :id "war-machine/dynamic-over-static", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/dynamic-over-static.flexiarg", :sources [], :status :ok, :title "Dynamic Over Static", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "An observation surface that covers half the system produces worse decisions than no observation surface at all, because it creates false confidence in completeness."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    The evidence store initially scanned only part of the repo set, yet still produced plausible coverage statistics. Review exposed that missing channels and missing repos were being treated as invisible rather than as first-class uncertainty."} {:name "IF", :name-key "if", :slug "if", :text "    The system is building an observation surface to drive recommendations, summaries, or prioritisation."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Partial coverage is inevitable, but unacknowledged partial coverage is dangerous. A half-blind observer overweights what it can see and confidently ignores what it cannot."} {:name "THEN", :name-key "then", :slug "then", :text "    Make every observation channel report both its findings and its coverage, and surface missing data as prominently as positive findings."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    An observer that knows it is blind can at least flag uncertainty. An observer that believes it sees everything makes confident wrong recommendations."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Add explicit coverage reporting to every observation channel and refuse aggregate confidence claims that hide missing surfaces.]"}], :conclusion "An observation surface that covers half the system produces worse decisions than no observation surface at all, because it creates false confidence in completeness.", :directives {:title "Half-Blind Observation"}, :id "war-machine/half-blind-observation", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/half-blind-observation.flexiarg", :sources [], :status :ok, :title "Half-Blind Observation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A self-representing system needs two images - what it aspires to be and what it actually is - plus a computable comparison between them."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    The stack already maintains ideal self-images in devmaps and actual state in evidence and code, but the comparison between them is still manual. Joe reads both and synthesises the discrepancy in his head."} {:name "IF", :name-key "if", :slug "if", :text "    The system maintains both aspirational specifications and evidence about its current implementation and coverage."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Self-representation without self-comparison turns into portraiture rather than correction. Some ideals remain only partly measurable, but the raw discrepancy still needs to be machine-detectable."} {:name "THEN", :name-key "then", :slug "then", :text "    Compute the ideal/actual gap: compare devmap components against mission inventory, compare sorry topology against implementation state, and surface the discrepancy as a first-class report."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The war machine operates in smooth space but periodically needs a computable comparison against its striated self-image to detect drift at scale."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Build a discrepancy report that pairs each ideal component with current evidence and flags the gaps that still require human judgment.]"}], :conclusion "A self-representing system needs two images - what it aspires to be and what it actually is - plus a computable comparison between them.", :directives {:title "Ideal Actual Gap"}, :id "war-machine/ideal-actual-gap", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/ideal-actual-gap.flexiarg", :sources [], :status :ok, :title "Ideal Actual Gap", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Infrastructure that is 90% built and 0% inhabited produces zero value; the last 10% that reduces entry friction is what creates the value because it crosses the inhabitation threshold."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    The evidence pipeline, pattern retrieval, browser surfaces, and HUD were all built before the session that finally fixed the entry ceremony. Once the friction bugs were removed, the already-built infrastructure became inhabited immediately."} {:name "IF", :name-key "if", :slug "if", :text "    A stack surface is largely built but still too awkward, brittle, or ritual-heavy to enter during ordinary work."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Prerequisite build-out is real, and inhabitation alone can also become a trap if it never deposits externally. The failure mode here is not building, but infrastructure that exists without being used."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat entry friction as severity-critical. Measure inhabitation as a first-class metric and prioritise the fixes that let ordinary work actually pass through the surface."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The war machine exists only when it is inhabited. No new capability was required once the entry bugs were fixed; the same infrastructure started producing evidence as soon as the threshold was crossed."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Audit every major surface for the exact bug or ritual that still blocks ordinary entry, and fix those before adding new capability.]"}], :conclusion "Infrastructure that is 90% built and 0% inhabited produces zero value; the last 10% that reduces entry friction is what creates the value because it crosses the inhabitation threshold.", :directives {:title "Inhabitation Threshold"}, :id "war-machine/inhabitation-threshold", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/inhabitation-threshold.flexiarg", :sources [], :status :ok, :title "Inhabitation Threshold", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Infrastructure that validates is operational; infrastructure that only documents is decorative. The test is whether the artifact changes behaviour when it fails."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    Wiring diagrams were assumed decorative until they began catching structural errors at scale. Once a wrong arrow produced a detectable failure, the diagram stopped being mere documentation."} {:name "IF", :name-key "if", :slug "if", :text "    The system is relying on a document, diagram, or status surface to steer or validate work."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Decorative infrastructure can still aid comprehension, and some sketches are intentionally aspirational. The failure comes when decorative artifacts are trusted as if they were operational."} {:name "THEN", :name-key "then", :slug "then", :text "    Make the artifact testable: derive status from evidence, validate diagrams, and wire failures so they force correction instead of silently going stale."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Operational infrastructure is defined by observable failure. A README can drift forever; a validator, gate, or checked diagram changes behaviour when reality diverges."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[For each strategic artifact, name the failure condition that would force correction; if none exists, treat it as decorative until one is built.]"}], :conclusion "Infrastructure that validates is operational; infrastructure that only documents is decorative. The test is whether the artifact changes behaviour when it fails.", :directives {:title "Operational Not Decorative"}, :id "war-machine/operational-not-decorative", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/operational-not-decorative.flexiarg", :sources [], :status :ok, :title "Operational Not Decorative", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A spatial display that shows state as shape and colour earns inhabitation; a tabular display that encodes state as numbers in rows becomes wallpaper."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    The ant war visualiser is watched at a glance, while markdown tables require deliberate reading and synthesis. The same information becomes obvious when presented spatially and becomes homework when presented only as rows."} {:name "IF", :name-key "if", :slug "if", :text "    Strategic state needs to be grasped quickly and revisited often rather than read line by line on demand."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Tables are still better for precise lookup, and spatial layouts can mislead if they are visually active but semantically arbitrary."} {:name "THEN", :name-key "then", :slug "then", :text "    Render the same state spatially - active regions glow, neglected regions dim, imbalances show as asymmetric shape - while keeping the table as a precise drill-down fallback."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Human vision processes colour, size, position, and motion pre-attentively. Strategic overviews need repeated comprehension at low cost, and spatial layout lowers that cost every time."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Prefer semantically grounded spatial layouts for strategic overviews, then keep exact counts and dates available as tabular drill-down.]"}], :conclusion "A spatial display that shows state as shape and colour earns inhabitation; a tabular display that encodes state as numbers in rows becomes wallpaper.", :directives {:title "Spatial Over Tabular"}, :id "war-machine/spatial-over-tabular", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/spatial-over-tabular.flexiarg", :sources [], :status :ok, :title "Spatial Over Tabular", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A nomadic practice is captured when it begins reproducing itself rather than following external flows; the test is whether today's work closes an external sorry or only improves the infrastructure for closing sorrys."} {:name "CONTEXT", :name-key "context", :slug "context", :text "    Joe HUD signals showed stack work dominating consulting and portfolio work. The system was becoming better at maintaining itself while external sorrys remained the ground truth that justified the stack in the first place."} {:name "IF", :name-key "if", :slug "if", :text "    Infrastructure maintenance begins to dominate the work mix and stack activity starts serving more stack activity than external deposition."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Some self-maintenance is necessary, and there is a live philosophical question about which side is the nomad and which is the State. The pattern matters when self-maintenance dominates instead of supporting grounded obligations."} {:name "THEN", :name-key "then", :slug "then", :text "    Use pocketwatch-style constraints and explicit external-sorry checks: every stack work item must answer which outside obligation it closes, and stack hours must stay bounded relative to portfolio and consulting hours."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The war machine can be captured by the institution it created. Without an explicit test, the stack quietly redirects nomadic practice toward self-reproduction."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Require each stack task to name the external sorry it closes, and treat tasks with no such answer as capture until proven otherwise.]"}], :conclusion "A nomadic practice is captured when it begins reproducing itself rather than following external flows; the test is whether today's work closes an external sorry or only improves the infrastructure for closing sorrys.", :directives {:title "State Capture"}, :id "war-machine/state-capture", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/war-machine/state-capture.flexiarg", :sources [], :status :ok, :title "State Capture", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Close Then Reframe Focus"} {:name "context", :name-key "context", :slug "context", :text "The current agenda has one explicit FOCUS item alongside many scheduled tasks that have accumulated partial progress or overrun status."} {:name "IF", :name-key "if", :slug "if", :text "    A FOCUS item is sufficiently bounded that it can be brought to a defensible stopping point."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Multiple overrun items compete as plausible successors and risk pulling attention prematurely."} {:name "THEN", :name-key "then", :slug "then", :text "    Complete the current FOCUS to a clear \"finished enough\" artifact, then deliberately select the next FOCUS from the overrun set based on leverage rather than urgency."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Focus only compounds value when it reaches closure, producing a reference point that informs the next prioritization rather than fragmenting effort."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Define what counts as \"done enough\" for the current FOCUS, list overrun items with a one-line statement of leverage, and choose the next FOCUS explicitly rather than by drift.]"}], :conclusion "Close Then Reframe Focus", :directives {:sigils ["🚴/专" "👋/一"], :title "Close Then Reframe Focus"}, :id "workday/close-then-reframe-focus", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚴/专" "👋/一"], :source-path "library/workday/agenda.flexiarg", :sources [], :status :ok, :title "Close Then Reframe Focus", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Single-Focus Amidst Agenda Saturation"} {:name "context", :name-key "context", :slug "context", :text "The week agenda contains many TODO, NEXT, WAIT, and SHIP items across ORPM and AOB, but only one item is explicitly marked FOCUS."} {:name "IF", :name-key "if", :slug "if", :text "    There is exactly one FOCUS item while multiple other tasks remain scheduled, recurring, or deadline-bearing."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Several non-FOCUS items still demand attention due to deadlines, dependencies, or institutional expectations."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat the FOCUS item as the sole candidate for discretionary depth, and constrain all other items to execution at their minimal viable level unless they directly unblock or materially enrich the FOCUS."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    A single declared focus only functions as such if it is protected from dilution by equally attention-hungry tasks."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Check whether any non-FOCUS items causally unblock or substantially reshape the FOCUS; if so, either promote them or explicitly time-box them to prevent silent priority creep.]"}], :conclusion "Single-Focus Amidst Agenda Saturation", :directives {:sigils ["🚴/专" "🌈/一"], :title "Single-Focus Amidst Agenda Saturation"}, :id "workday/single-focus-amidst-agenda", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚴/专" "🌈/一"], :source-path "library/workday/agenda.flexiarg", :sources [], :status :ok, :title "Single-Focus Amidst Agenda Saturation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Sign-Off Affordance for Deep Work"} {:name "context", :name-key "context", :slug "context", :text "You are working in a high-agency, high-immersion environment (Emacs, Codex, ChatGPT, long arcs) where attention is valuable and interruptions are minimal by design."} {:name "IF", :name-key "if", :slug "if", :text "    Deep work environments are successful at holding attention and reducing friction."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    They systematically erase natural stopping cues, making it easy to overshoot physical, cognitive, or temporal limits without noticing until damage has already accumulated."} {:name "THEN", :name-key "then", :slug "then", :text "    Persistence requires an explicit sign-off affordance at the FUTON-0 level: a mechanism that helps you recognize when continuation has stopped being beneficial before exhaustion, distortion, or resentment appear."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Long-arc work fails not when people start poorly, but when they lack reliable ways to stop without loss of identity, momentum, or meaning."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Treat signing off as a first-class state transition, not an absence of work.]\n    next[Identify concrete signals already present (time of day, bodily cues, repetition, diminishing returns) that could be surfaced rather than inferred.]\n    next[Prototype something minimal and reversible (a prompt, a timer with semantic meaning, a closing ritual, a FUTON-0 log entry) and observe whether it preserves desire to return.]"}], :conclusion "Sign-Off Affordance for Deep Work", :directives {:sigils ["⌛️/止" "🏃/功"], :title "Sign-Off Affordance for Deep Work"}, :id "workday/sign-off-affordance", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["⌛️/止" "🏃/功"], :source-path "library/workday/clock-hygiene.flexiarg", :sources [], :status :ok, :title "Sign-Off Affordance for Deep Work", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "External Project Index as System of Record"} {:name "context", :name-key "context", :slug "context", :text "The ChatGPT web sidebar is a slow, weak global navigator, and you are aiming to reduce dependence on the web UI. An external index can treat projects as contexts you can enter via stable pointers, while your own system becomes the canonical registry."} {:name "IF", :name-key "if", :slug "if", :text "    You can identify a stable entry URL per project (for example, one canonical chat inside each project) and store it in a fast local registry."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Some projects will not have a single obvious entry point, and links can become stale if you reorganize, rename, or delete chats."} {:name "THEN", :name-key "then", :slug "then", :text "    Maintain a minimal registry that maps project-id or name to entry URL + short intent + last-touched date, and add a periodic link-audit micro-loop that refreshes broken pointers and promotes better entry chats when needed."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    A small, explicit registry decouples navigation from a slow UI surface and makes \"where do I go next?\" an inspectable, improvable artifact rather than an interaction with a sidebar."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Pick 10 high-use projects, create (or designate) one entry chat each, capture their URLs into a single file (or FUTON1 node set), and do a weekly audit for one month measuring time-to-open and percentage of stale links.]"}], :conclusion "External Project Index as System of Record", :directives {:sigils ["📁/入" "🌏/予"], :title "External Project Index as System of Record"}, :id "workday/external-project-index", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["📁/入" "🌏/予"], :source-path "library/workday/external-project-index.flexiarg", :sources [], :status :ok, :title "External Project Index as System of Record", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  preserve equilibrium across five spheres: Institutional, Consulting, Technical, Reflective, Infrastructure"} {:name "context", :name-key "context", :slug "context", :text "Work naturally clusters into five spheres with different rhythms and demands; imbalance in any sphere propagates stress to the others."} {:name "IF", :name-key "if", :slug "if", :text "    one sphere dominates attention for multiple weeks while others go untouched"} {:name "HOWEVER", :name-key "however", :slug "however", :text "    without periodic review, sphere drift is invisible until a neglected area creates urgent demand"} {:name "THEN", :name-key "then", :slug "then", :text "    during weekly review, check that each sphere received some attention (even minimal); flag spheres with no recent activity"} {:name "CHECK", :name-key "check", :slug "check", :text "      each sphere has at least one touched item (commit, session, or note) in the past 14 days"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    equilibrium across spheres prevents crisis-driven context switching and keeps all commitments viable"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      track each sphere via tags or labels on org entries, git commits, or session\n      notes. A sphere is \"touched\" if at least one tagged artifact exists within\n      the window. Private time-management sources may be used as internal signal\n      sources, but publish only the aggregate count of touched spheres."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Use this pattern to frame the monthly review as a sphere-balance checkpoint.]\n    next[Add tags or labels so sphere touches can be counted without manual review.]"}], :conclusion "  preserve equilibrium across five spheres: Institutional, Consulting, Technical, Reflective, Infrastructure", :directives {:factor "Energy (viriya)", :sigils ["➰/五" "👀/互"], :title "Five Spheres Equilibrium"}, :id "workflow-coherence/sphere-equilibrium", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["➰/五" "👀/互"], :source-path "library/workflow-coherence/sphere-equilibrium.flexiarg", :sources [], :status :ok, :title "Five Spheres Equilibrium", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  verify that AOB check-in and Ambitions sync occurred within the past 7 days"} {:name "context", :name-key "context", :slug "context", :text "Epistemic rhythm depends on regular review cycles; skipped weeks accumulate drift and allow salients to decay unnoticed."} {:name "IF", :name-key "if", :slug "if", :text "    more than 7 days have passed since the last AOB or Ambitions sync event"} {:name "HOWEVER", :name-key "however", :slug "however", :text "    without automated detection, missed weeks go unnoticed until cognitive load spikes or commitments slip"} {:name "THEN", :name-key "then", :slug "then", :text "    flag the gap in Stack HUD; prompt review before new work starts"} {:name "CHECK", :name-key "check", :slug "check", :text "      timestamp of last sync event in futon1 or Tatami logs < 7 days ago"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    weekly rhythm prevents unbounded WIP, keeps salients fresh, and makes life feel lighter and more tractable"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      record a weekly sync marker in one of: (a) aob.org/org logs with a\n      timestamped \"AOB check-in\" / \"Ambitions sync\" entry, (b) futon1 or Tatami\n      logs with a dedicated event tag, or (c) a git commit note that references\n      the sync event. Use the most recent marker as the check timestamp."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Add a lightweight sync marker (org log entry, tag, or commit note) so the weekly cadence check has a reliable timestamp.]\n    next[Use this pattern to anchor the regular backup routine as a weekly cadence check.]"}], :conclusion "  verify that AOB check-in and Ambitions sync occurred within the past 7 days", :directives {:factor "Mindful apprehension (sati)", :sigils ["💖/弓" "➰/以"], :title "Weekly Rhythm Check"}, :id "workflow-coherence/weekly-rhythm", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💖/弓" "➰/以"], :source-path "library/workflow-coherence/weekly-rhythm.flexiarg", :sources [], :status :ok, :title "Weekly Rhythm Check", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  regularly review WIP balance; more than 3 active focus areas requires pausing one before starting new work"} {:name "context", :name-key "context", :slug "context", :text "Cognitive load grows nonlinearly with active threads; beyond a threshold, progress on all threads degrades."} {:name "IF", :name-key "if", :slug "if", :text "    more than 3 focus areas are marked active simultaneously"} {:name "HOWEVER", :name-key "however", :slug "however", :text "    new work feels urgent and pausing feels like loss, so WIP creeps upward without deliberate enforcement"} {:name "THEN", :name-key "then", :slug "then", :text "    block new work initiation until one active thread is paused or completed; surface the constraint in Stack HUD"} {:name "CHECK", :name-key "check", :slug "check", :text "      count of items with status=active in futon1 or Org <= 3"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    bounded WIP protects depth of focus and prevents the affect collapse that accompanies overload"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      define \"active\" as any item marked FOCUS or SHIP in org exports, or any\n      futon1 status=active entry. Capture a weekly count from the org columnview\n      table or futon1 status report and store it as a scan note."}], :conclusion "  regularly review WIP balance; more than 3 active focus areas requires pausing one before starting new work", :directives {:factor "Concentration (samadhi)", :sigils ["💖/弓" "👋/口"], :title "WIP Cap Enforcement"}, :id "workflow-coherence/wip-cap", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💖/弓" "👋/口"], :source-path "library/workflow-coherence/wip-cap.flexiarg", :sources [], :status :ok, :title "WIP Cap Enforcement", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "The construction \"not X, but also not Y; rather Z\" frequently hides the fact that Z is doing all the argumentative work while X and Y are strawmen no reader would actually have proposed.  The balanced pair lends Z the appearance of hard-won middle ground.  Lead with Z; introduce X and Y only when a reader plausibly would have raised them."} {:name "context", :name-key "context", :slug "context", :text "AI prose loves the balanced pair.  The construction is rhetorically soothing — it signals consideration, nuance, dialectical thinking — even when the X and Y positions exist only in the paragraph that rejects them.  When Z stands up on its own, the pair is padding.  When Z would be misread without the pair, the pair is earning its keep."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: rhetorical setup ↔ argumentative economy.\n    Irreducible: the same construction cannot simultaneously be (a) necessary dialectical framing and (b) padding.  It is one or the other for any given use."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a genuine dialectical move clarifies what a position is by showing what it rejects.  A synthetic dialectical move gives the position unearned weight by inventing rejections.\n    Active dynamic: the pull recurs at every claim the writer is not sure will land on its own."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Strawman X: the rejected position is one the paper's own argument makes implausible.\n      - Abstracted poles: X and Y are maximally abstract opposites (\"not purely technical, not purely social\") framing a Z that could be stated directly.\n      - Triangulated comfort: the balanced pair appears in every paragraph, regardless of whether Z needs dialectical setup."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Lead with Z: state the claim directly.  If the reader accepts it without confusion, X and Y were unnecessary.\n      (2) Reintroduce the pair only for a live misreading: if a reader plausibly would have taken Z to mean X or Y, introduce X or Y as the specific misreading being ruled out, not as generic alternatives.\n      (3) Cut Z: occasionally the discovery is that Z is itself unclear.  The balanced pair was doing work Z should be doing.  Rewrite Z."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every \"not X, but Y\" construction in the draft survives the question \"would a reader actually have proposed X?\"  Failing when: X is a position no competent reader of the paper would have held."}], :conclusion "The construction \"not X, but also not Y; rather Z\" frequently hides the fact that Z is doing all the argumentative work while X and Y are strawmen no reader would actually have proposed.  The balanced pair lends Z the appearance of hard-won middle ground.  Lead with Z; introduce X and Y only when a reader plausibly would have raised them.", :directives {:audience "paper authors, reviewers", :keywords ["balanced-pair" "not-x-but-y" "strawman" "rhetorical-padding" "false-choice"], :references ["writing-coherence/triad-inflation"], :style "pattern", :title "Lead With the Real Claim; Strawmen Appear Only If a Reader Would", :tone "technical"}, :id "writing-coherence/balanced-pair-padding", :keywords ["balanced-pair" "not-x-but-y" "strawman" "rhetorical-padding" "false-choice"], :projection-version "flexiarg-v0", :references ["writing-coherence/triad-inflation"], :scores {}, :sigils [], :source-path "library/writing-coherence/balanced-pair-padding.flexiarg", :sources [], :status :ok, :title "Lead With the Real Claim; Strawmen Appear Only If a Reader Would", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A load-bearing claim — one the rest of an argument rests on — must exhibit enough on-page evidence for a reader to judge whether it holds.  When a thesis, central finding, or bolded sentence rests on a thin citation (a phrase gesturing at a study, framework, or interview without naming what specifically was found, on what data, with what comparison), the reader is being asked to take the load-bearing move on trust.  Typographic emphasis and structural role expose the claim to challenge; the on-page citation must scale with the exposure.  Cash the citation, soften the claim, or reposition the load — but do not run a bolded comparative claim on a sixteen-word reference."} {:name "context", :name-key "context", :slug "context", :text "Working papers often inherit findings from companion or upstream work and treat them as established by reference.  This is appropriate when the finding is well-known to the audience, when the reference is short and the claim is incidental, or when the working paper is one of several that compose into a single body of evidence.  It fails when the claim is bolded or otherwise typographically marked as load-bearing; the claim makes a comparative or causal assertion (\"X matters more than Y\", \"X drives Z\") that requires both sides measured to support directionally; the reference is one phrase rather than a citation with specifics; the companion work's details aren't reproducible from the reference alone.  In these cases, the typographic emphasis or the comparative structure promises more than the citation delivers.  The reader is left with two unattractive options: take the claim on faith (which subverts the paper's argumentative discipline) or chase down the reference (which a working paper should not require for its central claims)."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: claim exposure ↔ citation density.\n    Irreducible: a claim's typographic emphasis and structural role expose it to challenge; the on-page citation must give the reader something to judge against, OR the claim must shrink to match what the citation delivers, OR the load must move to a sibling claim that does have on-page support."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: shoring up a citation means adding sentences that may feel pedagogical, redundant with a companion paper, or off the working paper's central concern.  Softening the claim means giving up directional or comparative strength that the analysis genuinely produced.  Repositioning the load may demote a finding the writer wants to keep prominent.  Each composition gives something up; the pattern's discipline is to choose explicitly rather than to leave the mismatch implicit and hope the reader is generous.\n    Active dynamic: the pull recurs whenever a working paper inherits findings from upstream work.  The inheritance pattern wants to be referential (\"see X for details\") but the load-bearing claim wants the details on-page.  Bolding amplifies the mismatch: bold tells the reader \"this is what I'm asking you to act on,\" which raises the citation bar."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Bolded-claim-thin-cite: the claim is typographically marked as load-bearing but the citation is one short phrase.  The bold makes a promise the citation does not keep.\n      - Comparative-without-comparison: \"X matters more than Y\" without exhibiting both X-side and Y-side measured.  Comparative direction can only be inferred from one side if the comparison frame itself is well-established in the field, which is rarely the case for novel claims.\n      - Framework-as-citation: the claim cites a methodological framework (NPT, AIF, etc.) instead of a finding from analysis using that framework.  Naming the framework does not name the finding.\n      - Reference-only inheritance: the load-bearing claim is established in a companion paper, but the working paper relies on the reader knowing that and chasing it.  Acceptable for incidental claims; not for the paper's thesis.\n      - Hedge-instead-of-cite: instead of shoring up the citation, the writer softens with \"with reasonable confidence\" or similar — preserving the claim's emphasis while gesturing at uncertainty.  The hedge is doing the work the citation should do."} {:name "THEN", :name-key "then", :slug "then", :text "Match citation density to claim exposure.  Pick one explicit composition."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Shore up the citation in-line.\n          Augmentation schema: {:claim-form :preserved :evidence-summary <what specifically was found> :method-detail <how it was inferred> :finding-direction <if directional>}\n          Entity types produced: :evidence-summary, :method-detail, :finding-direction-justification\n          Effect: the claim retains its emphasis; the citation grows on-page to support it.  Most appropriate when the directional or comparative content is genuinely supported and the paper has room.\n      (2) Soften the claim to match the citation.\n          Augmentation schema: {:claim-direction-fate :dropped-or-preserved :emphasis-form <foregrounding | named-finding | conditional>}\n          Entity types produced: :foregrounded-claim (replaces comparative with \"foregrounded as more consequential\"), :named-finding-claim (replaces directional with \"the analysis named X as the load-bearing factor\"), :conditional-claim (replaces unconditional with \"under the conditions analysed, X\").\n          Effect: the claim's emphasis shrinks to fit the citation's specificity.  Most appropriate when the directional content cannot be honestly supported on one-sided data, or when the comparative is rhetorical rather than substantive.\n      (3) Move the load-bearing weight elsewhere.\n          Augmentation schema: {:load-shift-target <section-id> :replacement-role <subsidiary | supporting | contextual>}\n          Entity types produced: :reference-to-load-bearing-section (the now-secondary claim cites its sibling that does the load-bearing).\n          Effect: a stronger sibling claim — one with denser on-page support — carries the argumentative weight, and the original load-bearing claim becomes supporting rather than central.  Appropriate when a different finding in the same paper actually deserves the emphasis."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when every load-bearing claim either (i) exhibits enough on-page citation for evaluation, (ii) is softened to match the citation's specificity, or (iii) is repositioned so a stronger sibling claim carries the load.  A skeptical reader, finding a bolded or thesis-level claim, can identify the specific evidence on-page that supports its directional or causal content.  Failing when a bolded comparative claim rests on a single-phrase citation and the writer relies on the reader to chase the reference."}], :conclusion "A load-bearing claim — one the rest of an argument rests on — must exhibit enough on-page evidence for a reader to judge whether it holds.  When a thesis, central finding, or bolded sentence rests on a thin citation (a phrase gesturing at a study, framework, or interview without naming what specifically was found, on what data, with what comparison), the reader is being asked to take the load-bearing move on trust.  Typographic emphasis and structural role expose the claim to challenge; the on-page citation must scale with the exposure.  Cash the citation, soften the claim, or reposition the load — but do not run a bolded comparative claim on a sixteen-word reference.", :directives {:audience "paper authors, working-paper drafters, reviewers", :keywords ["citation" "warrant" "evidence" "comparative-claim" "bold-claim" "load-bearing" "thesis" "density"], :references ["writing-coherence/floating-formalism" "writing-coherence/missing-mechanism" "writing-coherence/hedged-lift" "system-coherence/argue-empirically-not-persuasively"], :style "pattern", :title "Cash the Citation on Load-Bearing Claims", :tone "technical"}, :id "writing-coherence/citation-density-load-bearing-claim", :keywords ["citation" "warrant" "evidence" "comparative-claim" "bold-claim" "load-bearing" "thesis" "density"], :projection-version "flexiarg-v0", :references ["writing-coherence/floating-formalism" "writing-coherence/missing-mechanism" "writing-coherence/hedged-lift" "system-coherence/argue-empirically-not-persuasively"], :scores {}, :sigils [], :source-path "library/writing-coherence/citation-density-load-bearing-claim.flexiarg", :sources [], :status :ok, :title "Cash the Citation on Load-Bearing Claims", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When the same factual claim is made in two sections of a paper using different wording, the reader cannot tell whether the difference is a refinement, a qualification, or an inconsistency.  Reviewers default to inconsistency.  A load-bearing factual claim should have one canonical wording, used verbatim wherever the claim is invoked, with deliberate variation only when the variation is itself doing argumentative work."} {:name "context", :name-key "context", :slug "context", :text "Section-level rewrites — done at different times, often in response to different reviewer comments — produce drift that the writer doesn't notice because each section locally reads well.  Methods says \"X for purposes A, B, C\"; Limitations says \"X for purposes A, B\"; Discussion says \"X for purpose A\".  Each is plausible in isolation; together they read as the writer not having decided what the claim is.  Distinct from `paraphrase-drift` (intra-paragraph elegant restatement that fails to advance): operates at the section level and concerns *factual* alignment, not rhetorical advancement."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: local fluency in each section ↔ factual coherence across the paper.\n    Irreducible: a load-bearing factual claim either has a canonical formulation in the paper or it does not.  Drift cannot simultaneously be (a) inadvertent paraphrase and (b) deliberate argumentative variation."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a single canonical wording lets the reader recognise repeat invocation as repeat invocation.  Variation forces the reader to reconcile the variants and decide which is authoritative.\n    Active dynamic: the pull recurs in any paper rewritten in passes, especially when different reviewers prompt edits in different sections."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Inadvertent narrowing: Limitations restates the claim with one element dropped, suggesting (without intending to) that the dropped element doesn't apply there.\n      - Inadvertent widening: Discussion restates the claim with one element added, suggesting a stronger claim than the paper supports.\n      - Stylistic paraphrase: the writer rephrases for variety, treating the claim as prose rather than as a fixed proposition.\n      - Vocabulary drift across sections: the same entity is named differently in different sections (\"training input\", \"the training course\", \"the T3 programme\"), so the reader cannot tell whether they are the same."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Establish the canonical wording: in the section where the claim does its primary work, settle on one phrasing.  Treat that phrasing as the load-bearing version.\n      (2) Quote-and-reuse elsewhere: when the same claim is invoked in another section, use the canonical wording verbatim, or refer back to its first statement.\n      (3) Mark deliberate variation: where a section needs to *qualify* the canonical claim (\"subject to X\", \"in the limit of Y\"), make the qualification explicit; do not let the variation read as paraphrase.\n      (4) Audit during integration: when finalising a draft, list every load-bearing claim and the sections where it appears; check that each appearance uses the canonical wording or marks its variation."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every restatement of a load-bearing claim either uses the canonical wording verbatim or visibly marks its variation as deliberate.  Failing when: the same claim appears in three sections with three subtly different formulations and no signal that any variation is intentional."}], :conclusion "When the same factual claim is made in two sections of a paper using different wording, the reader cannot tell whether the difference is a refinement, a qualification, or an inconsistency.  Reviewers default to inconsistency.  A load-bearing factual claim should have one canonical wording, used verbatim wherever the claim is invoked, with deliberate variation only when the variation is itself doing argumentative work.", :directives {:audience "paper authors, reviewers", :keywords ["claim-drift" "cross-section" "consistency" "canonical-wording" "inadvertent-paraphrase"], :references ["writing-coherence/paraphrase-drift"], :style "pattern", :title "Use One Canonical Wording for the Same Claim", :tone "technical"}, :id "writing-coherence/cross-section-claim-drift", :keywords ["claim-drift" "cross-section" "consistency" "canonical-wording" "inadvertent-paraphrase"], :projection-version "flexiarg-v0", :references ["writing-coherence/paraphrase-drift"], :scores {}, :sigils [], :source-path "library/writing-coherence/cross-section-claim-drift.flexiarg", :sources [], :status :ok, :title "Use One Canonical Wording for the Same Claim", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A domain-specific named entity — an acronym, a programme name, a role title, a coined term — must be introduced at its first mention, even when a fuller treatment is reserved for a later section.  When the term first appears unintroduced, the reader carries an unresolved name across paragraphs and sections, hoping that the deferred definition will eventually arrive.  This is not the same as preserving suspense; it is forcing the reader to read in low resolution while the writer waits for the right moment to switch on the lights."} {:name "context", :name-key "context", :slug "context", :text "Acronyms (ORP, ORCA, T3), programme names (the Open Research Programme), role titles (\"stewards\", \"evaluators\"), and coined terms (\"receiving structure\", \"logic-model gates\") all tend to leak into the introduction or background sections of a paper before they have been introduced.  The writer knows what they mean; the reader does not.  Distinct from `floating-formalism` (typed vocabulary without grounded named instances) and from `plain-language-thesis` (jargon-reliance at thesis position): here the term *will* be defined later, but the cost is paid now."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: local economy of prose ↔ continuous reader comprehension.\n    Irreducible: the reader either knows what the term means at the point of first use, or does not.  No amount of later discharge retroactively closes the comprehension gap during the intervening pages."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: deferring a definition is sometimes the correct choice — when the term is used only ornamentally at first mention and a full definition would derail the paragraph.  But ornamental use is rare; load-bearing use is common, and load-bearing terms must be introduced when first invoked.\n    Active dynamic: the pull recurs whenever the writer is deep enough in the material to forget that the reader is meeting the term for the first time."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Acronym leak: the acronym appears in the introduction; the expansion is parked in the methods section.\n      - Cast member implied: a role (\"stewards\", \"ORCAs\") is invoked as if the reader already knows who fills it.\n      - Programme-as-given: a programme or initiative is named without a one-phrase gloss of what it consists of.\n      - Coined-term seeding: a coined term is dropped into the prose with the implicit promise that it will be explained later — and the explanation, when it arrives, no longer fits the contexts in which the term has already done work."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Discharge in plain language: introduce the entity in one phrase at first mention, even if a fuller treatment lives later.  \"the UKRN Open Research Programme — a distributed five-work-package programme operating across 24 UK higher-education institutions\".\n      (2) Demote to ornamental: if first mention is genuinely ornamental, rephrase to avoid invoking the named entity at all, and reserve the term for the section where it earns introduction.\n      (3) Promote the definition: move the full definition to the location of first mention.  Subsequent sections then become second-mentions, not first-mentions, and read accordingly."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: at every named-entity first mention, the reader can state what the entity is from the text adjacent to that first mention.  Failing when: the reader has to scan ahead, look up an acronym table, or carry an unresolved name through subsequent paragraphs."}], :conclusion "A domain-specific named entity — an acronym, a programme name, a role title, a coined term — must be introduced at its first mention, even when a fuller treatment is reserved for a later section.  When the term first appears unintroduced, the reader carries an unresolved name across paragraphs and sections, hoping that the deferred definition will eventually arrive.  This is not the same as preserving suspense; it is forcing the reader to read in low resolution while the writer waits for the right moment to switch on the lights.", :directives {:audience "paper authors, reviewers", :keywords ["first-mention" "definition" "named-entity" "acronym" "undefined-term" "deferred-introduction"], :references ["writing-coherence/floating-formalism," "writing-coherence/plain-language-thesis"], :style "pattern", :title "Discharge the Term at First Mention", :tone "technical"}, :id "writing-coherence/first-mention-undischarged", :keywords ["first-mention" "definition" "named-entity" "acronym" "undefined-term" "deferred-introduction"], :projection-version "flexiarg-v0", :references ["writing-coherence/floating-formalism," "writing-coherence/plain-language-thesis"], :scores {}, :sigils [], :source-path "library/writing-coherence/first-mention-undischarged.flexiarg", :sources [], :status :ok, :title "Discharge the Term at First Mention", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A formalism — a typed vocabulary, a category system, a quadrant diagram, a symbolic notation — earns its place in an argument by compressing content the writer has.  A formalism that is invented to *replace* content the writer lacks is free-floating: it looks rigorous without doing the work rigour does.  Free-floating formalism is diagnostic of a reality deficit.  When you reach for a typed flow, a capitalised-term taxonomy, or a new symbolic schema, check first: can you name a real instance for each element of the formalism?  If not, what the argument needs is not more formalism but more reality.  No formal element is kept in the argument unless at least one named instance from the actual domain populates it.  Formalism that cannot be grounded is either cut or marked as provisional with a note of what grounding would look like."} {:name "context", :name-key "context", :slug "context", :text "AI-assisted drafting reaches for formalism reliably.  A paragraph describing \"cross-mode evidence flows\" feels stronger than a paragraph naming actual flows between specific places.  A table of four quadrants feels stronger than a list of named cases occupying two of them.  The feeling tracks the writer's uncertainty: where reality is thin, the formalism compensates.  But the reader — especially a reader whose domain is the one the formalism invents for — sees the compensation.  Domain experts recognise their own world stripped of its proper nouns and typed into anonymous categories; the formalism reads as signal that the writer did not know the instances."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: formal compression ↔ instance grounding.\n    Irreducible: the same formal vocabulary cannot simultaneously be (a) load-bearing compression over existing reality and (b) substitute for reality the writer does not have.  At use time it is doing one or the other."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a genuine formalism compresses.  \"Voltage drop across this resistor\" is shorter than and equivalent to a paragraph describing the specific physical situation the resistor is in.  The formalism earns its compression because the instances are available when needed.  An ungrounded formalism extracts the compression without paying for it: the categories exist only in the paper's own text and the instances are never supplied.\n    Active dynamic: the pull recurs every time a writer is describing a domain they know less deeply than the reader — which for AI is most domains that have specific named inhabitants."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Typed flows without named instances: arrows labelled \"degradation signal\", \"diagnostic field report\", \"repair pattern\" between boxes labelled \"Multiplied\", \"Absorbed\", \"Mismatch\" — with no named flow of actual information between two actual places.\n      - Empty quadrants: 2×2 diagrams where three of four quadrants are labelled but only one is populated.\n      - Capitalised-term taxonomy: Capitalized Terms of Art appear only in the paper's own text and carry no external referent.\n      - Symbolic notation without reduction: a new notation is introduced but the argument could be stated without it at comparable length.\n      - Over-typed tables: column headers use formal categories (Valence, Modality, Grain) that the body cells then populate with prose — the formalism adds columns but no compression.\n      - Diagrams as decoration: box-and-arrow figures where the boxes are noun phrases from the surrounding paragraph rather than named entities."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Replace formalism with named instances: if \"cross-mode evidence flows\" is in the draft, name specific flows between specific places — \"external training provided by the Digital Research Academy and the Centre for Open Science\", \"peer-interview protocols between institutions A and B\".  Named instances carry the structural point AND ground it.\n      (2) Cash each type with at least one instance: if the formalism is load-bearing and must stay, for every type / category / quadrant, name at least one real instance that occupies it.  Empty types are the failure mode; every type populated is the pattern engaged.\n      (3) Drop the formalism: if no instances are available now, the argument does not need the formalism now.  State what you can say without it.  The formalism can be introduced later, in a draft that has the reality to ground it."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every formal element (type, category, quadrant, symbol, capitalised term) can be paired with a named real-world instance drawn from the paper's domain.  Failing when: (a) the formalism has types that are never populated with instances; (b) the \"instances\" supplied are themselves further formal categories; (c) a domain expert reading the passage could name three real things that belong in the formalism but the paper names none.\n      **Reality-deficit test:** list the formal elements.  For each, write out the first real instance you can think of from the actual domain.  If you stall on more than a third, the formalism is floating."}], :conclusion "A formalism — a typed vocabulary, a category system, a quadrant diagram, a symbolic notation — earns its place in an argument by compressing content the writer has.  A formalism that is invented to *replace* content the writer lacks is free-floating: it looks rigorous without doing the work rigour does.  Free-floating formalism is diagnostic of a reality deficit.  When you reach for a typed flow, a capitalised-term taxonomy, or a new symbolic schema, check first: can you name a real instance for each element of the formalism?  If not, what the argument needs is not more formalism but more reality.  No formal element is kept in the argument unless at least one named instance from the actual domain populates it.  Formalism that cannot be grounded is either cut or marked as provisional with a note of what grounding would look like.", :directives {:audience "paper authors, reviewers", :keywords ["formalism" "typed-flows" "categories" "quadrants" "reality-deficit" "grounding" "pseudo-rigor" "simulacrum"], :references ["writing-coherence/recursion-cheque" "writing-coherence/missing-mechanism" "writing-coherence/unearned-essentially"], :style "pattern", :title "Ground the Formalism in Named Instances", :tone "technical"}, :id "writing-coherence/floating-formalism", :keywords ["formalism" "typed-flows" "categories" "quadrants" "reality-deficit" "grounding" "pseudo-rigor" "simulacrum"], :projection-version "flexiarg-v0", :references ["writing-coherence/recursion-cheque" "writing-coherence/missing-mechanism" "writing-coherence/unearned-essentially"], :scores {}, :sigils [], :source-path "library/writing-coherence/floating-formalism.flexiarg", :sources [], :status :ok, :title "Ground the Formalism in Named Instances", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A strong sentence immediately softened by a disclaimer — \"though beyond the scope of this paper\", \"though further work is needed\", \"though we do not defend this claim here\" — asks the reader to both accept the lift and exempt the writer from defending it.  The hedge does rhetorical work the argument has not done.  Either commit and defend, or defer properly with a forward pointer the reader can chase, or cut."} {:name "context", :name-key "context", :slug "context", :text "Hedging is useful.  A hedge that names a precise scope limit is a service to the reader.  A hedge that gestures vaguely at limits (\"though beyond the scope\", \"more research is needed\", \"though nuance exists\") is authorial risk management masquerading as scholarly care.  The same sentence cannot both lift and retreat."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: claim strength ↔ authorial safety.\n    Irreducible: a sentence cannot maximise both strength and safety; the hedge is the visible negotiation."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: every claim exposes the writer to challenge; the stronger the claim, the larger the exposure.  Hedges reduce exposure but also reduce what the reader can take away.\n    Active dynamic: the pull recurs at every strong-claim sentence, particularly in conclusion paragraphs and abstracts."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Beyond-the-scope: \"important, though beyond the scope of this paper\".\n      - Future-work as escape: \"we leave a full treatment to future work\" with no indication of what the treatment would involve.\n      - Complexity plea: \"the situation is of course more complex than this\".\n      - Obligatory nuance: \"while acknowledging important nuances...\" followed by none."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Commit and defend: keep the strong sentence; use the next sentence to give the reader the argument or evidence behind it.  Pay what the lift promised.\n      (2) Defer properly: keep the strong sentence; replace the vague hedge with a forward pointer the reader can follow — \"(see §5 for the structural argument)\", \"(this is the subject of a forthcoming paper, Corneli in preparation)\".  The deferral is now a service, not an escape.\n      (3) Cut: if the claim cannot be defended now and cannot be properly deferred, it does not belong in the text.  Remove the sentence."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every strong claim in the draft is either followed by a defence, accompanied by a precise forward pointer, or removed.  Failing when: strong claims are followed by vague acknowledgements of limits (\"though this is complex\", \"though nuance exists\") that neither defend nor defer."}], :conclusion "A strong sentence immediately softened by a disclaimer — \"though beyond the scope of this paper\", \"though further work is needed\", \"though we do not defend this claim here\" — asks the reader to both accept the lift and exempt the writer from defending it.  The hedge does rhetorical work the argument has not done.  Either commit and defend, or defer properly with a forward pointer the reader can chase, or cut.", :directives {:audience "paper authors, reviewers", :keywords ["hedging" "strong-claim" "softener" "beyond-the-scope" "defer" "forward-pointer"], :references ["writing-coherence/throat-clearing-close" "writing-coherence/scope-mush"], :style "pattern", :title "Commit, Defer Properly, or Cut", :tone "technical"}, :id "writing-coherence/hedged-lift", :keywords ["hedging" "strong-claim" "softener" "beyond-the-scope" "defer" "forward-pointer"], :projection-version "flexiarg-v0", :references ["writing-coherence/throat-clearing-close" "writing-coherence/scope-mush"], :scores {}, :sigils [], :source-path "library/writing-coherence/hedged-lift.flexiarg", :sources [], :status :ok, :title "Commit, Defer Properly, or Cut", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A document grounded in one register (strategic, theoretical, architectural) often has a reader grounded in another (operational, calendar-based, decision-driven).  When the registers do not meet, the document looks evasive even when it is principled.  The remedy is not to rewrite in the reader's register, which sacrifices the rigour the abstraction was protecting; nor to leave the document unanchored, which forces the reader to translate every passage.  The remedy is to insert minimal anchors — calendar tags, cost bands, decision dates, applicability flags — that let the operational reader land without disturbing the document's stance.  The move is additive: anchors are parenthetical, italicised, and elidable; the original disclaimer that protects the abstraction's openness must be restated nearby, in the same eyeshot as the anchors."} {:name "context", :name-key "context", :slug "context", :text "Common in interdisciplinary writing where one document serves planning audiences and theoretical ones at once.  Strategic frameworks are deliberately abstract because they hold open future-decision space; operational readers experience that abstraction as refusal.  The diagnostic shows up when an operational reviewer reports that the document \"doesn't tell me what to do\" while a theoretical reviewer reports that the same document is \"appropriately principled\".  Distinct from `meta-lede` (about opening sentences, not register-mismatch across the document), `floating-formalism` (about an unanchored formalism, not an unanchored reader), and `plain-language-thesis` (about thesis legibility, not register accommodation)."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: principled abstraction ↔ reader's operational frame.\n    Irreducible: rewriting the document into the operational register sacrifices the rigour the abstraction was protecting; leaving the document fully abstract sacrifices the operational reader."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: an unanchored strategic document forces the operational reader to translate every passage and creates the impression of evasion; an over-anchored document loses the future-space the abstraction was holding and starts to read like a project plan.\n    Active dynamic: the temptation to \"soften\" the abstraction grows whenever the operational reader pushes back; the temptation to \"purify\" the abstraction grows whenever a theoretical reader objects to clutter.  The pattern recurs at every interface between strategic and operational registers in the document."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Capitulation: rewrite in the operational register and lose the rigour.  The strategic frame becomes a project plan.\n      - Refusal: leave the document unanchored and let the reader translate.  The operational reader concludes the document is evasive.\n      - Over-anchoring: insert so many anchors that the abstraction's openness collapses.  The reader can no longer tell which positions the document is holding open.\n      - Disclaimer drift: anchors are inserted without a nearby restatement of the abstraction's openness; the anchors get read as commitments."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Insert minimal italicised anchors at the points of register interface: `*(≤3 mo)*`, `*(governance-gated)*`, `*[ORP-only]*`, `*(decision binds at Stage 1)*`.  Anchors must be parenthetical and visually distinct from the running argument.\n      (2) Restate disclaimers verbatim within the same paragraph or the immediately following one: \"These brackets reflect a plausible quickstart calendar; the disclaimer about effort ranges still holds.\"  The anchor and the disclaimer must be in the same eyeshot.\n      (3) Direct the operational reader to a companion document: \"the operational addendum names the actions, time horizons, and resource bands required for the framework to become operative.\"  This preserves the main document's register while serving the operational frame elsewhere.\n      (4) Audit by elision: re-read the section without the anchors.  The argument should still hold and the disclaimer should still protect openness.  If removing the anchors changes the argument, the pattern has been over-applied."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when anchors are present, parenthetical, and elidable; the original disclaimer is restated in the same eyeshot; and the argument runs the same with or without the anchors.  Failing when anchors carry argumentative weight (the reader cannot elide them), or no nearby disclaimer protects the abstraction's openness, or the document has been rewritten in the operational register entirely."}], :conclusion "A document grounded in one register (strategic, theoretical, architectural) often has a reader grounded in another (operational, calendar-based, decision-driven).  When the registers do not meet, the document looks evasive even when it is principled.  The remedy is not to rewrite in the reader's register, which sacrifices the rigour the abstraction was protecting; nor to leave the document unanchored, which forces the reader to translate every passage.  The remedy is to insert minimal anchors — calendar tags, cost bands, decision dates, applicability flags — that let the operational reader land without disturbing the document's stance.  The move is additive: anchors are parenthetical, italicised, and elidable; the original disclaimer that protects the abstraction's openness must be restated nearby, in the same eyeshot as the anchors.", :directives {:audience "paper authors, working-paper drafters, designers writing for mixed audiences", :keywords ["register-mismatch" "operational-anchors" "calendar-tags" "applicability-flags" "abstraction-protection"], :references ["writing-coherence/meta-lede," "writing-coherence/floating-formalism," "writing-coherence/plain-language-thesis"], :style "pattern", :title "Meet the Reader Where They Are", :tone "technical"}, :id "writing-coherence/meet-the-reader-where-they-are", :keywords ["register-mismatch" "operational-anchors" "calendar-tags" "applicability-flags" "abstraction-protection"], :projection-version "flexiarg-v0", :references ["writing-coherence/meta-lede," "writing-coherence/floating-formalism," "writing-coherence/plain-language-thesis"], :scores {}, :sigils [], :source-path "library/writing-coherence/meet-the-reader-where-they-are.flexiarg", :sources [], :status :ok, :title "Meet the Reader Where They Are", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A paragraph's first sentence should perform the argument, not describe the shape of the argument it is about to make.  Announcing the shape — \"these two things differ in important ways, and those differences have consequences\" — tells the reader a paragraph is coming rather than starting it.  The concrete contrast itself, stated directly, is both more informative and more economical; the shape becomes visible from the content without being named."} {:name "context", :name-key "context", :slug "context", :text "AI prose reliably opens paragraphs with a meta-description of the paragraph's own structure: \"Both X and Y share Z, but they differ in W, and that difference matters for...\"  The sentence reads as considered and schematic, but it adds no claim the reader could disagree with.  A direct opener spends the same number of words making the actual argument, and the reader hits the claim in the first sentence rather than the second or third."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: argument announcement ↔ argument performance.\n    Irreducible: the same sentence cannot simultaneously describe the shape of a claim and make the claim."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: an announcement flags the paragraph's structure for a skimming reader; a performance commits the writer to content from the first sentence.  Both have a place — announcements work for section summaries, chapter heads, abstracts — but inside a working paragraph the performance does more.\n    Active dynamic: the pull recurs at every paragraph start, because the meta-sentence is easier to write than the direct one."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Shape-announcement: \"X and Y both do Z, but they differ in ways that matter for W.\"\n      - Topical preamble: \"There are several things to say about X, the most important of which is...\"\n      - Relevance claim: \"This distinction is important, and understanding it requires...\"\n      - Apparatus-description: \"In what follows, we examine how X relates to Y, and what this implies for Z.\""} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Cut the meta: delete the announcement sentence entirely.  The paragraph's second sentence becomes its first; the shape of the argument emerges from the content.\n      (2) Move the meta up: if the announcement genuinely frames a multi-paragraph section, lift it to a section heading or section-opening sentence where it does structural work, and let the paragraph itself open on the argument.\n      (3) Rewrite as entry: fuse the announcement and the direct claim into one sentence — the \"X differs from Y in Z\" form where Z is the content, not the claim that content exists."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: the first sentence of the paragraph states a claim a reader could disagree with, and which carries argumentative weight independently of the rest of the paragraph.  Failing when: the first sentence announces that a claim, contrast, or distinction is coming — without making it."}], :conclusion "A paragraph's first sentence should perform the argument, not describe the shape of the argument it is about to make.  Announcing the shape — \"these two things differ in important ways, and those differences have consequences\" — tells the reader a paragraph is coming rather than starting it.  The concrete contrast itself, stated directly, is both more informative and more economical; the shape becomes visible from the content without being named.", :directives {:audience "paper authors, reviewers", :keywords ["lede" "opening" "meta" "announcement" "argument-vs-description"], :references ["writing-coherence/subheading-without-paragraph" "writing-coherence/paraphrase-drift"], :style "pattern", :title "Open on the Argument, Not on Its Shape", :tone "technical"}, :id "writing-coherence/meta-lede", :keywords ["lede" "opening" "meta" "announcement" "argument-vs-description"], :projection-version "flexiarg-v0", :references ["writing-coherence/subheading-without-paragraph" "writing-coherence/paraphrase-drift"], :scores {}, :sigils [], :source-path "library/writing-coherence/meta-lede.flexiarg", :sources [], :status :ok, :title "Open on the Argument, Not on Its Shape", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A title — section, sub-section, working-paper, or document — should answer the question \"what is this saying\" in itself, not invite the reader to ask.  Where a paragraph opening can describe shape without disqualifying itself (the failure named by `meta-lede`), a title that describes shape — \"What endorsement commits\", \"Three concrete commitments\", \"On the question of X\" — fails more sharply, because the reader hits the title and is left needing to read on simply to discover what claim the section makes.  The discipline is therefore sharper for titles than for paragraph leads: a meta paragraph opener is suboptimal; a meta title is broken.  The remedy is to replace the label with the section's actual claim, in plain language, ideally drawn from the section's own load-bearing sentence."} {:name "context", :name-key "context", :slug "context", :text "AI prose and human first-drafts often title sections with descriptions of what the section will do (\"What X means\", \"On Y\", \"About Z\", \"Three observations\") rather than statements of what the section says.  The reader hits a meta title and is forced to ask \"what does X mean? what about Y?\" — questions the title itself was supposed to close.  Distinct from `meta-lede` (paragraph-level shape-vs-content failure that the paragraph itself can recover from in subsequent sentences) and from `subheading-without-paragraph` (the paragraph fails to discharge what the subheading promised; meta-title is a related but inverse failure where the heading does not even commit to a claim the paragraph could discharge).  Closely related to `plain-language-thesis`: titles, like top-level claims, must be readable standalone, by a reader who has not read the section yet."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: title as label-for-topic ↔ title as claim-about-content.\n    Irreducible: a title that names the shape of an argument and a title that performs the argument cannot be the same title."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a label-style title (\"Methods\", \"Limitations\", \"Discussion\") works in conventional scholarly contexts where the reader knows what each section will contain.  A claim-style title does more work in essays, working papers, and any section that is making an argument.  The right form depends on genre.  Mistaking a working-paper section for a methods section is one source of meta titles; the genre should be diagnosed before the title is set.\n    Active dynamic: meta titles are easier to write because the writer can pull a phrase out of the section's purpose and use it as a label without committing to what the section actually claims.  The pull recurs at every section break, especially when the section is being drafted before its claim has stabilised."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Topic label: \"On X\" / \"About Y\" / \"What X commits\" — titles that name a topic without making a claim.  Reader is left asking what about X.\n      - Question title: \"What does X mean?\" — invites the reader to read on for an answer the title should already have provided.\n      - Count-announcement: \"Three commitments\" / \"Four claims\" — names a count without naming the content.  Reader is left asking what the three or four are.\n      - Shape-announcement: \"Argument structure\" / \"How the model works\" — describes the shape of what is to come rather than what is being said.\n      - Genre-confusion: a working paper section uses scholarly conventional labels (\"Methodology\", \"Background\") where a claim-style title would do more work for the reader."} {:name "THEN", :name-key "then", :slug "then", :text "Replace the label with the section's actual claim; use the section's own load-bearing sentence as candidate; audit by question-test."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Replace label with claim: \"What endorsement commits\" → \"Reproducible research applied to learning system design\" (the section's own concluding sentence; performs what the section says).  \"Three commitments\" → \"Three concrete commitments follow from endorsement\" (still light, but at least makes the claim).\n      (2) Use the section's load-bearing sentence: if a single sentence in the section captures what the section says, that sentence (or a compressed form of it) is a candidate title.  Often the section's *own concluding line* is the cleanest title for the section.\n      (3) Audit by question-test: read the title; ask \"what does the reader still want to know after reading just this title?\" If the answer is \"what claim the section actually makes\", the title is meta.  If the answer is \"the details that support the claim the title made\", the title is fine.\n      (4) Diagnose the genre: if the document is a working paper or argumentative essay, prefer claim-style titles.  If it is conventional scholarly prose with established section labels, label-style titles are acceptable and do not need to be replaced."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when reading the title alone tells the reader what the section claims, in plain language, without further reading.  Failing when the title describes the section's topic, announces a count without naming what is counted, asks a question the section will answer, or labels the section by its conventional role rather than its content."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - In any working paper or argumentative section, audit every subsection heading against this pattern; replace meta titles with their load-bearing claims, often drawn from the section's own concluding line.\n    - Where genre conventions favour label-style titles (Methods, Limitations, References), flag the genre choice as deliberate rather than default.  The pattern is then engaged because the writer has named the choice."}], :conclusion "A title — section, sub-section, working-paper, or document — should answer the question \"what is this saying\" in itself, not invite the reader to ask.  Where a paragraph opening can describe shape without disqualifying itself (the failure named by `meta-lede`), a title that describes shape — \"What endorsement commits\", \"Three concrete commitments\", \"On the question of X\" — fails more sharply, because the reader hits the title and is left needing to read on simply to discover what claim the section makes.  The discipline is therefore sharper for titles than for paragraph leads: a meta paragraph opener is suboptimal; a meta title is broken.  The remedy is to replace the label with the section's actual claim, in plain language, ideally drawn from the section's own load-bearing sentence.", :directives {:audience "paper authors, working-paper drafters, anyone writing structured prose with section headings", :keywords ["title" "section-heading" "subheading" "claim-vs-description" "meta-title" "scholarly-genre" "working-paper"], :references ["writing-coherence/meta-lede," "writing-coherence/subheading-without-paragraph," "writing-coherence/plain-language-thesis"], :style "pattern", :title "Title the Section by What It Says, Not What It Discusses", :tone "technical"}, :id "writing-coherence/meta-title", :keywords ["title" "section-heading" "subheading" "claim-vs-description" "meta-title" "scholarly-genre" "working-paper"], :projection-version "flexiarg-v0", :references ["writing-coherence/meta-lede," "writing-coherence/subheading-without-paragraph," "writing-coherence/plain-language-thesis"], :scores {}, :sigils [], :source-path "library/writing-coherence/meta-title.flexiarg", :sources [], :status :ok, :title "Title the Section by What It Says, Not What It Discusses", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A contrast stated without its mechanism is a fact.  A contrast stated with its mechanism is generative — it produces consequences the reader can follow to new claims.  A paragraph that names a difference but never names what the difference does leaves the reader holding a distinction with nothing to do with it.  The mechanism is the hinge between \"what the contrast is\" and \"what the contrast implies\"; the visible hinge is often a single sentence of the form \"this divides X at the point of Y\" or \"the consequence is that Z\"."} {:name "context", :name-key "context", :slug "context", :text "AI prose is strong at naming contrasts and weak at cashing them.  A paragraph will set up \"A differs from B because A does X while B does Y\" and then close without saying what follows.  The reader absorbs the contrast as decorative.  A paragraph that names the mechanism — \"this divides their working methods at the point of revision\" — opens a door to consequences the contrast then pays out: opposite risks, opposite failure modes, opposite affordances.  Without the mechanism, the paragraph is complete as description but exhausted as argument."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: contrast as fact ↔ contrast as generator.\n    Irreducible: the same paragraph cannot simultaneously leave the contrast at rest and develop it.  To develop, the writer must commit to what the contrast does."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a well-stated contrast can stand on its own as observation; the writer is not obliged to extract consequences.  But a paragraph whose purpose is argument needs its contrasts to generate.  A contrast without mechanism closes down; a contrast with mechanism opens up.\n    Active dynamic: the pull recurs every time a writer states a contrast they find satisfying and is tempted to move on."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Decorative contrast: \"X does it one way; Y does it another\" stated and immediately restated, with no consequence.\n      - Asserted significance: \"and that difference decides almost everything\" — the significance is claimed but not discharged.\n      - Mechanism in metaphor only: the mechanism is implied by a vivid image but never stated in terms the argument can use.\n      - Consequence-free closing: the paragraph closes on a meta-reframe of the contrast rather than on what the contrast implies."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Name the mechanism explicitly: add a hinge sentence of the form \"this divides X at the point of Y\" or \"the consequence is that Z\", then cash the consequences in the sentences that follow.\n      (2) Implicit mechanism + immediate consequence: skip the hinge but immediately state a consequence that reveals the mechanism by inference — \"Van Gogh risks the image never arriving...\" does this for the revision mechanism.\n      (3) Retire the contrast: if no mechanism is available, the contrast may not belong in an argumentative paragraph.  Keep it as description elsewhere (a portrait, a sidebar) or cut."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every contrast stated in an argumentative paragraph has, by the end of the paragraph, either an explicit mechanism sentence or an immediate consequence sentence that reveals one.  Failing when: the paragraph states a contrast and paraphrases it without ever saying what the contrast produces."}], :conclusion "A contrast stated without its mechanism is a fact.  A contrast stated with its mechanism is generative — it produces consequences the reader can follow to new claims.  A paragraph that names a difference but never names what the difference does leaves the reader holding a distinction with nothing to do with it.  The mechanism is the hinge between \"what the contrast is\" and \"what the contrast implies\"; the visible hinge is often a single sentence of the form \"this divides X at the point of Y\" or \"the consequence is that Z\".", :directives {:audience "paper authors, reviewers", :keywords ["mechanism" "contrast" "consequence" "hinge" "so-what" "therefore"], :references ["writing-coherence/paraphrase-drift" "writing-coherence/recursion-cheque"], :style "pattern", :title "Name the Mechanism That Makes the Contrast Bite", :tone "technical"}, :id "writing-coherence/missing-mechanism", :keywords ["mechanism" "contrast" "consequence" "hinge" "so-what" "therefore"], :projection-version "flexiarg-v0", :references ["writing-coherence/paraphrase-drift" "writing-coherence/recursion-cheque"], :scores {}, :sigils [], :source-path "library/writing-coherence/missing-mechanism.flexiarg", :sources [], :status :ok, :title "Name the Mechanism That Makes the Contrast Bite", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a section describes what a successor project inherits from a predecessor, listing only the inheritance leaves readers to infer the full extent of the inheritance — which they will do generously.  The remedy is to name, alongside what is taken, what is deliberately dropped.  The drop list is short, explicit, and located in the same eyeshot as the inheritance list; without it, scope is implicit-by-omission and readers will silently over-attribute.  The discipline applies symmetrically: when naming what one is doing with a predecessor's work, name what one is leaving behind."} {:name "context", :name-key "context", :slug "context", :text "Common in working papers, successor proposals, derived programmes, replication studies — anywhere a new effort is positioned relative to a prior effort.  The writer knows what they are carrying forward AND what they are letting go; the reader sees only the carrying forward.  This produces the silent failure mode where readers assume continuity in scope decisions where the writer has actually re-decided.  Distinct from `scope-mush` (about hedged enumeration pretending to scope without specifying it): here the failure is the *absence* of the negative list, not the hedging of a list that exists."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: positive scope visible to reader ↔ scope decisions visible to reader.\n    Irreducible: the reader either has the drop list, or fills it in by default with the predecessor's full scope.  Default-fill is generous — the reader assumes inheritance unless told otherwise."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: the drop list looks negative, and the writer often resists writing it for that reason; producing it forces the writer to re-articulate why each dropped item is dropped, which exposes whether the drop is principled or accidental.\n    Active dynamic: the temptation to omit grows whenever the writer believes the drops are obvious; they rarely are, and obvious-to-the-writer is not obvious-to-the-reader."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Silent inheritance: list of inheritances published; list of drops withheld; reader infers full scope continuity.\n      - Hidden drop justifications: drop is mentioned somewhere in the document but not co-located with the inheritance, so the reader does not see it as part of the same scope decision.\n      - Apologetic drop: drops are mentioned but qualified (\"we cannot do X for resource reasons\"), making them feel temporary even when the decision is principled and permanent.\n      - Drop-as-limitation: drops are placed in a Limitations section, where they read as caveats rather than as architectural decisions."} {:name "THEN", :name-key "then", :slug "then", :text "Add an explicit drop list adjacent to the inheritance list; treat each drop as a positive scope decision with its own brief justification."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Co-locate the drop list: place \"what we drop\" / \"what is out of scope\" / \"what we leave behind\" immediately after or beside the inheritance list.  Eyeshot proximity matters: if the lists are in different sections, the reader will not pair them.\n      (2) Justify the drop, not just name it: each item in the drop list gets a one-clause justification explaining why it is dropped.  \"Trainer cascade obligations as a contractual structure: UKRN-S trainers deliver, they do not also recruit and train next-tier trainers.\"  The justification turns the drop into a scope decision rather than a deficit.\n      (3) Use a positive frame: \"what we drop\" or \"what we leave behind\" frames the list as decision; \"what we cannot do\" or \"limitations\" frames it as deficit.  Choose decision framing unless deficit is the actual content.\n      (4) Audit by symmetry: read the section listing inheritances; ask \"would a reader who saw this list assume we inherit X?\" for each candidate drop.  If yes for any, the drop list needs to include X."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when the section that lists inheritances is paired with a drop list of comparable visibility, each drop carries its own justification, and the framing presents drops as decisions rather than deficits.  Failing when inheritances are listed without their corresponding drops, or when drops are scattered into footnotes or limitations sections rather than co-located with inheritances."}], :conclusion "When a section describes what a successor project inherits from a predecessor, listing only the inheritance leaves readers to infer the full extent of the inheritance — which they will do generously.  The remedy is to name, alongside what is taken, what is deliberately dropped.  The drop list is short, explicit, and located in the same eyeshot as the inheritance list; without it, scope is implicit-by-omission and readers will silently over-attribute.  The discipline applies symmetrically: when naming what one is doing with a predecessor's work, name what one is leaving behind.", :directives {:audience "paper authors, working-paper drafters, system designers writing about predecessor projects", :keywords ["inheritance" "scope" "drop-list" "predecessor-project" "successor-project" "scope-by-omission" "negative-scope"], :references ["writing-coherence/scope-mush," "writing-coherence/first-mention-undischarged"], :style "pattern", :title "Name What You Drop, Not Only What You Inherit", :tone "technical"}, :id "writing-coherence/name-what-you-drop", :keywords ["inheritance" "scope" "drop-list" "predecessor-project" "successor-project" "scope-by-omission" "negative-scope"], :projection-version "flexiarg-v0", :references ["writing-coherence/scope-mush," "writing-coherence/first-mention-undischarged"], :scores {}, :sigils [], :source-path "library/writing-coherence/name-what-you-drop.flexiarg", :sources [], :status :ok, :title "Name What You Drop, Not Only What You Inherit", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a paragraph carries multiple structurally distinct claims — two scenarios, three cases, several findings — each fused together by em-dashes and semicolons doing the structural-separation work that paragraph breaks should do, the reader has to recover the claim-count from punctuation rather than from layout.  This is most visible when the prose is meant to correspond to an external visual (a figure with N panels, a table with N rows): if the figure shows four panels but the prose collapses two of them into one paragraph, the prose-figure correspondence breaks at exactly the point a reader scanning between them would expect to find alignment.  The fix is structurally honest: one paragraph per typed claim, or one bullet per claim, or move to a list/table form when the claim-count gets large."} {:name "context", :name-key "context", :slug "context", :text "Prose paragraphs are typed by their structural role — an evidence-presentation paragraph, a synthesis paragraph, a scenario-description paragraph, a counter-claim paragraph.  When a single paragraph carries two scenarios, two findings, or two arguments, it's doing the work of two paragraphs in one — and signalling this only with internal punctuation (em-dashes, semicolons, \"and\" coordinators).  Readers who skim by paragraph count miss the implicit structure entirely.  Readers cross-referencing to a figure see N panels and N-1 paragraphs and have to figure out where the missing-paragraph's content went.  The fix is to split."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: paragraph-as-structural-unit ↔ paragraph-as-prose-rhythm.\n    Irreducible: either the paragraph count matches the typed-claim count, or the typed-claim count is hidden inside punctuation."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: splitting a fused paragraph into two paragraphs can lose narrative flow (sometimes the em-dash and semicolon were doing genuine connective work).  Short paragraphs can read as choppy.  And not every multi-claim paragraph is best split — sometimes the claims are genuinely subordinate (a main claim with a parenthetical caveat), and splitting promotes the caveat above its rank.\n    Active dynamic: the pull toward fusion is strongest in synthesis or summary paragraphs (where multiple findings are being assembled), in scenario-bounding paragraphs (where the writer is naming \"two scenarios that bracket the envelope\" and treating them as a pair), and in evidence-presentation paragraphs (where a primary claim and its supporting detail get rolled together)."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Em-dash structural work: the em-dash is carrying paragraph-break weight (separating two scenarios, two findings, two cases) where a paragraph break is the appropriate structural marker.\n      - Semicolon-stack: three or more semicolons in a paragraph that's actually three or more claims stitched together.\n      - Prose-figure misalignment: a figure has N panels (or a table has N rows); the corresponding prose has fewer paragraphs, with some panels' content fused into others.\n      - \"Two scenarios\" sentence followed by one paragraph: the writer explicitly says \"two scenarios\" but writes only one paragraph to cover both — the announce-vs-deliver mismatch.\n      - List collapsed into prose: what should have been a 3-item list (\"first, ...; second, ...; third, ...\") gets written as one prose paragraph; the reader has to count manually."} {:name "THEN", :name-key "then", :slug "then", :text "Match paragraph structure to typed-claim structure.  Pick one composition."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Split into one paragraph per claim.\n          Augmentation schema: {:claim-count <n> :paragraph-titles <optional, one per claim>}\n          Entity types produced: :split-paragraph (one per claim)\n          Effect: paragraph count now matches claim count; figure-correspondence (if applicable) becomes legible.\n      (2) Convert to a list or table.\n          Augmentation schema: {:list-or-table :list | :table :columns <if table>}\n          Entity types produced: :structured-list, :typed-row\n          Effect: most appropriate when the claims are short, parallel, and would be served by visual alignment (a 4-row table is more legible than 4 short paragraphs).\n      (3) Subordinate the secondary claim.\n          Augmentation schema: {:primary-claim <id> :subordinate-claim <id> :subordination-form :parenthetical | :footnote | :inline-clause}\n          Entity types produced: :subordinated-claim\n          Effect: when the two claims aren't actually structurally equal (one is the main scenario, one is a caveat), explicitly mark the subordinate as parenthetical rather than fusing as if both were primary."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when paragraph count matches typed-claim count (for paragraphs carrying scenarios, findings, or cases) and any prose-figure correspondence is exhibitable by 1:1 alignment.  A skeptical reader can count claims by counting paragraphs.  Failing when a sentence announcing \"N scenarios\" is followed by fewer than N paragraphs, or when an em-dash inside a paragraph is doing paragraph-break work."}], :conclusion "When a paragraph carries multiple structurally distinct claims — two scenarios, three cases, several findings — each fused together by em-dashes and semicolons doing the structural-separation work that paragraph breaks should do, the reader has to recover the claim-count from punctuation rather than from layout.  This is most visible when the prose is meant to correspond to an external visual (a figure with N panels, a table with N rows): if the figure shows four panels but the prose collapses two of them into one paragraph, the prose-figure correspondence breaks at exactly the point a reader scanning between them would expect to find alignment.  The fix is structurally honest: one paragraph per typed claim, or one bullet per claim, or move to a list/table form when the claim-count gets large.", :directives {:audience "paper authors, working-paper drafters, reviewers", :keywords ["paragraph" "fused-paragraph" "structure" "claim-count" "scenario" "prose-figure-alignment" "em-dash" "semicolon"], :references ["writing-coherence/subheading-without-paragraph" "writing-coherence/structural-style-inconsistency" "system-coherence/present-graph-topology-not-adjacency-lists"], :style "pattern", :title "One Paragraph Per Typed Claim", :tone "technical"}, :id "writing-coherence/one-paragraph-per-typed-claim", :keywords ["paragraph" "fused-paragraph" "structure" "claim-count" "scenario" "prose-figure-alignment" "em-dash" "semicolon"], :projection-version "flexiarg-v0", :references ["writing-coherence/subheading-without-paragraph" "writing-coherence/structural-style-inconsistency" "system-coherence/present-graph-topology-not-adjacency-lists"], :scores {}, :sigils [], :source-path "library/writing-coherence/one-paragraph-per-typed-claim.flexiarg", :sources [], :status :ok, :title "One Paragraph Per Typed Claim", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Each sentence in a paragraph must add something the preceding sentences did not.  A sentence that re-expresses a prior claim in prettier language — however elegant the rephrasing — is drift, not development.  The paragraph ends in roughly the same place it started, and the reader has absorbed two or three beautiful versions of a single idea rather than one idea plus two or three consequences of it."} {:name "context", :name-key "context", :slug "context", :text "Paraphrase drift is the most literate failure mode in AI-assisted prose.  It reads as sophisticated because each restatement reaches for a new metaphor — \"the surface is a transcript\", \"evidence of a nervous system\", \"a rendering medium\" — and the cumulative effect is of depth.  But a reader who tracks what the paragraph claims, sentence by sentence, finds the sentences say the same thing.  A good paragraph states the claim once and then spends its remaining sentences on what follows from it: a mechanism, a consequence, a contrast, a complication."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: restatement ↔ development.\n    Irreducible: a single sentence cannot simultaneously restate the prior sentence and advance beyond it.  The choice is local and binary."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: restatement is easier, prettier, and feels safer — each new phrasing reduces the risk that one phrasing lands badly.  Development is harder because it commits to a next claim that must itself be defended.\n    Active dynamic: the pull recurs at every sentence boundary, especially after a sentence the writer is pleased with."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Metaphor stack: \"the surface is a transcript; paint as evidence of a nervous system; a record of its own making\" — three images, one claim.\n      - Semicolon-pair chains: the same contrast re-rendered as \"X does A; Y does B\" three times with different As and Bs that mean the same thing.\n      - Elegant-close drift: the paragraph's last sentence is its most beautiful restatement rather than its strongest consequence.\n      - Synonymous parallelism: \"Not only X, but also Y\" where X and Y are the same observation in different words."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Develop: replace a restatement sentence with a sentence that names the mechanism, consequence, or condition that follows from the prior claim.  The paragraph now advances.\n      (2) Cut: delete the restatement entirely.  If the prior sentence was well-made, the paragraph does not lose argument by losing the paraphrase.\n      (3) Promote one phrasing, cut the others: if multiple paraphrases exist across consecutive sentences, keep the strongest and cut the rest.  A single well-chosen metaphor beats three stacked."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every sentence in a paragraph adds a claim, mechanism, consequence, or precondition not present in the preceding sentences.  Failing when: consecutive sentences map, under paraphrase, to the same underlying assertion."}], :conclusion "Each sentence in a paragraph must add something the preceding sentences did not.  A sentence that re-expresses a prior claim in prettier language — however elegant the rephrasing — is drift, not development.  The paragraph ends in roughly the same place it started, and the reader has absorbed two or three beautiful versions of a single idea rather than one idea plus two or three consequences of it.", :directives {:audience "paper authors, reviewers", :keywords ["paraphrase" "restatement" "development" "advancement" "elegant-drift" "semicolon-parallel"], :references ["writing-coherence/triad-inflation" "writing-coherence/throat-clearing-close" "writing-coherence/meta-lede"], :style "pattern", :title "Every Sentence Must Advance", :tone "technical"}, :id "writing-coherence/paraphrase-drift", :keywords ["paraphrase" "restatement" "development" "advancement" "elegant-drift" "semicolon-parallel"], :projection-version "flexiarg-v0", :references ["writing-coherence/triad-inflation" "writing-coherence/throat-clearing-close" "writing-coherence/meta-lede"], :scores {}, :sigils [], :source-path "library/writing-coherence/paraphrase-drift.flexiarg", :sources [], :status :ok, :title "Every Sentence Must Advance", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A top-level claim — the paper's thesis, a section's \"lemma\"-style opening assertion, an exec-summary proposition — must be readable standalone, by a reader who has not read the rest of the work.  This means: no load-bearing jargon (terms that require prior definition from the paper to resolve), and no syntactic contortion (subjects buried behind referring expressions the reader has to unpack).  Body paragraphs can lean on technical vocabulary the paper earns as it goes; top-level claims cannot, because they are the first thing the reader meets and the last thing the reader remembers."} {:name "context", :name-key "context", :slug "context", :text "AI-assisted drafting routinely produces top-level claims that sound precise to the writer — who has the whole paper loaded — but require the paper-internal context to parse.  \"UKRN-S's core function is to hold the evidence apex\" reads cleanly if §1 is in head; reads as an impenetrable noun phrase otherwise.  Similarly \"the service bearing it accepts five design disciplines\" forces the reader to reconstruct what \"the service bearing it\" refers to, which introduces a small but repeating friction with every re-read.  The claim may be correct; it is not *landing* as a claim."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: precision ↔ standalone readability.\n    Irreducible: the same sentence cannot simultaneously be maximally precise (using the paper's earned terms) and maximally standalone (using terms any reader already carries).  At thesis position, standalone wins; at body position, precision can win."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: technical vocabulary earns compression.  The same sentence with jargon can encode more than its plain-language sibling.  But at the thesis position, the compression is paid by readers who don't have the prior context — which, for a thesis, is every reader on first encounter and every skimming reader on every encounter.\n    Active dynamic: the pull recurs every time the writer states a claim at the paper or section top — because the writer has the context and the reader, at that position, provably does not."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Jargon-reliance: \"UKRN-S's core function is to hold the evidence apex that the ORP could not\" — \"evidence apex\" requires §1; \"ORP\" requires prior-knowledge acronym expansion.\n      - Syntactic displacement: \"the service bearing it accepts five design disciplines\" — \"it\" resolves to something the sentence does not carry; \"the service bearing it\" puts the real subject three words in.\n      - Shibboleth: \"We operationalise five coherence patterns under NPT sub-construct ratings in a prior-predictive framework\" — parses only for readers inside the paper's community.\n      - Nested-clause thesis: \"The claim, which rests on the observation that X, when Y, is Z\" — correct but unparseable cold.\n      - Capitalised-concept overload: \"The Sustainability Tetrahedron's Evidence Apex coordinates the Three Mode-Sub-Tetrahedra\" — internal capitalisation does not compensate for missing definitions."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Strip the jargon: name the referent directly using a term the reader already carries.  \"Evidence apex\" → \"the kind of cross-institutional evidence that makes local success conditions legible to others\".  Longer, but readable cold.\n      (2) Unbury the subject: the sentence's actor and verb should be first-hit parseable.  \"The service bearing it accepts five disciplines\" has subject \"the service bearing it\" — a three-word referring expression before the main verb.  \"A centrally-administered training programme becomes a learning system when...\" leads with a concrete subject.\n      (3) Define-and-use in the same sentence: if a technical term is genuinely load-bearing and cannot be unstripped, define it in the sentence before invoking it — \"UKRN-S's core function is to hold the evidence apex — the shareable, translatable evidence of what works locally\".  Rare; costs length; paid only when the term earns it.\n      (4) Two-sentence decompression: one sentence states the claim in plain language; the next promotes the technical term.  \"UKRN-S becomes a learning system when it inhabits the design tensions the programme has named.  In the paper's geometric terms, UKRN-S holds the evidence apex relative to three mode-tetrahedra.\"  The plain version is the thesis; the technical version is the operational sharpening."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: the top-level claim is comprehensible to a reader who has not read the paper, with no forward-reference to section content, and parses on first read without mental contortion.  Failing when: (a) a term in the claim requires prior paper content to resolve (jargon-reliance), or (b) the subject-verb-object structure requires the reader to re-parse to locate what acts on what (syntactic displacement), or (c) the claim reads as signal of membership in the paper's argument community rather than as a claim (shibboleth).\n      **Standalone-reader test:** paste the sentence alone into a message to someone unfamiliar with the work.  Can they tell what is being claimed, even roughly?  If not, the pattern is not engaged."}], :conclusion "A top-level claim — the paper's thesis, a section's \"lemma\"-style opening assertion, an exec-summary proposition — must be readable standalone, by a reader who has not read the rest of the work.  This means: no load-bearing jargon (terms that require prior definition from the paper to resolve), and no syntactic contortion (subjects buried behind referring expressions the reader has to unpack).  Body paragraphs can lean on technical vocabulary the paper earns as it goes; top-level claims cannot, because they are the first thing the reader meets and the last thing the reader remembers.", :directives {:audience "paper authors, reviewers", :keywords ["thesis" "lemma" "top-level-claim" "jargon" "standalone-reader" "readability" "shibboleth"], :references ["writing-coherence/meta-lede" "writing-coherence/missing-mechanism" "writing-coherence/unearned-essentially"], :style "pattern", :title "State Top-Level Claims in Plain Language", :tone "technical"}, :id "writing-coherence/plain-language-thesis", :keywords ["thesis" "lemma" "top-level-claim" "jargon" "standalone-reader" "readability" "shibboleth"], :projection-version "flexiarg-v0", :references ["writing-coherence/meta-lede" "writing-coherence/missing-mechanism" "writing-coherence/unearned-essentially"], :scores {}, :sigils [], :source-path "library/writing-coherence/plain-language-thesis.flexiarg", :sources [], :status :ok, :title "State Top-Level Claims in Plain Language", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A sentence claiming that an argument applies at multiple scales — \"the same argument applies within X as across X\", \"the structure is recursive: the same pattern holds at each level\" — writes a cheque that must be cashed.  Either the paper demonstrates the claim at at least one scale, or it does not belong.  Recursion, fractality, and self-similarity are analytical devices only when they produce a result the flat view does not."} {:name "context", :name-key "context", :slug "context", :text "Recursion claims are attractive because they sound elegant and ambitious.  They promise that one argument covers multiple phenomena.  They are dangerous because the elegance is free — the writer pays nothing to claim recursion, and the reader has no way to check unless the paper exhibits it.  AI prose tips toward making recursion claims that the paper has set up but not demonstrated."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: generalisation claim ↔ demonstration capacity.\n    Irreducible: a claim cannot simultaneously generalise across scales and decline to show any scale beyond the original."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: recursion, when genuine, is a powerful compression.  Recursion, when asserted without demonstration, is mere rhetoric.  The paper cannot have the compression without paying for it.\n    Active dynamic: the pull recurs whenever a paper's main argument feels \"big enough\" to generalise but has only been shown in one form."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Undemonstrated within-X: \"the same logic that holds across institutions holds within them\" with no within-institution case.\n      - Asserted fractality: \"the structure is recursive / fractal / self-similar\" as a closing gesture.\n      - Free elegance: recursion claim appears only in the conclusion, not in the body.\n      - Circular defence: when questioned, the writer points to the main argument as evidence the recursion holds — but the main argument is at the primary scale only."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Cash at one scale: keep the recursion claim; add one concrete instance at a second scale.  Show the argument biting at the smaller or larger scale the claim names.  The recursion is now earned by exhibition.\n      (2) Cash at both scales: if the recursion is structurally central (not decorative), demonstrate it at both.  This is the highest-commitment path and is appropriate when the recursion IS the result.\n      (3) Drop the claim: if no scale-shifted demonstration is available, remove the recursion sentence.  The paper still has everything it had before; what it loses is a claim it could not back."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every recursion or multi-scale claim in the paper is accompanied by at least one concrete demonstration beyond the primary scale.  Failing when: \"the same argument applies at scale Y\" appears without a demonstration at scale Y."}], :conclusion "A sentence claiming that an argument applies at multiple scales — \"the same argument applies within X as across X\", \"the structure is recursive: the same pattern holds at each level\" — writes a cheque that must be cashed.  Either the paper demonstrates the claim at at least one scale, or it does not belong.  Recursion, fractality, and self-similarity are analytical devices only when they produce a result the flat view does not.", :directives {:audience "paper authors, reviewers", :keywords ["recursion" "fractal" "self-similar" "scale" "multi-scale" "cash-it-or-drop"], :references ["writing-coherence/unearned-essentially"], :style "pattern", :title "Show the Recursion at at Least One Scale, or Drop It", :tone "technical"}, :id "writing-coherence/recursion-cheque", :keywords ["recursion" "fractal" "self-similar" "scale" "multi-scale" "cash-it-or-drop"], :projection-version "flexiarg-v0", :references ["writing-coherence/unearned-essentially"], :scores {}, :sigils [], :source-path "library/writing-coherence/recursion-cheque.flexiarg", :sources [], :status :ok, :title "Show the Recursion at at Least One Scale, or Drop It", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Constructions like \"this matters for a variety of reasons, including...\" or \"among other things, X, Y, and Z...\" typically contain either one real reason padded with filler, or several reasons of unequal weight that would each deserve a sentence.  The mush signals coverage without paying its cost.  Name the reasons individually and defend each, or state a single reason cleanly, or drop the list."} {:name "context", :name-key "context", :slug "context", :text "Scope mush is a form of enumeration that has lost faith in its own items.  The \"variety\" hedges the quantity; the \"including\" hedges the selection; the \"among other things\" hedges both.  AI prose reaches for the mush when the writer has not sorted which reasons are load-bearing.  Readers sense the lack of commitment and discount the whole sentence."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: coverage ↔ specificity.\n    Irreducible: a sentence cannot simultaneously claim broad coverage and commit to specific items.  Either the scope is wide and the items are examples, or the scope is narrow and the items are the argument."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a genuinely multi-reason claim deserves enumeration with defences per item.  A single-reason claim deserves one sentence that states the reason cleanly.  Mush optimises for neither.\n    Active dynamic: the pull recurs whenever a writer has more than one candidate reason but has not ranked or differentiated them."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Variety hedge: \"for a variety of reasons, including...\" with one real reason and filler.\n      - Among-other-things: \"among other things, X, Y, and Z\" where the \"other things\" never surface.\n      - Uneven weight: a three-item list where item 1 carries the claim and items 2–3 are illustrations promoted to parallel status.\n      - Open-ended enumeration: \"such as A, B, C, ...\" where the trailing \"...\" exempts the writer from completeness."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Name one and defend it: if one reason is load-bearing, cut the list and state that reason with its defence.  \"This matters because X\" beats \"this matters for a variety of reasons\".\n      (2) Split into sentences: if several reasons carry distinct weight, give each its own sentence with its own defence.  The enumeration is now an argument, not a gesture.\n      (3) Drop the list: if the claim stands alone without a reason catalogue, remove the list entirely.  Readers are not well-served by the variety-claim if the items are not going to work."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every \"variety of reasons\" / \"among other things\" / \"including\" list in the draft has been rewritten as either a single committed reason or as per-sentence enumerated reasons.  Failing when: lists appear where the items are not individually defended and are not clearly illustrative of a single committed claim."}], :conclusion "Constructions like \"this matters for a variety of reasons, including...\" or \"among other things, X, Y, and Z...\" typically contain either one real reason padded with filler, or several reasons of unequal weight that would each deserve a sentence.  The mush signals coverage without paying its cost.  Name the reasons individually and defend each, or state a single reason cleanly, or drop the list.", :directives {:audience "paper authors, reviewers", :keywords ["scope" "variety-of-reasons" "including-among-others" "filler-list" "enumeration"], :references ["writing-coherence/triad-inflation" "writing-coherence/hedged-lift"], :style "pattern", :title "Name the Real Reasons Individually, or Not at All", :tone "technical"}, :id "writing-coherence/scope-mush", :keywords ["scope" "variety-of-reasons" "including-among-others" "filler-list" "enumeration"], :projection-version "flexiarg-v0", :references ["writing-coherence/triad-inflation" "writing-coherence/hedged-lift"], :scores {}, :sigils [], :source-path "library/writing-coherence/scope-mush.flexiarg", :sources [], :status :ok, :title "Name the Real Reasons Individually, or Not at All", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A section boundary is the place where the reader most needs help: the closing paragraph must name what has been established, and the next opening paragraph must name what is now to be addressed.  When the closing sentence reads as a finding rather than a positioning move, and the next section begins cold, the reader cannot tell whether the closing claim was the section's conclusion or its setup.  The section-to-section connective tissue has been silently elided, and the argument's spine goes invisible at exactly the joints."} {:name "context", :name-key "context", :slug "context", :text "AI drafts and condensed academic prose both tend to drop the bridge.  Each paragraph stands locally well, and each section opens with a competent topic sentence; but the relationship between them has been left to the reader to reconstruct from the section titles alone.  Reviewers experience this as \"the argument jumps\" even when no individual paragraph is weak.  Distinct from `throat-clearing-close` (which is about ending on attitude rather than claim) and from `meta-lede` (which is about opening on shape rather than content): here the diagnostic is the *transition*, not either sentence in isolation."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: local paragraph competence ↔ argumentative continuity across sections.\n    Irreducible: the bridge cannot be supplied by section titles alone — titles signal topic, but the reader needs the argumentative move from one to the next."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a strong closing paragraph orients the reader to what has just been established; a strong opening paragraph names what is now at stake.  Without both, the section boundary asserts a structural break the argument never repairs.\n    Active dynamic: the pull recurs at every section break, and is strongest where the writer has been deep inside one section and forgets that the reader is about to leave it."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Cold open: the next section begins with a topic sentence that ignores the closing claim of the previous section.\n      - Finding-as-close: the closing sentence asserts a result without orienting the reader to what is next.\n      - Title-as-bridge: the writer relies on the section title to do the connective work, leaving the reader to infer the argumentative move."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Close on positioning: rewrite the closing sentence so it names what the section established AND points at what remains open.  \"Frameworks for collective stewardship therefore direct attention away from individual motivation and toward whether the institutional conditions are in place.\"\n      (2) Open on connection: add a connective sentence at the start of the next section that names the move being made.  \"A complementary perspective comes from implementation science, which distinguishes adoption from implementation from sustainability.\"\n      (3) Audit at every break: read the last sentence of section N immediately followed by the first sentence of section N+1, with nothing else.  If the move from one to the other is not legible from those two sentences, the bridge is missing."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: the last sentence of each section reads as a positioning move AND the first sentence of the next section names what is now being addressed.  Failing when: either the close reads as a finding without forward orientation, or the open begins cold without acknowledging what the previous section established."}], :conclusion "A section boundary is the place where the reader most needs help: the closing paragraph must name what has been established, and the next opening paragraph must name what is now to be addressed.  When the closing sentence reads as a finding rather than a positioning move, and the next section begins cold, the reader cannot tell whether the closing claim was the section's conclusion or its setup.  The section-to-section connective tissue has been silently elided, and the argument's spine goes invisible at exactly the joints.", :directives {:audience "paper authors, reviewers", :keywords ["section-boundary" "transition" "connective-tissue" "paragraph-break" "finding-vs-positioning"], :references ["writing-coherence/throat-clearing-close," "writing-coherence/meta-lede"], :style "pattern", :title "Bridge the Section Boundary", :tone "technical"}, :id "writing-coherence/section-bridge-missing", :keywords ["section-boundary" "transition" "connective-tissue" "paragraph-break" "finding-vs-positioning"], :projection-version "flexiarg-v0", :references ["writing-coherence/throat-clearing-close," "writing-coherence/meta-lede"], :scores {}, :sigils [], :source-path "library/writing-coherence/section-bridge-missing.flexiarg", :sources [], :status :ok, :title "Bridge the Section Boundary", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a paper undergoes a structural change — a section removed, a step renumbered, a definition revised, a term renamed — every downstream reference to the changed element becomes a candidate for staleness.  The drift is referential, not stylistic: the wording is unchanged, but what the wording points at no longer exists or no longer means what it did.  Local re-reading does not catch it because each section reads correctly in isolation.  The remedy is an audit pass at the moment of restructure that lists each affected element and its referents, then updates each referent to reflect the new structure or flags it for deletion."} {:name "context", :name-key "context", :slug "context", :text "Common during late-stage paper revision when the author is making one structural change at a time and not running a full re-read.  Especially common when a section is moved, a numbered step is dropped, or a worked example is replaced.  Distinct from `cross-section-claim-drift` (about wording variation across sections sharing a claim) and from `paraphrase-drift` (about local sentence-level restatement): here the wording is consistent and the semantics has shifted underneath it.  The diagnostic is \"the sentence is fine, but its referent is gone.\""} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: local section coherence ↔ post-restructure global coherence.\n    Irreducible: a reference either points at something the document still contains, or it does not.  Local rewording does not change which."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a full audit after every micro-edit is expensive and slows iteration; deferring the audit to a final pass risks accumulating drift that becomes hard to untangle.\n    Active dynamic: the temptation to skip the audit grows with the size of the document and the smallness of the edit, even though the failure mode does not depend on edit size — a single removed bullet can leave stale references in three later sections."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Numbered-step drift: \"Step 4\" referenced in a downstream pattern composition after Step 4 has been removed from the bootstrap sequence.\n      - Renamed-term shadow: a term renamed in the methods is still referred to by its old name in the discussion.\n      - Cross-reference to vanished section: \"see §3.2\" remains in the text after §3.2 has been merged into §3.1.\n      - Deleted-figure reference: \"as Figure 4 shows\" persists after Figure 4 was cut.\n      - Worked-example drift: a worked example revised in §3 is still cited in §5 with the old numbers."} {:name "THEN", :name-key "then", :slug "then", :text "Audit at the moment of restructure; update or delete every downstream reference; verify by grep."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Audit at the moment of restructure: when removing or renaming an element, immediately grep the document for every reference to the element and decide for each whether to update, delete, or flag.  This is cheaper than deferring.\n      (2) Maintain a restructure log: keep a running list of structural changes during a revision pass; before declaring the pass complete, audit every reference against the log.\n      (3) Use unique tokens for high-risk elements: when a structural element is likely to be referenced (numbered steps, named patterns, figure numbers), keep the token as distinctive as possible so an audit grep is reliable.\n      (4) Audit by elision-test: re-read each section that references an element after the element has been changed; the section should still hold without the reference.  If removing the reference breaks the section, the reference is load-bearing and must be updated, not merely removed."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when no downstream reference points at an element that has been removed, renamed, or moved without being updated.  Failing when grepping for a removed element returns hits in sections other than the one where the removal happened."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Validate the system-level analogue when a documented use-case becomes available.  The principle plausibly extends from documents to systems: when a system is restructured (a service decommissioned, an interface renamed, a role redistributed), every downstream dependency becomes a candidate for staleness, and the same audit discipline applies.  Confirming the analogue requires concrete cases of system restructure and dependency-staleness; without those, the analogue is conjectural and should not be promoted to `system-coherence` on speculation (per `system-coherence/argue-empirically-not-persuasively`: a pattern must follow from a use-case, not be speculated forward).\n    - If the system-level analogue is later validated, draft `system-coherence/audit-downstream-dependencies-after-restructure` with concrete failure-modes drawn from the validating cases."}], :conclusion "When a paper undergoes a structural change — a section removed, a step renumbered, a definition revised, a term renamed — every downstream reference to the changed element becomes a candidate for staleness.  The drift is referential, not stylistic: the wording is unchanged, but what the wording points at no longer exists or no longer means what it did.  Local re-reading does not catch it because each section reads correctly in isolation.  The remedy is an audit pass at the moment of restructure that lists each affected element and its referents, then updates each referent to reflect the new structure or flags it for deletion.", :directives {:audience "paper authors, reviewers, anyone editing a multi-section document iteratively", :keywords ["restructure" "stale-reference" "dangling-reference" "cross-reference" "post-edit-audit" "referential-drift"], :references ["writing-coherence/cross-section-claim-drift," "writing-coherence/paraphrase-drift"], :style "pattern", :title "Audit the Downstream After Restructure", :tone "technical"}, :id "writing-coherence/stale-reference-after-restructure", :keywords ["restructure" "stale-reference" "dangling-reference" "cross-reference" "post-edit-audit" "referential-drift"], :projection-version "flexiarg-v0", :references ["writing-coherence/cross-section-claim-drift," "writing-coherence/paraphrase-drift"], :scores {}, :sigils [], :source-path "library/writing-coherence/stale-reference-after-restructure.flexiarg", :sources [], :status :ok, :title "Audit the Downstream After Restructure", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Headings, sub-headings, and run-in bold labels carry the document's hierarchy.  When their format drifts within the document — level-3 hashes in one section, run-in bold in another, sentence case here, title case there, terminating period sometimes and not others — the reader scanning the table of contents or skim-reading cannot infer which subheadings carry equal weight.  The hierarchy that the writer has in mind is not the hierarchy the reader can see.  Distinct from `subheading-without-paragraph` (about whether the body discharges the subheading's promise): here the body is fine but the *form* of the subheading drifts."} {:name "context", :name-key "context", :slug "context", :text "Documents written in passes, or assembled from multiple authors' contributions, accumulate heading-style inconsistency the way they accumulate citation-style inconsistency — locally invisible, globally distracting.  Run-in bold for some level-3s and hashes for others; sentence case here and title case there; sometimes \"Methods.\", sometimes \"Methods\", sometimes \"Methods:\".  Reviewers read the inconsistency as a sign that the document has not been edited as a whole."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: local readability of each section ↔ document-level legibility of the hierarchy.\n    Irreducible: a heading at logical depth N either follows the same format as other headings at depth N, or it doesn't.  The reader has no other channel for inferring depth."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: the convention chosen at each logical depth is a small thing.  Choosing inconsistently is also a small thing per-occurrence.  Across a 30-page document, the cumulative effect is that no reader can use the heading hierarchy as a navigation aid.\n    Active dynamic: the pull recurs whenever the document grows, and especially when content is moved between sections without re-styling its headings."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Mixed levels: some level-3s use hashes, others use run-in bold; the table of contents gives the reader a misleading skeleton.\n      - Capitalisation drift: title case (\"Logic Model Composition\") and sentence case (\"Logic model composition\") both appear at the same depth.\n      - Punctuation drift: some headings end with a period, some with a colon, some with neither.\n      - Inherited formatting: a section copied from another document carries that document's heading style and was never normalised."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Choose one convention per depth: at each logical depth, pick a single format (hash level, capitalisation, terminating punctuation, bold/italic) and apply it everywhere at that depth.\n      (2) Audit top-to-bottom: in one pass, read the document looking only at headings — ignore body text — and normalise to the chosen conventions.\n      (3) Demote run-in bold to bold paragraph leads only where they are doing genuinely different work from a subheading: a run-in bold \"Logic model composition.\" that introduces a multi-paragraph subsection should be promoted to a subheading; a run-in bold that introduces a single-sentence note should be left as run-in bold.\n      (4) Decide the punctuation rule once: terminating period or no, colon or no, sentence or title case — and apply it."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: a reader scrolling the document or scanning the table of contents can correctly infer logical depth from formatting alone.  Failing when: two headings at the same logical depth are formatted differently, or two headings at different logical depths look the same."}], :conclusion "Headings, sub-headings, and run-in bold labels carry the document's hierarchy.  When their format drifts within the document — level-3 hashes in one section, run-in bold in another, sentence case here, title case there, terminating period sometimes and not others — the reader scanning the table of contents or skim-reading cannot infer which subheadings carry equal weight.  The hierarchy that the writer has in mind is not the hierarchy the reader can see.  Distinct from `subheading-without-paragraph` (about whether the body discharges the subheading's promise): here the body is fine but the *form* of the subheading drifts.", :directives {:audience "paper authors, reviewers", :keywords ["heading-style" "structural-style" "hierarchy" "formatting-drift" "run-in-bold" "capitalisation"], :references ["writing-coherence/subheading-without-paragraph"], :style "pattern", :title "Normalise Heading Conventions Across Logical Depths", :tone "technical"}, :id "writing-coherence/structural-style-inconsistency", :keywords ["heading-style" "structural-style" "hierarchy" "formatting-drift" "run-in-bold" "capitalisation"], :projection-version "flexiarg-v0", :references ["writing-coherence/subheading-without-paragraph"], :scores {}, :sigils [], :source-path "library/writing-coherence/structural-style-inconsistency.flexiarg", :sources [], :status :ok, :title "Normalise Heading Conventions Across Logical Depths", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A subheading is a promise that the following paragraph will make a specific claim.  When the paragraph names the concept but does not discharge the promise — two or three sentences that gesture at the label without stating what the label actually asserts — the subheading is a label looking for a paragraph, and the document's structural skeleton goes soft at that point."} {:name "context", :name-key "context", :slug "context", :text "AI drafts frequently produce subheadings that sound structural (\"Ontogenetic accretion\", \"Architectural sustainability\", \"The recursive scaffold\") but whose paragraphs merely restate the concept's existence.  The subheading commits to more than the text pays."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: structural promise ↔ content capacity.\n    Irreducible: a subheading cannot both promise a claim and merely name a concept."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a strong subheading carves the argument into inspectable units; an under-discharged subheading creates the appearance of structure without the argumentative weight.  Readers track subheadings as a proxy for what the paper claims.\n    Active dynamic: the pull recurs whenever a writer has a strong concept name but hasn't yet written the paragraph that earns it."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Concept-drop: the subheading names a concept; the paragraph says the concept is important.\n      - Two-sentence stub: a paragraph of two sentences under a subheading, neither of which states a claim.\n      - Restatement: the paragraph restates the subheading in a full sentence and stops."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Expand: discharge the promise.  Write the paragraph that makes the claim the subheading asserted.  If the concept is \"ontogenetic accretion\", walk the reader through what accretes, at which stage, from which prior deposit.\n      (2) Fold: drop the subheading and merge the existing content into an adjacent section as a closing remark or bridge sentence.  Concept survives; structural promise retracts.\n      (3) Rename: replace the ambitious subheading with one that matches the claim actually present.  If the paragraph says \"each stage depends on prior stages\", the subheading should say that, not \"ontogenetic accretion\"."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: reader can state the subheading's claim in one sentence, independent of the subheading, drawn from the paragraph body.  Failing when: the only sentence that makes the claim is the subheading itself."}], :conclusion "A subheading is a promise that the following paragraph will make a specific claim.  When the paragraph names the concept but does not discharge the promise — two or three sentences that gesture at the label without stating what the label actually asserts — the subheading is a label looking for a paragraph, and the document's structural skeleton goes soft at that point.", :directives {:audience "paper authors, reviewers", :keywords ["subheading" "structure" "promise" "discharge" "label" "concept-drop"], :references ["writing-coherence/unearned-essentially"], :style "pattern", :title "Discharge the Subheading's Claim", :tone "technical"}, :id "writing-coherence/subheading-without-paragraph", :keywords ["subheading" "structure" "promise" "discharge" "label" "concept-drop"], :projection-version "flexiarg-v0", :references ["writing-coherence/unearned-essentially"], :scores {}, :sigils [], :source-path "library/writing-coherence/subheading-without-paragraph.flexiarg", :sources [], :status :ok, :title "Discharge the Subheading's Claim", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "A paragraph — especially an executive-summary or section-closing paragraph — earns its ending by leaving the reader with a claim.  When the last sentence instead expresses an aim, hope, or authorial posture toward the work, it tells the reader what the writer feels rather than what they argue, and the paragraph loses its structural payload."} {:name "context", :name-key "context", :slug "context", :text "AI-assisted prose tends to close warm: \"the overall aim is to help X inhabit this space\", \"we hope this will serve as a starting point\", \"this paper aims to contribute to...\".  These closers function as rhetorical exhale after the real argument.  They are not wrong — they are under-committed."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: warmth / attitude ↔ claim / proposition.\n    Irreducible: a single sentence cannot be simultaneously maximally warm and maximally propositional; the two pull in opposite directions."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: warmth signals intellectual humility and softens the ask; a claim commits, which is riskier and harder to retract.  Both have costs.\n    Active dynamic: the pull recurs at every paragraph close — warmth wants the last word because it is easier to write."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Aim-as-close: \"the aim is to help X inhabit / learn / grow / develop\".\n      - Hope-as-close: \"we hope this contributes to / opens a conversation about\".\n      - Meta-as-close: \"this paper attempts to set out a framework for...\".\n      - Self-congratulation: \"this approach represents a promising direction\"."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Commit: replace the softener with the strongest claim the paragraph supports.  \"This paper argues X\" lands harder than \"this paper aims to help with X\".\n      (2) Relocate warmth: move the attitudinal sentence upstream (into the paragraph's opening or the section intro) so it frames rather than closes, and end on the claim.\n      (3) Cut: delete the softener entirely.  Readers rarely miss it; they were already weighing the claim."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: the last sentence of the paragraph states a proposition a careful reader could disagree with.  Failing when: the last sentence expresses an aim, a hope, a promise of help, or a meta-reflection about what the paper is doing."}], :conclusion "A paragraph — especially an executive-summary or section-closing paragraph — earns its ending by leaving the reader with a claim.  When the last sentence instead expresses an aim, hope, or authorial posture toward the work, it tells the reader what the writer feels rather than what they argue, and the paragraph loses its structural payload.", :directives {:audience "paper authors, reviewers", :keywords ["closing" "paragraph" "claim" "attitude" "softener" "exec-summary" "throat-clearing"], :references ["writing-coherence/hedged-lift" "writing-coherence/scope-mush"], :style "pattern", :title "End on the Claim, Not the Attitude", :tone "technical"}, :id "writing-coherence/throat-clearing-close", :keywords ["closing" "paragraph" "claim" "attitude" "softener" "exec-summary" "throat-clearing"], :projection-version "flexiarg-v0", :references ["writing-coherence/hedged-lift" "writing-coherence/scope-mush"], :scores {}, :sigils [], :source-path "library/writing-coherence/throat-clearing-close.flexiarg", :sources [], :status :ok, :title "End on the Claim, Not the Attitude", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Three parallel items where two would do — because three sounds structural — leaves the third item carrying no weight the first two do not.  The triad inflates the appearance of a considered enumeration.  The third term earns its place only when it carries a distinct claim the reader could lose by dropping it."} {:name "context", :name-key "context", :slug "context", :text "The rule of three has genuine force: it signals completeness, rhythm, balance.  It also has genuine cost: a triad invites the writer to round out a pair with a filler term that is a hyponym, synonym, or restatement.  AI prose does this often — \"conceptually, structurally, and operationally\" — where the three adverbs overlap substantially in meaning."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: parallelism as polish ↔ argumentative weight.\n    Irreducible: a list cannot simultaneously optimise rhythm and carry distinct weight per item; one must give."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: symmetric lists feel complete and read well.  Asymmetric lists feel unfinished even when they are accurate.\n    Active dynamic: the pull recurs whenever a pair would read as incomplete."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Adverb stack: \"conceptually, structurally, and operationally\" where the three overlap.\n      - Synonym triad: \"robust, durable, and resilient\" — three words for one property.\n      - Instance promoted to parallel: \"physics, chemistry, and the hard sciences generally\" — category error disguised as triad.\n      - Rhetorical rhythm: the triad appears because two-item lists felt incomplete, not because the third term earned its place."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Drop the third: if the third item does not carry distinct weight, cut it.  Pairs are not weaker than triads; they are more honest.\n      (2) Replace the third with a specific instance: convert the third abstract term into a concrete example that exemplifies both of the first two.  The triad now carries different work per slot.\n      (3) Keep all three and declare what each does: if the triad is load-bearing, make the per-slot distinction visible in the surrounding sentences, so the reader can see why three and not two."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: removing the third item changes what the reader would conclude.  Failing when: the third item is a hyponym of, synonym for, or restatement of the first or second."}], :conclusion "Three parallel items where two would do — because three sounds structural — leaves the third item carrying no weight the first two do not.  The triad inflates the appearance of a considered enumeration.  The third term earns its place only when it carries a distinct claim the reader could lose by dropping it.", :directives {:audience "paper authors, reviewers", :keywords ["triad" "rule-of-three" "parallelism" "list" "padding"], :references ["writing-coherence/balanced-pair-padding" "writing-coherence/scope-mush"], :style "pattern", :title "Make the Third Item Earn Its Place", :tone "technical"}, :id "writing-coherence/triad-inflation", :keywords ["triad" "rule-of-three" "parallelism" "list" "padding"], :projection-version "flexiarg-v0", :references ["writing-coherence/balanced-pair-padding" "writing-coherence/scope-mush"], :scores {}, :sigils [], :source-path "library/writing-coherence/triad-inflation.flexiarg", :sources [], :status :ok, :title "Make the Third Item Earn Its Place", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Words like \"essentially\", \"fundamentally\", \"simply\", \"basically\", \"just\" ask the reader to accept that the current sentence is the collapsed form of a deeper argument.  They do rhetorical work the paper has not done.  Either the actual structural reason belongs in the sentence — at which point the adverb is redundant — or no collapse has been earned — at which point the adverb lies."} {:name "context", :name-key "context", :slug "context", :text "These adverbs are one of the clearest AI-prose signatures.  They compress without doing the work of compression.  Used well, \"essentially\" signals that a careful argument has been made earlier and is now being invoked; used badly, it signals that the writer wishes the argument had been made."} {:name "IF", :name-key "if", :slug "if", :text "    The pattern operates on the axis: rhetorical force ↔ argumentative warrant.\n    Irreducible: the same adverb cannot simultaneously earn its collapse (reader has the derivation) and substitute for the derivation (reader does not)."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Real costs: a genuine \"essentially\" is efficient — it lets a reader skip the full derivation when they already have it.  A counterfeit \"essentially\" extracts the efficiency without paying for it.\n    Active dynamic: the pull recurs whenever a claim needs to sound harder-earned than the paper has actually earned."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Essentially as warrant: \"the relationship is essentially X\" where X is the actual structural claim being made for the first time.\n      - Simply as softener: \"the argument is simply that...\" where the argument is, in fact, not simple.\n      - Fundamentally as gravitas: \"fundamentally, this is about...\" where the adverb adds weight but no information.\n      - Just as scope control: \"we just need to show that...\" where the claim being shown is actually substantial."} {:name "THEN", :name-key "then", :slug "then", :text "Operate an explicit move on the named axis (see substructure below); steward the pattern against the declared discipline."} {:name "COMPOSITIONS", :name-key "compositions", :slug "compositions", :text "      (1) Replace with the structural reason: if the adverb is load-bearing, state the reason it compresses.  \"Essentially multiplicative\" becomes \"multiplicative because D and A combine as a product, so either dimension alone can bound the whole\" — and the adverb is redundant.\n      (2) Cut the adverb: if the reader already has the derivation from earlier in the paper, the collapse is earned and the adverb is decorative.  Remove it.\n      (3) Earn the collapse: if the adverb is load-bearing and the derivation has not appeared, write the derivation (possibly in a prior paragraph or footnote) before invoking the collapse."} {:name "CHECK", :name-key "check", :slug "check", :text "      Engaged when: every instance of \"essentially / fundamentally / simply / basically / just\" in the draft either has a prior derivation the reader can point to, or is explicitly replaced by the structural reason, or is cut.  Failing when: the adverb is the strongest warrant the claim has."}], :conclusion "Words like \"essentially\", \"fundamentally\", \"simply\", \"basically\", \"just\" ask the reader to accept that the current sentence is the collapsed form of a deeper argument.  They do rhetorical work the paper has not done.  Either the actual structural reason belongs in the sentence — at which point the adverb is redundant — or no collapse has been earned — at which point the adverb lies.", :directives {:audience "paper authors, reviewers", :keywords ["essentially" "fundamentally" "simply" "basically" "rhetorical-work" "load-bearing"], :references ["writing-coherence/subheading-without-paragraph" "writing-coherence/hedged-lift"], :style "pattern", :title "Replace the Rhetorical Collapse With the Structural Reason", :tone "technical"}, :id "writing-coherence/unearned-essentially", :keywords ["essentially" "fundamentally" "simply" "basically" "rhetorical-work" "load-bearing"], :projection-version "flexiarg-v0", :references ["writing-coherence/subheading-without-paragraph" "writing-coherence/hedged-lift"], :scores {}, :sigils [], :source-path "library/writing-coherence/unearned-essentially.flexiarg", :sources [], :status :ok, :title "Replace the Rhetorical Collapse With the Structural Reason", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Capture live performances as artifacts so divergent aspirations can align."} {:name "context", :name-key "context", :slug "context", :text "A collaborative music project contains divergent but compatible aspirations about presence and durable artifacts."} {:name "IF", :name-key "if", :slug "if", :text "    A collaborator seeks to play gigs as a primary mode of engagement."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Another collaborator is motivated by the creation of recorded albums rather than by live performance as an end in itself."} {:name "THEN", :name-key "then", :slug "then", :text "    The artifact-oriented collaborator can support live performances by equipping themselves to capture those performances as live recordings."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    This reframes gigs as opportunities for artifact production, allowing both aspirations to be met without forcing alignment on performance-first or studio-first priorities."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Attend to whether the capture setup remains proportionate to the artifact goal.\n    - Watch for pressures that attempt to reclassify it as general-purpose live-sound infrastructure."}], :conclusion "Capture live performances as artifacts so divergent aspirations can align.", :directives {:audience "collaborative practice", :sigils ["🐺/内"], :style "pattern", :title "Live Recording Bridge", :tone "practical"}, :id "xed-roads/live-recording-bridge", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🐺/内"], :source-path "library/xed-roads/live-recording-bridge.flexiarg", :sources [], :status :ok, :title "Live Recording Bridge", :typed-slots nil}]
