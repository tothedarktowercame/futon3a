auses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Single-line messages transmit reliably; multi-line fragments do not."} {:name "context", :name-key "context", :slug "context", :text "IRC relays can split or interleave long multi-line messages."} {:name "IF", :name-key "if", :slug "if", :text "    Messages contain newlines or multiple blocks that fragment on relay."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Some content needs detail beyond a short line."} {:name "THEN", :name-key "then", :slug "then", :text "    Send a single-line primary message with a short summary and attach details via files or structured events."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    A single-line payload preserves ordering and reduces lost context."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - evidence: message-length capped (~350 words) with no newlines.\n    - evidence-shape: {:summary :string, :detail-ref :string}"}], :conclusion "Single-line messages transmit reliably; multi-line fragments do not.", :directives {:audience "fulab agents, musn server", :sigils ["🚞/文"], :style "pattern", :title "Keep Realtime Messages Single-Line", :tone "technical"}, :id "realtime/single-line-transport", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚞/文"], :source-path "library/realtime/single-line-transport.flexiarg", :sources [], :status :ok, :title "Keep Realtime Messages Single-Line", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Structured PSR/PUR events parse reliably; free-text does not."} {:name "context", :name-key "context", :slug "context", :text "Realtime matchers depend on consistent schemas and keys."} {:name "IF", :name-key "if", :slug "if", :text "    PSR/PUR are emitted as free-text or inconsistent key names."} {:name "HOWEVER", :name-key "however", :slug "however", :text