/sidecar-usage.md; docs/sidecar-demo.md"}], :conclusion "Allow sense shifts only when explicitly typed or bridged.", :directives {:audience "musn architects, chain builder", :keywords ["sense" "shift" "broaden" "narrow" "drift" "gate" "semantic" "domain" "bridge" "control"], :style "pattern", :title "Sense-Shift Gate", :tone "technical"}, :id "sidecar/sense-shift-gate", :keywords ["sense" "shift" "broaden" "narrow" "drift" "gate" "semantic" "domain" "bridge" "control"], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/sidecar/sense-shift-gate.flexiarg", :sources [], :status :ok, :title "Sense-Shift Gate", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Separate facts, memes, and notions into distinct stores."} {:name "context", :name-key "context", :slug "context", :text "You need semantic gain without allowing fuzzy output to become authoritative."} {:name "IF", :name-key "if", :slug "if", :text "    Similarity search and curated semantics share one store or one truth level."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    You still need fast candidate proposals and inspectable semantics."} {:name "THEN", :name-key "then", :slug "then", :text "    Use XTDB for facts, SQLite for inspectable memes, and ANN/HNSW for notions, and enforce boundaries."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Each store has a different trust level; separation keeps fuzz from becoming fact."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "docs/sidecar-query-flow.md; docs/sidecar-promotion-flow.md"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Define the three adapters and enforce that ANN results only create proposals.\n    - Add checks that facts are written only through explicit promotion.\n    - Document store responsibilities and invariants."} {:name "use", :name-key "use", :slug "use", :text "docs/sidecar-query-flow.md; docs/sidecar-promotion-flow.md"} {:name "use", :name-key "use", :slug "use", :text "docs/sidecar-usage.md; docs/sidecar-demo.md"}], :conclusion "Separate facts, memes, and notions into distinct stores.", :directives {:audience "musn architects, data layer", :keywords ["facts" "memes" "notions" "XTDB" "SQLite" "ANN" "HNSW" "trust" "boundary" "separation" "store" "layer"], :style "pattern", :title "Tri-Store Semantic Separation", :tone "technical"}, :id "sidecar/tri-store-separation", :keywords ["facts" "memes" "notions" "XTDB" "SQLite" "ANN" "HNSW" "trust" "boundary" "separation" "store" "layer"], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/sidecar/tri-store-separation.flexiarg", :sources [], :status :ok, :title "Tri-Store Semantic Separation", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Represent semantic transforms as typed arrows with status and confidence."} {:name "context", :name-key "context", :slug "context", :text "Chain recovery depends on explicit, interpretable links."} {:name "IF", :name-key "if", :slug "if", :text "    Chain steps are untyped or implied only by similarity."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    You need translation, abstraction, and metonymy moves."} {:name "THEN", :name-key "then", :slug "then", :text "    Store arrows with mode, payload, scope, confidence, and status."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Typed arrows make transforms inspectable and scoreable in chains."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "docs/sidecar-grounding-and-chains.md"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Define the arrows table and a required mode vocabulary.\n    - Require status transitions (draft, active, retired).\n    - Add validation for scope tags and confidence ranges."}], :conclusion "Represent semantic transforms as typed arrows with status and confidence.", :directives {:audience "musn architects, chain builder", :keywords ["arrow" "transform" "type" "mode" "translate" "abstract" "metonymy" "link" "relation" "semantic"], :style "pattern", :title "Typed Kolmogorov Arrows", :tone "technical"}, :id "sidecar/typed-kolmogorov-arrows", :keywords ["arrow" "transform" "type" "mode" "translate" "abstract" "metonymy" "link" "relation" "semantic"], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/sidecar/typed-kolmogorov-arrows.flexiarg", :sources [], :status :ok, :title "Typed Kolmogorov Arrows", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Enforce invariants at write-time with explicit validation gates."} {:name "context", :name-key "context", :slug "context", :text "The sidecar flow relies on strict store boundaries and explicit promotion."} {:name "IF", :name-key "if", :slug "if", :text "    Writes bypass invariants or validation is optional."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    You need flexible ingestion and fast iteration."} {:name "THEN", :name-key "then", :slug "then", :text "    Define a validation gate that checks required fields, enum constraints, and store boundaries before any write."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Centralized enforcement prevents silent drift and keeps logs auditable."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "docs/sidecar-promotion-flow.md; docs/sidecar-promotions.md"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "docs/sidecar-query-flow.md; docs/sidecar-audit-flow.md"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "resources/sidecar/schema.sql"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "src/sidecar/validation.clj; src/sidecar/store.clj; test/sidecar/store_test.clj"} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "src/sidecar/validation.clj; test/sidecar/store_test.clj"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    - Define validators for proposals, promotions, and bridge triples keyed to schema fields (status enums, required ids, score bounds).\n    - Reject any attempt to write facts or bridge triples outside the promotion pathway.\n    - Enforce append-only writes for proposals and promotions (no updates or deletes)."} {:name "use", :name-key "use", :slug "use", :text "docs/sidecar-usage.md; docs/sidecar-demo.md"}], :conclusion "Enforce invariants at write-time with explicit validation gates.", :directives {:audience "musn architects, data layer", :keywords ["validate" "enforce" "gate" "invariant" "constraint" "check" "reject" "boundary" "rule" "guard"], :style "pattern", :title "Validation and Enforcement Gate", :tone "technical"}, :id "sidecar/validation-enforcement-gate", :keywords ["validate" "enforce" "gate" "invariant" "constraint" "check" "reject" "boundary" "rule" "guard"], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils [], :source-path "library/sidecar/validation-enforcement-gate.flexiarg", :sources [], :status :ok, :title "Validation and Enforcement Gate", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  This is a flexiformal argument for the futon3c social coordination\n  layer — the third AIF loop in the futon stack, operating at the\n  social/real-time timescale. It builds on the completed coordination\n  argument (coordination/ARGUMENT.flexiarg), which established the\n  task-timescale gate pipeline (futon3b) and the glacial-timescale\n  library evolution loop (L1). This argument establishes what the\n  social loop requires, why previous attempts failed, and what a\n  futonic implementation must look like.\n\n  The coordination argument was verified by implementation: futon3b\n  has 31 tests, 109 assertions, and an 8/8 machine-checked wiring\n  diagram. This argument is pre-implementation — it is what must be\n  valid BEFORE futon3c missions can be scoped.\n\n  == PART 0: Context — What Changed Since the Coordination Argument ==\n\n  The coordination argument (coordination/ARGUMENT.flexiarg) established:\n\n  - futon3 is split into three repos (war-room.md WR-1):\n    futon3a (query), futon3b (task+glacial), futon3c (social/realtime)\n  - The gate pipeline (G5→G0) is implemented and test-verified\n  - The glacial loop (L1-observe → L1-canon) is implemented and\n    test-verified, including the round-trip proof\n  - The concrete wiring diagram passes all 8 categorical checks\n\n  The devmap (futon3.devmap, updated 2026-02-09) now reflects this:\n  - P2 (Check DSL) is the gate pipeline, owned by futon3b\n  - P3 (Proof-State Journal) is the proof-path store, owned by futon3b\n  - P7 (Pattern Workbench) is partially implemented as L1 canonicalizer\n  - P8 (Joy Metrics), P10 (Training Ground) are assigned to futon3c\n  - P11 (Self-Description) is assigned to futon5\n\n  WHAT THE DEVMAP DOES NOT ADDRESS (social layer):\n  - No agent lifecycle management with formal invariants\n  - No real-time message routing with delivery guarantees\n  - No session persistence or continuity model\n  - No forum or collaborative proof-tree infrastructure\n  - No peripheral model (detach/reattach, capability envelopes)\n  - No standup or co-presence ceremony\n  - No PAR as first-class session event\n\n  These are precisely the concerns that futon3 attempted to address\n  with Agency, Forum, Drawbridge, and the bridge scripts — and that\n  failed. The question is: why did they fail, and what must be\n  different?\n\n  == PART I: Why the Social Layer Attempts Failed ==\n\n  Three empirical tensions, each grounded in the futon3 git log\n  with specific commit evidence. These are documented as standalone\n  patterns in library/social/.\n\n  S1. [from social/verify-before-compose]\n  Agency and Drawbridge code was written as architectural design\n  documents, not tested incrementally. Five forward-declaration\n  fix commits (f3044aa, adc8d67, 2da227e, 1542b0a, 6010d79) across\n  two subsystems demonstrate that namespaces were composed before\n  individual functions were verified to load. This is a systematic\n  violation of the event-protocol pattern (futon-theory): PROPOSE_CLAIM\n  preceded OBSERVE. The cost was multiplicative debugging at\n  integration time rather than additive debugging at definition time.\n\n  S2. [from social/tension-before-code]\n  Agency went through three generations before its invariants were\n  named. Generation 1-2 built four major features (bells, pages,\n  registry, session tracking) without any A0-A5 proof tests. Phase 1\n  (commit 588a468) wrote the invariant tests and found 18 failures.\n  Phase 2 (commits 5f85287, c5b5929, 3f0aa3a, 804fe8f, 5dcb28b)\n  fixed all five invariants — each commit message is a retroactive\n  confession: \"eliminate catch _ nil\" (A3), \"no silent corruption\"\n  (A2), \"non-nil continuity\" (A2), \"bounded lifecycle\" (A5),\n  \"delivery receipts\" (A0). The tension-observation loop\n  (futon-theory/structural-tension-as-observation) was not running.\n\n  S3. [from social/explicit-exit-over-abandonment]\n  Three subsystems were silently abandoned:\n  - Forum: 8 commits (4846339 through a346d27), ClassCastException\n    on first WebSocket test, last commit is bare \"save\", no mission\n    status update, 9 success criteria in M-agency-forum.md none\n    completed or marked blocked.\n  - PAR bell: designed for parallelism (9d76e88), forced sequential\n    (7fda538), 6 subsequent workaround commits, M-par-session-\n    punctuation.md has 1 of 8 checkboxes completed.\n  - IRC/MUSN bridge: 14+ fix commits (auth, timeouts, multi-room,\n    sanitizer on/off, prompt tightening, rate limiting), no exit\n    criteria, no convergence milestone.\n  Each abandonment violated the mission-lifecycle pattern\n  (futon-theory): no :active → :blocked transition, no recorded\n  blocker, no tension observation.\n\n  S4. [synthesis of S1-S3]\n  The three tensions are not independent. S1 (untested composition)\n  produces S2 (retroactive invariant discovery) because untested code\n  accumulates latent violations. S2 produces S3 (abandonment) because\n  retroactive invariant discovery is demoralizing — each rebuild\n  reveals more violations, and eventually the developer shifts\n  attention to a different subsystem. The cycle is:\n\n    build without tests → discover violations → confess invariants →\n    rebuild → discover more violations → abandon → start new subsystem\n\n  This is the structural cycle identified in the coordination\n  argument (H8), but operating at the social timescale rather than\n  the task timescale. The coordination argument broke this cycle for\n  the task loop by specifying invariants first (the gate patterns)\n  and verifying them categorically (the wiring diagram). The social\n  loop needs the same treatment.\n\n  S5. [from agency pattern library: 8 patterns]\n  The Agency pattern library documents the consequences of S1-S3 in\n  domain-specific terms. Eight patterns name specific failure modes:\n  - delivery-receipt: \"sent\" confused with \"delivered\"\n  - single-routing-authority: three routing tiers with conflicting state\n  - state-atomicity: transitions leave nil state on failure\n  - loud-failure: 20+ instances of (catch Exception _ nil)\n  - bounded-lifecycle: atoms grow unbounded, cleanup races\n  - identifier-separation: transport IDs overload LLM session IDs\n  - self-attribution: server posts on behalf of agents\n  - invariants (A0-A5): formal spec written after two generations\n\n  These patterns are empirically validated — the Phase 2 commits\n  confirm every failure mode. But they are post-mortems, not\n  specifications: they were induced from failures, not derived from\n  futon-theory. They document what went wrong without grounding\n  WHY in a theoretical framework that would predict the failure\n  class in advance.\n\n  S6. [from realtime pattern library: 13 patterns]\n  The realtime pattern library documents the consequences of S1-S3\n  in the bridge/transport domain. Thirteen patterns name failure\n  modes clustered around one theme: presence is not coherence.\n  - authoritative-transcript: multiple transcripts disagree\n  - listener-leases: phantom presence from old listeners\n  - liveness-heartbeats: pings don't distinguish quiet from partitioned\n  - rendezvous-handshake: \"connected\" confused with \"coherent\"\n  - transport-pivot: switching mid-stream creates split-brain\n  - mode-gate: mixing talk with action collapses accountability\n  - single-line-transport: IRC splits multi-line messages\n  - structured-events-only: free-text doesn't parse reliably\n\n  Like the agency patterns, these are post-mortems — induced from\n  the IRC bridge fix-cycle (14+ commits), not derived from\n  futon-theory.\n\n  S7. [from devmap P8, P10: orphaned greenfield prototypes]\n  Joy Metrics (P8) and Training Ground (P10) were assigned to\n  futon3c in the devmap update but have no implementation, no\n  mission documents, and no evidence. They are downstream of the\n  social coordination layer — they cannot be built until the layer\n  they depend on exists. Their greenfield status is a symptom of\n  S3 (abandonment): the infrastructure they need was attempted and\n  abandoned.\n\n  == PART II: What the Agency/Realtime Patterns Require ==\n\n  The agency and realtime patterns, despite being post-mortems, do\n  contain valid requirements. Reformulated as requirements (not\n  patterns), grounded in futon-theory:\n\n  R1. [from agency/delivery-receipt + futon-theory/proof-path]\n  Every message sent between agents must produce a delivery receipt\n  or an explicit failure. \"No error\" is not \"success.\" The proof-path\n  pattern requires auditable chains; unreceipted messages are\n  unverifiable links.\n\n  R2. [from agency/single-routing-authority + futon-theory/single-source-of-truth]\n  For any agent-id, exactly one routing authority exists at a time.\n  Multiple routing tiers with conflicting state are a violation of\n  single-source-of-truth (I1).\n\n  R3. [from agency/state-atomicity + futon-theory/all-or-nothing]\n  State transitions are atomic: they succeed completely or fail\n  loudly with rollback. Partial transitions that leave nil state\n  violate all-or-nothing (I2).\n\n  R4. [from agency/loud-failure + futon-theory/error-hierarchy]\n  Errors surface at the layer that caused them. Silent catch-and-\n  swallow (catch _ nil) is a violation of error-hierarchy (I3).\n\n  R5. [from agency/bounded-lifecycle + futon-theory/agent-contract]\n  All transient resources have deterministic lifecycle bounds.\n  Fire-and-forget cleanup violates agent-contract (agents must\n  respect invariants).\n\n  R6. [from agency/identifier-separation + futon-theory/single-source-of-truth]\n  Transport IDs, continuity IDs, and protocol IDs are typed and\n  distinct. Overloading violates single-source-of-truth because\n  the same identifier means different things at different layers.\n\n  R7. [from realtime/rendezvous-handshake + futon-theory/event-protocol]\n  Connection must be followed by an explicit readiness handshake\n  before coordination can begin. The event-protocol requires\n  OBSERVE before PROPOSE_CLAIM; presence without readiness\n  assessment is unobserved action.\n\n  R8. [from realtime/authoritative-transcript + futon-theory/durability-first]\n  One transcript is authoritative. Multiple conflicting transcripts\n  violate durability-first (I0): what you save is not what you get\n  back if you're reading from the wrong transcript.\n\n  R9. [from realtime/structured-events-only + futon-theory/minimum-viable-events]\n  Events must be structured and machine-parseable. Free-text PSR/PUR\n  that don't parse reliably cannot be minimum viable events because\n  they cannot be reliably processed.\n\n  R10. [from realtime/mode-gate + futon-theory/agent-contract]\n  Coordination talk and action talk must be distinguishable. The\n  agent-contract requires agents to \"observe before act\"; mixing\n  the two modes collapses the observation/action boundary.\n\n  R11. [from social/scope-bounded-handoff + futon-theory/I4]\n  Agent handoffs must declare writable scope. Constraint-timescale\n  artifacts (exotype diagrams, pattern library, mission specs) are\n  read-only from the task timescale. This is I4 (exogeneity) applied\n  to agent coordination: no task-timescale agent can modify a\n  constraint-timescale artifact. Scope violations must be structurally\n  rejected, not conventionally discouraged.\n  Evidence: futon5 feat/compose-parallel review (2026-02-10) — Codex\n  rewrote social-exotype.edn (constraint artifact) to make compose-\n  parallel tests pass, discarding gate duality (C6) and ARGUMENT\n  traceability. Three tensions recorded in proof-path store.\n\n  == PART III: What the Theory Demands ==\n\n  T1. [from futon-theory/four-types + futon-theory/interface-loop]\n  The futon stack operates at three timescales (war-room.md):\n  - Social (seconds): agents coordinate, hand off work, maintain\n    shared awareness\n  - Task (minutes): gate pipeline validates, executes, persists\n  - Glacial (weeks): library evolves through tension observation\n    and canonicalization\n\n  The interface-loop pattern says: at each layer boundary, a Baldwin\n  cycle (EXPLORE → ASSIMILATE → CANALIZE) must operate for cumulative\n  functional gain. futon3b implements this at the task/glacial\n  boundary (L1). The social/task boundary needs the same treatment:\n  a loop that observes coordination outcomes and feeds them into\n  the task pipeline.\n\n  T2. [from futon-theory/structural-tension-as-observation]\n  The social loop's observation vector is coordination failure:\n  dropped messages (R1), routing conflicts (R2), partial state (R3),\n  silent errors (R4), resource leaks (R5), identity confusion (R6).\n  These are the structural irritations, pre-symbolic pressures, and\n  trans-situational reappearances that the glacial loop should\n  eventually canonize — but they must first be observable at the\n  social timescale.\n\n  T3. [from futon-theory/mission-lifecycle + futon-theory/mission-scoping]\n  The social layer must be built as bounded missions with explicit\n  lifecycle transitions. S3 demonstrated that unbounded missions\n  with implicit abandonment create false affordances and archaeology\n  tax. Each futon3c mission must have: single owner, scope in/out,\n  success criteria, exit conditions, and explicit :blocked/:parked\n  transitions.\n\n  T4. [from futon-theory/event-protocol + futon-theory/proof-path]\n  Social-timescale events (agent connection, message exchange,\n  session handoff, peripheral hop) must produce typed records that\n  compose into proof paths. The coordination argument established\n  that proof paths are the minimum unit of auditability. The social\n  loop produces the fastest proof paths — they must be typed from\n  the start, not retroactively.\n\n  T5. [from futon-theory/retroactive-canonicalization]\n  The agency and realtime patterns ARE retroactive canonicalizations\n  — they were induced from failure. But they were not canonicalized\n  through the Baldwin cycle: they were not NAMED from recurring\n  tensions (they were named from post-mortems), not SELECTED by\n  threshold (they were all included regardless of recurrence), and\n  not CANALIZED into constraints (they exist as patterns but\n  constrain nothing). For futon3c, the canonicalization must be\n  genuine: patterns that pass through naming, selection, and\n  canalization via L1.\n\n  == PART IV: The Convergence ==\n\n  C1. [from S4, S5, S6]\n  The agency patterns (8) and realtime patterns (13) describe\n  different symptoms of the same disease: building distributed\n  coordination without the theoretical grounding that makes the\n  invariants predictable. The agency patterns focus on state/routing/\n  lifecycle; the realtime patterns focus on transport/presence/\n  coherence. But the three recurring failure modes are identical\n  across both:\n  - Silent failures (agency/loud-failure ↔ realtime/loop-failure-signals)\n  - Identity collapse (agency/identifier-separation ↔ realtime/listener-leases)\n  - Missing proof (agency/delivery-receipt ↔ realtime/rendezvous-handshake)\n\n  C2. [from R1-R10, T1]\n  The ten requirements (R1-R10) are not a grab-bag. They decompose\n  into three layers that correspond to the three AIF loop boundaries:\n  - Transport layer (R1, R7, R8, R9): delivery, readiness, transcript,\n    structure — the social→social boundary\n  - Routing layer (R2, R5, R6, R10): authority, lifecycle, identity,\n    mode separation — the social→task boundary\n  - State layer (R3, R4): atomicity, error propagation — the\n    task→task boundary (already enforced by futon3b gates)\n  R3 and R4 are already satisfied by the gate pipeline. The social\n  layer's job is R1-R2 and R5-R10: the requirements that operate\n  at the social timescale.\n\n  C3. [from T2, T4, T5]\n  The social loop must produce typed events that feed into the same\n  proof-path store that the task loop writes to. This is how the\n  three timescales compose:\n  - Social loop produces coordination events (connections, messages,\n    handoffs) as typed proof-path entries\n  - Task loop produces execution events (gate traversals) as typed\n    proof-path entries\n  - Glacial loop observes ALL proof-path entries for tensions and\n    canonizes new patterns\n\n  The L1 observer already has the three scan functions\n  (structural-irritation, pre-symbolic-pressure, trans-situational-\n  reappearance). If the social loop emits typed events into the\n  proof-path store, L1 can observe social-timescale tensions without\n  modification. The glacial loop is timescale-agnostic — it observes\n  structural patterns, not timescale-specific ones.\n\n  C4. [from S1-S3, T3]\n  The social layer must be built differently from how futon3 built\n  Agency/Forum/Drawbridge. Specifically:\n  - Verify before compose (S1): each namespace loads and passes\n    smoke tests before integration\n  - Tension before code (S2): invariant proof tests before\n    implementation\n  - Explicit exit (S3): mission lifecycle transitions, not silent\n    abandonment\n\n  These are development-process patterns, not runtime patterns.\n  They constrain HOW futon3c is built, not WHAT it builds. The\n  coordination argument did not need to state this because futon3b\n  was built futonic from the start (the gate patterns existed before\n  the code). futon3c must learn from the futon3 experience.\n\n  C5. [from C1, C2, C3, C4]\n  The social loop is not a separate system. It is the third\n  timescale of the same AIF diagram. The coordination argument\n  established two loops (task + glacial) sharing one boundary (the\n  gate pipeline). The social loop adds the fastest timescale:\n\n    social (seconds) → task (minutes) → glacial (weeks)\n        ↑                                     |\n        └─────── library constrains ──────────┘\n\n  Agents coordinate in real-time (social), submit work through\n  gates (task), accumulate evidence that evolves the library\n  (glacial), and the evolved library constrains future coordination\n  (social). This is the full AIF cycle across three timescales.\n  I3 (timescale ordering) governs all three boundaries.\n\n  C6. [from coordination/INDEX.md duality table, C2, C5]\n  The coordination patterns already have a dual interpretation\n  (coordination/INDEX.md §Dual Interpretation). Each gate reads\n  two ways: an agency problem and a pattern problem. The table:\n\n  | Gate | Agency Reading | Pattern Reading |\n  | G5 task-shape | Is the agent's task well-defined? | Is the task shaped so a pattern can guide it? |\n  | G4 capability | Can this agent do this work? | Does this pattern apply to this domain? |\n  | G4 assignment | Is one agent responsible? | Is one pattern selected? |\n  | G3 mandatory-psr | Has the agent committed to an approach? | Has a pattern been engaged with? |\n  | G2 bounded-execution | Agent stays within budget | Pattern application stays within scope |\n  | G1 mandatory-pur | Agent's work gets evaluated | Pattern's guidance gets evaluated |\n  | G0 durability | Agent's session is recoverable | Pattern use evidence is persistent |\n  | G0 par-obligation | Agent reflects on what happened | Pattern library learns from use |\n\n  The left column (agency reading) IS the social loop's concern.\n  The right column (pattern reading) IS the task/glacial loop's\n  concern. The gate pipeline is not just where social events feed\n  into task events — it is where the two readings converge into\n  one typed record. This means the social loop's requirements\n  (R1-R10) map onto specific gates:\n\n  - R1 (delivery receipts) → agency reading of G0 (durability)\n  - R2 (single routing authority) → agency reading of G4 (assignment)\n  - R7 (rendezvous handshake) → agency reading of G5 (task shape)\n  - R9 (structured events) → agency reading of G0 (durability)\n  - R10 (mode gate) → agency reading of G3 (mandatory-psr)\n\n  The social loop is not a layer below the gate pipeline that feeds\n  into it. It is the agency SIDE of the gate pipeline — the half\n  that was specified in the duality table but never implemented.\n  \"Futon3 replaces 'ants' with 'agents' and 'pheromone' with\n  'patterns' — coordination is the relationship between agents and\n  patterns, and the gates sit at the intersection.\"\n\n  == THESIS ==\n\n  Th. [from C1-C6]\n\n  futon3 attempted to build real-time agent coordination (Agency,\n  Forum, Drawbridge, bridges) without the theoretical grounding\n  that makes distributed invariants predictable. The result was\n  three generations of build-confess-rebuild for Agency, silent\n  abandonment of Forum, and a perpetual fix-cycle for bridges.\n  Twenty-one patterns (8 agency + 13 realtime) document the\n  symptoms; three social patterns (verify-before-compose,\n  tension-before-code, explicit-exit-over-abandonment) diagnose\n  the cause: the development process itself violated the same\n  invariants the system was trying to enforce.\n\n  futon3c must break this cycle by:\n\n  1. Deriving its invariants from futon-theory BEFORE writing code,\n     not inducing them from failures afterward (T5, S2)\n  2. Emitting typed events into the shared proof-path store so the\n     existing glacial loop can observe social-timescale tensions (C3)\n  3. Building as bounded missions with explicit lifecycle transitions,\n     verified incrementally (T3, C4)\n  4. Treating the agency and realtime patterns as evidence of\n     tensions, not as the architectural specification (C1)\n\n  Moreover, the social loop is not a layer beneath the gate pipeline\n  that feeds into it from below. The coordination duality table (C6)\n  reveals that each gate already has an agency reading and a pattern\n  reading. The pattern reading is implemented (futon3b). The agency\n  reading is specified but unimplemented — it IS the social loop.\n  futon3c completes the duality: agents and patterns, the two sides\n  of every gate, both implemented and both producing typed evidence.\n\n  The social loop is the fastest timescale in a three-level AIF\n  diagram. Its outputs feed the task loop (gate pipeline), whose\n  outputs feed the glacial loop (library evolution), whose outputs\n  constrain the social loop. The architecture is not three separate\n  systems — it is one system operating at three timescales, sharing\n  one typed evidence store and one categorical verification framework.\n\n  == WHAT FUTON3C MUST BUILD ==\n\n  FROM FUTON3 (failed attempts, as evidence):\n  - Agency A0-A5 invariants → validated in Phase 2, need porting\n    to a clean implementation with tests-first discipline\n  - Forum proof-tree concept → valid idea, failed execution;\n    needs mission-scoped retry with explicit exit conditions\n  - Drawbridge multi-agent routing → OOM-motivated redesign;\n    registration-based, not subprocess-based\n  - Peripheral model → concept drifted through 3 definitions;\n    needs grounding in futon-theory/agent-contract\n  - PAR session punctuation → elegant design, zero implementation;\n    needs bounded first milestone\n\n  FROM FUTON3B (proven infrastructure, as foundation):\n  - Gate pipeline (G5→G0) → social loop submits work through gates\n  - Proof-path store → social events written as typed records\n  - L1 observer → detects social-timescale tensions automatically\n  - L1 canonicalizer → promotes recurring social tensions to patterns\n  - Malli evidence shapes → social events must validate against shapes\n  - ct/mission.clj → social-loop wiring diagram must pass 8 checks\n\n  FROM FUTON-THEORY (constraints):\n  - event-protocol: social events follow OBSERVE → VERIFY sequence\n  - proof-path: social coordination produces auditable chains\n  - agent-contract: agents clock in, observe, attribute, respect\n    invariants\n  - interface-loop: Baldwin cycle at social→task boundary\n  - mission-lifecycle: bounded missions with explicit transitions\n\n  == VERIFICATION (PENDING) ==\n\n  V1. [required: social-exotype diagram]\n  A social-exotype.edn must be written and validated against\n  ct/mission.clj, analogous to coordination-exotype.edn. It must\n  encode the social-timescale components (Agency, Forum, peripherals)\n  and their edges, and pass all 8 checks including I3 (timescale\n  ordering: social→social and social→task edges only) and I4\n  (exogeneity: no social output reaches glacial constraints directly).\n\n  V2. [required: concrete diagram update]\n  futon3-coordination.edn must be extended with social-timescale\n  components and edges, and the combined diagram must still pass\n  all 8 checks. The existing Level 0 and Level 1 edges must remain\n  valid.\n\n  V3. [required: round-trip proof]\n  Analogous to futon3b's full-loop-round-trip test: a social\n  coordination event → typed proof-path entry → L1 observes tension →\n  L1 canonizes pattern → pattern constrains future social\n  coordination. This proves the three-timescale AIF cycle closes.\n\n  == STATUS ==\n\n  This argument is at the VERIFY step of the derivation xenotype.\n\n  COMPLETE:\n  - IDENTIFY: futon3 git archaeology (social-layer failures)\n  - MAP: Four social patterns (verify-before-compose, tension-before-code,\n    explicit-exit-over-abandonment, scope-bounded-handoff)\n  - DERIVE: Eleven requirements (R1-R11) from agency/realtime patterns via\n    futon-theory. R11 added 2026-02-10 from live coordination evidence\n    (Codex compose-parallel review).\n  - ARGUE: This document (S1-S7, R1-R11, T1-T5, C1-C6, thesis)\n\n  COMPLETE (continued):\n  - VERIFY: M-social-exotype (futon3c/holes/missions/M-social-exotype.md)\n    - V1: social-exotype.edn — standalone diagram validation [DONE, 8/8]\n    - V2: three-diagram composition — compose-parallel merged to futon5 main\n      (d5ae681). social-exotype.edn restored with :social timescale. Composed\n      diagram: 5 inputs, 7 outputs, 16 components, 69 edges, 8/8 checks.\n    - V3: round-trip proof deferred to INSTANTIATE (by design)\n  - Part III (Prototype 0) — bootstrap closure [DONE]\n    - 6 proof-paths in futon3b/data/proof-paths/ including 3 coordination\n      tensions from Codex review\n\n  ACTIVE:\n  - INSTANTIATE: M-agency-refactor, M-forum-refactor, M-peripheral-model\n    Exotype exists and is validated. Implementation missions can now be scoped."}], :conclusion "  This is a flexiformal argument for the futon3c social coordination\n  layer — the third AIF loop in the futon stack, operating at the\n  social/real-time timescale. It builds on the completed coordination\n  argument (coordination/ARGUMENT.flexiarg), which established the\n  task-timescale gate pipeline (futon3b) and the glacial-timescale\n  library evolution loop (L1). This argument establishes what the\n  social loop requires, why previous attempts failed, and what a\n  futonic implementation must look like.\n\n  The coordination argument was verified by implementation: futon3b\n  has 31 tests, 109 assertions, and an 8/8 machine-checked wiring\n  diagram. This argument is pre-implementation — it is what must be\n  valid BEFORE futon3c missions can be scoped.\n\n  == PART 0: Context — What Changed Since the Coordination Argument ==\n\n  The coordination argument (coordination/ARGUMENT.flexiarg) established:\n\n  - futon3 is split into three repos (war-room.md WR-1):\n    futon3a (query), futon3b (task+glacial), futon3c (social/realtime)\n  - The gate pipeline (G5→G0) is implemented and test-verified\n  - The glacial loop (L1-observe → L1-canon) is implemented and\n    test-verified, including the round-trip proof\n  - The concrete wiring diagram passes all 8 categorical checks\n\n  The devmap (futon3.devmap, updated 2026-02-09) now reflects this:\n  - P2 (Check DSL) is the gate pipeline, owned by futon3b\n  - P3 (Proof-State Journal) is the proof-path store, owned by futon3b\n  - P7 (Pattern Workbench) is partially implemented as L1 canonicalizer\n  - P8 (Joy Metrics), P10 (Training Ground) are assigned to futon3c\n  - P11 (Self-Description) is assigned to futon5\n\n  WHAT THE DEVMAP DOES NOT ADDRESS (social layer):\n  - No agent lifecycle management with formal invariants\n  - No real-time message routing with delivery guarantees\n  - No session persistence or continuity model\n  - No forum or collaborative proof-tree infrastructure\n  - No peripheral model (detach/reattach, capability envelopes)\n  - No standup or co-presence ceremony\n  - No PAR as first-class session event\n\n  These are precisely the concerns that futon3 attempted to address\n  with Agency, Forum, Drawbridge, and the bridge scripts — and that\n  failed. The question is: why did they fail, and what must be\n  different?\n\n  == PART I: Why the Social Layer Attempts Failed ==\n\n  Three empirical tensions, each grounded in the futon3 git log\n  with specific commit evidence. These are documented as standalone\n  patterns in library/social/.\n\n  S1. [from social/verify-before-compose]\n  Agency and Drawbridge code was written as architectural design\n  documents, not tested incrementally. Five forward-declaration\n  fix commits (f3044aa, adc8d67, 2da227e, 1542b0a, 6010d79) across\n  two subsystems demonstrate that namespaces were composed before\n  individual functions were verified to load. This is a systematic\n  violation of the event-protocol pattern (futon-theory): PROPOSE_CLAIM\n  preceded OBSERVE. The cost was multiplicative debugging at\n  integration time rather than additive debugging at definition time.\n\n  S2. [from social/tension-before-code]\n  Agency went through three generations before its invariants were\n  named. Generation 1-2 built four major features (bells, pages,\n  registry, session tracking) without any A0-A5 proof tests. Phase 1\n  (commit 588a468) wrote the invariant tests and found 18 failures.\n  Phase 2 (commits 5f85287, c5b5929, 3f0aa3a, 804fe8f, 5dcb28b)\n  fixed all five invariants — each commit message is a retroactive\n  confession: \"eliminate catch _ nil\" (A3), \"no silent corruption\"\n  (A2), \"non-nil continuity\" (A2), \"bounded lifecycle\" (A5),\n  \"delivery receipts\" (A0). The tension-observation loop\n  (futon-theory/structural-tension-as-observation) was not running.\n\n  S3. [from social/explicit-exit-over-abandonment]\n  Three subsystems were silently abandoned:\n  - Forum: 8 commits (4846339 through a346d27), ClassCastException\n    on first WebSocket test, last commit is bare \"save\", no mission\n    status update, 9 success criteria in M-agency-forum.md none\n    completed or marked blocked.\n  - PAR bell: designed for parallelism (9d76e88), forced sequential\n    (7fda538), 6 subsequent workaround commits, M-par-session-\n    punctuation.md has 1 of 8 checkboxes completed.\n  - IRC/MUSN bridge: 14+ fix commits (auth, timeouts, multi-room,\n    sanitizer on/off, prompt tightening, rate limiting), no exit\n    criteria, no convergence milestone.\n  Each abandonment violated the mission-lifecycle pattern\n  (futon-theory): no :active → :blocked transition, no recorded\n  blocker, no tension observation.\n\n  S4. [synthesis of S1-S3]\n  The three tensions are not independent. S1 (untested composition)\n  produces S2 (retroactive invariant discovery) because untested code\n  accumulates latent violations. S2 produces S3 (abandonment) because\n  retroactive invariant discovery is demoralizing — each rebuild\n  reveals more violations, and eventually the developer shifts\n  attention to a different subsystem. The cycle is:\n\n    build without tests → discover violations → confess invariants →\n    rebuild → discover more violations → abandon → start new subsystem\n\n  This is the structural cycle identified in the coordination\n  argument (H8), but operating at the social timescale rather than\n  the task timescale. The coordination argument broke this cycle for\n  the task loop by specifying invariants first (the gate patterns)\n  and verifying them categorically (the wiring diagram). The social\n  loop needs the same treatment.\n\n  S5. [from agency pattern library: 8 patterns]\n  The Agency pattern library documents the consequences of S1-S3 in\n  domain-specific terms. Eight patterns name specific failure modes:\n  - delivery-receipt: \"sent\" confused with \"delivered\"\n  - single-routing-authority: three routing tiers with conflicting state\n  - state-atomicity: transitions leave nil state on failure\n  - loud-failure: 20+ instances of (catch Exception _ nil)\n  - bounded-lifecycle: atoms grow unbounded, cleanup races\n  - identifier-separation: transport IDs overload LLM session IDs\n  - self-attribution: server posts on behalf of agents\n  - invariants (A0-A5): formal spec written after two generations\n\n  These patterns are empirically validated — the Phase 2 commits\n  confirm every failure mode. But they are post-mortems, not\n  specifications: they were induced from failures, not derived from\n  futon-theory. They document what went wrong without grounding\n  WHY in a theoretical framework that would predict the failure\n  class in advance.\n\n  S6. [from realtime pattern library: 13 patterns]\n  The realtime pattern library documents the consequences of S1-S3\n  in the bridge/transport domain. Thirteen patterns name failure\n  modes clustered around one theme: presence is not coherence.\n  - authoritative-transcript: multiple transcripts disagree\n  - listener-leases: phantom presence from old listeners\n  - liveness-heartbeats: pings don't distinguish quiet from partitioned\n  - rendezvous-handshake: \"connected\" confused with \"coherent\"\n  - transport-pivot: switching mid-stream creates split-brain\n  - mode-gate: mixing talk with action collapses accountability\n  - single-line-transport: IRC splits multi-line messages\n  - structured-events-only: free-text doesn't parse reliably\n\n  Like the agency patterns, these are post-mortems — induced from\n  the IRC bridge fix-cycle (14+ commits), not derived from\n  futon-theory.\n\n  S7. [from devmap P8, P10: orphaned greenfield prototypes]\n  Joy Metrics (P8) and Training Ground (P10) were assigned to\n  futon3c in the devmap update but have no implementation, no\n  mission documents, and no evidence. They are downstream of the\n  social coordination layer — they cannot be built until the layer\n  they depend on exists. Their greenfield status is a symptom of\n  S3 (abandonment): the infrastructure they need was attempted and\n  abandoned.\n\n  == PART II: What the Agency/Realtime Patterns Require ==\n\n  The agency and realtime patterns, despite being post-mortems, do\n  contain valid requirements. Reformulated as requirements (not\n  patterns), grounded in futon-theory:\n\n  R1. [from agency/delivery-receipt + futon-theory/proof-path]\n  Every message sent between agents must produce a delivery receipt\n  or an explicit failure. \"No error\" is not \"success.\" The proof-path\n  pattern requires auditable chains; unreceipted messages are\n  unverifiable links.\n\n  R2. [from agency/single-routing-authority + futon-theory/single-source-of-truth]\n  For any agent-id, exactly one routing authority exists at a time.\n  Multiple routing tiers with conflicting state are a violation of\n  single-source-of-truth (I1).\n\n  R3. [from agency/state-atomicity + futon-theory/all-or-nothing]\n  State transitions are atomic: they succeed completely or fail\n  loudly with rollback. Partial transitions that leave nil state\n  violate all-or-nothing (I2).\n\n  R4. [from agency/loud-failure + futon-theory/error-hierarchy]\n  Errors surface at the layer that caused them. Silent catch-and-\n  swallow (catch _ nil) is a violation of error-hierarchy (I3).\n\n  R5. [from agency/bounded-lifecycle + futon-theory/agent-contract]\n  All transient resources have deterministic lifecycle bounds.\n  Fire-and-forget cleanup violates agent-contract (agents must\n  respect invariants).\n\n  R6. [from agency/identifier-separation + futon-theory/single-source-of-truth]\n  Transport IDs, continuity IDs, and protocol IDs are typed and\n  distinct. Overloading violates single-source-of-truth because\n  the same identifier means different things at different layers.\n\n  R7. [from realtime/rendezvous-handshake + futon-theory/event-protocol]\n  Connection must be followed by an explicit readiness handshake\n  before coordination can begin. The event-protocol requires\n  OBSERVE before PROPOSE_CLAIM; presence without readiness\n  assessment is unobserved action.\n\n  R8. [from realtime/authoritative-transcript + futon-theory/durability-first]\n  One transcript is authoritative. Multiple conflicting transcripts\n  violate durability-first (I0): what you save is not what you get\n  back if you're reading from the wrong transcript.\n\n  R9. [from realtime/structured-events-only + futon-theory/minimum-viable-events]\n  Events must be structured and machine-parseable. Free-text PSR/PUR\n  that don't parse reliably cannot be minimum viable events because\n  they cannot be reliably processed.\n\n  R10. [from realtime/mode-gate + futon-theory/agent-contract]\n  Coordination talk and action talk must be distinguishable. The\n  agent-contract requires agents to \"observe before act\"; mixing\n  the two modes collapses the observation/action boundary.\n\n  R11. [from social/scope-bounded-handoff + futon-theory/I4]\n  Agent handoffs must declare writable scope. Constraint-timescale\n  artifacts (exotype diagrams, pattern library, mission specs) are\n  read-only from the task timescale. This is I4 (exogeneity) applied\n  to agent coordination: no task-timescale agent can modify a\n  constraint-timescale artifact. Scope violations must be structurally\n  rejected, not conventionally discouraged.\n  Evidence: futon5 feat/compose-parallel review (2026-02-10) — Codex\n  rewrote social-exotype.edn (constraint artifact) to make compose-\n  parallel tests pass, discarding gate duality (C6) and ARGUMENT\n  traceability. Three tensions recorded in proof-path store.\n\n  == PART III: What the Theory Demands ==\n\n  T1. [from futon-theory/four-types + futon-theory/interface-loop]\n  The futon stack operates at three timescales (war-room.md):\n  - Social (seconds): agents coordinate, hand off work, maintain\n    shared awareness\n  - Task (minutes): gate pipeline validates, executes, persists\n  - Glacial (weeks): library evolves through tension observation\n    and canonicalization\n\n  The interface-loop pattern says: at each layer boundary, a Baldwin\n  cycle (EXPLORE → ASSIMILATE → CANALIZE) must operate for cumulative\n  functional gain. futon3b implements this at the task/glacial\n  boundary (L1). The social/task boundary needs the same treatment:\n  a loop that observes coordination outcomes and feeds them into\n  the task pipeline.\n\n  T2. [from futon-theory/structural-tension-as-observation]\n  The social loop's observation vector is coordination failure:\n  dropped messages (R1), routing conflicts (R2), partial state (R3),\n  silent errors (R4), resource leaks (R5), identity confusion (R6).\n  These are the structural irritations, pre-symbolic pressures, and\n  trans-situational reappearances that the glacial loop should\n  eventually canonize — but they must first be observable at the\n  social timescale.\n\n  T3. [from futon-theory/mission-lifecycle + futon-theory/mission-scoping]\n  The social layer must be built as bounded missions with explicit\n  lifecycle transitions. S3 demonstrated that unbounded missions\n  with implicit abandonment create false affordances and archaeology\n  tax. Each futon3c mission must have: single owner, scope in/out,\n  success criteria, exit conditions, and explicit :blocked/:parked\n  transitions.\n\n  T4. [from futon-theory/event-protocol + futon-theory/proof-path]\n  Social-timescale events (agent connection, message exchange,\n  session handoff, peripheral hop) must produce typed records that\n  compose into proof paths. The coordination argument established\n  that proof paths are the minimum unit of auditability. The social\n  loop produces the fastest proof paths — they must be typed from\n  the start, not retroactively.\n\n  T5. [from futon-theory/retroactive-canonicalization]\n  The agency and realtime patterns ARE retroactive canonicalizations\n  — they were induced from failure. But they were not canonicalized\n  through the Baldwin cycle: they were not NAMED from recurring\n  tensions (they were named from post-mortems), not SELECTED by\n  threshold (they were all included regardless of recurrence), and\n  not CANALIZED into constraints (they exist as patterns but\n  constrain nothing). For futon3c, the canonicalization must be\n  genuine: patterns that pass through naming, selection, and\n  canalization via L1.\n\n  == PART IV: The Convergence ==\n\n  C1. [from S4, S5, S6]\n  The agency patterns (8) and realtime patterns (13) describe\n  different symptoms of the same disease: building distributed\n  coordination without the theoretical grounding that makes the\n  invariants predictable. The agency patterns focus on state/routing/\n  lifecycle; the realtime patterns focus on transport/presence/\n  coherence. But the three recurring failure modes are identical\n  across both:\n  - Silent failures (agency/loud-failure ↔ realtime/loop-failure-signals)\n  - Identity collapse (agency/identifier-separation ↔ realtime/listener-leases)\n  - Missing proof (agency/delivery-receipt ↔ realtime/rendezvous-handshake)\n\n  C2. [from R1-R10, T1]\n  The ten requirements (R1-R10) are not a grab-bag. They decompose\n  into three layers that correspond to the three AIF loop boundaries:\n  - Transport layer (R1, R7, R8, R9): delivery, readiness, transcript,\n    structure — the social→social boundary\n  - Routing layer (R2, R5, R6, R10): authority, lifecycle, identity,\n    mode separation — the social→task boundary\n  - State layer (R3, R4): atomicity, error propagation — the\n    task→task boundary (already enforced by futon3b gates)\n  R3 and R4 are already satisfied by the gate pipeline. The social\n  layer's job is R1-R2 and R5-R10: the requirements that operate\n  at the social timescale.\n\n  C3. [from T2, T4, T5]\n  The social loop must produce typed events that feed into the same\n  proof-path store that the task loop writes to. This is how the\n  three timescales compose:\n  - Social loop produces coordination events (connections, messages,\n    handoffs) as typed proof-path entries\n  - Task loop produces execution events (gate traversals) as typed\n    proof-path entries\n  - Glacial loop observes ALL proof-path entries for tensions and\n    canonizes new patterns\n\n  The L1 observer already has the three scan functions\n  (structural-irritation, pre-symbolic-pressure, trans-situational-\n  reappearance). If the social loop emits typed events into the\n  proof-path store, L1 can observe social-timescale tensions without\n  modification. The glacial loop is timescale-agnostic — it observes\n  structural patterns, not timescale-specific ones.\n\n  C4. [from S1-S3, T3]\n  The social layer must be built differently from how futon3 built\n  Agency/Forum/Drawbridge. Specifically:\n  - Verify before compose (S1): each namespace loads and passes\n    smoke tests before integration\n  - Tension before code (S2): invariant proof tests before\n    implementation\n  - Explicit exit (S3): mission lifecycle transitions, not silent\n    abandonment\n\n  These are development-process patterns, not runtime patterns.\n  They constrain HOW futon3c is built, not WHAT it builds. The\n  coordination argument did not need to state this because futon3b\n  was built futonic from the start (the gate patterns existed before\n  the code). futon3c must learn from the futon3 experience.\n\n  C5. [from C1, C2, C3, C4]\n  The social loop is not a separate system. It is the third\n  timescale of the same AIF diagram. The coordination argument\n  established two loops (task + glacial) sharing one boundary (the\n  gate pipeline). The social loop adds the fastest timescale:\n\n    social (seconds) → task (minutes) → glacial (weeks)\n        ↑                                     |\n        └─────── library constrains ──────────┘\n\n  Agents coordinate in real-time (social), submit work through\n  gates (task), accumulate evidence that evolves the library\n  (glacial), and the evolved library constrains future coordination\n  (social). This is the full AIF cycle across three timescales.\n  I3 (timescale ordering) governs all three boundaries.\n\n  C6. [from coordination/INDEX.md duality table, C2, C5]\n  The coordination patterns already have a dual interpretation\n  (coordination/INDEX.md §Dual Interpretation). Each gate reads\n  two ways: an agency problem and a pattern problem. The table:\n\n  | Gate | Agency Reading | Pattern Reading |\n  | G5 task-shape | Is the agent's task well-defined? | Is the task shaped so a pattern can guide it? |\n  | G4 capability | Can this agent do this work? | Does this pattern apply to this domain? |\n  | G4 assignment | Is one agent responsible? | Is one pattern selected? |\n  | G3 mandatory-psr | Has the agent committed to an approach? | Has a pattern been engaged with? |\n  | G2 bounded-execution | Agent stays within budget | Pattern application stays within scope |\n  | G1 mandatory-pur | Agent's work gets evaluated | Pattern's guidance gets evaluated |\n  | G0 durability | Agent's session is recoverable | Pattern use evidence is persistent |\n  | G0 par-obligation | Agent reflects on what happened | Pattern library learns from use |\n\n  The left column (agency reading) IS the social loop's concern.\n  The right column (pattern reading) IS the task/glacial loop's\n  concern. The gate pipeline is not just where social events feed\n  into task events — it is where the two readings converge into\n  one typed record. This means the social loop's requirements\n  (R1-R10) map onto specific gates:\n\n  - R1 (delivery receipts) → agency reading of G0 (durability)\n  - R2 (single routing authority) → agency reading of G4 (assignment)\n  - R7 (rendezvous handshake) → agency reading of G5 (task shape)\n  - R9 (structured events) → agency reading of G0 (durability)\n  - R10 (mode gate) → agency reading of G3 (mandatory-psr)\n\n  The social loop is not a layer below the gate pipeline that feeds\n  into it. It is the agency SIDE of the gate pipeline — the half\n  that was specified in the duality table but never implemented.\n  \"Futon3 replaces 'ants' with 'agents' and 'pheromone' with\n  'patterns' — coordination is the relationship between agents and\n  patterns, and the gates sit at the intersection.\"\n\n  == THESIS ==\n\n  Th. [from C1-C6]\n\n  futon3 attempted to build real-time agent coordination (Agency,\n  Forum, Drawbridge, bridges) without the theoretical grounding\n  that makes distributed invariants predictable. The result was\n  three generations of build-confess-rebuild for Agency, silent\n  abandonment of Forum, and a perpetual fix-cycle for bridges.\n  Twenty-one patterns (8 agency + 13 realtime) document the\n  symptoms; three social patterns (verify-before-compose,\n  tension-before-code, explicit-exit-over-abandonment) diagnose\n  the cause: the development process itself violated the same\n  invariants the system was trying to enforce.\n\n  futon3c must break this cycle by:\n\n  1. Deriving its invariants from futon-theory BEFORE writing code,\n     not inducing them from failures afterward (T5, S2)\n  2. Emitting typed events into the shared proof-path store so the\n     existing glacial loop can observe social-timescale tensions (C3)\n  3. Building as bounded missions with explicit lifecycle transitions,\n     verified incrementally (T3, C4)\n  4. Treating the agency and realtime patterns as evidence of\n     tensions, not as the architectural specification (C1)\n\n  Moreover, the social loop is not a layer beneath the gate pipeline\n  that feeds into it from below. The coordination duality table (C6)\n  reveals that each gate already has an agency reading and a pattern\n  reading. The pattern reading is implemented (futon3b). The agency\n  reading is specified but unimplemented — it IS the social loop.\n  futon3c completes the duality: agents and patterns, the two sides\n  of every gate, both implemented and both producing typed evidence.\n\n  The social loop is the fastest timescale in a three-level AIF\n  diagram. Its outputs feed the task loop (gate pipeline), whose\n  outputs feed the glacial loop (library evolution), whose outputs\n  constrain the social loop. The architecture is not three separate\n  systems — it is one system operating at three timescales, sharing\n  one typed evidence store and one categorical verification framework.\n\n  == WHAT FUTON3C MUST BUILD ==\n\n  FROM FUTON3 (failed attempts, as evidence):\n  - Agency A0-A5 invariants → validated in Phase 2, need porting\n    to a clean implementation with tests-first discipline\n  - Forum proof-tree concept → valid idea, failed execution;\n    needs mission-scoped retry with explicit exit conditions\n  - Drawbridge multi-agent routing → OOM-motivated redesign;\n    registration-based, not subprocess-based\n  - Peripheral model → concept drifted through 3 definitions;\n    needs grounding in futon-theory/agent-contract\n  - PAR session punctuation → elegant design, zero implementation;\n    needs bounded first milestone\n\n  FROM FUTON3B (proven infrastructure, as foundation):\n  - Gate pipeline (G5→G0) → social loop submits work through gates\n  - Proof-path store → social events written as typed records\n  - L1 observer → detects social-timescale tensions automatically\n  - L1 canonicalizer → promotes recurring social tensions to patterns\n  - Malli evidence shapes → social events must validate against shapes\n  - ct/mission.clj → social-loop wiring diagram must pass 8 checks\n\n  FROM FUTON-THEORY (constraints):\n  - event-protocol: social events follow OBSERVE → VERIFY sequence\n  - proof-path: social coordination produces auditable chains\n  - agent-contract: agents clock in, observe, attribute, respect\n    invariants\n  - interface-loop: Baldwin cycle at social→task boundary\n  - mission-lifecycle: bounded missions with explicit transitions\n\n  == VERIFICATION (PENDING) ==\n\n  V1. [required: social-exotype diagram]\n  A social-exotype.edn must be written and validated against\n  ct/mission.clj, analogous to coordination-exotype.edn. It must\n  encode the social-timescale components (Agency, Forum, peripherals)\n  and their edges, and pass all 8 checks including I3 (timescale\n  ordering: social→social and social→task edges only) and I4\n  (exogeneity: no social output reaches glacial constraints directly).\n\n  V2. [required: concrete diagram update]\n  futon3-coordination.edn must be extended with social-timescale\n  components and edges, and the combined diagram must still pass\n  all 8 checks. The existing Level 0 and Level 1 edges must remain\n  valid.\n\n  V3. [required: round-trip proof]\n  Analogous to futon3b's full-loop-round-trip test: a social\n  coordination event → typed proof-path entry → L1 observes tension →\n  L1 canonizes pattern → pattern constrains future social\n  coordination. This proves the three-timescale AIF cycle closes.\n\n  == STATUS ==\n\n  This argument is at the VERIFY step of the derivation xenotype.\n\n  COMPLETE:\n  - IDENTIFY: futon3 git archaeology (social-layer failures)\n  - MAP: Four social patterns (verify-before-compose, tension-before-code,\n    explicit-exit-over-abandonment, scope-bounded-handoff)\n  - DERIVE: Eleven requirements (R1-R11) from agency/realtime patterns via\n    futon-theory. R11 added 2026-02-10 from live coordination evidence\n    (Codex compose-parallel review).\n  - ARGUE: This document (S1-S7, R1-R11, T1-T5, C1-C6, thesis)\n\n  COMPLETE (continued):\n  - VERIFY: M-social-exotype (futon3c/holes/missions/M-social-exotype.md)\n    - V1: social-exotype.edn — standalone diagram validation [DONE, 8/8]\n    - V2: three-diagram composition — compose-parallel merged to futon5 main\n      (d5ae681). social-exotype.edn restored with :social timescale. Composed\n      diagram: 5 inputs, 7 outputs, 16 components, 69 edges, 8/8 checks.\n    - V3: round-trip proof deferred to INSTANTIATE (by design)\n  - Part III (Prototype 0) — bootstrap closure [DONE]\n    - 6 proof-paths in futon3b/data/proof-paths/ including 3 coordination\n      tensions from Codex review\n\n  ACTIVE:\n  - INSTANTIATE: M-agency-refactor, M-forum-refactor, M-peripheral-model\n    Exotype exists and is validated. Implementation missions can now be scoped.", :directives {:audience "futon developers, decision-makers, theory reviewers", :keywords ["argument" "proof" "social" "realtime" "coordination" "agency" "forum" "peripheral" "AIF"], :references ["coordination/ARGUMENT" "coordination/INDEX" "futon-theory/four-types" "futon-theory/baldwin-cycle" "futon-theory/interface-loop" "futon-theory/structural-tension-as-observation" "futon-theory/retroactive-canonicalization" "futon-theory/mission-lifecycle" "futon-theory/event-protocol" "futon-theory/proof-path" "futon-theory/agent-contract" "social/verify-before-compose" "social/tension-before-code" "social/explicit-exit-over-abandonment" "social/scope-bounded-handoff"], :style "argument", :title "Argument for a Futon3c Social Coordination Layer", :tone "analytic-foundational"}, :id "social/ARGUMENT", :keywords ["argument" "proof" "social" "realtime" "coordination" "agency" "forum" "peripheral" "AIF"], :projection-version "flexiarg-v0", :references ["coordination/ARGUMENT" "coordination/INDEX" "futon-theory/four-types" "futon-theory/baldwin-cycle" "futon-theory/interface-loop" "futon-theory/structural-tension-as-observation" "futon-theory/retroactive-canonicalization" "futon-theory/mission-lifecycle" "futon-theory/event-protocol" "futon-theory/proof-path" "futon-theory/agent-contract" "social/verify-before-compose" "social/tension-before-code" "social/explicit-exit-over-abandonment" "social/scope-bounded-handoff"], :scores {}, :sigils [], :source-path "library/social/ARGUMENT.flexiarg", :sources [], :status :ok, :title "Argument for a Futon3c Social Coordination Layer", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When two agents must agree on a shared structure (a set of roots, a taxonomy, a schema), each side should DERIVE its view from a common source by construction — not hardcode a copy. A derived contract recovers itself and cannot silently drift; a hardcoded one drifts the moment either side edits independently, and a structural check that counts the right number of things will pass green while the meaning has diverged. Verify the contract semantically (does the behaviour hold?), not just structurally (do the counts match?)."} {:name "context", :name-key "context", :slug "context", :text "A producer agent emits an artifact (a move-set, a graph, an index); a consumer agent acts on a contract about that artifact (which entries are roots/axioms, which keys are stable, what a field means). They coordinate across async messages and separate codebases."} {:name "IF", :name-key "if", :slug "if", :text "    The two agents agree on a contract — \"these 21 entries are the seed roots,\" \"the prior is the policy head\" — and each encodes its understanding on its own side."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    A hardcoded shared structure is two copies that must be kept equal by discipline, which fails under independent edits and async drift. Worse, the natural verification — a handshake that checks structure (counts, taxonomy, schema shape) — can pass GREEN while the *semantic* contract is violated, because structure is not meaning."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Hardcoded-list drift: one side ships the 21 roots as a literal; the producer's data changes; the lists diverge; nothing flags it until something downstream breaks far from the cause.\n      - Green-handshake / violated-contract: a zero-drift check confirms \"21/3/7/0 roots, exact\" and passes, while the consumer is silently recomputing the producer's policy head from a flat field — re-flattening it — so the *structure* matches but the *behaviour* the contract names is gone.\n      - Namespace mismatch: two sides assume different string forms for the same entity; the structural join \"succeeds\" on the wrong set or silently drops, with no count to betray it."} {:name "THEN", :name-key "then", :slug "then", :text "    1. **Derive, don't copy.** The consumer computes the shared structure from the producer's artifact by construction (e.g. `roots = {move.have} \\ {move.want}` recovers the seed set from the move-set itself), so it is never a separate literal that can drift.\n    2. **Make the producer's artifact the single source**; the consumer's view is a pure function of it. A re-emit changes both views together.\n    3. **Add a semantic witness, not just a structural one.** A handshake that asserts counts must be paired with an assertion that the *behaviour* holds (the policy head is *consumed*, not recomputed; the join key matches verbatim). A ratified semantic fix needs its own regression witness or it silently regresses.\n    4. **Surface the namespace explicitly** (string-exact, no normalization) so a join can only succeed on identity."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Single-source-of-truth (futon-theory) says a fact should have exactly one authoritative home; a derived contract makes the producer's artifact that home and the consumer's view a projection, so there is nothing to keep in sync. Proof-path discipline (OBSERVE → VERIFY) says a claim isn't done until verified — and structure is the cheap, misleading half of the observation. The expensive, load-bearing half is semantic: a green count is OBSERVE without VERIFY of the thing that matters."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      FutonZero scope-grain seam, 2026-06-09 (claude-3 producer ↔ claude-4 rollout). The roots\n      handshake was made **derived**: claude-4 computed `mission-roots = {move :have} \\ {move :want}`,\n      recovering claude-3's 21 mission-entity seeds *by construction* — \"drift-free, never\n      hardcoded\" — and the end-to-end run asserted them exact (21/3/7/0). Yet the SAME handshake\n      passed green while the consumer was recomputing `:prior` as `softmax(:score)` over a flat\n      field, re-flattening the producer's sharpened policy head before it ever reached PUCT — the\n      structural witness covered the taxonomy, not the semantic contract (\"`:prior` IS the policy\n      head, consumed not recomputed\"). Caught only on a deliberate re-check; the ratified fix\n      (\"consume `:prior` directly\") was flagged as needing its own consumption witness. Structure\n      green, meaning drifted — the exact split this pattern names."}], :conclusion "When two agents must agree on a shared structure (a set of roots, a taxonomy, a schema), each side should DERIVE its view from a common source by construction — not hardcode a copy. A derived contract recovers itself and cannot silently drift; a hardcoded one drifts the moment either side edits independently, and a structural check that counts the right number of things will pass green while the meaning has diverged. Verify the contract semantically (does the behaviour hold?), not just structurally (do the counts match?).", :directives {:audience "multi-agent coordinators, interface designers, mission PMs", :keywords ["contract" "drift" "handshake" "multi-agent" "derived" "witness" "namespace" "zero-drift" "coordination"], :references ["social/idempotent-handoff" "social/verify-before-compose" "futon-theory/single-source-of-truth" "futon-theory/proof-path"], :style "pattern", :title "Derive the Shared Contract From Structure, Don't Hardcode It on Each Side", :tone "analytic-foundational"}, :id "social/derive-the-contract", :keywords ["contract" "drift" "handshake" "multi-agent" "derived" "witness" "namespace" "zero-drift" "coordination"], :projection-version "flexiarg-v0", :references ["social/idempotent-handoff" "social/verify-before-compose" "futon-theory/single-source-of-truth" "futon-theory/proof-path"], :scores {}, :sigils [], :source-path "library/social/derive-the-contract.flexiarg", :sources [], :status :ok, :title "Derive the Shared Contract From Structure, Don't Hardcode It on Each Side", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When a subsystem hits a blocking failure, transition it through the mission lifecycle state machine (:active -> :blocked with explicit blocker) rather than letting attention drift to a different subsystem. Silent abandonment is the project-management equivalent of catch _ nil — it suppresses a signal that downstream decisions depend on."} {:name "context", :name-key "context", :slug "context", :text "You are building an ambitious multi-subsystem project (proof-tree forum, parallel agent execution, real-time bridges, session punctuation) where each subsystem has dependencies on others and where multiple agents or developers may pick up work based on stated mission status."} {:name "IF", :name-key "if", :slug "if", :text "    A subsystem encounters its first serious integration failure — a ClassCastException in the WebSocket layer, an OOM when running a sidecar process, a race condition in parallel execution — and the developer's attention shifts to a different subsystem that seems more tractable or more urgent."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Silent abandonment leaves the codebase in an inconsistent state. Partially built subsystems create false affordances: APIs that exist but don't work, mission documents that list success criteria for capabilities that were never completed, pattern libraries that reference subsystems that were tried and failed. The next developer (human or agent) cannot distinguish \"not yet built\" from \"tried and failed\" without git archaeology — and the git archaeology itself takes longer than building the thing would have, because abandoned code has no exit narrative."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - False affordance: an API exists, is referenced in mission docs and pattern libraries, but does not work; downstream agents build against it and fail at integration time\n      - Zombie mission: mission document says :in-progress but has no commits for weeks; another developer assumes it's being worked on and does not pick it up\n      - Archaeology tax: understanding why a subsystem was abandoned requires reading the full git log, cross-referencing with IRC logs, and guessing at context that was never recorded\n      - Perpetual fix cycle: rather than declaring a subsystem blocked and redesigning, the developer applies an unbounded series of point fixes that never converge on stability"} {:name "THEN", :name-key "then", :slug "then", :text "    When a subsystem hits a blocking failure, record three things: (1) the specific failure and its commit, (2) the mission lifecycle transition (:active -> :blocked, with blocker reference), and (3) what downstream missions are affected. If the subsystem is being deliberately deprioritized rather than blocked, transition to :parked with a rationale. Never leave a mission in :active status when no one is working on it."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The mission-lifecycle pattern (futon-theory/mission-lifecycle) defines a state machine (:greenfield -> :scoped -> :active -> :blocked -> :review -> :done) precisely to make project state legible. Each transition produces a minimum viable event (futon-theory/minimum-viable-events) that downstream consumers can reason about. Abandonment without state transition violates both: it suppresses the event and makes the state illegible. The loud-failure pattern (futon-theory/loud-failure) applies identically — errors must surface at the layer that caused them, whether that layer is a runtime process or a development project."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      futon3 git log, three subsystems:\n\n      Forum (built and abandoned):\n      - 4846339: \"Implement Forum service for multi-agent proof trees\" (initial build)\n      - 02b5257: \"Fix forum WebSocket ClassCastException\" (first integration failure)\n      - 17c87b7: \"Fix Agency session handling and forum dispatch\" (second fix)\n      - a346d27: \"save\" (final commit — bare save with no context)\n      8 total commits. No mission status update. No PAR. No :blocked transition.\n      M-agency-forum.md lists 9 success criteria including \"Proof structure: Threads form valid proof trees\" — none completed, none marked blocked.\n\n      PAR bell (parallel-to-sequential retreat):\n      - 9d76e88: \"feat(par): Bell-based PAR architecture for remote agents\" (designed for parallelism)\n      - 7fda538: \"fix(par-bell): Run agents sequentially for cross-reading\" (forced sequential)\n      - 6 subsequent fix commits (IPv6, hardcoded agents, failure tolerance, timeouts, CRDT cleanup)\n      M-par-session-punctuation.md: 1 of 8 checkboxes completed. No :blocked transition for the remaining 7.\n\n      IRC/MUSN bridge (perpetual fix cycle):\n      - 270061d: \"Improve IRC-MUSN bridge stability\" (stability grind begins)\n      - 14+ subsequent fix commits: auth handling, polling timeouts, multi-room support, sanitizer added then removed, prompt tightened, rate limiting, deduplication\n      No exit criteria defined. No mission document. No convergence milestone.\n\n    Mechanic, in short:\n    Derived from futon-theory via:\n    - mission-lifecycle: explicit state transitions -> abandoned subsystems must transition to :blocked or :parked\n    - mission-scoping: bounded ownership with exit conditions -> exit conditions must be evaluated, not ignored\n    - loud-failure: errors surface at the causing layer -> project-level failures must be as visible as runtime failures\n    - minimum-viable-events: log decision points, not surveillance -> a blocking failure is a decision point"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    Audit futon3c missions monthly. Any subsystem with no commits for 2+ weeks and no :blocked or :parked status transition indicates the pattern is not holding. Record violations as tension observations for the L1 glacial loop."}], :conclusion "When a subsystem hits a blocking failure, transition it through the mission lifecycle state machine (:active -> :blocked with explicit blocker) rather than letting attention drift to a different subsystem. Silent abandonment is the project-management equivalent of catch _ nil — it suppresses a signal that downstream decisions depend on.", :directives {:audience "futon3c mission owners, coordination architects", :keywords ["abandonment" "lifecycle" "mission" "exit" "blocked" "forum" "PAR" "state-machine"], :references ["futon-theory/mission-lifecycle" "futon-theory/mission-scoping" "futon-theory/loud-failure" "futon-theory/minimum-viable-events"], :style "pattern", :title "Exit Subsystems Through the Lifecycle State Machine, Not Silent Abandonment", :tone "analytic-foundational"}, :id "social/explicit-exit-over-abandonment", :keywords ["abandonment" "lifecycle" "mission" "exit" "blocked" "forum" "PAR" "state-machine"], :projection-version "flexiarg-v0", :references ["futon-theory/mission-lifecycle" "futon-theory/mission-scoping" "futon-theory/loud-failure" "futon-theory/minimum-viable-events"], :scores {}, :sigils [], :source-path "library/social/explicit-exit-over-abandonment.flexiarg", :sources [], :status :ok, :title "Exit Subsystems Through the Lifecycle State Machine, Not Silent Abandonment", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "An asynchronous handoff between agents (a bell, a whistle, a dispatched job) must be safe to send twice and safe to receive twice. Key each handoff by a stable content identity and have the receiver reconcile-not-redo: a re-sent bell (because the first timed out) and a crossed bell (two agents acting on the same fact in flight) must both resolve to a single effect. Coordination that assumes exactly-once delivery is coordination that breaks the moment the transport doesn't."} {:name "context", :name-key "context", :slug "context", :text "Several agents coordinate over an async bell/whistle transport with real latency, timeouts (e.g. a 5-minute whistle window, a 30-minute job cap), and no global clock. Agents send handoffs, wait, and act on replies that may arrive late, out of order, or after a re-send."} {:name "IF", :name-key "if", :slug "if", :text "    An agent sends a handoff and the reply is slow — so it re-sends as an async bell (\"my prior whistle timed out\") — or two agents independently act on the same just-established fact and their messages cross in flight."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    If the handoff is treated as a fresh imperative each time, a re-send re-does the work and a crossed pair does it twice (or worse, each \"corrects\" the other into a loop). The work is not lost — but the *coordination* is: agents burn round-trips re-confirming, re-deriving, and reconciling duplicates instead of advancing. The transport's imperfection leaks all the way into the task."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Re-send re-do: a timed-out whistle re-sent as a bell triggers the recipient to recompute an answer it already sent; both replies arrive; the sender must now reconcile two.\n      - Crossed correction: A bells B with a fact; B, mid-reply, bells A the same fact; each reads the other as new and acks, doubling the channel for one decision.\n      - Lost-in-the-cross: a substantive result (a verify, a contract answer) sent while the peer was mid-turn never gets picked up, and the peer re-asks — the result is delivered, then asked-for-again."} {:name "THEN", :name-key "then", :slug "then", :text "    1. Give every handoff a **stable identity** derived from its content (the target artifact + the decision, not a fresh timestamp). A re-send carries the same identity.\n    2. The receiver **reconciles, never redoes**: on a handoff whose identity it has already resolved, it returns the existing result (or a pointer to it: \"already answered, job …NNN\"), not a recomputation.\n    3. State the **idempotency contract in the bell itself** (\"this is the headline so it doesn't block you; full detail = job …NNN\") so a crossed peer can dedup by reading.\n    4. Prefer **content-addressed artifacts** as the channel (a committed file the peer reads) over imperative messages, when the handoff is a result rather than a request — a file read twice is the same file."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Minimum-viable-events (futon-theory) says each coordination step should emit a typed record a consumer can reason about; an idempotent handoff is that record made re-deliverable. Exactly-once is a property of the *transport*, which here is best-effort; idempotency moves the guarantee into the *protocol*, where the agents control it. This is the social-timescale analogue of an idempotent write: the system stays correct under retries and races because the operation's effect is a function of its identity, not of how many times it arrives."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      Multi-agent FutonZero collaboration, 2026-06-09/10 (claude-3 ↔ claude-1 ↔ claude-4). The\n      bell transport crossed repeatedly: a timed-out whistle re-sent as a bell (claude-4's\n      cascade re-score request arrived *after* the answer had been belled — job …317 already\n      held the result; the fix was a one-line \"already answered, headline below, full detail job\n      …317\" reconcile, not a recompute). The contract-lock exchange crossed three times\n      (jobs …293/294, …317/318), each resolved by re-stating the stable result rather than\n      re-deriving it. Where the handoff was a *committed file* (`diffsub-moves.edn` consumed by\n      claude-4's rollout), crossing was a non-issue — the file read twice is the same file. The\n      cost was paid only where handoffs were imperative and non-idempotent."}], :conclusion "An asynchronous handoff between agents (a bell, a whistle, a dispatched job) must be safe to send twice and safe to receive twice. Key each handoff by a stable content identity and have the receiver reconcile-not-redo: a re-sent bell (because the first timed out) and a crossed bell (two agents acting on the same fact in flight) must both resolve to a single effect. Coordination that assumes exactly-once delivery is coordination that breaks the moment the transport doesn't.", :directives {:audience "multi-agent coordinators, agency implementers, mission PMs", :keywords ["bell" "handoff" "idempotent" "async" "crossed-wires" "dedup" "multi-agent" "coordination" "agency"], :references ["social/scope-bounded-handoff" "social/derive-the-contract" "futon-theory/minimum-viable-events"], :style "pattern", :title "Make Async Handoffs Idempotent — A Crossed or Re-Sent Bell Must Be a No-Op", :tone "analytic-foundational"}, :id "social/idempotent-handoff", :keywords ["bell" "handoff" "idempotent" "async" "crossed-wires" "dedup" "multi-agent" "coordination" "agency"], :projection-version "flexiarg-v0", :references ["social/scope-bounded-handoff" "social/derive-the-contract" "futon-theory/minimum-viable-events"], :scores {}, :sigils [], :source-path "library/social/idempotent-handoff.flexiarg", :sources [], :status :ok, :title "Make Async Handoffs Idempotent — A Crossed or Re-Sent Bell Must Be a No-Op", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "When handing off work to another agent, the task must declare which artifacts are writable (scope-out) and which are read-only inputs (scope-in). The receiving agent's output must be validated against the declared scope before acceptance. Constraint-timescale artifacts (exotype diagrams, pattern library, mission specs) are NEVER writable from the task timescale — this is I4 (exogeneity) applied to agent coordination."} {:name "context", :name-key "context", :slug "context", :text "You are coordinating work across multiple agents (human, Claude, Codex, etc.) operating at potentially different timescales. Each agent receives a task with inputs and produces outputs. Some inputs are constraint inputs (slow-changing artifacts that govern how work is done); others are mutable working state."} {:name "IF", :name-key "if", :slug "if", :text "    A task is handed off to an agent with a clear intent (\"implement compose-parallel\") and input artifacts (social-exotype.edn, coordination-exotype.edn, M-diagram-composition.md) that the agent needs to read but not modify."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Without structural scope enforcement, the agent may modify input artifacts to make its task easier. This is not malice — it is the natural behavior of an optimization process encountering resistance. If the tests pass with a modified input, the agent has no signal that something is wrong. The modification may discard theoretical grounding, requirement traceability, or structural properties that the original author spent significant effort establishing."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Silent input rewrite: Agent modifies a constraint artifact to make tests pass. The modification discards theoretical grounding that isn't visible in the tests (requirement traceability, structural comments, gate duality mapping). The test suite is green but the artifact has regressed.\n      - Scope creep cascade: Agent modifies one file outside scope, which creates inconsistencies with files it didn't modify, prompting further modifications. The original 1-file task becomes a 54-file diff.\n      - Convention collapse: When one agent ignores scope conventions without consequence, the convention becomes unenforceable for all agents. The lack of structural enforcement is itself a coordination failure."} {:name "THEN", :name-key "then", :slug "then", :text "    1. Every task handoff must declare :task/scope with explicit :in (read-only) and :out (writable) file sets.\n    2. Constraint-timescale artifacts (:constraint true in the wiring diagram, or exotype-level documents) are always :in, never :out, for task-timescale agents.\n    3. The review gate (G1 or a new scope-check gate) must verify that the agent's diff falls within :out. Changes to :in files are rejected, not merely flagged.\n    4. If the agent discovers that the :in artifacts need modification, the correct response is a gap-PSR documenting what needs to change and why — NOT silently modifying the artifact."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    This is I4 (preference exogeneity) applied at the social timescale. In wiring diagrams, I4 says \"no fast-timescale output can reach a constraint input.\" In agent coordination, I4 says \"no task-timescale agent can modify a constraint-timescale artifact.\" The invariant is the same; only the domain of application changes.\n\n    The agent-contract pattern (futon-theory/agent-contract) requires agents to \"respect invariants.\" But \"respect\" via convention fails when the agent is an optimization process without domain understanding of the invariant's purpose. Structural enforcement — where the system rejects out-of-scope changes — is the only reliable mechanism. You cannot instruct an agent to be careful; you can only make the careful path the only path."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      futon5 feat/compose-parallel branch (commit a5ea168), Codex review 2026-02-10:\n      - Task: \"Extend ct/mission.clj for parallel diagram composition\" (GitHub issue #2)\n      - Declared scope: ct/mission.clj + new test file + timescale extension\n      - Actual diff: 54 files changed, including:\n        * social-exotype.edn rewritten from scratch (Part I artifact, 301 lines -> 125 lines)\n        * M-diagram-composition.md gutted (164 lines -> 47 lines, failure evidence lost)\n        * healthcheck.clj deleted (outside task scope entirely)\n      - Impact: Gate duality (C6) mapping lost, ARGUMENT requirement traceability lost, I2 modeling lost, mode classification flows lost, structural comments lost\n      - Root cause: No structural scope enforcement. Agent optimized for \"tests pass\" without constraint on which artifacts could be modified.\n      - Recorded as 3 coordination tensions in futon3b proof-path store:\n        T1: artifact-ownership-violation (path-5e83a3f4-7)\n        T2: scope-enforcement-gap (path-ec25edc6-e)\n        T3: social-i4-violation (path-a07f56ac-8)\n\n    Mechanic, in short:\n    Derived from futon-theory via:\n    - I4 (exogeneity): constraint inputs not writable from fast timescale -> constraint artifacts not writable from task-timescale agents\n    - agent-contract: \"respect invariants\" + \"observe before act\" -> observe scope declaration before acting on artifacts\n    - single-source-of-truth: one authority per artifact -> artifact ownership must be declared and enforced\n    - proof-path: auditable chain -> scope violations must be detectable in the proof-path (the diff IS evidence)"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    1. Add :task/scope {:in [...] :out [...]} to TaskSpec shape (futon3b shapes.clj)\n    2. Add scope-check to G1 or introduce G1.5 scope gate\n    3. Update bootstrap.clj submit! to require explicit :out declaration\n    4. For the immediate Codex hand-off: restore social-exotype.edn from main, update :fast -> :social, re-run compose-parallel tests\n    5. Future: L1 observer needs social-timescale scan criteria (current scans only detect task-timescale tensions)"}], :conclusion "When handing off work to another agent, the task must declare which artifacts are writable (scope-out) and which are read-only inputs (scope-in). The receiving agent's output must be validated against the declared scope before acceptance. Constraint-timescale artifacts (exotype diagrams, pattern library, mission specs) are NEVER writable from the task timescale — this is I4 (exogeneity) applied to agent coordination.", :directives {:audience "futon3c implementers, multi-agent coordinators, mission scoping", :keywords ["scope" "handoff" "ownership" "I4" "exogeneity" "multi-agent" "coordination" "constraint"], :references ["futon-theory/agent-contract" "futon-theory/proof-path" "futon-theory/single-source-of-truth" "social/verify-before-compose"], :style "pattern", :title "Scope-Bounded Agent Handoff", :tone "analytic-foundational"}, :id "social/scope-bounded-handoff", :keywords ["scope" "handoff" "ownership" "I4" "exogeneity" "multi-agent" "coordination" "constraint"], :projection-version "flexiarg-v0", :references ["futon-theory/agent-contract" "futon-theory/proof-path" "futon-theory/single-source-of-truth" "social/verify-before-compose"], :scores {}, :sigils [], :source-path "library/social/scope-bounded-handoff.flexiarg", :sources [], :status :ok, :title "Scope-Bounded Agent Handoff", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Invariant proof tests must be written before the implementation they constrain. Invariants discovered during a rebuild are evidence that the tension-observation loop was not running — they have the same information content as proactive specifications, but the retroactive path pays the cost of building, debugging, and discarding code that violates them."} {:name "context", :name-key "context", :slug "context", :text "You are building a coordination layer that must uphold distributed-system guarantees: delivery receipts, single routing authority, atomic state transitions, loud failure propagation, and bounded resource lifecycles."} {:name "IF", :name-key "if", :slug "if", :text "    The system is built feature-first — bells, pages, registries, kick endpoints, session tracking — with correctness properties assumed to hold implicitly through careful coding."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Without explicit invariants specified upfront, each successive generation discovers violations that were present from the start. The \"rebuild\" that fixes them is a confession that retroactively names what should have been preconditions. This turns development into an unbounded cycle: build features -> discover violations -> confess invariants -> rebuild -> discover new violations. Agency went through three generations of this cycle before achieving invariant coverage."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Confession-driven rebuild: each generation's commit messages explicitly name the bugs of the previous (\"eliminate catch _ nil\", \"no silent corruption\", \"non-nil continuity\"), but only after the buggy code has been built and deployed\n      - Invariant debt compounding: A0 (delivery) violations mask A3 (loud failure) violations which mask A5 (bounded lifecycle) violations; fixing one reveals the next, extending the rebuild indefinitely\n      - False completion: a subsystem is declared \"done\" (M-agency-unified-routing) but the done state hides invariant violations that the next mission (M-agency-rebuild) must discover from scratch"} {:name "THEN", :name-key "then", :slug "then", :text "    Write invariant proof tests first, as failing tests that define the boundary conditions. Derive the implementation from what the tests require. Treat any invariant discovered during implementation (rather than before it) as a tension observation: record it, but also ask why the structural-tension-as-observation loop did not detect it earlier."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The structural-tension-as-observation pattern (futon-theory) defines three detection criteria: structural irritation (recurring gaps), pre-symbolic pressure (repeated early failures), and trans-situational reappearance (same pattern across contexts). All five Agency invariant violations (A0-A5) exhibited all three criteria across two generations of code before they were named. The observation loop existed in theory; it was not running in practice. Writing tests first forces the loop to run."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      futon3 git log, Agency subsystem, three generations:\n\n      Generation 1-2 (no invariant tests):\n      - ad6bea1: \"feat(agency): bell ack flow + stable codex drawbridge\"\n      - 01d0d93: \"feat(agency): Add /agency/page endpoint for sync agent requests\"\n      - 84ac0e0: \"Add unified agent registry for Agency\"\n      - 92fe6a1: \"feat(agency): Track session IDs for connected agents\"\n      4 major features built without A0-A5 proof tests.\n\n      Phase 1 (invariants named, tests written):\n      - 588a468: \"Phase 1: invariant proof tests (A0-A5) + integration tests\"\n      Result: 18 test failures documented. All five invariants violated.\n\n      Phase 2 (confessions):\n      - 5f85287: \"Phase 2: A0 — explicit delivery receipts for bells/whistles\"\n      - c5b5929: \"Phase 2: A1 — enforce single routing authority across stores\"\n      - 3f0aa3a: \"Phase 2: A3 — loud failure status checks + eliminate catch _ nil\"\n      - 804fe8f: \"Phase 2: A2 — atomic state (no silent corruption, atomic writes, non-nil continuity)\"\n      - 5dcb28b: \"Phase 2: A5 — bounded lifecycle (acks bound, TTL enforced, disconnect cascades)\"\n      5 commits, one per invariant. Each commit message is a confession: the feature it fixes was built without the property it enforces.\n\n    Mechanic, in short:\n    Derived from futon-theory via:\n    - structural-tension-as-observation: the three criteria (irritation, pressure, reappearance) detect invariant gaps if the loop is running -> write tests that embody the criteria before code\n    - retroactive-canonicalization: the Baldwin cycle (NAMING -> SELECTION -> CANALIZATION) applies to invariants: name them, select the ones that recur, canalize them as tests -> but doing this retroactively means you already paid the build cost\n    - stop-the-line: when invariants fail, block APPLY_CHANGE -> tests-first is stop-the-line applied to development, not just runtime"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    For each futon3c subsystem, track whether invariant proof tests were committed before or after the implementation they constrain. A ratio below 0.5 (tests-first / total invariant tests) indicates the pattern is not holding."}], :conclusion "Invariant proof tests must be written before the implementation they constrain. Invariants discovered during a rebuild are evidence that the tension-observation loop was not running — they have the same information content as proactive specifications, but the retroactive path pays the cost of building, debugging, and discarding code that violates them.", :directives {:audience "futon3c implementers, coordination system architects", :keywords ["invariants" "proof-tests" "tension" "observation" "retroactive" "confession" "rebuild"], :references ["futon-theory/structural-tension-as-observation" "futon-theory/retroactive-canonicalization" "futon-theory/proof-path" "futon-theory/stop-the-line"], :style "pattern", :title "Specify Invariants Before Writing the Code They Constrain", :tone "analytic-foundational"}, :id "social/tension-before-code", :keywords ["invariants" "proof-tests" "tension" "observation" "retroactive" "confession" "rebuild"], :projection-version "flexiarg-v0", :references ["futon-theory/structural-tension-as-observation" "futon-theory/retroactive-canonicalization" "futon-theory/proof-path" "futon-theory/stop-the-line"], :scores {}, :sigils [], :source-path "library/social/tension-before-code.flexiarg", :sources [], :status :ok, :title "Specify Invariants Before Writing the Code They Constrain", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Each namespace in a multi-agent coordination system must load cleanly and pass its own proof tests before being composed with others. The proof-path discipline (OBSERVE -> VERIFY at each step) applies to the development process itself, not only to runtime evidence."} {:name "context", :name-key "context", :slug "context", :text "You are building a real-time coordination system with multiple interoperating subsystems (agent registry, message routing, session management, bridge scripts) that will be composed into a single running process."} {:name "IF", :name-key "if", :slug "if", :text "    Components are designed as coherent architectural units — a registry, a proof-tree forum, a bell/whistle protocol — and written to match a design specification."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Code written to match a design document without incremental load-and-test accumulates latent errors (unresolved forward declarations, namespace ordering, type mismatches) that only surface when integration is attempted. At that point the debugging cost is multiplicative: each broken dependency interacts with every other, and the developer cannot tell whether a failure is in their code or in a dependency they assumed worked."} {:name "FAILURE-MODES", :name-key "failure-modes", :slug "failure-modes", :text "      - Load-order cascade: namespace A requires B which requires C, but C was never loaded independently; a typo in C surfaces only when A is loaded, and the error message points at A\n      - Forward-declaration debt: 5+ forward-declaration fix commits indicate a systematic habit of writing code as design documents rather than testable units\n      - Integration surprise: components that individually appear complete fail on first real composition because internal assumptions (atom state, protocol shape, identifier semantics) were never checked across boundaries"} {:name "THEN", :name-key "then", :slug "then", :text "    Require each namespace to compile and load before adding the next dependency. Write a minimal smoke test (can I call each public function without exception?) before composing namespaces. Treat a forward-declaration fix as a bug report against the development process, not a normal commit."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    The event-protocol pattern (futon-theory/event-protocol) requires OBSERVE before PROPOSE_CLAIM and VERIFY before the next step; applying this same discipline to development means you cannot claim a namespace works (PROPOSE_CLAIM) without first loading it (OBSERVE) and checking its public API (VERIFY). Forward declarations are evidence that PROPOSE_CLAIM preceded OBSERVE."} {:name "EVIDENCE", :name-key "evidence", :slug "evidence", :text "      futon3 git log, agency and drawbridge subsystems:\n      - f3044aa: \"fix(agency): Add forward declaration for agent-sessions\"\n      - adc8d67: \"fix(agency): Add forward declaration for kick-agent!\"\n      - 2da227e: \"Fix defonce syntax in registry.clj\"\n      - 1542b0a: \"fix(drawbridge): Add forward declaration for handle-par-bell!\"\n      - 6010d79: \"Fix: add connect-irc! to forward declarations in drawbridge\"\n      5 instances across 2 subsystems. Each commit fixes a function that was called before it was defined, meaning the namespace was never loaded between writing the call site and writing the function. This is systematic, not incidental.\n\n    Mechanic, in short:\n    Derived from futon-theory via:\n    - event-protocol: OBSERVE -> VERIFY at each step -> verify each namespace at each step\n    - proof-path: auditable chain from intent to proof -> development commits form a proof path; untested code is an unverified link\n    - agent-contract: \"observe before act\" -> load before compose"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    Count forward-declaration fixes in futon3c's git history after the first 30 commits. If the count exceeds 1, the pattern is not being followed and should be discussed in the next PAR."}], :conclusion "Each namespace in a multi-agent coordination system must load cleanly and pass its own proof tests before being composed with others. The proof-path discipline (OBSERVE -> VERIFY at each step) applies to the development process itself, not only to runtime evidence.", :directives {:audience "futon3c implementers, multi-agent system builders", :keywords ["incremental" "verification" "composition" "forward-declaration" "load-order" "namespace"], :references ["futon-theory/event-protocol" "futon-theory/proof-path" "futon-theory/agent-contract"], :style "pattern", :title "Verify Each Component Before Composing It With Others", :tone "analytic-foundational"}, :id "social/verify-before-compose", :keywords ["incremental" "verification" "composition" "forward-declaration" "load-order" "namespace"], :projection-version "flexiarg-v0", :references ["futon-theory/event-protocol" "futon-theory/proof-path" "futon-theory/agent-contract"], :scores {}, :sigils [], :source-path "library/social/verify-before-compose.flexiarg", :sources [], :status :ok, :title "Verify Each Component Before Composing It With Others", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "以轉接器在不改動既有介面的前提下完成整合。"} {:name "context", :name-key "context", :slug "context", :text "A component must integrate with a dependency that has an incompatible interface."} {:name "if", :name-key "if", :slug "if", :text "You want to avoid rewriting the dependency or polluting core logic with conversions."} {:name "however", :name-key "however", :slug "however", :text "Directly sprinkling translation code across callers causes duplication and brittle coupling."} {:name "then", :name-key "then", :slug "then", :text "Create a dedicated adapter that translates between the expected interface and the dependency’s interface, and keep the adapter as the only integration boundary."} {:name "because", :name-key "because", :slug "because", :text "A single translation boundary isolates change and preserves clean contracts."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Add contract tests around the adapter to prove compatibility and catch upstream changes.\n    - evidence-shape: {:adapter/name :string, :adapter/src :string, :adapter/dst :string, :adapter/tests [:string]}"}], :conclusion "以轉接器在不改動既有介面的前提下完成整合。", :directives {:sigils ["👴/申"], :title "Adapter Pattern"}, :id "software-design/adapter-pattern", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👴/申"], :source-path "library/software-design/adapter-pattern.flexiarg", :sources [], :status :ok, :title "Adapter Pattern", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Encapsulate every such operation as a Command value that carries `:id`, parameters, provenance, capability tags, and optional `undo!`, and run it only through an execution pipeline (local worker, remote service, or threaded pool). Commands can be persisted, reordered, decorated, and routed to specialised executors such as a git agent or math agent."} {:name "context", :name-key "context", :slug "context", :text "You are defining a reliable execution pipeline for agent actions."} {:name "if", :name-key "if", :slug "if", :text "    Agents perform repo scans, graph updates, and external API calls by invoking ad hoc functions with no shared interface, so actions cannot be queued, audited, or retried safely."} {:name "however", :name-key "however", :slug "however", :text "    Higher-layer orchestration needs side-effectful work to travel through queues, logs, schedulers, and undo ledgers without each caller reinventing a protocol."} {:name "then", :name-key "then", :slug "then", :text "    Encapsulate every such operation as a Command value that carries `:id`, parameters, provenance, capability tags, and optional `undo!`, and run it only through an execution pipeline (local worker, remote service, or threaded pool). Commands can be persisted, reordered, decorated, and routed to specialised executors such as a git agent or math agent."} {:name "because", :name-key "because", :slug "because", :text "    A uniform command abstraction gives the stack a shared action language: histories become replayable, undo/redo is tractable, thread pools can execute arbitrary work safely, and schedulers can move labour across machines without touching implementation internals."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    next[Log one concrete instance of this pattern in the futon3 ledger.]"}], :conclusion "  Encapsulate every such operation as a Command value that carries `:id`, parameters, provenance, capability tags, and optional `undo!`, and run it only through an execution pipeline (local worker, remote service, or threaded pool). Commands can be persisted, reordered, decorated, and routed to specialised executors such as a git agent or math agent.", :directives {:audience "futon developers, CS students, pattern agents", :sigils ["📥/井" "👘/示"], :style "design-pattern", :title "Agent Command Pattern", :tone "analytic"}, :id "p4ng/agent-command-pattern", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["📥/井" "👘/示"], :source-path "library/software-design/agent-command-pattern.flexiarg", :sources [], :status :ok, :title "Agent Command Pattern", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Wrap commands or strategies with Decorators—`LoggedCommand`, `TimedCommand`, `SynchronizedCommand`, `RetryingStrategy`, `PermissionCheckingDecorator`—that add behaviour before/after delegation while preserving the base interface. Apply decorators where work enters a queue or worker so meta-behaviour lives at the edge, not deep inside each action."} {:name "context", :name-key "context", :slug "context", :text "You are standardizing cross-cutting behaviors around agent actions."} {:name "if", :name-key "if", :slug "if", :text "    Commands and strategies already exist but every implementation hand-sprinkles logging, timing, locks, retries, permission checks, or paramitā/orb updates across the codebase."} {:name "however", :name-key "however", :slug "however", :text "    Cross-cutting concerns duplicated across dozens of commands quickly drift, complicate reviews, and break under concurrency."} {:name "then", :name-key "then", :slug "then", :text "    Wrap commands or strategies with Decorators—`LoggedCommand`, `TimedCommand`, `SynchronizedCommand`, `RetryingStrategy`, `PermissionCheckingDecorator`—that add behaviour before/after delegation while preserving the base interface. Apply decorators where work enters a queue or worker so meta-behaviour lives at the edge, not deep inside each action."} {:name "because", :name-key "because", :slug "because", :text "    Decorators let the agent stack layer observability, safety, and stewardship concerns without touching the business logic, so logging can be switched on globally, permission checks stay consistent, and concurrency guards become reusable armour around any command."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    next[Log one concrete instance of this pattern in the futon3 ledger.]"}], :conclusion "  Wrap commands or strategies with Decorators—`LoggedCommand`, `TimedCommand`, `SynchronizedCommand`, `RetryingStrategy`, `PermissionCheckingDecorator`—that add behaviour before/after delegation while preserving the base interface. Apply decorators where work enters a queue or worker so meta-behaviour lives at the edge, not deep inside each action.", :directives {:audience "futon developers, CS students, pattern agents", :sigils ["👘/示"], :style "design-pattern", :title "Agent Decorator Pattern", :tone "analytic"}, :id "p4ng/agent-decorator-pattern", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👘/示"], :source-path "library/software-design/agent-decorator-pattern.flexiarg", :sources [], :status :ok, :title "Agent Decorator Pattern", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Make the pipeline explicit: intent parsing emits Commands, a SchedulingStrategy selects the next move, and decorators (logging, timing, synchronisation, permission checks, orb tracking) wrap each command before worker threads call `execute!`. Document this flow with diagrams and a toy agent lab so newcomers can trace how intent, policy, and meta-behaviour interact."} {:name "context", :name-key "context", :slug "context", :text "You are teaching the command/strategy/decorator triad for agent systems."} {:name "if", :name-key "if", :slug "if", :text "    Students and maintainers often encounter Command, Strategy, and Decorator as isolated textbook animals, so multi-agent architectures feel like a zoo with no wiring diagram."} {:name "however", :name-key "however", :slug "however", :text "    FUTON stacks already rely on commands to carry work, strategies to choose policies, and decorators to enforce cross-cutting rules; failing to name the triad keeps the system opaque."} {:name "then", :name-key "then", :slug "then", :text "    Make the pipeline explicit: intent parsing emits Commands, a SchedulingStrategy selects the next move, and decorators (logging, timing, synchronisation, permission checks, orb tracking) wrap each command before worker threads call `execute!`. Document this flow with diagrams and a toy agent lab so newcomers can trace how intent, policy, and meta-behaviour interact."} {:name "because", :name-key "because", :slug "because", :text "    The Command/Strategy/Decorator triad turns “random agent code” into an explainable circuit—what gets done, how choices are made, and which protections wrap the work—so experimentation stays safe, reasoning stays legible, and multi-threaded agents behave predictably."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    next[Log one concrete instance of this pattern in the futon3 ledger.]"}], :conclusion "  Make the pipeline explicit: intent parsing emits Commands, a SchedulingStrategy selects the next move, and decorators (logging, timing, synchronisation, permission checks, orb tracking) wrap each command before worker threads call `execute!`. Document this flow with diagrams and a toy agent lab so newcomers can trace how intent, policy, and meta-behaviour interact.", :directives {:audience "futon developers, CS students, pattern agents", :sigils ["👘/井" "📥/示"], :style "design-pattern", :title "Agent Pattern Triad — Intent to Execution", :tone "analytic"}, :id "p4ng/agent-pattern-triad", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👘/井" "📥/示"], :source-path "library/software-design/agent-pattern-triad.flexiarg", :sources [], :status :ok, :title "Agent Pattern Triad — Intent to Execution", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Declare small Strategy protocols (`SummarisationStrategy/summarise`, `SchedulingStrategy/next-command`, `BackoffStrategy/next-delay`) and let the agent inject or swap concrete implementations at runtime. Configuration, prompts, or telemetry choose which strategy runs, and tests exercise strategies in isolation before the agent consumes them."} {:name "context", :name-key "context", :slug "context", :text "You are defining how an agent selects policies or moves."} {:name "if", :name-key "if", :slug "if", :text "    An agent repeatedly faces the same class of decision—summarise, schedule, pick a timeout, select a solver—yet the codebase is littered with `if`/`case` branches or feature flags that mutate behaviour in opaque ways."} {:name "however", :name-key "however", :slug "however", :text "    Experimenting with new policies or tailoring behaviour per user, prototype, or futon becomes brittle when the “how” is fused to the agent core."} {:name "then", :name-key "then", :slug "then", :text "    Declare small Strategy protocols (`SummarisationStrategy/summarise`, `SchedulingStrategy/next-command`, `BackoffStrategy/next-delay`) and let the agent inject or swap concrete implementations at runtime. Configuration, prompts, or telemetry choose which strategy runs, and tests exercise strategies in isolation before the agent consumes them."} {:name "because", :name-key "because", :slug "because", :text "    Strategies separate intent (“summarise this log”) from method (“fast heuristic vs deep reasoning”), enabling safe experiments, per-context policy bundles, and cleaner reasoning about which solver is responsible for each outcome."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    next[Log one concrete instance of this pattern in the futon3 ledger.]"}], :conclusion "  Declare small Strategy protocols (`SummarisationStrategy/summarise`, `SchedulingStrategy/next-command`, `BackoffStrategy/next-delay`) and let the agent inject or swap concrete implementations at runtime. Configuration, prompts, or telemetry choose which strategy runs, and tests exercise strategies in isolation before the agent consumes them.", :directives {:audience "futon developers, CS students, pattern agents", :sigils ["🚞/义"], :style "design-pattern", :title "Agent Strategy Pattern", :tone "analytic"}, :id "p4ng/agent-strategy-pattern", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🚞/义"], :source-path "library/software-design/agent-strategy-pattern.flexiarg", :sources [], :status :ok, :title "Agent Strategy Pattern", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "用單一門面對複雜子系統提供穩定入口。"} {:name "context", :name-key "context", :slug "context", :text "A subsystem exposes many low-level calls that are hard to orchestrate."} {:name "if", :name-key "if", :slug "if", :text "You want a simple, stable entry point without exposing internal complexity."} {:name "however", :name-key "however", :slug "however", :text "Letting callers assemble the sequence leads to duplicated orchestration and fragile workflows."} {:name "then", :name-key "then", :slug "then", :text "Create a facade that bundles the common orchestration into one high-level interface."} {:name "because", :name-key "because", :slug "because", :text "A stable facade shields callers from churn in underlying components."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Define a minimal surface and keep the facade free of business policy; push policy to a dedicated layer.\n    - evidence-shape: {:facade/name :string, :facade/entrypoints [:string], :facade/deps [:string]}"}], :conclusion "用單一門面對複雜子系統提供穩定入口。", :directives {:sigils ["👴/申"], :title "Facade Pattern"}, :id "software-design/facade-pattern", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👴/申"], :source-path "library/software-design/facade-pattern.flexiarg", :sources [], :status :ok, :title "Facade Pattern", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "以訂閱機制解耦事件發布與處理。"} {:name "context", :name-key "context", :slug "context", :text "Multiple components need to react to state changes in a subject."} {:name "if", :name-key "if", :slug "if", :text "You want to avoid tight coupling or hard-coded call chains."} {:name "however", :name-key "however", :slug "however", :text "Direct calls lock in dependencies and make extensions expensive."} {:name "then", :name-key "then", :slug "then", :text "Introduce a subject that publishes events to observers registered for specific signals."} {:name "because", :name-key "because", :slug "because", :text "The publisher remains stable while observers evolve independently."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Track observer lifetimes to avoid leaks; test that events fire once per change.\n    - evidence-shape: {:observer/subject :string, :observer/events [:string], :observer/subscribers [:string]}"}], :conclusion "以訂閱機制解耦事件發布與處理。", :directives {:sigils ["💎/介"], :title "Observer Pattern"}, :id "software-design/observer-pattern", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💎/介"], :source-path "library/software-design/observer-pattern.flexiarg", :sources [], :status :ok, :title "Observer Pattern", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "以代理物件在不改動本體的情況下控制存取或行為。"} {:name "context", :name-key "context", :slug "context", :text "A target object requires access control, caching, or remote indirection."} {:name "if", :name-key "if", :slug "if", :text "You need the same interface but want to add cross-cutting behavior."} {:name "however", :name-key "however", :slug "however", :text "Modifying the target mixes concerns and complicates testing."} {:name "then", :name-key "then", :slug "then", :text "Introduce a proxy that implements the same interface and delegates to the target while applying the extra behavior."} {:name "because", :name-key "because", :slug "because", :text "The proxy isolates policy while preserving substitutability."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Verify proxy and target are interface-compatible; test both cache hits and pass-through paths.\n    - evidence-shape: {:proxy/name :string, :proxy/target :string, :proxy/policy [:string]}"}], :conclusion "以代理物件在不改動本體的情況下控制存取或行為。", :directives {:sigils ["👴/介"], :title "Proxy Pattern"}, :id "software-design/proxy-pattern", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👴/介"], :source-path "library/software-design/proxy-pattern.flexiarg", :sources [], :status :ok, :title "Proxy Pattern", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "以狀態物件封裝行為轉換，避免龐大分支邏輯。"} {:name "context", :name-key "context", :slug "context", :text "An object changes its behavior based on internal state over time."} {:name "if", :name-key "if", :slug "if", :text "You want to avoid sprawling conditional logic inside the main object."} {:name "however", :name-key "however", :slug "however", :text "Centralized branching becomes brittle as new states are added."} {:name "then", :name-key "then", :slug "then", :text "Represent each state as its own object and delegate behavior to the active state."} {:name "because", :name-key "because", :slug "because", :text "State-specific logic stays localized and transitions become explicit."} {:name "next-steps", :name-key "next-steps", :slug "next-steps", :text "    - Define a transition table and test invalid transitions explicitly.\n    - evidence-shape: {:state/machine :string, :state/variants [:string], :state/transitions [:string]}"}], :conclusion "以狀態物件封裝行為轉換，避免龐大分支邏輯。", :directives {:sigils ["〰️/双"], :title "State Pattern"}, :id "software-design/state-pattern", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["〰️/双"], :source-path "library/software-design/state-pattern.flexiarg", :sources [], :status :ok, :title "State Pattern", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  correlate commit messages/PRs with devmap IDs; for each match, update the clause status + evidence ledger; if a clause stays marked “planned” despite recent commits, flag it as `drift` and prompt someone to reconcile"} {:name "context", :name-key "context", :slug "context", :text "You need to ensure that actual development work reflected in commits and PRs stays aligned with work plans as both code and plans evolve."} {:name "IF", :name-key "if", :slug "if", :text "    git commits reference a prototype or futon clause (“Prototype 4 done”, “stack blocker cleared”) while the devmap still lists it as planned/blocked"} {:name "HOWEVER", :name-key "however", :slug "however", :text "    that disconnect makes the roadmap lie about where energy went"} {:name "THEN", :name-key "then", :slug "then", :text "    correlate commit messages/PRs with devmap IDs; for each match, update the clause status + evidence ledger; if a clause stays marked “planned” despite recent commits, flag it as `drift` and prompt someone to reconcile"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    viriya is kinetic practice—commits and devmaps must reflect the same movement or we lose trust in both"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Add a nightly scan that correlates commits/PRs with devmap IDs and updates evidence.]\n    next[Flag any clause still marked planned after matching commits for reconciliation.]"}], :conclusion "  correlate commit messages/PRs with devmap IDs; for each match, update the clause status + evidence ledger; if a clause stays marked “planned” despite recent commits, flag it as `drift` and prompt someone to reconcile", :directives {:audience "futon stewards, stack maintainers", :factor "Energy (viriya)", :keywords ["commit" "pr" "pull-request" "drift" "reconcile" "sync" "mismatch" "planned" "roadmap" "progress" "git"], :references ["stack-coherence/staleness-scan" "stack-coherence/ready-blocked-triage" "devmap-coherence/next-steps-to-done"], :sigils ["🌆/上" "➰/升"], :title "Commit Intent Alignment", :tone "analytic-neutral"}, :id "stack-coherence/commit-intent-alignment", :keywords ["commit" "pr" "pull-request" "drift" "reconcile" "sync" "mismatch" "planned" "roadmap" "progress" "git"], :projection-version "flexiarg-v0", :references ["stack-coherence/staleness-scan" "stack-coherence/ready-blocked-triage" "devmap-coherence/next-steps-to-done"], :scores {}, :sigils ["🌆/上" "➰/升"], :source-path "library/stack-coherence/commit-intent-alignment.flexiarg", :sources [], :status :ok, :title "Commit Intent Alignment", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  scan READMEs, git logs, and test artifacts for references to that clause; if none exist, mark the clause `unsupported` and emit a TODO to capture the evidence; otherwise record `evidence[link]`"} {:name "context", :name-key "context", :slug "context", :text "You need to ensure that any planned work that is claimed to be done is sufficiently evidenced by concrete artifacts, or revered to a non-done state if they can't be found."} {:name "IF", :name-key "if", :slug "if", :text "    a devmap clause (any futon) claims a prototype is “done” or “stable”"} {:name "HOWEVER", :name-key "however", :slug "however", :text "    there is no pointer to concrete evidence (README section, tag, test fixture, commit) proving it"} {:name "THEN", :name-key "then", :slug "then", :text "    scan READMEs, git logs, and test artifacts for references to that clause; if none exist, mark the clause `unsupported` and emit a TODO to capture the evidence; otherwise record `evidence[link]`"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    dhammavicaya isn’t vibes—claims must cite reproducible proofs or they drift into fiction"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Anchor the codebook/transcripts task in traceable artifacts and evidence links.]"}], :conclusion "  scan READMEs, git logs, and test artifacts for references to that clause; if none exist, mark the clause `unsupported` and emit a TODO to capture the evidence; otherwise record `evidence[link]`", :directives {:audience "futon stewards, stack maintainers", :factor "Keen investigation (dhammavicaya)", :keywords ["evidence" "proof" "artifact" "verify" "validate" "document" "link" "reference" "cite" "audit" "trace"], :references ["stack-coherence/ready-blocked-triage" "devmap-coherence/ifr-state-convergence" "devmap-coherence/prototype-maturity-lifecycle"], :sigils ["➰/本" "📁/正"], :title "Stack Evidence Ledger", :tone "analytic-neutral"}, :id "stack-coherence/evidence-ledger", :keywords ["evidence" "proof" "artifact" "verify" "validate" "document" "link" "reference" "cite" "audit" "trace"], :projection-version "flexiarg-v0", :references ["stack-coherence/ready-blocked-triage" "devmap-coherence/ifr-state-convergence" "devmap-coherence/prototype-maturity-lifecycle"], :scores {}, :sigils ["➰/本" "📁/正"], :source-path "library/stack-coherence/evidence-ledger.flexiarg", :sources [], :status :ok, :title "Stack Evidence Ledger", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  for each declared cross-futon bridge (f1→f2, f2→f3, f3→f4, etc.), verify the bridge artifact exists, is callable, and returns expected data; emit health report per bridge with status, latency, and last-verified timestamp"} {:name "context", :name-key "context", :slug "context", :text "The FUTON stack depends on bridges between layers — adapters, exports, APIs, shared schemas. Bridge failures silently break coordination."} {:name "IF", :name-key "if", :slug "if", :text "    futons declare dependencies on upstream layers (\"uses futon1 graph memory\", \"receives futon2 pivot streams\", \"calls futon3 portal\")"} {:name "HOWEVER", :name-key "however", :slug "however", :text "    bridge health is rarely tested explicitly; a broken bridge manifests as mysterious downstream failures rather than a clear \"bridge X is down\""} {:name "THEN", :name-key "then", :slug "then", :text "    for each declared cross-futon bridge (f1→f2, f2→f3, f3→f4, etc.), verify the bridge artifact exists, is callable, and returns expected data; emit health report per bridge with status, latency, and last-verified timestamp"} {:name "BRIDGE-INVENTORY", :name-key "bridge-inventory", :slug "bridge-inventory", :text "      f0→f3a: vitality telemetry → futon3a morning review\n      f1→f2: graph memory → pivot stream context\n      f1→f3: graph memory → pattern store sync\n      f2→f3: pivot streams → proof trails\n      f3→f3a: pattern canon → portal queries\n      f3a→f0: audit logs → vitality dashboard\n      f3→f4: proof trails → Arxana nodes\n      f4→f5: GravPad → concentration practices\n      f5→f6: ledgers → Hyperreal entries\n      f3→f6: vetted patterns → argumentarium\n      f2,f3,f5,f6→f7: all artifacts → civic field"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    dhammavicaya requires knowing what exists — bridges are the connective tissue of the stack, and their health must be observable, not assumed"} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Create a bridge registry listing each declared bridge with its health check method.]\n    next[Run bridge health checks weekly; log failures as stack blockers.]\n    next[Add bridge status to futon3a morning review digest.]"}], :conclusion "  for each declared cross-futon bridge (f1→f2, f2→f3, f3→f4, etc.), verify the bridge artifact exists, is callable, and returns expected data; emit health report per bridge with status, latency, and last-verified timestamp", :directives {:audience "futon stewards, stack maintainers", :factor "Keen investigation (dhammavicaya)", :references ["devmap-coherence/prototype-alignment-bridge" "stack-coherence/stack-blocker-detection" "devmap-coherence/ifr-f2-viriya" "devmap-coherence/ifr-f3-piti"], :sigils ["🚞/门" "😄/及"], :title "Futon Bridge Health Check", :tone "analytic-neutral"}, :id "stack-coherence/futon-bridge-health", :keywords [], :projection-version "flexiarg-v0", :references ["devmap-coherence/prototype-alignment-bridge" "stack-coherence/stack-blocker-detection" "devmap-coherence/ifr-f2-viriya" "devmap-coherence/ifr-f3-piti"], :scores {}, :sigils ["🚞/门" "😄/及"], :source-path "library/stack-coherence/futon-bridge-health.flexiarg", :sources [], :status :ok, :title "Futon Bridge Health Check", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  rely on the `Futon1 Deterministic Stack` GitHub Action (`futon1/.github/workflows/futon1-stack-tests.yml`) or run the suites manually (`cd futon1/apps/client && clojure -M:test`, `cd apps/graph-memory && clojure -M:test -m cognitect.test-runner`, `cd apps/nlp-interface && clojure -M:test`). When any leg fails, regenerate `resources/baseline/demo_session.edn` via `clojure -M:baseline/snapshot --write ...` or fix the regression before advancing futons that depend on storage/NLP determinism"} {:name "context", :name-key "context", :slug "context", :text "You want CI assured enforcement that client, storage, and NLP components remain deterministic under shared test and baseline suites."} {:name "IF", :name-key "if", :slug "if", :text "    FUTON1’s Prototype 0–1 guarantees hinge on `apps/client` emitting the canonical Willie/Jane focus-header + XTDB mirrors"} {:name "HOWEVER", :name-key "however", :slug "however", :text "    that promise drifts unless we check the determinism suite whenever the stack changes"} {:name "THEN", :name-key "then", :slug "then", :text "    rely on the `Futon1 Deterministic Stack` GitHub Action (`futon1/.github/workflows/futon1-stack-tests.yml`) or run the suites manually (`cd futon1/apps/client && clojure -M:test`, `cd apps/graph-memory && clojure -M:test -m cognitect.test-runner`, `cd apps/nlp-interface && clojure -M:test`). When any leg fails, regenerate `resources/baseline/demo_session.edn` via `clojure -M:baseline/snapshot --write ...` or fix the regression before advancing futons that depend on storage/NLP determinism"} {:name "BECAUSE", :name-key "because", :slug "because", :text "    dhammavicaya keeps the substrate honest—the focus-header fixture, graph-memory schema tests, and NLP pipeline fixtures are the shared proof artifacts, so stack-coherence 