conclusion", :text "Deliberation patterns should be defined independently of rendering technology so they work across VR domes, AR overlays, 2D graphs, hypertext, and terminals."} {:name "context", :name-key "context", :slug "context", :text "You are designing for longevity across hardware generations."} {:name "IF", :name-key "if", :slug "if", :text "The patterns of connection, clustering, and deliberation outlive specific renderers."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Coupling to one technology (A-Frame, a specific headset) means patterns die with it."} {:name "THEN", :name-key "then", :slug "then", :text "Define the deliberation layer as data structures and interaction contracts. Each projection surface implements the contract differently."} {:name "BECAUSE", :name-key "because", :slug "because", :text "Projection independence is how a pattern library outlives its first implementation."} {:name "STATUS", :name-key "status", :slug "status", :text "status[sketch]"}], :conclusion "Deliberation patterns should be defined independently of rendering technology so they work across VR domes, AR overlays, 2D graphs, hypertext, and terminals.", :directives {:sigils ["🪞/映"], :title "Projection Independence"}, :id "vsatelier/projection-independence", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🪞/映"], :source-path "library/vsatelier/vsatelier.multiarg", :sources [], :status :ok, :title "Projection Independence", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Outcomes of actions should re-enter the constellation as new stories, closing the loop between seeing, deciding, acting, and witnessing."} {:name "context", :name-key "context", :slug "context", :text "You are designing a living system where action feeds back into shared knowledge."} {:name "IF", :name-key "if", :slug "if", :text "A community acts on a pattern surfaced by the constellation."} {:name "HOWEVER", :name-key "however", :slug "however", :text "If the outcome is never recorded, the constellation becomes a static snapshot."} {:name "THEN", :name-key "then", :slug "then", :text "Structure outcome stories that re-enter as new nodes, with arcs from the decision record to the outcome."} {:name "BECAUSE", :name-key "because", :slug "because", :text "The return loop transforms the constellation from a diagnostic instrument into a learning cycle."} {:name "STATUS", :name-key "status", :slug "status", :text "status[sketch]"}], :conclusion "Outcomes of actions should re-enter the constellation as new stories, closing the loop between seeing, deciding, acting, and witnessing.", :directives {:sigils ["🔄/返"], :title "Return Loop (Outcomes as New Stories)"}, :id "vsatelier/return-loop", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🔄/返"], :source-path "library/vsatelier/vsatelier.multiarg", :sources [], :status :ok, :title "Return Loop (Outcomes as New Stories)", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Treat each facilitated session as a rehearsal — a bounded, low-stakes space where participants practise collective interpretation, deliberation, and commitment."} {:name "context", :name-key "context", :slug "context", :text "You are introducing deliberation practices to groups new to collective sense-making."} {:name "IF", :name-key "if", :slug "if", :text "Participants are new to interpreting linked stories and producing shared decisions."} {:name "HOWEVER", :name-key "however", :slug "however", :text "Jumping to consequential decisions in an unfamiliar medium risks poor outcomes."} {:name "THEN", :name-key "then", :slug "then", :text "Structure early sessions as rehearsals with small anthologies and low-stakes questions. Graduate to consequential sessions once the group has practised the cycle."} {:name "BECAUSE", :name-key "because", :slug "because", :text "An atelier is a place of practice before it is a place of production. Deliberation skills are learned through doing."} {:name "STATUS", :name-key "status", :slug "status", :text "status[sketch]"}], :conclusion "Treat each facilitated session as a rehearsal — a bounded, low-stakes space where participants practise collective interpretation, deliberation, and commitment.", :directives {:sigils ["🎭/排"], :title "Session as Rehearsal"}, :id "vsatelier/session-as-rehearsal", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🎭/排"], :source-path "library/vsatelier/vsatelier.multiarg", :sources [], :status :ok, :title "Session as Rehearsal", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Use the proof-of-concept budget to answer the specific “does linking add value”\n  question instead of building a finished system."} {:name "context", :name-key "context", :slug "context", :text "You are framing how proof-of-concept funds should be spent so funders (and other stakeholders) can see the value of \"story linking\" versus broader platform build-out. This does not apply once the linking question is already answered or the phase is post-PoC."} {:name "IF", :name-key "if", :slug "if", :text "    Funders care whether minimal linking increases organisational value in the proof-of-concept phase."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Spending on general development could end with no evidence for that question."} {:name "THEN", :name-key "then", :slug "then", :text "    Allocate funds to build the minimal feature, run pilots, and extract concrete\n    offerings so the phase ends with documented value."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Focusing budget on a falsifiable question is more accountable than diffuse\n    build-out."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Prepare the funder overview linking feature, pilots, and outcomes to the central question.]\n    next[Define a success threshold (e.g., ≥2 pilots show improved shared insight) to trigger post-PoC build-out.]"}], :conclusion "  Use the proof-of-concept budget to answer the specific “does linking add value”\n  question instead of building a finished system.", :directives {:audience "VSAT collaborators, funders", :references ["vsatlas/proof-of-concept-scope" "repository-transition/job-argument"], :sigils ["🌽/卜" "🔃/万"], :title "Accountable Use of Proof-of-Concept Funds", :tone "plain-analytic"}, :id "vsatlas/accountable-poc", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlas/proof-of-concept-scope" "repository-transition/job-argument"], :scores {}, :sigils ["🌽/卜" "🔃/万"], :source-path "library/vsatlas/accountable-poc.flexiarg", :sources [], :status :ok, :title "Accountable Use of Proof-of-Concept Funds", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Add an interpretive “askew” layer where contributors propose arcs, passages, and conceptual bridges without modifying originals."} {:name "context", :name-key "context", :slug "context", :text "You are designing a narrative system where contributors can explore interpretations and relationships without altering canonical stories, preserving authorial integrity while enabling sense-making. This does not apply when the canonical layer can be edited by mutual consent."} {:name "IF", :name-key "if", :slug "if", :text "    Canonical stories must be preserved yet contributors need room to explore relations."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Forcing links into the canonical layer violates narrative sovereignty and breeds incoherence."} {:name "THEN", :name-key "then", :slug "then", :text "    Add an interpretive “askew” layer where contributors propose arcs, passages, and conceptual bridges without modifying originals."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Interpretive overlays let relational meaning emerge while protecting authorial integrity."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Define a lightweight \"askew\" proposal schema and review workflow.]\n    next[Prototype one askew bridge on an existing story pair.]\n    next[Define apply/avoid signals (e.g., \"canon locked\" vs \"canon editable\").]\n    next[Record one case where askew prevented a canonical conflict and one where it added noise.]\n    next[Consolidate with vsatlas/non-destructive-relational-layers and retire this pattern once merged.]"}], :conclusion "  Add an interpretive “askew” layer where contributors propose arcs, passages, and conceptual bridges without modifying originals.", :directives {:audience "software architects, narrative system designers", :sigils ["🍯/只" "🙇/双"], :style "design-pattern", :title "Askew Layer", :tone "analytic"}, :id "vsatlas/askew-layer", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🍯/只" "🙇/双"], :source-path "library/vsatlas/askew-layer.flexiarg", :sources [], :status :ok, :title "Askew Layer", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Design for peer-to-peer audiences by enabling reciprocal storytelling loops and navigable inter-story connections."} {:name "context", :name-key "context", :slug "context", :text "You are rethinking platform design so audiences become active participants who respond to and connect with each other’s stories, rather than remaining passive viewers. This does not apply to one-way broadcast archives where participation is not a goal."} {:name "IF", :name-key "if", :slug "if", :text "    The platform centres display logic so stories attract passive spectators."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Communities require environments where participants recognise and respond to one another as peers."} {:name "THEN", :name-key "then", :slug "then", :text "    Design for peer-to-peer audiences by enabling reciprocal storytelling loops and navigable inter-story connections."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Shifting the audience from spectators to participants restores agency, dialogue, and collective problem-solving."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Prototype one reciprocal loop (respond, remix, or co-author) in the UI.]\n    next[Measure how often participants move from viewing to contributing.]\n    next[Define an apply signal (e.g., >60% sessions are view-only) and an avoid signal (e.g., high safety risk for public replies).]"}], :conclusion "  Design for peer-to-peer audiences by enabling reciprocal storytelling loops and navigable inter-story connections.", :directives {:audience "media theorists, civic technologists", :sigils ["💤/也" "🐜/上"], :style "design-pattern", :title "Audience Shift", :tone "analytic"}, :id "vsatlas/audience-shift", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["💤/也" "🐜/上"], :source-path "library/vsatlas/audience-shift.flexiarg", :sources [], :status :ok, :title "Audience Shift", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Recognise that VSAT already excels at self-authored stories but does not yet\n  help organisations see what a cohort’s stories reveal together."} {:name "context", :name-key "context", :slug "context", :text "You have built a system that supports individual storytelling but that doesn't yet help people see collective patterns across stories."} {:name "IF", :name-key "if", :slug "if", :text "    Partners such as ACMi adopt VSAT for elegant individual storytelling."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    They cannot inspect the collective field; there is no support for linking or\n    comparing stories to surface shared diagnosis."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat “collective understanding of stories” as the unmet need and scope any\n    proof-of-concept around that gap."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Without framing the gap explicitly, pilots will chase polish rather than the\n    organisational question."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Write an internal note summarising the current strength + explicit gap to anchor partner briefings.]\n    next[Define a gap indicator (e.g., no cross-story links or shared themes in partner debriefs) and note when the pattern stops applying.]"}], :conclusion "  Recognise that VSAT already excels at self-authored stories but does not yet\n  help organisations see what a cohort’s stories reveal together.", :directives {:audience "VSAT collaborators", :references ["vsatlas/peeragogical-infrastructures" "vsatlas/value-flow-constellation"], :sigils ["👀/卜" "🌏/万"], :title "Current Strength and Gap", :tone "plain-analytic"}, :id "vsatlas/current-strength-gap", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlas/peeragogical-infrastructures" "vsatlas/value-flow-constellation"], :scores {}, :sigils ["👀/卜" "🌏/万"], :source-path "library/vsatlas/current-strength-gap.flexiarg", :sources [], :status :ok, :title "Current Strength and Gap", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Allow emergent clusters to attach lightweight economic tools (mutual aid, microcredit, resource maps) to relational arcs."} {:name "context", :name-key "context", :slug "context", :text "You are exploring how narrative connections can be paired with lightweight economic tools so relational meaning aligns with material mutual support. This does not apply when there is no willingness to manage shared resources. Treat this as future work until core linking is validated."} {:name "IF", :name-key "if", :slug "if", :text "    Atomised interventions and isolated acts of generosity rarely create durable resilience."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Story systems that operate purely at the narrative level ignore material alignment."} {:name "THEN", :name-key "then", :slug "then", :text "    Allow emergent clusters to attach lightweight economic tools (mutual aid, microcredit, resource maps) to relational arcs."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    When narrative resonance aligns with economic mutuality, the manifold becomes regenerative rather than extractive."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Prototype one mutual-aid link attached to an existing story cluster.]\n    next[Define a lightweight resource map schema for shared contributions.]\n    next[Define a success metric (e.g., mutual-aid participation rises after linking) and a falsifying observation.]\n    next[Identify one small-scale pilot (e.g., one community media org linking to a few peers) to test feasibility.]"}], :conclusion "  Allow emergent clusters to attach lightweight economic tools (mutual aid, microcredit, resource maps) to relational arcs.", :directives {:audience "alternative-economy designers, community developers", :sigils ["🍯/义" "💫/支"], :style "design-pattern", :title "Economic Resonance Layer", :tone "conceptual"}, :id "vsatlas/economic-resonance-layer", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🍯/义" "💫/支"], :source-path "library/vsatlas/economic-resonance-layer.flexiarg", :sources [], :status :ok, :title "Economic Resonance Layer", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Treat the manifold as a festival—an evolving scene where newcomers, veterans, and stewards co-create shared worlds."} {:name "context", :name-key "context", :slug "context", :text "You are conceptualising the 'story manifold' as a living cultural space where ongoing participation, roles, and rituals matter more than static content delivery. This does not apply to one-off exhibitions without recurring cohorts."} {:name "IF", :name-key "if", :slug "if", :text "    Linear media formats keep participation limited to producers and spectators, turning the platform into a static catalog of finished works."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Cultural vitality emerges from collective gatherings, ongoing creation, and interwoven practices."} {:name "THEN", :name-key "then", :slug "then", :text "    Treat the manifold as a festival—an evolving scene where newcomers, veterans, and stewards co-create shared worlds."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Festivals generate cultures, not commodities."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Draft one recurring festival ritual that invites newcomers into stewardship.]\n    next[Name the roles for one season and define how people graduate between them.]\n    next[Define a signal for when the festival model should start (e.g., repeat cohort demand) and a signal to pause.]"}], :conclusion "  Treat the manifold as a festival—an evolving scene where newcomers, veterans, and stewards co-create shared worlds.", :directives {:audience "cultural designers, community technologists", :sigils ["🎏/门" "🎴/女"], :style "design-pattern", :title "Festival Model", :tone "conceptual"}, :id "vsatlas/festival-model", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🎏/门" "🎴/女"], :source-path "library/vsatlas/festival-model.flexiarg", :sources [], :status :ok, :title "Festival Model", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Introduce a manifold layer where canonical charts overlap voluntarily so resonances can emerge without rewriting originals."} {:name "context", :name-key "context", :slug "context", :text "You are considering introducing a voluntary overlap or annotation layer that enables shared meaning to be made without rewriting originals. This does not apply when stories are already intentionally merged into a single narrative."} {:name "IF", :name-key "if", :slug "if", :text "    Contributors craft narrative dioramas in isolation and the stack offers no cross-story relation layer."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Groups need shared meaning rather than atomised testimony."} {:name "THEN", :name-key "then", :slug "then", :text "    Introduce a manifold layer where canonical charts overlap voluntarily so resonances can emerge without rewriting originals."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Relational topology converts isolated narratives into a shared world with emergent coherence."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Define the minimal overlap annotation schema and one pilot use case.]\n    next[Prototype an opt-in overlay view that preserves original charts.]\n    next[Define a decision signal (e.g., repeated cross-story themes with no shared map) and a failure case to retire the overlay.]\n    next[Consolidate with vsatlas/non-destructive-relational-layers and retire this pattern once merged.]"}], :conclusion "  Introduce a manifold layer where canonical charts overlap voluntarily so resonances can emerge without rewriting originals.", :directives {:audience "platform architects, collective narrative designers", :sigils ["🐊/田" "🎶/白"], :style "design-pattern", :title "Isolarion Drift", :tone "analytic"}, :id "vsatlas/isolarion-drift", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🐊/田" "🎶/白"], :source-path "library/vsatlas/isolarion-drift.flexiarg", :sources [], :status :ok, :title "Isolarion Drift", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Build only the minimal linking feature and test it with one or two tightly\n  scoped pilots."} {:name "context", :name-key "context", :slug "context", :text "You are defining a tightly scoped build-and-test phase that focuses only on core linking actions, so pilots can answer whether collective sense-making improves with these features. This does not apply when the linking loop is already validated for the"} {:name "IF", :name-key "if", :slug "if", :text "    Budget is small and the linking concept is unproven with real groups."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Shipping broader features before testing risks consuming funds without\n    answering the central question.\n    target cohort."} {:name "THEN", :name-key "then", :slug "then", :text "    Implement only propose/confirm/view links and run short pilots with carefully\n    chosen partners (e.g., ACMi, a university class)."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Concentrating on the linking loop lets partners judge whether collective\n    sense-making improves."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Pick 1–2 partners and co-design a lightweight pilot plan documenting observations.]\n    next[Define a decision threshold (e.g., pilots report new shared insights) that gates broader feature build-out.]"}], :conclusion "  Build only the minimal linking feature and test it with one or two tightly\n  scoped pilots.", :directives {:audience "VSAT collaborators", :references ["vsatlas/proof-of-concept-scope" "vsatlas/value-flow-constellation"], :sigils ["👓/石" "🌏/匀"], :title "Minimal Feature and Pilots", :tone "plain-analytic"}, :id "vsatlas/minimal-linking-pilot", :keywords [], :projection-version "flexiarg-v0", :references ["vsatlas/proof-of-concept-scope" "vsatlas/value-flow-constellation"], :scores {}, :sigils ["👓/石" "🌏/匀"], :source-path "library/vsatlas/minimal-linking-pilot.flexiarg", :sources [], :status :ok, :title "Minimal Feature and Pilots", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Add relational layers that connect stories without rewriting the originals."} {:name "context", :name-key "context", :slug "context", :text "You are extending a story corpus into a shared world while preserving narrative sovereignty. This does not apply when stories are intentionally merged into a single authored narrative."} {:name "IF", :name-key "if", :slug "if", :text "    Contributors need to propose links, arcs, or interpretations across stories without altering the canonical texts."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Forcing links into canonical layers violates sovereignty and can create incoherence or conflict."} {:name "THEN", :name-key "then", :slug "then", :text "    Introduce opt-in relational layers (e.g., overlays, adjacency maps, interpretive bridges) that sit beside canonical stories and can be accepted, revised, or retired without changing originals."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Non-destructive layers allow shared meaning to emerge while protecting ownership and provenance."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Define a lightweight relational proposal schema (links, arcs, bridges) and a review workflow.]\n    next[Prototype an opt-in overlay view that preserves original stories.]\n    next[Sketch an “emporium” adjacency map for three stories and define a minimal adjacency link type.]\n    next[Record one case where the layer prevented a canonical conflict and one case where it added noise.]"}], :conclusion "  Add relational layers that connect stories without rewriting the originals.", :directives {:audience "narrative system designers, VSAT collaborators", :sigils ["🌈/义"], :style "design-pattern", :title "Non-Destructive Relational Layers", :tone "analytic"}, :id "vsatlas/non-destructive-relational-layers", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌈/义"], :source-path "library/vsatlas/non-destructive-relational-layers.flexiarg", :sources [], :status :ok, :title "Non-Destructive Relational Layers", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Define a simple offer ladder (intro workshop → multi-session pilot → annual programme) where each rung has a clear scope, price band, and expected outcome."} {:name "context", :name-key "context", :slug "context", :text "You are translating 'story manifold' capabilities into a small set of concrete (purchasable) offerings that institutions can understand, budget for, and adopt. This does not apply when procurement requires a single bundled offer."} {:name "IF", :name-key "if", :slug "if", :text "    A story platform with rich theory but no articulated “offers” risks being seen as a research toy rather than a service."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Communities, NGOs, and universities buy concrete packages—workshops, courses, facilitation, reporting—rather than abstract infrastructures."} {:name "THEN", :name-key "then", :slug "then", :text "    Define a simple offer ladder (intro workshop → multi-session pilot → annual programme) where each rung has a clear scope, price band, and expected outcome."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    A visible ladder of offers turns VSATLAS from an idea into a portfolio of bookable engagements that can recover costs and demonstrate real-world demand."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Draft the three-rung ladder with scope, price band, and outcomes.]\n    next[Test the ladder with one partner and refine based on feedback.]\n    next[Define adoption signals (e.g., partner picks a rung without extra explanation) and revise if absent.]\n    next[Define where interpretation sessions sit in the ladder (e.g., a mid-tier offer).]"}], :conclusion "  Define a simple offer ladder (intro workshop → multi-session pilot → annual programme) where each rung has a clear scope, price band, and expected outcome.", :directives {:audience "funders, programme designers, institutional partners", :sigils ["🌞/六" "🔹/只"], :style "design-pattern", :title "Offer Ladder", :tone "analytic"}, :id "vsatlas/offer-ladder", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌞/六" "🔹/只"], :source-path "library/vsatlas/offer-ladder.flexiarg", :sources [], :status :ok, :title "Offer Ladder", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Publish core components under open licences, cultivate a distributed developer community, and document governance primitives."} {:name "context", :name-key "context", :slug "context", :text "You are considering whether there is a strategic requirement that the platform’s foundations remain open, forkable, and governable to support long-term collective authorship. This does not apply to short-lived prototypes where governance is not yet in scope."} {:name "IF", :name-key "if", :slug "if", :text "    Centralised proprietary systems limit trust, adoption, and collaboration."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Multi-author worlds require transparent, forkable, and collectively governed foundations."} {:name "THEN", :name-key "then", :slug "then", :text "    Publish core components under open licences, cultivate a distributed developer community, and document governance primitives."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Only an open ecosystem can support pluriversality, collective authorship, and long-term resilience."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Draft an open-ecosystem charter and list the non-negotiables.]\n    next[Identify the first two governance primitives to document publicly.]\n    next[Define evidence signals (e.g., external contributors, forks, governance participation) and a failure case (e.g., no uptake despite openness).]"}], :conclusion "  Publish core components under open licences, cultivate a distributed developer community, and document governance primitives.", :directives {:audience "platform strategists, organisational designers", :sigils ["👐/门" "🔦/支"], :style "design-pattern", :title "Open Ecosystem Mandate", :tone "analytic"}, :id "vsatlas/open-ecosystem-mandate", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👐/门" "🔦/支"], :source-path "library/vsatlas/open-ecosystem-mandate.flexiarg", :sources [], :status :ok, :title "Open Ecosystem Mandate", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Embed scaffolds for co-authorship, negotiation of meaning, stewardship, and joint decision-making inside the manifold."} {:name "context", :name-key "context", :slug "context", :text "You are designing a complex knowledge ecosystem that actively teaches contributors how to collaborate, negotiate meaning, and share responsibility, not just create content. This does not apply to short, one-off workshops without ongoing community formation."} {:name "IF", :name-key "if", :slug "if", :text "    Contributors learn media-making but struggle with collaborative coordination and shared responsibility."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    The platform teaches creation but not co-governance."} {:name "THEN", :name-key "then", :slug "then", :text "    Embed scaffolds for co-authorship, negotiation of meaning, stewardship, and joint decision-making inside the manifold."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Peeragogical competence is required to maintain shared worlds and enable social imagination."} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-steps", :text "    next[Add one explicit co-authorship ritual to the onboarding flow.]\n    next[Define a stewardship checkpoint that requires shared decision-making.]\n    next[Define success signals (e.g., shared decisions recorded) and a failure signal (e.g., coordination breakdown persists).]"}], :conclusion "  Embed scaffolds for co-authorship, negotiation of meaning, stewardship, and joint decision-making inside the manifold.", :directives {:audience "educators, peer-learning designers", :sigils ["👍/门" "🌀/田"], :style "design-pattern", :title "Peeragogical Infrastructures", :tone "analytic"}, :id "vsatlas/peeragogical-infrastructures", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["👍/门" "🌀/田"], :source-path "library/vsatlas/peeragogical-infrastructures.flexiarg", :sources [], :status :ok, :title "Peeragogical Infrastructures", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "  Translate successful pilots into a few clearly named offerings that\n  organisations can adopt and fund."} {:name "context", :name-key "context", :slug "context", :text "You are focused on converting pilot learnings into clearly named programmes, so partners can recognise what is being offered and why it matters. This does not apply before pilot evidence exists."} {:name "IF", :name-key "if", :slug "if", :text "    Pilots show that linked stories help cohorts see shared situations."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Leaving results as “internal improvements” obscures what partners are buying."} {:name "THEN", :name-key "then", :slug "then", :text "    Package the practice into offers (e.g., connected community story lab, linked\n    stories module)