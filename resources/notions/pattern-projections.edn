ion 2\n   :match-threshold 0.45\n   :invert-on-phenotype? true\n   :update-prob 0.55\n   :mix-mode :scramble\n   :description \"Mobile, adaptive intervention\"}\n\n  :tensor-interpretation\n  {:operation :wander\n   :description \"Transient movement\"}\n\n  :regime-prediction\n  {:expected :transient\n   :dynamics \"Mobile patterns with low stability\"\n   :eoc-relevance \"Can explore but unstable\"}\n\n@domain-transfer-notes\n  \"旅 is the pattern of WANDERING across domains:\n   - In ants: roaming adaptation\n   - In CA: transient structures\""}], :conclusion "The wanderer is transient; adaptability and caution sustain movement.", :directives {:audience "improvisers, system designers, CT practitioners", :sigils ["🌆/亏"], :style "pattern", :title "䷷ 旅 (Lǚ) - The Wanderer", :tone "foundational"}, :id "iching/hexagram-56-lv", :keywords [], :projection-version "flexiarg-v0", :references [], :scores {}, :sigils ["🌆/亏"], :source-path "library/iching/hexagram-56-lv.flexiarg", :sources [], :status :ok, :title "䷷ 旅 (Lǚ) - The Wanderer", :typed-slots nil} #:pattern{:clauses [{:name "conclusion", :name-key "conclusion", :slug "conclusion", :text "Gentle, repeated influence penetrates more deeply than force."} {:name "context", :name-key "context", :slug "context", :text "A system needs gradual alignment rather than abrupt change."} {:name "IF", :name-key "if", :slug "if", :text "    Direct force fails or causes resistance."} {:name "HOWEVER", :name-key "however", :slug "however", :text "    Excess gentleness can become indecision or drift."} {:name "THEN", :name-key "then", :slug "then", :text "    Apply steady, low-amplitude influence until alignment appears."} {:name "BECAUSE", :name-key "because", :slug "because", :text "    Wind shapes by persistence; gradual pressure can redirect flows."} {:name "evidence", :name-key "evidence", :slug "evidence", :text "Traditional: \"The Gentle. Success through what is small.\""} {:name "NEXT-STEPS", :name-key "next-steps", :slug "next-s